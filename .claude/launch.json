{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "apfelwiese",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "app",
        "run",
        "dev",
        "--",
        "--port",
        "5174",
        "--strictPort"
      ],
      "port": 5174
    },
    {
      "name": "apfelwiese-live-api",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "APFEL_API=live",
        "npm",
        "--prefix",
        "app",
        "run",
        "dev",
        "--",
        "--port",
        "5175",
        "--strictPort"
      ],
      "port": 5175
    }
  ]
}