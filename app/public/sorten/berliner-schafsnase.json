{"id":"berliner-schafsnase","name":"Berliner Schafsnase","synonyme":[{"name":"Berliner Apfel","beleg":{"quelle":"illustr_hb_1","band":"I","seite":"209"}},{"name":"Pomme de Berlin","beleg":{"quelle":"illustr_hb_1","band":"I","seite":"209"}},{"name":"Pomme prussienne","beleg":{"quelle":"illustr_hb_1","band":"I","seite":"209"}}],"herkunft":{"text":"Herkunft nach dem Illustrirten Handbuch (1859) Preußen; die Sorte war vorzugsweise in Norddeutschland verbreitet. Diel beschrieb sie unter diesem Namen (Heft XVIII, S. 18).","belege":[{"quelle":"illustr_hb_1","band":"I","seite":"209"},{"quelle":"engelbrecht1889","seite":"91 (Nr. 82)"}]},"merkmale":[{"merkmal":"frucht_breite","wert":65,"original":"Gestalt 65:66—72","quelle":"engelbrecht1889","seite":"91 (Nr. 82)"},{"merkmal":"frucht_hoehe","wert":69,"original":"Gestalt 65:66—72","quelle":"engelbrecht1889","seite":"91 (Nr. 82)"},{"merkmal":"frucht_hoehe_breite","wert":1.06,"original":"Gestalt 65:66—72","quelle":"engelbrecht1889","seite":"91 (Nr. 82)"},{"merkmal":"frucht_form","wert":"eifoermig","original":"etwas abgest. lang eiförm., häufig mehr walzen-, selten mehr kegelförm.","quelle":"engelbrecht1889","seite":"91 (Nr. 82)"},{"merkmal":"frucht_form","wert":"walzenfoermig","original":"etwas abgest. lang eiförm., häufig mehr walzen-, selten mehr kegelförm.","quelle":"engelbrecht1889","seite":"91 (Nr. 82)"},{"merkmal":"frucht_breiteste_stelle","wert":"stiel","original":"wenig stielbauch.","quelle":"engelbrecht1889","seite":"91 (Nr. 82)"},{"merkmal":"frucht_symmetrie","wert":"schief","original":"Hälften oft etwas ungleich","quelle":"engelbrecht1889","seite":"91 (Nr. 82)"},{"merkmal":"frucht_rippung","wert":"5","original":"Querschnitt flachkantig, oft fast rund","quelle":"engelbrecht1889","seite":"91 (Nr. 82)"},{"merkmal":"frucht_rippung","wert":"3","original":"Querschnitt flachkantig, oft fast rund","quelle":"engelbrecht1889","seite":"91 (Nr. 82)"},{"merkmal":"frucht_kronung","wert":"5","original":"zwischen mässig starken, flach