imedia.org/wiki/File:Deutsche_Pomologie_-_Aepfel_-_015.jpg","art":"tafel","urheber":"Wilhelm Lauche","lizenz":"gemeinfrei","quelle":"lauche1883","titel":"Deutsche Pomologie - Aepfel - 015"}],"farbmessung":[{"bild":"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/9f/Deutsche_Pomologie_-_Aepfel_-_015.jpg/960px-Deutsche_Pomologie_-_Aepfel_-_015.jpg","methode":"Farbtafel","verfahren":"Chromolithografie (Lauche, Deutsche Pomologie 1882–83); Papierton als Weißpunkt; Frucht vor Papier freigestellt; Schalenpixel einzeln klassifiziert (Deckfarbe = deutlich höheres a* als die Grundfarbe, Anteile über Pixel); Höhe/Breite aus dem Längsschnitt, sonst aus der Seitenansicht; gemessen an einer 480 px breiten Kopie; Druckfarben gealtert, nicht fotometrisch","grundfarbe":"#c1b237","deckfarbeAnteil":0.01,"fleischfarbe":"#ebead0","hoeheZuBreite":0.938}],"regionen":[{"region":"DE-MV","art":"empfehlung","belege":[{"quelle":"rg_mv-lfa-hoehne-2012","seite":"S. 187, Tab. 1"}],"original":"Cludius’ Herbstapfel"}]}