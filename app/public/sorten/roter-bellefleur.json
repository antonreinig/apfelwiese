{"id":"roter-bellefleur","name":"Roter Bellefleur","synonyme":[{"name":"Long Red Pearmain","beleg":{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Roter_Bellefleur&oldid=251337018"}},{"name":"Malmedy","beleg":{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Roter_Bellefleur&oldid=251337018"}},{"name":"Red Bellflower","beleg":{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Roter_Bellefleur&oldid=251337018"}},{"name":"Rote Bellefleur","beleg":{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Roter_Bellefleur&oldid=251337018"}},{"name":"Siebenschläfer","beleg":{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Roter_Bellefleur&oldid=251337018"}}],"herkunft":{"text":"Vermutlich aus Holland; bereits 1760 beschrieben.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Roter_Bellefleur&oldid=251337018"}]},"merkmale":[{"merkmal":"frucht_groesse","wert":"5","original":"Die mittelgroßen Äpfel sind rund, abgeflacht","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Roter_Bellefleur&oldid=251337018"},{"merkmal":"frucht_form","wert":"flachrund","original":"rund, abgeflacht und häufig etwas unregelmäßig gebaut","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Roter_Bellefleur&oldid=251337018"},{"merkmal":"schale_beschaffenheit","wert":"glatt","original":"Die glatte, glänzende Schale","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Roter_Bellefleur&oldid=251337018"},{"merkmal":"schale_beschaffenheit","wert":"glaenzend","original":"Die glatte, glänzende Schale","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Roter_Bellefleur&oldid=251337018"},{"merkmal":"schale_grundfarbe","wert":"gelbgruen","original":"hat eine gelblich-grüne Farbe","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Roter_Bellefleur&oldid=251337018"},{"merkmal":"schale_deckfarbe_anteil","wert":"5","original":"trägt auf der Sonnenseite eine gestreifte bis verwaschene … Deckfarbe","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Roter_Bellefleur&oldid=251337018"},{"merkmal":"schale_deckfarbe_farbton","wert":"hellrot","original":"intensiv hellrote, selten dunkelrote Deckfarbe","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Roter_Bellefleur&oldid=251337018"},{"merkmal":"schale_deckfarbe_art","wert":"gestreift","original":"gestreifte bis verwaschene","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Roter_Bellefleur&oldid=251337018"},{"merkmal":"schale_deckfarbe_art","wert":"verwaschen","original":"gestreifte bis verwaschene","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Roter_Bellefleur&oldid=251337018"},{"merkmal":"schale_lentizellen_groesse","wert":"3","original":"Feine braune Schalenpunkte","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Roter_Bellefleur&oldid=251337018"},{"merkmal":"schale_lentizellen_art","wert":"braun","original":"Feine braune Schalenpunkte","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Roter_Bellefleur&oldid=251337018"},{"merkmal":"stielgrube_tiefe","wert":"5","original":"in einer weiten, mitteltiefen Höhle, die häufig berostet ist","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Roter_Bellefleur&oldid=251337018"},{"merkmal":"stielgrube_weite","wert":"7","original":"in einer weiten, mitteltiefen Höhle","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Roter_Bellefleur&oldid=251337018"},{"merkmal":"schale_berostung_stielgrube","wert":"5","original":"Höhle, die häufig berostet ist","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Roter_Bellefleur&oldid=251337018"},{"merkmal":"fleisch_farbe","wert":"cremeweiss","original":"Das Fruchtfleisch ist gelblich-weiß","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Roter_Bellefleur&oldid=251337018"},{"merkmal":"fleisch_saftigkeit","wert":"5","original":"mittelmäßig saftig","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Roter_Bellefleur&oldid=251337018"},{"merkmal":"geschmack_aroma","wert":"süßlich bis würzig","original":"süßlich bis würzig","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Roter_Bellefleur&oldid=251337018"},{"merkmal":"pflueckreife","wert":"9","original":"Mitte September bis Ende Oktober pflückreif","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Roter_Bellefleur&oldid=251337018"},{"merkmal":"pflueckreife","wert":"10","original":"Mitte September bis Ende Oktober pflückreif","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Roter_Bellefleur&oldid=251337018"},{"merkmal":"genussreife_beginn","wert":"12","original":"von Dezember bis etwa April–Mai zum Verzehr","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Roter_Bellefleur&oldid=251337018"},{"merkmal":"genussreife_ende","wert":"4","original":"bis etwa April–Mai","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Roter_Bellefleur&oldid=251337018"},{"merkmal":"genussreife_ende","wert":"5","original":"bis etwa April–Mai","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Roter_Bellefleur&oldid=251337018"},{"merkmal":"baum_wuchs","wert":"3","original":"Der Baum wächst langsam","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Roter_Bellefleur&oldid=251337018"},{"merkmal":"bluete_zeit","wert":"7","original":"Sie blüht sehr spät, merklich später als die meisten anderen Apfelsorten","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Roter_Bellefleur&oldid=251337018"},{"merkmal":"ploidie","wert":"diploid","original":"Sie ist diploid und ein guter Pollenspender","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Roter_Bellefleur&oldid=251337018"},{"merkmal":"verwendung","wert":"kueche","original":"als Wirtschaftsapfel und Tafelapfel","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Roter_Bellefleur&oldid=251337018"},{"merkmal":"verwendung","wert":"tafel","original":"als Wirtschaftsapfel und Tafelapfel","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Roter_Bellefleur&oldid=251337018"}],"texte":[{"thema":"ueberblick","text":"Alte, vermutlich holländische Sorte, schon 1760 beschrieben und in Rheinland-Pfalz verbreitet. Die mittelgroßen, flachrunden Früchte sind gelblichgrün mit hellroter, gestreifter bis verwaschener Sonnenseite und halten sich bis ins Frühjahr. Wegen der sehr späten Blüte heißt die Sorte im Volksmund auch Siebenschläfer.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Roter_Bellefleur&oldid=251337018"}]},{"thema":"herkunft","text":"Wikipedia vermutet den Ursprung in Holland und nennt eine Beschreibung aus dem Jahr 1760. Weitere Namen sind Malmedy, Long Red Pearmain und Red Bellflower. Ob die Sorte mit einem der Bellefleur-Einträge der Werke des 19. Jahrhunderts übereinstimmt, ist nicht gesichert.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Roter_Bellefleur&oldid=251337018"}]},{"thema":"frucht","text":"Die Äpfel sind mittelgroß, rund und abgeflacht, häufig etwas unregelmäßig, mit 68 bis 78 mm Breite und 50 bis 60 mm Höhe. Der Stiel sitzt in einer weiten, mitteltiefen, häufig berosteten Höhle.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Roter_Bellefleur&oldid=251337018"}]},{"thema":"schale","text":"Die Schale ist glatt und glänzend, gelblichgrün, sonnenseits gestreift bis verwaschen kräftig hellrot, selten dunkelrot. Feine braune Schalenpunkte sind in wechselnder Zahl verteilt. Die Früchte duften nur schwach.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Roter_Bellefleur&oldid=251337018"}]},{"thema":"fleisch_geschmack","text":"Das Fleisch ist gelblichweiß, mäßig saftig und schmeckt süßlich bis würzig.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Roter_Bellefleur&oldid=251337018"}]},{"thema":"reife_lagerung","text":"Gepflückt wird von Mitte September bis Ende Oktober; genussreif sind die Früchte von Dezember bis etwa April oder Mai.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Roter_Bellefleur&oldid=251337018"}]},{"thema":"verwendung","text":"Die Sorte wird als Wirtschafts- und Tafelapfel genutzt.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Roter_Bellefleur&oldid=251337018"}]},{"thema":"baum","text":"Der Baum wächst langsam und bildet eine große, gleichmäßige, kugelförmige Krone. Er gedeiht auch auf schlechteren Böden und in frostgefährdeten Höhenlagen, trägt reichlich und ist widerstandsfähig gegen Krankheiten und Schädlinge. Die Sorte ist diploid, ein guter Pollenspender und blüht sehr spät.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Roter_Bellefleur&oldid=251337018"}]},{"thema":"unterscheidung","text":"In Mittelhessen gibt es eine regionale Sorte gleichen Namens, die nach Wikipedia nicht mit dem Roten Bellefleur identisch ist.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Roter_Bellefleur&oldid=251337018"}]}],"bilder":[{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/5/5c/Malus-Roter-Bellefleur.jpg/960px-Malus-Roter-Bellefleur.jpg","seite":"https://commons.wikimedia.org/wiki/File:Malus-Roter-Bellefleur.jpg","art":"frucht","urheber":"Sven Teschke","lizenz":"CC BY-SA 2.0 de","quelle":"commons","titel":"Malus-Roter-Bellefleur.jpg"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/84/Pomological_Watercolor_POM00002733.jpg/960px-Pomological_Watercolor_POM00002733.jpg","seite":"https://commons.wikimedia.org/wiki/File:Pomological_Watercolor_POM00002733.jpg","art":"tafel","urheber":"Swann, Eliza C","lizenz":"gemeinfrei","quelle":"usda-pomological","titel":"Pomological Watercolor POM00002733"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/f/f2/Pomological_Watercolor_POM00000478.jpg/960px-Pomological_Watercolor_POM00000478.jpg","seite":"https://commons.wikimedia.org/wiki/File:Pomological_Watercolor_POM00000478.jpg","art":"tafel","urheber":"Amanda Newton","lizenz":"gemeinfrei","quelle":"usda-pomological","titel":"Pomological Watercolor POM00000478"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/78/Double_Belle_Fleur_Rouge%2C_Ailly-le-Haut-Clocher%2C_Apple_festival_06_et_07-11-2021_%28apples%29.jpg/960px-Double_Belle_Fleur_Rouge%2C_Ailly-le-Haut-Clocher%2C_Apple_festival_06_et_07-11-2021_%28apples%29.jpg","seite":"https://commons.wikimedia.org/wiki/File:Double_Belle_Fleur_Rouge,_Ailly-le-Haut-Clocher,_Apple_festival_06_et_07-11-2021_(apples).jpg","art":"bluete","urheber":"APictche","lizenz":"CC BY-SA 4.0","quelle":"commons-fotos","titel":"Double Belle Fleur Rouge, Ailly-le-Haut-Clocher, Apple festival 06 et 07-11-2021 (apples)"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/3/39/Malus_Roter_Bellefleur_4193.jpg/960px-Malus_Roter_Bellefleur_4193.jpg","seite":"https://commons.wikimedia.org/wiki/File:Malus_Roter_Bellefleur_4193.jpg","art":"bluete","urheber":"Sven Teschke","lizenz":"CC BY-SA 3.0 DE","quelle":"commons-fotos","titel":"Malus Roter Bellefleur 4193"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/a/a9/Siebenschl%C3%A4fer_Hessenwiese.jpg/960px-Siebenschl%C3%A4fer_Hessenwiese.jpg","seite":"https://commons.wikimedia.org/wiki/File:Siebenschl%C3%A4fer_Hessenwiese.jpg","art":"baum","urheber":"Stefan Flöper","lizenz":"CC BY-SA 4.0","quelle":"commons-fotos","titel":"Siebenschläfer Hessenwiese"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/3/35/Siebenschl%C3%A4fer_Hessenwiese_2.jpg/960px-Siebenschl%C3%A4fer_Hessenwiese_2.jpg","seite":"https://commons.wikimedia.org/wiki/File:Siebenschl%C3%A4fer_Hessenwiese_2.jpg","art":"baum","urheber":"Stefan Flöper","lizenz":"CC BY-SA 4.0","quelle":"commons-fotos","titel":"Siebenschläfer Hessenwiese 2"}],"farbmessung":[{"bild":"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/84/Pomological_Watercolor_POM00002733.jpg/960px-Pomological_Watercolor_POM00002733.jpg","methode":"Aquarell","verfahren":"Aquarell (USDA Pomological Watercolor, ca. 1886–1942); Papierton als Weißpunkt; Frucht vor Papier freigestellt; Schalenpixel einzeln klassifiziert (Deckfarbe = deutlich höheres a* als die Grundfarbe, Anteile über Pixel); Höhe/Breite aus dem gemalten Längsschnitt, sonst aus der Seitenansicht; gemessen an einer 480 px breiten Kopie; Farbwiedergabe des Malers, nicht fotometrisch","deckfarbe":"#d3441d","deckfarbeAnteil":1,"fleischfarbe":"#f7f3e6","hoeheZuBreite":0.936},{"bild":"https://thumb.wikimedia.org/wikipedia/commons/thumb/f/f2/Pomological_Watercolor_POM00000478.jpg/960px-Pomological_Watercolor_POM00000478.jpg","methode":"Aquarell","verfahren":"Aquarell (USDA Pomological Watercolor, ca. 1886–1942); Papierton als Weißpunkt; Frucht vor Papier freigestellt; Schalenpixel einzeln klassifiziert (Deckfarbe = deutlich höheres a* als die Grundfarbe, Anteile über Pixel); Höhe/Breite aus dem gemalten Längsschnitt, sonst aus der Seitenansicht; gemessen an einer 480 px breiten Kopie; Farbwiedergabe des Malers, nicht fotometrisch","deckfarbe":"#aa0909","deckfarbeAnteil":1,"fleischfarbe":"#f9e4c6","hoeheZuBreite":1.114}]}