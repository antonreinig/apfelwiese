{"id":"osnabruecker-renette","name":"Osnabrücker Renette","synonyme":[{"name":"Osnabrücker Reinette","beleg":{"quelle":"engelbrecht1889","seite":"641 (Nr. 579)"}},{"name":"Graue Osnabrücker Renette","beleg":{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Osnabrücker_Renette&oldid=268216321"}},{"name":"Graue Osnabrücker Reinette","beleg":{"quelle":"engelbrecht1889","seite":"641 (Nr. 579)"}},{"name":"Reinette d'Osnabrück","beleg":{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Osnabrücker_Renette&oldid=268216321"}},{"name":"Osnabrücker grau überzogene Reinette","beleg":{"quelle":"illustr_hb_1","band":"I","seite":"343"}},{"name":"Osnabrucker Reinette","beleg":{"quelle":"nfc2025","seite":"Akzession 1947070"}}],"herkunft":{"text":"Vermutlich ein Zufallssämling aus der Gegend um Osnabrück, bekannt seit dem Ende des 18. Jahrhunderts. Christ beschrieb die Sorte als Osnabrücker grau überzogene Reinette, nach Wikipedia erstmals 1802.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Osnabrücker_Renette&oldid=268216321"},{"quelle":"illustr_hb_1","band":"I","seite":"343"}],"land":"DE","landSicher":false,"ort":"Gegend um Osnabrück","jahr":1790},"merkmale":[{"merkmal":"frucht_breite","wert":66,"original":"Gestalt 66:52—54","quelle":"engelbrecht1889","seite":"641 (Nr. 579)"},{"merkmal":"frucht_hoehe","wert":53,"original":"Gestalt 66:52—54","quelle":"engelbrecht1889","seite":"641 (Nr. 579)"},{"merkmal":"frucht_hoehe_breite","wert":0.8,"original":"Gestalt 66:52—54","quelle":"engelbrecht1889","seite":"641 (Nr. 579)"},{"merkmal":"frucht_form","wert":"eifoermig","original":"flach eiförmig, stielbauch.","quelle":"engelbrecht1889","seite":"641 (Nr. 579)"},{"merkmal":"frucht_form","wert":"konisch","original":"hochgebauter, calvillartig zugespitzter Apfel","quelle":"illustr_hb_1","band":"I","seite":"343"},{"merkmal":"frucht_groesse","wert":"5","original":"mittelgroßer, selbst großer (nach Diel kleiner