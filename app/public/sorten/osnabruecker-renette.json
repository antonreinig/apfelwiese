t"},{"merkmal":"schale_grundfarbe","wert":"gruengelb","quelle":"nfc2025","seite":"Akzession 1947070 (Smith 1971)","original":"Green yellow"},{"merkmal":"schale_deckfarbe_anteil","wert":"3","quelle":"nfc2025","seite":"Akzession 1947070 (Smith 1971)","original":"Low"},{"merkmal":"schale_deckfarbe_farbton","wert":"rot","quelle":"nfc2025","seite":"Akzession 1947070 (Smith 1971)","original":"Red"},{"merkmal":"schale_deckfarbe_art","wert":"gestreift","quelle":"nfc2025","seite":"Akzession 1947070 (Smith 1971)","original":"Only stripes"},{"merkmal":"schale_berostung_gesamt","wert":"3","quelle":"nfc2025","seite":"Akzession 1947070 (Smith 1971)","original":"Low"},{"merkmal":"fleisch_farbe","wert":"gruenlich","quelle":"nfc2025","seite":"Akzession 1947070 (Smith 1971)","original":"Greenish"},{"merkmal":"fleisch_festigkeit","wert":"3","quelle":"nfc2025","seite":"Akzession 1947070 (Verkostung P. Hale, 20/12/2021)","original":"Soft to intermediate"},{"merkmal":"fleisch_festigkeit","wert":"5","quelle":"nfc2025","seite":"Akzession 1947070 (Verkostung P. Hale, 20/12/2021)","original":"Soft to intermediate"},{"merkmal":"fleisch_saftigkeit","wert":"3","quelle":"nfc2025","seite":"Akzession 1947070 (Verkostung P. Hale, 20/12/2021)","original":"Low"},{"merkmal":"geschmack_suesse","wert":"5","quelle":"nfc2025","seite":"Akzession 1947070 (Verkostung P. Hale, 20/12/2021)","original":"Intermediate to high"},{"merkmal":"geschmack_suesse","wert":"7","quelle":"nfc2025","seite":"Akzession 1947070 (Verkostung P. Hale, 20/12/2021)","original":"Intermediate to high"},{"merkmal":"geschmack_saeure","wert":"5","quelle":"nfc2025","seite":"Akzession 1947070 (Verkostung P. Hale, 20/12/2021)","original":"Intermediate to high"},{"merkmal":"geschmack_saeure","wert":"7","quelle":"nfc2025","seite":"Akzession 1947070 (Verkostung P. Hale, 20/12/2021)","original":"Intermediate to high"},{"merkmal":"verwendung","wert":"tafel","quelle":"nfc2025","seite":"Akzession 1947070","original":"Dessert"},{"merkmal":"pflueckreife","wert":"10","quelle":"nfc2025","seite":"Akzession 1947070","original":"Mid October"},{"merkmal":"genussreife_ende","wert":"3","quelle":"nfc2025","seite":"Akzession 1947070","original":"March"},{"merkmal":"bluete_zeit","wert":"5","quelle":"nfc2025","seite":"Akzession 1947070","original":"Klasse 5 (10 % der Blüten offen, Tag 125)"},{"merkmal":"lagerfaehigkeit","wert":"7","original":"Genussreif von Dezember bis März.","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Osnabrücker_Renette&oldid=268216321","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Osnabrücker_Renette&oldid=268216321"},{"quelle":"illustr_hb_1","band":"I","seite":"344"},{"quelle":"engelbrecht1889","seite":"641 (Nr. 579)"}]},{"merkmal":"hochstamm","wert":"gut","original":"eignet sich für Straßenpflanzungen","quelle":"illustr_hb_1","band":"I","seite":"344"},{"merkmal":"standort_klima","wert":"3","original":"ist wenig witterungsempfindlich","quelle":"illustr_hb_1","band":"I","seite":"344"},{"merkmal":"standort_klima","wert":"7","original":"braucht warme, durchlässige Böden und eine freie, sonnige Lage","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Osnabrücker_Renette&oldid=268216321"},{"merkmal":"standort_boden","wert":"7","original":"braucht warme, durchlässige Böden","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Osnabrücker_Renette&oldid=268216321"},{"merkmal":"ertrag_beginn","wert":"frueh","original":"der Baum trägt früh","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Osnabrücker_Renette&oldid=268216321"},{"merkmal":"anfaelligkeit_krebs","wert":"7","original":"wird häufig von Obstbaumkrebs befallen","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Osnabrücker_Renette&oldid=268216321"}],"texte":[{"thema":"ueberblick","text":"Graue Renette aus Nordwestdeutschland, deren Schale fast ganz von fuchsigbraunem Rost bedeckt ist; ein Teil der Kelchwölbung bleibt dabei fast immer rostfrei und grüngelb. Die mittelgroßen Früchte sind hochgebaut und kelchwärts zugespitzt. Das Illustrirte Handbuch nannte sie 1859 einen Tafelapfel fast ersten Ranges, im Obsthandel geschätzt; heute ist die Sorte vor allem noch in der Schweiz verbreitet.","belege":[{"quelle":"engelbrecht1889","seite":"641 (Nr. 579)"},{"quelle":"illustr_hb_1","band":"I","seite":"343"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Osnabrücker_Renette&oldid=268216321"}]},{"thema":"herkunft","text":"Die Sorte stammt vermutlich aus der Gegend um Osnabrück und ist seit dem Ende des 18. Jahrhunderts bekannt. Christ beschrieb sie als Osnabrücker grau überzogene Reinette, Diel als Graue Osnabrücker Reinette. Nach dem Handbuch war sie um 1859 besonders in Norddeutschland häufig. Lucas fand sie in Württemberg in alten Hochstämmen unter dem Namen Französische Gold-Reinette und führte sie zeitweise unter einem anderen Namen, den er wieder zurückzog. Engelbrecht erhielt 1889 Früchte aus Magdeburg (Bertog), Guben (Gartenbauverein) und Lich (Junker).","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Osnabrücker_Renette&oldid=268216321"},{"quelle":"illustr_hb_1","band":"I","seite":"343"},{"quelle":"engelbrecht1889","seite":"641 (Nr. 579)"}]},{"thema":"frucht","text":"Engelbrecht maß 66 mm Breite und 52 bis 54 mm Höhe. Er beschreibt die Frucht als flach eiförmig und stielbauchig, stielwärts rund bis flachrund, kelchwärts rundlich zugespitzt, mit ziemlich gleichen Hälften; das Handbuch nennt sie hochgebaut und kalvillartig zugespitzt, mittelgroß bis groß. Der geschlossene bis halb offene, langblättrige, weißfilzige Kelch sitzt flach in einer engen Grube, die nach dem Handbuch wie eingeschnürt wirkt; einige flache Falten laufen oft bis zum Bauch, der Querschnitt bleibt ziemlich rund. Der dünne bis mitteldicke Stiel ist etwa 15 mm lang, nach dem Handbuch kurz.","belege":[{"quelle":"engelbrecht1889","seite":"641 (Nr. 579)"},{"quelle":"illustr_hb_1","band":"I","seite":"343"},{"quelle":"illustr_hb_1","band":"I","seite":"344"}]},{"thema":"schale","text":"Die Schale ist fein rau, am Baum hellgrün, später grünlichgelb bis gelb. Fast die ganze Frucht ist von fuchsigbraunem, meist feinmaschigem, seltener schuppigem Rost bedeckt; das Handbuch vergleicht ihn mit netzartig gepresstem, graugelbem Papier. Die Kelchwölbung bleibt fast immer zum Teil rostfrei und grüngelb, was beide alten Quellen als kennzeichnend hervorheben. Die Sonnenseite ist rötlich angeflogen und sparsam dunkler rot gestreift, nach dem Handbuch blutrot verwaschen und gestreift; Wikipedia beschreibt die Deckfarbe als trübrot marmoriert und rot gestreift, meist vom Rost verdeckt. Die wenigen Schalenpunkte erscheinen im Rost weißlich. Die Stielgrube ist mitteltief bis tief, ziemlich weit und berostet, nach dem Handbuch stark berostet.","belege":[{"quelle":"engelbrecht1889","seite":"641 (Nr. 579)"},{"quelle":"illustr_hb_1","band":"I","seite":"344"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Osnabrücker_Renette&oldid=268216321"}]},{"thema":"schnitt","text":"Das Kernhaus ist zwiebelförmig und breiter als hoch (39:33 mm). Die Kammern sind stielwärts spitz, kelchwärts abgerundet, fast glattwandig und ziemlich flach; sie sind bald weit, bald wenig offen, das Handbuch nennt das Kernhaus offen und oft kalvillartig. Die Achsenhöhle ist meist ziemlich breit. Je Kammer liegen ein bis zwei mittelgroße, länglich eiförmige, ziemlich lang gespitzte braune Kerne, oft zum Teil unvollkommen oder nur angedeutet. Die Kelchhöhle ist kegelförmig und reicht kaum ein Drittel bis zwei Fünftel des Weges zur Achsenhöhle; das Handbuch nennt die Kelchröhre kurz und kegelförmig und vermerkt, dass Diel einen langen, spitzen Kegel beschrieben hatte. Das Fleisch ist am Schnitt hellgelblich oder grüngelblich weiß.","belege":[{"quelle":"engelbrecht1889","seite":"641 (Nr. 579)"},{"quelle":"illustr_hb_1","band":"I","seite":"344"}]},{"thema":"fleisch_geschmack","text":"Engelbrecht beschreibt das Fleisch als fein, markig und ziemlich saftig, renettenartig, aber nicht stark gewürzt, mit vorherrschender, kräftiger Weinsäure und wechselnd mäßiger bis genügender Süße. Nach dem Handbuch ist es weiß mit grünlichem Schimmer und sehr markig, mit edlem Renettengeschmack, in dem eine angenehme Weinsäure vorherrscht. Wikipedia nennt das Fleisch gelblich, grob, fest und saftig, kräftig gewürzt, anfangs auffallend spitz sauer und später angenehm erfrischend.","belege":[{"quelle":"engelbrecht1889","seite":"641 (Nr. 579)"},{"quelle":"illustr_hb_1","band":"I","seite":"344"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Osnabrücker_Renette&oldid=268216321"}]},{"thema":"reife_lagerung","text":"Pflückreif Ende Oktober; das Handbuch rät, spät zu pflücken. Genussreif von Dezember bis März. Die Früchte welken auf dem Lager wenig.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Osnabrücker_Renette&oldid=268216321"},{"quelle":"illustr_hb_1","band":"I","seite":"344"},{"quelle":"engelbrecht1889","seite":"641 (Nr. 579)"}]},{"thema":"baum","text":"Nach dem Handbuch bildet der Baum eine hochkugelige, lockere Krone mit starken Ästen und viel kurzem Fruchtholz; er trägt auch in ungünstigen Jahren gut, ist wenig witterungsempfindlich und eignet sich für Straßenpflanzungen. Wikipedia beschreibt den Wuchs in der Jugend als kräftig; der Baum trägt früh, braucht warme, durchlässige Böden und eine freie, sonnige Lage, wird häufig von Obstbaumkrebs befallen und neigt zur Spitzendürre.","belege":[{"quelle":"illustr_hb_1","band":"I","seite":"344"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Osnabrücker_Renette&oldid=268216321"}]},{"thema":"verwendung","text":"Engelbrecht vergab 1889 die Zeichen für Tafelfrüchte (o) und sehr gute Haushaltsfrüchte (††). Das Handbuch hebt den Wert für den Obsthandel hervor und nennt die Sorte auch für Obstwein und die Küche vortrefflich.","belege":[{"quelle":"engelbrecht1889","seite":"641 (Nr. 579)"},{"quelle":"illustr_hb_1","band":"I","seite":"344"}]},{"thema":"unterscheidung","text":"Diels Rothgraue Kelch-Reinette ist nach Oberdieck wohl dieselbe Sorte; Lucas schloss sich dem an, hielt aber weitere Vergleiche für nötig. Engelbrecht erhielt unter diesem Namen Früchte, die er von der Osnabrücker Renette nicht unterscheiden konnte.","belege":[{"quelle":"illustr_hb_1","band":"I","seite":"343"},{"quelle":"engelbrecht1889","seite":"641 (Nr. 579)"}]},{"thema":"frucht","text":"Nach den Erhebungen der National Fruit Collection: mittelgroße, stumpf kegelförmige Frucht mit grünlich gelber Grundfarbe und gestreifter roter Deckfarbe auf einem kleinen Teil der Schale. Das Fruchtfleisch ist grünlich, die Schale wenig berostet. Bei der Verkostung war das Fleisch weich bis mittelfest und wenig saftig, der Geschmack mäßig bis deutlich süß und mäßig bis deutlich sauer, mit mittlerem Aroma. In der Sammlung als Tafelapfel geführt; pflückreif Mitte Oktober, lagerfähig bis März.","belege":[{"quelle":"nfc2025","seite":"Akzession 1947070"}]}],"bilder":[{"url":"https://archive.org/download/bub_gb_tR4EMgEACAAJ/page/n655_w800.jpg","seite":"https://archive.org/details/bub_gb_tR4EMgEACAAJ/page/n655","art":"schnitt","urheber":"Theodor Engelbrecht (Zeichnung), Albert Probst (Holzschnitt)","lizenz":"gemeinfrei","quelle":"engelbrecht1889","titel":"Längsschnitt-Umriss bei Engelbrecht 1889, S. 641 (ganze Buchseite)"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/5/5d/Osnabr%C3%BCcker_Renette_jm55058.jpg/960px-Osnabr%C3%BCcker_Renette_jm55058.jpg","seite":"https://commons.wikimedia.org/wiki/File:Osnabr%C3%BCcker_Renette_jm55058.jpg","art":"frucht","urheber":"joergens.mi","lizenz":"CC BY-SA 3.0","quelle":"commons","titel":"Osnabrücker Renette jm55058.jpg"},{"url":"https://upload.wikimedia.org/wikipedia/commons/e/e0/Cross_section_of_Osnabrucker_Reinette%2C_National_Fruit_Collection_%28acc._1947-070%29.jpg","seite":"https://commons.wikimedia.org/wiki/File:Cross_section_of_Osnabrucker_Reinette,_National_Fruit_Collection_(acc._1947-070).jpg","art":"schnitt","urheber":"National Fruit Collection, Brogdale.","lizenz":"OGL 2","quelle":"commons","titel":"Cross section of Osnabrucker Reinette, National Fruit Collection (acc. 1947-070).jpg"}],"munq":891,"akzessionen":[{"sammlung":"UK National Fruit Collection (Brogdale)","nummer":"1947070","name":"Osnabrucker Reinette"}],"farbmessung":[{"bild":"https://upload.wikimedia.org/wikipedia/commons/e/e0/Cross_section_of_Osnabrucker_Reinette%2C_National_Fruit_Collection_%28acc._1947-070%29.jpg","methode":"NFC-Foto","verfahren":"Foto (NFC-Fototafel: 4 ganze Früchte, 2 Schnitte, Fototisch); Weißabgleich über den Hintergrund; Frucht per Hintergrundmodell freigestellt; Schalenpixel ohne Glanzlichter einzeln klassifiziert: Grundfarbe aus gelbgrünen Pixeln, Deckfarbe = Pixel mit deutlich höherem a* als die Grundfarbe (auch dunkle Rot- und Braunrottöne), Anteile über Pixel; Höhe/Breite aus dem Längsschnitt","grundfarbe":"#b6a846","deckfarbe":"#98562f","deckfarbeAnteil":0.28,"fleischfarbe":"#e4d8bf","hoeheZuBreite":0.91}],"regionen":[{"region":"DE-NI","art":"herkunft","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Osnabrücker_Renette&oldid=268216321"},{"quelle":"illustr_hb_1","band":"I","seite":"343"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Osnabrücker_Renette&oldid=268216321"},{"quelle":"illustr_hb_1","band":"I","seite":"343"},{"quelle":"engelbrecht1889","seite":"641 (Nr. 579)"}]},{"region":"DE-RP","art":"empfehlung","belege":[{"quelle":"rg_rp-streuobst-sortenempfehlung-2018"}],"original":"Osnabrücker Renette"}],"gefaehrdung":[{"stufe":"Rote Liste der gefährdeten einheimischen Nutzpflanzen in Deutschland","belege":[{"quelle":"rg_ble-rote-liste"}],"original":"Osnabrücker Renette"}]}