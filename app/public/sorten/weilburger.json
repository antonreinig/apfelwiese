{"id":"weilburger","name":"Weilburger","synonyme":[],"herkunft":{"text":"Wahrscheinlich ein Zufallssämling aus der Gegend von Weilburg an der Lahn; 1799 von Diel erstmals beschrieben. 2009 nach einem Suchaufruf des Pomologen-Vereins an einem letzten Baum in der Gemarkung Hünfelden wiedergefunden. Genetische Untersuchungen deuten auf einen Abkömmling des Edelborsdorfers.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Weilburger&oldid=258739314"},{"quelle":"engelbrecht1889","seite":"540 (Nr. 487)"}]},"merkmale":[{"merkmal":"frucht_breite","wert":56,"original":"Gestalt 56:43—45 (61:51—52, Illustr. Handb.)","quelle":"engelbrecht1889","seite":"540 (Nr. 487)"},{"merkmal":"frucht_hoehe","wert":44,"original":"Gestalt 56:43—45","quelle":"engelbrecht1889","seite":"540 (Nr. 487)"},{"merkmal":"frucht_hoehe_breite","wert":0.79,"original":"Gestalt 56:43—45","quelle":"engelbrecht1889","seite":"540 (Nr. 487)"},{"merkmal":"frucht_form","wert":"rund","original":"abgest. rundlich, wenig stielbauch.","quelle":"engelbrecht1889","seite":"540 (Nr. 487)"},{"merkmal":"frucht_breiteste_stelle","wert":"stiel","original":"wenig stielbauch. Stielwölbung wenig breiter als die Kelchwölbung","quelle":"engelbrecht1889","seite":"540 (Nr. 487)"},{"merkmal":"frucht_symmetrie","wert":"symmetrisch","original":"Hälften gleich","quelle":"engelbrecht1889","seite":"540 (Nr. 487)"},{"merkmal":"frucht_rippung","wert":"3","original":"Querschn. ziemlich rund","quelle":"engelbrecht1889","seite":"540 (Nr. 487)"},{"merkmal":"frucht_kronung","wert":"5","original":"Einsenk. … zwischen flach zum Bauche laufenden Falten","quelle":"engelbrecht1889","seite":"540 (Nr. 487)"},{"merkmal":"kelch_offenheit","wert":"halboffen","original":"Kelch halb offen, grünlich und braun, kurzwollig","quelle":"engelbrecht1889","seite":"540 (Nr. 487)"},{"merkmal":"kelchgrube_tiefe","wert":"5","original":"Einsenk. mässig tief, mittelweit","quelle":"engelbrecht1889","seite":"540 (Nr. 487)"},{"merkmal":"kelchgrube_weite","wert":"5","original":"Einsenk. mässig tief, mittelweit","quelle":"engelbrecht1889","seite":"540 (Nr. 487)"},{"merkmal":"stiel_dicke","wert":"5","original":"Stiel holzig, mitteldick, etwa 13 mm l.","quelle":"engelbrecht1889","seite":"540 (Nr. 487)"},{"merkmal":"stielgrube_tiefe","wert":"5","original":"Höhle mitteltief, weit, fast eben, zart berostet","quelle":"engelbrecht1889","seite":"540 (Nr. 487)"},{"merkmal":"stielgrube_weite","wert":"7","original":"Höhle mitteltief, weit","quelle":"engelbrecht1889","seite":"540 (Nr. 487)"},{"merkmal":"schale_berostung_stielgrube","wert":"3","original":"Höhle … zart berostet","quelle":"engelbrecht1889","seite":"540 (Nr. 487)"},{"merkmal":"schale_beschaffenheit","wert":"glatt","original":"Schale glatt, geschmeidig, glänzend","quelle":"engelbrecht1889","seite":"540 (Nr. 487)"},{"merkmal":"schale_beschaffenheit","wert":"glaenzend","original":"Schale glatt, geschmeidig, glänzend","quelle":"engelbrecht1889","seite":"540 (Nr. 487)"},{"merkmal":"schale_grundfarbe","wert":"gelb","original":"hellgelb, später lebhafter gelb","quelle":"engelbrecht1889","seite":"540 (Nr. 487)"},{"merkmal":"schale_deckfarbe_anteil","wert":"5","original":"sonnenw. carmoisinroth überzogen","quelle":"engelbrecht1889","seite":"540 (Nr. 487)"},{"merkmal":"schale_deckfarbe_farbton","wert":"rot","original":"sonnenw. carmoisinroth überzogen","quelle":"engelbrecht1889","seite":"540 (Nr. 487)"},{"merkmal":"schale_deckfarbe_art","wert":"verwaschen","original":"carmoisinroth überzogen","quelle":"engelbrecht1889","seite":"540 (Nr. 487)"},{"merkmal":"schale_lentizellen_anzahl","wert":"3","original":"Punkte sparsam, sehr fein, braun","quelle":"engelbrecht1889","seite":"540 (Nr. 487)"},{"merkmal":"schale_lentizellen_groesse","wert":"3","original":"Punkte sparsam, sehr fein, braun","quelle":"engelbrecht1889","seite":"540 (Nr. 487)"},{"merkmal":"schale_lentizellen_art","wert":"braun","original":"Punkte sparsam, sehr fein, braun","quelle":"engelbrecht1889","s