g","wert":"tafel","original":"Weilburger (Illustr. Handb.) o††","quelle":"engelbrecht1889","seite":"540 (Nr. 487)"},{"merkmal":"verwendung","wert":"kueche","original":"Weilburger (Illustr. Handb.) o††","quelle":"engelbrecht1889","seite":"540 (Nr. 487)"},{"merkmal":"frucht_groesse","wert":"3","original":"bei kleiner bis mittlerer Größe","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Weilburger&oldid=258739314"},{"merkmal":"frucht_groesse","wert":"5","original":"bei kleiner bis mittlerer Größe","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Weilburger&oldid=258739314"},{"merkmal":"frucht_form","wert":"flachrund","original":"Die Form der Frucht ist flachrund","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Weilburger&oldid=258739314"},{"merkmal":"frucht_breiteste_stelle","wert":"stiel","original":"in Richtung des Stieles mäßig bauchig","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Weilburger&oldid=258739314"},{"merkmal":"frucht_rippung","wert":"3","original":"Fruchtquerschnitt … unregelmäßig rund und zeigt drei bis fünf schwach ausgeprägte Kanten","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Weilburger&oldid=258739314"},{"merkmal":"schale_beschaffenheit","wert":"glatt","original":"Die Schale ist glatt, geschmeidig und etwas glänzend","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Weilburger&oldid=258739314"},{"merkmal":"schale_grundfarbe","wert":"gelb","original":"hellgelb bis strohgelb werdenden Grundfarbe","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Weilburger&oldid=258739314"},{"merkmal":"schale_grundfarbe","wert":"weisslichgelb","original":"hellgelb bis strohgelb werdenden Grundfarbe","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Weilburger&oldid=258739314"},{"merkmal":"schale_deckfarbe_farbton","wert":"hellrot","original":"auf der Sonnenseite ein verwaschenes Hellrot","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Weilburger&oldid=258739314"},{"merkmal":"schale_deckfarbe_art","wert":"verwaschen","original":"ein verwaschenes Hellrot","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Weilburger&oldid=258739314"},{"merkmal":"schale_lentizellen_anzahl","wert":"7","original":"Es finden sich zahlreiche Schalenpunkte","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Weilburger&oldid=258739314"},{"merkmal":"schale_lentizellen_art","wert":"umhoeft_rot","original":"Diese sind – teils auf der Sonnenseite – rot umhöft","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Weilburger&oldid=258739314"},{"merkmal":"kelch_offenheit","wert":"geschlossen","original":"Der Kelch selbst ist mittelgroß und geschlossen bis halboffen","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Weilburger&oldid=258739314"},{"merkmal":"kelch_offenheit","wert":"halboffen","original":"geschlossen bis halboffen","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Weilburger&oldid=258739314"},{"merkmal":"kelchgrube_tiefe","wert":"3","original":"zeigt sich die Kelchgrube leicht eingesenkt, mit flachen Wülsten","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Weilburger&oldid=258739314"},{"merkmal":"schale_berostung_kelchgrube","wert":"3","original":"sortentypische Rostfiguren oder ein schuppiger Rostanflug","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Weilburger&oldid=258739314"},{"merkmal":"stielgrube_tiefe","wert":"5","original":"die mitteltiefe, relativ weite Stielgrube","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Weilburger&oldid=258739314"},{"merkmal":"stielgrube_weite","wert":"7","original":"die mitteltiefe, relativ weite Stielgrube","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Weilburger&oldid=258739314"},{"merkmal":"schale_berostung_stielgrube","wert":"5","original":"Die Stielgrube ist feinstrahlig bis schuppig berostet","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Weilburger&oldid=258739314"},{"merkmal":"stiel_dicke","wert":"5","original":"Der mitteldicke, holzig-braune Stiel ist kurz bis mittellang","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Weilburger&oldid=258739314"},{"merkmal":"stiel_laenge","wert":"3","original":"Stiel ist kurz bis mittellang","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Weilburger&oldid=258739314"},{"merkmal":"stiel_laenge","wert":"5","original":"Stiel ist kurz bis mittellang","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Weilburger&oldid=258739314"},{"merkmal":"genussreife_ende","wert":"4","original":"sie reifen Mitte Oktober und sind ohne Qualitätsverlust bis April verwendbar","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Weilburger&oldid=258739314"},{"merkmal":"verwendung","wert":"tafel","original":"Die Sorte wird als Tafel- und Wirtschaftsapfel verwendet","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Weilburger&oldid=258739314"},{"merkmal":"verwendung","wert":"kueche","original":"Die Sorte wird als Tafel- und Wirtschaftsapfel verwendet","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Weilburger&oldid=258739314"},{"merkmal":"kernhaus_breite_mm","wert":31,"original":"Kernhaus 31:23","quelle":"engelbrecht1889","seite":"540 (Nr. 487)"},{"merkmal":"kernhaus_hoehe_mm","wert":23,"original":"Kernhaus 31:23","quelle":"engelbrecht1889","seite":"540 (Nr. 487)"},{"merkmal":"kernfach_breite_mm","wert":9,"original":"Kammern 9:16","quelle":"engelbrecht1889","seite":"540 (Nr. 487)"},{"merkmal":"kernfach_hoehe_mm","wert":16,"original":"Kammern 9:16","quelle":"engelbrecht1889","seite":"540 (Nr. 487)"},{"merkmal":"kernhaus_form","wert":"flachrund","original":"Kernhaus flachrund bis flachrund zwiebelf","quelle":"engelbrecht1889","seite":"540 (Nr. 487)"},{"merkmal":"genussreife_ende","wert":"6","original":"Zeitigung: Ende Decemb. bis Juni","quelle":"engelbrecht1889","seite":"540 (Nr. 487)"}],"texte":[{"thema":"ueberblick","text":"Hessische Lokalsorte aus der Familie der Borsdorfer, die Diel 1799 als erster beschrieb. Der kleine bis mittelgroße, flachrunde Apfel wird gelb mit verwaschener roter Sonnenseite und hält sich ohne zu welken bis ins Frühjahr, bei Engelbrecht sogar bis Juni. Er dient als Tafel- und Wirtschaftsapfel. Der Pomologen-Verein (Landesgruppe Hessen) wählte ihn zur Hessischen Lokalsorte des Jahres 2016.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Weilburger&oldid=258739314"},{"quelle":"engelbrecht1889","seite":"540 (Nr. 487)"}]},{"thema":"herkunft","text":"Diel beschrieb die Sorte 1799 (Heft 1, S. 149). Aehrenthal veröffentlichte 1833 die ältesten Abbildungen, das Illustrirte Handbuch stellte sie 1875 in Band VIII vor. Oberdieck, Lucas und Jahn vermuteten dort einen Zufallssämling, dessen Name auf Weilburg an der Lahn zurückgeht, als Fundort oder als Gebiet mit verbreitetem Anbau. Engelbrecht erhielt 1889 Früchte von Koch aus Braunschweig. Danach geriet die Sorte für Jahrzehnte in Vergessenheit, bis nach einem Suchaufruf 2009 ein letzter Baum in der Gemarkung Hünfelden gefunden wurde; von ihm stammen die heutigen Bäume. Genetische Untersuchungen weisen auf eine Abstammung vom echten Edelborsdorfer hin.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Weilburger&oldid=258739314"},{"quelle":"engelbrecht1889","seite":"540 (Nr. 487)"}]},{"thema":"frucht","text":"Engelbrecht maß 56 mm Breite bei 43–45 mm Höhe, nach der Abbildung im Handbuch Band VIII 61:51–52 mm. Die Frucht ist abgestumpft rundlich bis flachrund, wenig stielbauchig, die Hälften sind gleich. Nach Wikipedia ist der Querschnitt unregelmäßig rund mit drei bis fünf schwachen Kanten. Der mittelgroße Kelch ist halb offen (Engelbrecht) bzw. geschlossen bis halboffen (Wikipedia), die Kelchblätter berühren sich am Grund. Die Kelchgrube ist mäßig tief bis leicht eingesenkt, mittelweit, mit flachen Falten oder Wülsten. Der mitteldicke, holzige, braune Stiel ist kurz bis mittellang (etwa 13 mm) und ragt nicht über die Stielgrube hinaus.","belege":[{"quelle":"engelbrecht1889","seite":"540 (Nr. 487)"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Weilburger&oldid=258739314"}]},{"thema":"schale","text":"Die Schale ist glatt, geschmeidig und glänzend, hellgelb und später kräftiger gelb bis strohgelb. Die Sonnenseite ist karminrot (Engelbrecht) bzw. verwaschen hellrot (Wikipedia) überzogen. Engelbrecht nennt die Schalenpunkte sparsam, sehr fein und braun; Wikipedia beschreibt zahlreiche, auf der Sonnenseite teils rot umhöfte Punkte. Rostanflüge sind selten und klein; um den Kelch zeigen sich typische Rostfiguren oder schuppiger Rost. Die Früchte welken nicht.","belege":[{"quelle":"engelbrecht1889","seite":"540 (Nr. 487)"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Weilburger&oldid=258739314"}]},{"thema":"schnitt","text":"Engelbrecht beschreibt ein flachrundes bis flach zwiebelförmiges Kernhaus von 31:23 mm. Die Kammern (9:16 mm) sind stielwärts etwas stumpf gespitzt, kelchwärts stärker abgestumpft, wenig zerrissen, ziemlich geräumig und meist offen; die Achsenhöhle ist mittelbreit. Je Kammer liegen zwei mittelgroße, vollkommene, eiförmige, kurz gespitzte braune Kerne. Die Kelchhöhle ist kegelförmig und reicht ⅔ zur Achsenhöhle. Die Stielgrube ist mitteltief und weit, zart (Engelbrecht) bzw. feinstrahlig bis schuppig (Wikipedia) berostet. Das Fleisch ist hell gelblich weiß.","belege":[{"quelle":"engelbrecht1889","seite":"540 (Nr. 487)"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Weilburger&oldid=258739314"}]},{"thema":"fleisch_geschmack","text":"Das Fleisch ist fein und abknackend, später etwas mürber, saftig und etwas gewürzt. Im Geschmack herrscht nach Engelbrecht das Weinige vor, bei mäßiger bis genügender Süße. Wikipedia hebt hervor, dass der Geschmack über die lange Lagerzeit gleich bleibt.","belege":[{"quelle":"engelbrecht1889","seite":"540 (Nr. 487)"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Weilburger&oldid=258739314"}]},{"thema":"reife_lagerung","text":"Nach Wikipedia reifen die Äpfel Mitte Oktober und sind ohne Qualitätsverlust bis April verwendbar. Engelbrecht gibt die Genussreife mit Ende Dezember bis Juni an. Die Früchte welken auf dem Lager nicht.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Weilburger&oldid=258739314"},{"quelle":"engelbrecht1889","seite":"540 (Nr. 487)"}]},{"thema":"verwendung","text":"Der Weilburger wird als Tafel- und Wirtschaftsapfel genutzt; Engelbrecht bewertet ihn als Tafelfrucht und gute Haushaltsfrucht (o††).","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Weilburger&oldid=258739314"},{"quelle":"engelbrecht1889","seite":"540 (Nr. 487)"}]},{"thema":"baum","text":"Die Sorte ist robust, widerstandsfähig und ausreichend frosthart; windoffene Lagen sind günstig. Der Baum bildet auf geradem Stamm eine hohe, gut verzweigte Krone; lange, sich gut verzweigende Triebe setzen reichlich Fruchtholz an. Er trägt früh, reichlich und regelmäßig.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Weilburger&oldid=258739314"}]}],"bilder":[{"url":"https://archive.org/download/bub_gb_tR4EMgEACAAJ/page/n554_w800.jpg","seite":"https://archive.org/details/bub_gb_tR4EMgEACAAJ/page/n554","art":"schnitt","urheber":"Theodor Engelbrecht (Zeichnung), Albert Probst (Holzschnitt)","lizenz":"gemeinfrei","quelle":"engelbrecht1889","titel":"Längsschnitt-Umriss bei Engelbrecht 1889, S. 540 (ganze Buchseite)"}]}