"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Charlamowsky&oldid=251367539"},{"merkmal":"schale_grundfarbe","wert":"gelb","original":"vom Baum grünlich-gelb, lagerreif fast goldgelb","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Charlamowsky&oldid=251367539"},{"merkmal":"schale_deckfarbe_farbton","wert":"rot","original":"auf der Sonnenseite rot gestreift und geflammt","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Charlamowsky&oldid=251367539"},{"merkmal":"schale_deckfarbe_art","wert":"gestreift","original":"auf der Sonnenseite rot gestreift und geflammt","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Charlamowsky&oldid=251367539"},{"merkmal":"schale_deckfarbe_art","wert":"geflammt","original":"auf der Sonnenseite rot gestreift und geflammt","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Charlamowsky&oldid=251367539"},{"merkmal":"fleisch_farbe","wert":"cremeweiss","original":"Das Fruchtfleisch ist hell gelblich-weiß, mürbe und saftig","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Charlamowsky&oldid=251367539"},{"merkmal":"fleisch_festigkeit","wert":"3","original":"Das Fruchtfleisch ist hell gelblich-weiß, mürbe und saftig","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Charlamowsky&oldid=251367539"},{"merkmal":"fleisch_saftigkeit","wert":"7","original":"Das Fruchtfleisch ist hell gelblich-weiß, mürbe und saftig","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Charlamowsky&oldid=251367539"},{"merkmal":"geschmack_saeure","wert":"7","original":"von eher säuerlichem, wenig aromatischem Geschmack","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Charlamowsky&oldid=251367539"},{"merkmal":"kelchgrube_tiefe","wert":"3","original":"die Höhle selbst ist flach und weit","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Charlamowsky&oldid=251367539"},{"merkmal":"kelchgrube_weite","wert":"7","original":"die Höhle selbst ist flach und weit","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Charlamowsky&oldid=251367539"},{"merkmal":"stiel_laenge","wert":"7","original":"Der Stiel ist recht lang, dünn","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Charlamowsky&oldid=251367539"},{"merkmal":"stiel_dicke","wert":"3","original":"Der Stiel ist recht lang, dünn","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Charlamowsky&oldid=251367539"},{"merkmal":"stielgrube_tiefe","wert":"7","original":"in einer tiefen, breiten und gelegentlich berosteten Stielhöhle","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Charlamowsky&oldid=251367539"},{"merkmal":"stielgrube_weite","wert":"7","original":"in einer tiefen, breiten und gelegentlich berosteten Stielhöhle","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Charlamowsky&oldid=251367539"},{"merkmal":"genussreife_beginn","wert":"8","original":"Die Äpfel reifen Mitte bis Ende August","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Charlamowsky&oldid=251367539"},{"merkmal":"bluete_zeit","wert":"3","original":"Die Blüte erfolgt früh","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Charlamowsky&oldid=251367539"},{"merkmal":"baum_wuchs","wert":"3","original":"aufgrund der frühen Reife und des schwachen Wuchses für Hausgärten geeignet","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Charlamowsky&oldid=251367539"},{"merkmal":"verwendung","wert":"kueche","original":"besser für die Verarbeitung beispielsweise zu Apfelmus oder Apfelkuchen geeignet","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Charlamowsky&oldid=251367539"},{"merkmal":"kernhaus_breite_mm","wert":39,"original":"Kernhaus 39:32","quelle":"engelbrecht1889","seite":"190 (Nr. 169)"},{"merkmal":"kernhaus_hoehe_mm","wert":32,"original":"Kernhaus 39:32","quelle":"engelbrecht1889","seite":"190 (Nr. 169)"},{"merkmal":"kernfach_breite_mm","wert":12,"original":"Kammern 12:19","quelle":"engelbrecht1889","seite":"190 (Nr. 169)"},{"merkmal":"kernfach_hoehe_mm","wert":19,"original":"Kammern 12:19","quelle":"engelbrecht1889","seite":"190 (Nr. 169)"},{"merkmal":"frucht_breite","wert":71,"quelle":"nfc2025","seite":"Akzession 1957190 (Smith 1971)"},{"merkmal":"frucht_hoehe","wert":58,"quelle":"nfc2025","seite":"Akzession 1957190 (Smith 1971)"},{"merkmal":"frucht_groesse","wert":"7","quelle":"nfc2025","seite":"Akzession 1957190 (Smith 1971)","original":"Large"},{"merkmal":"frucht_form","wert":"flachrund","quelle":"nfc2025","seite":"Akzession 1957190 (Smith 1971)","original":"Flat globose"},{"merkmal":"frucht_hoehe_breite","wert":0.817,"quelle":"nfc2025","seite":"Akzession 1957190 (Smith 1971)"},{"merkmal":"frucht_rippung","wert":"1","quelle":"nfc2025","seite":"Akzession 1957190 (Smith 1971)","original":"Very light"},{"merkmal":"schale_grundfarbe","wert":"weisslichgelb","quelle":"nfc2025","seite":"Akzession 1957190 (Smith 1971)","original":"Whitish yellow"},{"merkmal":"schale_deckfarbe_farbton","wert":"orange","quelle":"nfc2025","seite":"Akzession 1957190 (Smith 1971)","original":"Orange"},{"merkmal":"schale_deckfarbe_art","wert":"gestreift","quelle":"nfc2025","seite":"Akzession 1957190 (Smith 1971)","original":"Only stripes"},{"merkmal":"fleisch_farbe","wert":"weiss","quelle":"nfc2025","seite":"Akzession 1957190 (Smith 1971)","original":"White"},{"merkmal":"verwendung","wert":"kueche","quelle":"nfc2025","seite":"Akzession 1957190","original":"Dual-purpose"},{"merkmal":"verwendung","wert":"tafel","quelle":"nfc2025","seite":"Akzession 1957190","original":"Dual-purpose"},{"merkmal":"pflueckreife","wert":"8","quelle":"nfc2025","seite":"Akzession 1957190","original":"Mid August"},{"merkmal":"genussreife_ende","wert":"9","quelle":"nfc2025","seite":"Akzession 1957190","original":"September"},{"merkmal":"bluete_zeit","wert":"3","quelle":"nfc2025","seite":"Akzession 1957190","original":"Klasse 3 (10 % der Blüten offen, Tag 119)"}],"texte":[{"thema":"ueberblick","text":"Russische Sommersorte, in England und Amerika als Duchess of Oldenburg bekannt. Die mittelgroße, stark abgestumpft rundliche Frucht ist hellgelb und sonnenseits fein rot gestreift und geflammt. Das gelblichweiße, mürbe Fleisch ist kräftig säuerlich und wenig aromatisch. Die Äpfel reifen Ende August und halten sich nur etwa vier Wochen.","belege":[{"quelle":"engelbrecht1889","seite":"190 (Nr. 169)"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Charlamowsky&oldid=251367539"},{"quelle":"illustr_hb_1","band":"I","seite":"95"}]},{"thema":"herkunft","text":"Diel, der die Sorte aus Moskau erhielt und zuerst beschrieb, vermutete eine Herkunft aus Persien; das Illustrierte Handbuch (1859) hält das südliche Russland für wahrscheinlicher, woher auch die verwandten Klaräpfel stammen. Nach Wikipedia wurde sie um 1830 erstmals in Hohenheim angepflanzt. Um 1859 war sie in deutschen Baumschulen und Gärten ziemlich verbreitet. Der Bearbeiter des Handbuchs verglich Früchte eines von Booth bezogenen Baumes der englischen Duchess of Oldenburg und fand sie, wie schon Oberdieck, mit dem Charlamowsky übereinstimmend. Der Name Duchess of Oldenburg hat nichts mit der Sorte Geheimrat Dr. Oldenburg zu tun. Engelbrecht erhielt 1889 Früchte aus Jeinsen, Meiningen und Braunschweig.","belege":[{"quelle":"illustr_hb_1","band":"I","seite":"95"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Charlamowsky&oldid=251367539"},{"quelle":"engelbrecht1889","seite":"190 (Nr. 169)"}]},{"thema":"frucht","text":"Engelbrecht maß 76 mm Breite bei 60–63 mm Höhe; die Frucht ist stark abgestumpft rundlich, mittelbauchig, mit fast gleichen Hälften und fast rundem Querschnitt. Der Kelch ist meist geschlossen (Handbuch: geschlossen oder halb offen) und hat große, ziemlich lange Blätter. Er sitzt in einer mitteltiefen, ziemlich weiten Einsenkung zwischen flachen Rippen, die sich kaum zum Bauch fortsetzen; Wikipedia beschreibt die Kelchhöhle als flach und weit. Den Stiel nennt Engelbrecht mitteldick und etwa 16 mm lang in mitteltiefer, mittelweiter, wenig berosteter Höhle, Wikipedia recht lang und dünn in tiefer, breiter Stielhöhle.","belege":[{"quelle":"engelbrecht1889","seite":"190 (Nr. 169)"},{"quelle":"illustr_hb_1","band":"I","seite":"95"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Charlamowsky&oldid=251367539"}]},{"thema":"schale","text":"Die Schale ist fein, glatt, geschmeidig und etwas beduftet, vom Baum hellgrünlichgelb, im Lager hellgelb bis fast goldgelb. Die Sonnenseite ist oft weithin hell punktiert gerötet und dunkler karminrot fein gestreift und geflammt; in ungünstigen Jahrgängen gibt es nach dem Handbuch auch fast ungerötete Früchte. Die Punkte sind sehr fein, kaum bemerkbar, weißlich oder grünlich, oft nur Tupfen. Der Geruch ist schwach, aber angenehm.","belege":[{"quelle":"engelbrecht1889","seite":"190 (Nr. 169)"},{"quelle":"illustr_hb_1","band":"I","seite":"95"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Charlamowsky&oldid=251367539"}]},{"thema":"schnitt","text":"Engelbrecht maß ein zwiebelförmiges Kernhaus von 39:32 mm. Die Kammern (12:19 mm) sind stielwärts stumpf gespitzt, kelchwärts etwas zugespitzt oder wenig abgestumpft, etwas zerrissen, mittelgeräumig und nicht oder sehr wenig geöffnet; die Achsenhöhle ist schmal. Meist liegt nur ein mittelgroßer, meist vollkommener, eiförmiger, gespitzter, brauner Kern in jeder Kammer. Die Kelchhöhle ist stumpf kegelförmig, oft fast kegeltrichterförmig, und reicht 3/5 zur Achsenhöhle. Das Handbuch nennt das Kernhaus groß, zwiebelförmig und schwach angedeutet, die Fächer geräumig und wenig zur schmalen Achsenhöhle geöffnet, mit wenigen guten Kernen; Kelchhöhle und kurze Röhre bilden einen etwas eingezogenen Kegel. Das Fleisch ist am Schnitt gelblichweiß, um die Hauptgefäßbündel oft etwas rötlich.","belege":[{"quelle":"engelbrecht1889","seite":"190 (Nr. 169)"},{"quelle":"illustr_hb_1","band":"I","seite":"95"}]},{"thema":"fleisch_geschmack","text":"Das Fleisch ist gelblichweiß, ziemlich fein, locker, mürbe und saftig. Engelbrecht nennt es schwach gewürzt, kräftig weinig und wenig süß; Wikipedia beschreibt den Geschmack als eher säuerlich und wenig aromatisch. Das Handbuch fand ihn dagegen süßsäuerlich und angenehm, etwas zuckerhaft gewürzt, zuweilen schwach rosenartig; Diel sprach von Himbeergeschmack.","belege":[{"quelle":"engelbrecht1889","seite":"190 (Nr. 169)"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Charlamowsky&oldid=251367539"},{"quelle":"illustr_hb_1","band":"I","seite":"95"}]},{"thema":"reife_lagerung","text":"Engelbrecht gibt Ende August bis September an, das Handbuch Ende August für etwa vier Wochen. Nach Wikipedia reifen die Äpfel Mitte bis Ende August und halten sich nur etwa vier Wochen.","belege":[{"quelle":"engelbrecht1889","seite":"190 (Nr. 169)"},{"quelle":"illustr_hb_1","band":"I","seite":"95"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Charlamowsky&oldid=251367539"}]},{"thema":"baum","text":"Nach dem Handbuch wächst der Baum gut, trägt bald und fast jährlich reichlich und eignet sich auch für raue Gegenden. Wikipedia beschreibt ihn als genügsam und unempfindlich, auch für höhere Lagen geeignet, aber nicht für nasse, kühle Standorte. Nach anfänglich starkem Wachstum lässt der Wuchs bald nach, der Baum bleibt klein, altert früh und ist kurzlebig, trägt aber früh und regelmäßig, wenn er regelmäßig geschnitten wird. Er blüht früh, ist dabei recht frostfest und ein guter Pollenspender.","belege":[{"quelle":"illustr_hb_1","band":"I","seite":"95"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Charlamowsky&oldid=251367539"}]},{"thema":"verwendung","text":"Das Handbuch sah in der Frucht eine schöne Sommerfrucht für Markt und Tafel, auch für die Wirtschaft brauchbar; Engelbrecht bewertete sie mit o††. Wikipedia empfiehlt sie wegen des säuerlichen, wenig würzigen Geschmacks eher zur Verarbeitung, etwa zu Apfelmus oder Kuchen, und wegen des schwachen Wuchses für Hausgärten.","belege":[{"quelle":"illustr_hb_1","band":"I","seite":"95"},{"quelle":"engelbrecht1889","seite":"190 (Nr. 169)"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Charlamowsky&oldid=251367539"}]},{"thema":"unterscheidung","text":"Nach dem Handbuch sind die nächsten Verwandten die Astrachanischen Sommeräpfel; auch der Blumensauer hat viel Ähnlichkeit mit dem Charlamowsky.","belege":[{"quelle":"illustr_hb_1","band":"I","seite":"95"}]},{"thema":"frucht","text":"Nach den Erhebungen der National Fruit Collection: die Sorte bildet große, flachrunde Früchte mit weißlich gelber Grundfarbe und gestreifter orangefarbener Deckfarbe. Das Fruchtfleisch ist weiß. In der Sammlung als Tafel- und Küchenapfel geführt; pflückreif Mitte August, lagerfähig bis September.","belege":[{"quelle":"nfc2025","seite":"Akzession 1957190"}]}],"bilder":[{"url":"https://archive.org/download/bub_gb_tR4EMgEACAAJ/page/n207_w800.jpg","seite":"https://archive.org/details/bub_gb_tR4EMgEACAAJ/page/n207","art":"schnitt","urheber":"Theodor Engelbrecht (Zeichnung), Albert Probst (Holzschnitt)","lizenz":"gemeinfrei","quelle":"engelbrecht1889","titel":"Längsschnitt-Umriss bei Engelbrecht 1889, S. 190 (ganze Buchseite)"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/d/d3/Charlamowsky_Ri1.JPG/960px-Charlamowsky_Ri1.JPG","seite":"https://commons.wikimedia.org/wiki/File:Charlamowsky_Ri1.JPG","art":"frucht","urheber":"HerbertRi","lizenz":"CC BY-SA 3.0","quelle":"commons","titel":"Charlamowsky Ri1.JPG"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/b/b0/Charlamowsky.jpg/960px-Charlamowsky.jpg","seite":"https://commons.wikimedia.org/wiki/File:Charlamowsky.jpg","art":"baum","urheber":"User:MarkusHagenlocher","lizenz":"CC BY-SA 3.0","quelle":"commons","titel":"Charlamowsky.jpg"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/3/3d/Charlamowsky_jm55148.jpg/960px-Charlamowsky_jm55148.jpg","seite":"https://commons.wikimedia.org/wiki/File:Charlamowsky_jm55148.jpg","art":"frucht","urheber":"joergens.mi","lizenz":"CC BY-SA 3.0","quelle":"commons","titel":"Charlamowsky jm55148.jpg"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/80/Deutsche_Pomologie_-_Aepfel_-_008.jpg/960px-Deutsche_Pomologie_-_Aepfel_-_008.jpg","seite":"https://commons.wikimedia.org/wiki/File:Deutsche_Pomologie_-_Aepfel_-_008.jpg","art":"tafel","urheber":"Wilhelm Lauche (Deutsche Pomologie, 1882)","lizenz":"gemeinfrei","quelle":"lauche_dp1882","titel":"Deutsche Pomologie - Aepfel - 008.jpg (Charlamowsky)"},{"url":"https://upload.wikimedia.org/wikipedia/commons/4/47/Cross_section_of_Duchess_of_Oldenburg%2C_National_Fruit_Collection_%28acc._1957-190%29.jpg","seite":"https://commons.wikimedia.org/wiki/File:Cross_section_of_Duchess_of_Oldenburg,_National_Fruit_Collection_(acc._1957-190).jpg","art":"schnitt","urheber":"National Fruit Collection, Brogdale","lizenz":"OGL 2.0","quelle":"nfc-commons","titel":"Cross section of Duchess of Oldenburg, National Fruit Collection (acc. 1957-190)"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/0/0c/Apfel_023_Borowinka_%28fcm%29.jpg/960px-Apfel_023_Borowinka_%28fcm%29.jpg","seite":"https://commons.wikimedia.org/wiki/File:Apfel_023_Borowinka_(fcm).jpg","art":"frucht","urheber":"Photograph: Frank C. Müller , Frankfurt am Main","lizenz":"CC BY-SA 4.0","quelle":"commons-fotos","titel":"Apfel 023 Borowinka (fcm)"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/96/Apfel_024_Borowinka_%28fcm%29.jpg/960px-Apfel_024_Borowinka_%28fcm%29.jpg","seite":"https://commons.wikimedia.org/wiki/File:Apfel_024_Borowinka_(fcm).jpg","art":"frucht","urheber":"Photograph: F