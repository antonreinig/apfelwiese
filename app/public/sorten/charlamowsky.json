t":"tafel","urheber":"Schutt, Ellen Isham, 1873-1955","lizenz":"gemeinfrei","quelle":"usda-pomological","titel":"Pomological Watercolor POM00001531"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/8f/%28R.G._Chase_and_Co._%28Geneva%2C_N.Y.%29_materials%29_%28Page_12%29_BHL46913868.jpg/960px-%28R.G._Chase_and_Co._%28Geneva%2C_N.Y.%29_materials%29_%28Page_12%29_BHL46913868.jpg","seite":"https://commons.wikimedia.org/wiki/File:(R.G._Chase_and_Co._(Geneva,_N.Y.)_materials)_(Page_12)_BHL46913868.jpg","art":"tafel","urheber":"Liberty Hyde Bailey Hortorium.; R.G. Chase & Co. (Geneva, N.Y.)","lizenz":"gemeinfrei","quelle":"commons-illustrationen","titel":"(R.G. Chase and Co. (Geneva, N.Y.) materials) (Page 12) BHL46913868"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/13/Charlamowsky_%28H_Sj%C3%B6berg%29.jpg/960px-Charlamowsky_%28H_Sj%C3%B6berg%29.jpg","seite":"https://commons.wikimedia.org/wiki/File:Charlamowsky_(H_Sj%C3%B6berg).jpg","art":"tafel","urheber":"Henriette Sjöberg (1842–1915)","lizenz":"gemeinfrei","quelle":"commons-illustrationen","titel":"Charlamowsky (H Sjöberg)"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/94/Descriptive_catalogue_of_fruit_and_ornamental_trees%2C_shrubs%2C_vines_and_plants_%281900%29_%2820369172228%29.jpg/960px-Descriptive_catalogue_of_fruit_and_ornamental_trees%2C_shrubs%2C_vines_and_plants_%281900%29_%2820369172228%29.jpg","seite":"https://commons.wikimedia.org/wiki/File:Descriptive_catalogue_of_fruit_and_ornamental_trees,_shrubs,_vines_and_plants_(1900)_(20369172228).jpg","art":"tafel","urheber":"Internet Archive Book Images","lizenz":"gemeinfrei (keine bekannten Rechte, Flickr Commons)","quelle":"commons-illustrationen","titel":"Descriptive catalogue of fruit and ornamental trees, shrubs, vines and plants (1900) (20369172228)"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/7e/Descriptive_catalogue_of_fruit_and_ornamental_trees%2C_shrubs%2C_vines_and_plants_%281900%29_%282