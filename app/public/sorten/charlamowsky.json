{"id":"charlamowsky","name":"Charlamowsky","synonyme":[{"name":"Borowitzky","beleg":{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Charlamowsky&oldid=251367539"}},{"name":"Duchess of Oldenburg","beleg":{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Charlamowsky&oldid=251367539"}},{"name":"Borowitsky","beleg":{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Charlamowsky&oldid=251367539"}},{"name":"Charlamowski","beleg":{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Charlamowsky&oldid=251367539"}},{"name":"Charlamovsky","beleg":{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Charlamowsky&oldid=251367539"}},{"name":"Charlamowsky d'Automne","beleg":{"quelle":"engelbrecht1889","seite":"190 (Nr. 169)"}},{"name":"Borowicki","beleg":{"quelle":"engelbrecht1889","seite":"190 (Nr. 169)"}},{"name":"Charlamowskyscher Nalivi","beleg":{"quelle":"illustr_hb_1","band":"I","seite":"95"}}],"herkunft":{"text":"Vermutlich aus dem südlichen Russland; Diel, der die Sorte aus Moskau erhielt, vermutete eine Herkunft aus Persien. Um 1830 wurde sie erstmals in Hohenheim angepflanzt. Die in England und Amerika als Duchess of Oldenburg geführte Sorte ist nach dem Illustrierten Handbuch dieselbe.","belege":[{"quelle":"illustr_hb_1","band":"I","seite":"95"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Charlamowsky&oldid=251367539"}]},"merkmale":[{"merkmal":"frucht_breite","wert":76,"original":"Gestalt 76:60—63","quelle":"engelbrecht1889","seite":"190 (Nr. 169)"},{"merkmal":"frucht_hoehe","wert":61.5,"original":"Gestalt 76:60—63","quelle":"engelbrecht1889","seite":"190 (Nr. 169)"},{"merkmal":"frucht_hoehe_breite","wert":0.81,"original":"Gestalt 76:60—63","quelle":"engelbrecht1889","seite":"190 (Nr. 169)"},{"merkmal":"frucht_form","wert":"rund","original":"stark abgest. rundlich","quelle":"engelbrecht1889","seite":"190 (Nr. 169)"},{"merkmal":"frucht_breiteste_stelle","wert":"mitte","original":"mittelbauch.","quelle":"engelbrecht1889","seite":"190 (Nr. 169)"},{"merkmal":"frucht_symmetrie","wert":"symmetrisch","original":"Hälften fast gleich","quelle":"engelbrecht1889","seite":"190 (Nr. 169)"},{"merkmal":"frucht_rippung","wert":"3","original":"Querschn. fast rund","quelle":"engelbrecht1889","seite":"190 (Nr. 169)"},{"merkmal":"kelch_offenheit","wert":"geschlossen","original":"Kelch meistens geschlossen","quelle":"engelbrecht1889","seite":"190 (Nr. 169)"},{"merkmal":"kelchgrube_tiefe","wert":"5","original":"Einsenk. mitteltief, ziemlich weit","quelle":"engelbrecht1889","seite":"190 (Nr. 169)"},{"merkmal":"kelchgrube_weite","wert":"7","original":"Einsenk. mitteltief, ziemlich weit","quelle":"engelbrecht1889","seite":"190 (Nr. 169)"},{"merkmal":"stiel_dicke","wert":"5","original":"Stiel holzig, mitteldick, etwa 16 mm lang","quelle":"engelbrecht1889","seite":"190 (Nr. 169)"},{"merkmal":"stielgrube_tiefe","wert":"5","original":"Höhle mitteltief, mittelweit, eben, grün, wenig berostet","quelle":"engelbrecht1889","seite":"190 (Nr. 169)"},{"merkmal":"stielgrube_weite","wert":"5","original":"Höhle mitteltief, mittelweit, eben, grün, wenig berostet","quelle":"engelbrecht1889","seite":"190 (Nr. 169)"},{"merkmal":"schale_berostung_stielgrube","wert":"3","original":"Höhle … grün, wenig berostet","quelle":"engelbrecht1889","seite":"190 (Nr. 169)"},{"merkmal":"schale_beschaffenheit","wert":"bereift","original":"Schale geschmeidig, etwas beduftet","quelle":"engelbrecht1889","seite":"190 (Nr. 169)"},{"merkmal":"schale_grundfarbe","wert":"gelb","original":"hellgrünlichgelb, später hellgelb","quelle":"engelbrecht1889","seite":"190 (Nr. 169)"},{"merkmal":"schale_deckfarbe_anteil","wert":"7","original":"sonnenw. … oft weithin hell punktirt geröthet","quelle":"engelbrecht1889","seite":"190 (Nr. 169)"},{"merkmal":"schale_deckfarbe_farbton","wert":"rot","original":"dunkler carmoisin fein gestreift","quelle":"engelbrecht1889","seite":"190 (Nr. 169)"},{"merkmal":"schale_deckfarbe_art","wert":"getuepfelt","original":"oft weithin hell punktirt geröthet","quelle":"engelbrecht1889","seite":"190 (Nr. 169)"},{"merkmal":"schale_deckfarbe_art","wert":"gestreift","original":"dunkler carmoisin fein gestreift","quelle":"engelbrecht1889","seite":"190 (Nr. 169)"},{"merkmal":"schale_lentizellen_groesse","wert":"3","original":"Punkte sehr fein, oft nur Dupfen","quelle":"engelbrecht1889","seite":"190 (Nr. 169)"},{"merkmal":"kernhaus_form","wert":"zwiebel","original":"Kernhaus 39:32, zwiebelf.","quelle":"engelbrecht1889","seite":"190 (Nr. 169)"},{"merkmal":"kernfaecher_oeffnung","wert":"geschlossen","original":"Kammern … mittelgeräumig, nicht oder sehr wenig geöffnet","quelle":"engelbrecht1889","seite":"190 (Nr. 169)"},{"merkmal":"kernfaecher_oeffnung","wert":"teilweise","original":"Kammern … mittelgeräumig, nicht oder sehr wenig geöffnet","quelle":"engelbrecht1889","seite":"190 (Nr. 169)"},{"merkmal":"kernhaus_achse","wert":"offen","original":"Achsenh. schmal","quelle":"engelbrecht1889","seite":"190 (Nr. 169)"},{"merkmal":"kerne_form","wert":"eifoermig","original":"Kerne meistens zu 1, mittelgross, meistens vollkommen, eiförmig, gespitzt","quelle":"engelbrecht1889","seite":"190 (Nr. 169)"},{"merkmal":"kelchhoehle_form","wert":"dreieck_lang","original":"Kelchhöhle stumpf kegel-, oft fast kegeltrichterf., ⅗ zur Achsenh.","quelle":"engelbrecht1889","seite":"190 (Nr. 169)"},{"merkmal":"fleisch_farbe","wert":"cremeweiss","original":"Fleisch gelblichweiss","quelle":"engelbrecht1889","seite":"190 (Nr. 169)"},{"merkmal":"fleisch_festigkeit","wert":"3","original":"ziemlich fein, locker, mürbe, saftig","quelle":"engelbrecht1889","seite":"190 (Nr. 169)"},{"merkmal":"fleisch_saftigkeit","wert":"7","original":"ziemlich fein, locker, mürbe, saftig","quelle":"engelbrecht1889","seite":"190 (Nr. 169)"},{"merkmal":"geschmack_saeure","wert":"7","original":"vorherrschend, kräftig weinig, wenig süss","quelle":"engelbrecht1889","seite":"190 (Nr. 169)"},{"merkmal":"geschmack_suesse","wert":"3","original":"vorherrschend, kräftig weinig, wenig süss","quelle":"engelbrecht1889","seite":"190 (Nr. 169)"},{"merkmal":"verwendung","wert":"tafel","original":"o†† (Kopfzeile)","quelle":"engelbrecht1889","seite":"190 (Nr. 169)"},{"merkmal":"verwendung","wert":"kueche","original":"o†† (Kopfzeile)","quelle":"engelbrecht1889","seite":"190 (Nr. 169)"},{"merkmal":"genussreife_beginn","wert":"8","original":"Ende August bis September","quelle":"engelbrecht1889","seite":"190 (Nr. 169)"},{"merkmal":"genussreife_ende","wert":"9","original":"Ende August bis September","quelle":"engelbrecht1889","seite":"190 (Nr. 169)"},{"merkmal":"kelch_offenheit","wert":"geschlossen","original":"Kelch: … geschlossen oder halboffen","quelle":"illustr_hb_1","band":"I","seite":"95"},{"merkmal":"kelch_offenheit","wert":"halboffen","original":"Kelch: … geschlossen oder halboffen","quelle":"illustr_hb_1","band":"I","seite":"95"},{"merkmal":"schale_beschaffenheit","wert":"glatt","original":"Schale: fein, glatt, geschmeidig, oft noch etwas duftig","quelle":"illustr_hb_1","band":"I","seite":"95"},{"merkmal":"schale_beschaffenheit","wert":"bereift","original":"Schale: fein, glatt, geschmeidig, oft noch etwas duftig","quelle":"illustr_hb_1","band":"I","seite":"95"},{"merkmal":"schale_lentizellen_groesse","wert":"3","original":"Die Punkte sind fein, fast kaum bemerklich, weißlich oder grünlich","quelle":"illustr_hb_1","band":"I","seite":"95"},{"merkmal":"schale_lentizellen_art","wert":"hell","original":"Die Punkte sind fein, fast kaum bemerklich, weißlich oder grünlich","quelle":"illustr_hb_1","band":"I","seite":"95"},{"merkmal":"kernhaus_form","wert":"zwiebel","original":"Kernhaus: schwach angedeutet, groß, zwiebelförmig","quelle":"illustr_hb_1","band":"I","seite":"95"},{"merkmal":"kernfaecher_oeffnung","wert":"teilweise","original":"Fächer: wenig nach der schmalen Axenhöhle geöffnet, geräumig","quelle":"illustr_hb_1","band":"I","se