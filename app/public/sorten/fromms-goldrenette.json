ert":"symmetrisch","original":"Hälften gleich","quelle":"engelbrecht1889","seite":"370 (Nr. 328)"},{"merkmal":"frucht_rippung","wert":"1","original":"Querschnitt rund","quelle":"engelbrecht1889","seite":"370 (Nr. 328)"},{"merkmal":"kelch_offenheit","wert":"halboffen","original":"Kelch halb offen bis offen, meist braun, wollig","quelle":"engelbrecht1889","seite":"370 (Nr. 328)"},{"merkmal":"kelch_offenheit","wert":"offen","original":"Kelch halb offen bis offen, meist braun, wollig","quelle":"engelbrecht1889","seite":"370 (Nr. 328)"},{"merkmal":"kelchgrube_tiefe","wert":"5","original":"Einsenkung mitteltief, mittelweit, meistens eben","quelle":"engelbrecht1889","seite":"370 (Nr. 328)"},{"merkmal":"kelchgrube_weite","wert":"5","original":"Einsenkung mitteltief, mittelweit, meistens eben","quelle":"engelbrecht1889","seite":"370 (Nr. 328)"},{"merkmal":"stiel_dicke","wert":"5","original":"Stiel holzig oder etwas fleischig, mitteldick, etwa 13 mm lang","quelle":"engelbrecht1889","seite":"370 (Nr. 328)"},{"merkmal":"stielgrube_weite","wert":"7","original":"Höhle fast mitteltief, ziemlich weit, eben, berostet","quelle":"engelbrecht1889","seite":"370 (Nr. 328)"},{"merkmal":"schale_berostung_stielgrube","wert":"5","original":"Höhle … eben, berostet","quelle":"engelbrecht1889","seite":"370 (Nr. 328)"},{"merkmal":"schale_beschaffenheit","wert":"glatt","original":"Schale glatt, etwas glänzend","quelle":"engelbrecht1889","seite":"370 (Nr. 328)"},{"merkmal":"schale_grundfarbe","wert":"gelb","original":"hellgrünlichgelb, später lebhaft gelb","quelle":"engelbrecht1889","seite":"370 (Nr. 328)"},{"merkmal":"schale_deckfarbe_anteil","wert":"1","original":"sonnenw. etwas goldiger, zuweilen zart röthlich angeflogen","quelle":"engelbrecht1889","seite":"370 (Nr. 328)"},{"merkmal":"schale_lentizellen_anzahl","wert":"5","original":"Punkte mittelzahlreich, meistens fein, braun","quelle":"engelbrecht1889","seite":"370 (Nr. 328)"},{"merkmal":"schale_lentizellen_groesse","wert":"3","original":"Punkte mittelzahlreich, meistens fein, braun","quelle":"engelbrecht1889","seite":"370 (Nr. 328)"},{"merkmal":"schale_lentizellen_art","wert":"braun","original":"Punkte mittelzahlreich, meistens fein, braun","quelle":"engelbrecht1889","seite":"370 (Nr. 328)"},{"merkmal":"schale_berostung_wangen","wert":"3","original":"Feine Rostanflüge nicht selten","quelle":"engelbrecht1889","seite":"370 (Nr. 328)"},{"merkmal":"kernhaus_form","wert":"zwiebel","original":"Kernhaus 34:25, flachrund bis zwiebelf.","quelle":"engelbrecht1889","seite":"370 (Nr. 328)"},{"merkmal":"kernfaecher_oeffnung","wert":"geschlossen","original":"Kammern 9:14 … glattwandig, geräumig, meistens geschlossen","quelle":"engelbrecht1889","seite":"370 (Nr. 328)"},{"merkmal":"kernhaus_achse","wert":"offen","original":"Achsenh. schmal","quelle":"engelbrecht1889","seite":"370 (Nr. 328)"},{"merkmal":"kerne_form","wert":"eifoermig","original":"Kerne zu 2, fast mittelgross, meistens vollkommen, länglich eiförmig, lang gespitzt","quelle":"engelbrecht1889","seite":"370 (Nr. 328)"},{"merkmal":"kelchhoehle_form","wert":"dreieck_breit","original":"Kelchhöhle breiter, kurzer Kegel, ⅓ bis ⅖ zur Achsenh.","quelle":"engelbrecht1889","seite":"370 (Nr. 328)"},{"merkmal":"fleisch_farbe","wert":"gelblich","original":"Fleisch hellgelblich, fein, erst fest, später fast mürbe","quelle":"engelbrecht1889","seite":"370 (Nr. 328)"},{"merkmal":"fleisch_saftigkeit","wert":"5","original":"ziemlich saftig","quelle":"engelbrecht1889","seite":"370 (Nr. 328)"},{"merkmal":"geschmack_saeure","wert":"7","original":"etwas vorherrschend weinig, genügend süss","quelle":"engelbrecht1889","seite":"370 (Nr. 328)"},{"merkmal":"geschmack_suesse","wert":"5","original":"etwas vorherrschend weinig, genügend süss","quelle":"engelbrecht1889","seite":"370 (Nr. 328)"},{"merkmal":"geschmack_aroma","wert":"gewürzt","original":"ziemlich saftig, gewürzt","quelle":"engelbrecht1889","seite":"370 (Nr. 328)"},{"merkmal":"verwendung","wert":"tafel","original":"fast oo++ (Kopfzeile)","quelle":"engelbrecht1889","seite":"370 (Nr. 328)"},{"merkmal":"verwendung","wert":"kueche","original":"fast oo++ (Kopfzeile)","quelle":"engelbrecht1889","seite":"370 (Nr. 328)"},{"merkmal":"genussreife_beginn","wert":"11","original":"Ende November bis März (Kopfzeile)","quelle":"engelbrecht1889","seite":"370 (Nr. 328)"},{"merkmal":"genussreife_ende","wert":"3","original":"Ende November bis März (Kopfzeile)","quelle":"engelbrecht1889","seite":"370 (Nr. 328)"},{"merkmal":"kernhaus_breite_mm","wert":34,"original":"Kernhaus 34:25","quelle":"engelbrecht1889","seite":"370 (Nr. 328)"},{"merkmal":"kernhaus_hoehe_mm","wert":25,"original":"Kernhaus 34:25","quelle":"engelbrecht1889","seite":"370 (Nr. 328)"},{"merkmal":"kernfach_breite_mm","wert":9,"original":"Kammern 9:14","quelle":"engelbrecht1889","seite":"370 (Nr. 328)"},{"merkmal":"kernfach_hoehe_mm","wert":14,"original":"Kammern 9:14","quelle":"engelbrecht1889","seite":"370 (Nr. 328)"},{"merkmal":"kernhaus_form","wert":"flachrund","original":"Kernhaus flachrund bis zwiebelf","quelle":"engelbrecht1889","seite":"370 (Nr. 328)"},{"merkmal":"lagerfaehigkeit","wert":"7","original":"Nach Engelbrecht ist die Sorte von Ende November bis März genussreif","quelle":"engelbrecht1889","seite":"370 (Nr. 328)"}],"texte":[{"thema":"ueberblick","text":"Fromms Goldrenette ist eine alte Renette aus der Thüringer Rhön. Die flachrunden Früchte sind lebhaft gelb, kaum gerötet und oft fein berostet; das hellgelbliche Fleisch ist gewürzt und etwas vorherrschend weinig. Engelbrecht ordnete sie 1889 bei den Borsdorfer-Renetten ein. Heute ist die Sorte sehr selten; 2023 war sie Thüringer Obstsorte des Jahres.","belege":[{"quelle":"engelbrecht1889","seite":"370 (Nr. 328)"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Fromms_Goldrenette&oldid=263959258"}]},{"thema":"herkunft","text":"Die Sorte ist ein Zufallssämling aus Seeba (heute Gemeinde Rhönblick) in Thüringen und seit etwa 1839 bekannt. Sie hieß zunächst nach ihrem Ursprungsort Seebaer Borsdorfer; den Namen Fromms Goldrenette erhielt sie zu Ehren eines Meininger Regierungskanzlisten. Dittrich beschrieb sie als Fromm's Gold-Reinette, Leroy als Reinette Fromm. Engelbrecht bekam 1889 Früchte vom Verein für Pomologie und Gartenbau in Meiningen unter beiden Namen.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Fromms_Goldrenette&oldid=263959258"},{"quelle":"engelbrecht1889","seite":"370 (Nr. 328)"}]},{"thema":"frucht","text":"Engelbrecht maß 60 mm Breite bei 47 mm Höhe; im Illustrirten Handbuch (Bd. VIII) waren es 67:53–56 mm, bei Leroy 71:56 mm. Die Frucht ist abgestumpft rundlich bis flachrund, mittelbauchig, mit gleichen Hälften und rundem Querschnitt. Der Kelch ist halb offen bis offen und sitzt in einer mitteltiefen, mittelweiten, meist ebenen Einsenkung. Der holzige oder etwas fleischige, mitteldicke Stiel ist etwa 13 mm lang; die Stielgrube ist knapp mitteltief, ziemlich weit, eben und berostet.","belege":[{"quelle":"engelbrecht1889","seite":"370 (Nr. 328)"}]},{"thema":"schale","text":"Die glatte, etwas glänzende Schale ist hellgrünlichgelb und wird lebhaft gelb, auf der Sonnenseite etwas goldiger und nur zuweilen zart rötlich angehaucht. Die Schalenpunkte sind mittelzahlreich, meist fein und braun; feine Rostanflüge sind häufig. Die Früchte welken nicht und riechen merklich.","belege":[{"quelle":"engelbrecht1889","seite":"370 (Nr. 328)"}]},{"thema":"schnitt","text":"Das Kernhaus ist klein, flachrund bis zwiebelförmig (34:25 mm). Die Kammern (9:14 mm) sind stielwärts spitz, kelchwärts abgerundet, glattwandig, geräumig und meist geschlossen; die Achsenhöhle ist schmal. Je Kammer liegen zwei fast mittelgroße, meist vollkommene, länglich eiförmige, lang gespitzte, hellbraune Kerne. Die Kelchhöhle ist ein breiter, kurzer Kegel, der ⅓ bis ⅖ zur Achsenhöhle reicht. Das Fleisch ist am Schnitt hellgelblich.","belege":[{"quelle":"engelbrecht1889","seite":"370 (Nr. 328)"}]},{"thema":"fleisch_geschmack","text":"Das hellgelbliche Fleisch ist fein, anfangs fest, später fast mürbe, ziemlich saftig und gewürzt. Die Säure überwiegt etwas, die Süße ist ausreichend.","belege":[{"quelle":"engelbrecht1889","seite":"370 (Nr. 328)"}]},{"thema":"reife_lagerung","text":"Nach Engelbrecht ist die Sorte von Ende November bis März genussreif.","belege":[{"quelle":"engelbrecht1889","seite":"370 (Nr. 328)"}]},{"thema":"verwendung","text":"Engelbrecht gibt fast die höchsten Wertzeichen für Tafel und Haushalt.","belege":[{"quelle":"engelbrecht1889","seite":"370 (Nr. 328)"}]}],"bilder":[{"url":"https://archive.org/download/bub_gb_tR4EMgEACAAJ/page/n384_w800.jpg","seite":"https://archive.org/details/bub_gb_tR4EMgEACAAJ/page/n384","art":"schnitt","urheber":"Theodor Engelbrecht (Zeichnung), Albert Probst (Holzschnitt)","lizenz":"gemeinfrei","quelle":"engelbrecht1889","titel":"Längsschnitt-Umriss bei Engelbrecht 1889, S. 370 (ganze Buchseite)"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/93/Fromms_Goldrenette_%E2%80%93_100_Jahre_Gr%C3%BCne_Woche.jpg/960px-Fromms_Goldrenette_%E2%80%93_100_Jahre_Gr%C3%BCne_Woche.jpg","seite":"https://commons.wikimedia.org/wiki/File:Fromms_Goldrenette_%E2%80%93_100_Jahre_Gr%C3%BCne_Woche.jpg","art":"frucht","urheber":"Weltalf","lizenz":"CC BY-SA 4.0","quelle":"commons","titel":"Fromms Goldrenette – 100 Jahre Grüne Woche.jpg"}],"regionen":[{"region":"DE-TH","art":"herkunft","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Fromms_Goldrenette&oldid=263959258"},{"quelle":"engelbrecht1889","seite":"370 (Nr. 328)"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Fromms_Goldrenette&oldid=263959258"},{"quelle":"engelbrecht1889","seite":"370 (Nr. 328)"},{"quelle":"rg_th-pv-lg-thueringen"}]},{"region":"DE-TH","art":"regionalsorte","belege":[{"quelle":"rg_pv-obstsorte-des-jahres","seite":"Thüringer Obstsorte 2024"}],"original":"Fromms Goldrenette"}],"gefaehrdung":[{"stufe":"selten","belege":[{"quelle":"engelbrecht1889","seite":"370 (Nr. 328)"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Fromms_Goldrenette&oldid=263959258"}],"original":"Heute ist die Sorte sehr selten"},{"stufe":"Rote Liste der gefährdeten einheimischen Nutzpflanzen in Deutschland","belege":[{"quelle":"rg_ble-rote-liste"}],"original":"Fromms Goldrenette"}]}