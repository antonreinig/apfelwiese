{"id":"landsberger-renette","name":"Landsberger Renette","synonyme":[{"name":"Landsberger Reinette","beleg":{"quelle":"engelbrecht1889","seite":"543 (Nr. 490)"}},{"name":"Landsberger","beleg":{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Landsberger_Renette&oldid=250533090"}},{"name":"Landsberger Apfel","beleg":{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Landsberger_Renette&oldid=250533090"}},{"name":"Reinette de Landsberg","beleg":{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Landsberger_Renette&oldid=250533090"}},{"name":"Reneta Landsberska","beleg":{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Landsberger_Renette&oldid=250533090"}}],"herkunft":{"text":"Um 1850 von Justizrat Burchardt in Landsberg an der Warthe als Sämling gezogen; nach Wikipedia ein Sämling von Harberts Renette. Burchardt schickte Reiser an den Verein für Pomologie und Gartenbau in Meiningen, von wo aus sich die Sorte verbreitete.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Landsberger_Renette&oldid=250533090"},{"quelle":"illustr_hb_4","band":"IV","seite":"131"}],"land":"PL","landSicher":true,"ort":"Landsberg an der Warthe","jahr":1850},"merkmale":[{"merkmal":"frucht_breite","wert":78,"original":"Gestalt 78:62—63","quelle":"engelbrecht1889","seite":"543 (Nr. 490)"},{"merkmal":"frucht_hoehe","wert":62.5,"original":"Gestalt 78:62—63","quelle":"engelbrecht1889","seite":"543 (Nr. 490)"},{"merkmal":"frucht_hoehe_breite","wert":0.8,"original":"Gestalt 78:62—63","quelle":"engelbrecht1889","seite":"543 (Nr. 490)"},{"merkmal":"frucht_groesse","wert":"5","original":"mittelgroß, oft groß","quelle":"illustr_hb_4","band":"IV","seite":"131"},{"merkmal":"frucht_groesse","wert":"7","original":"mittelgroß, oft groß","quelle":"illustr_hb_4","band":"IV","seite":"131"},{"merkmal":"frucht_form","wert":"rund","original":"abgest. rundlich","quelle":"engelbrecht1