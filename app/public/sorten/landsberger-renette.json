riginal":"White"},{"merkmal":"fleisch_festigkeit","wert":"3","quelle":"nfc2025","seite":"Akzession 2000057 (Verkostung P. Hale, 11/11/2020)","original":"Very soft"},{"merkmal":"fleisch_saftigkeit","wert":"5","quelle":"nfc2025","seite":"Akzession 2000057 (Verkostung P. Hale, 11/11/2020)","original":"Intermediate to high"},{"merkmal":"fleisch_saftigkeit","wert":"7","quelle":"nfc2025","seite":"Akzession 2000057 (Verkostung P. Hale, 11/11/2020)","original":"Intermediate to high"},{"merkmal":"geschmack_suesse","wert":"5","quelle":"nfc2025","seite":"Akzession 2000057 (Verkostung P. Hale, 11/11/2020)","original":"Intermediate"},{"merkmal":"geschmack_saeure","wert":"5","quelle":"nfc2025","seite":"Akzession 2000057 (Verkostung P. Hale, 11/11/2020)","original":"Intermediate to high"},{"merkmal":"geschmack_saeure","wert":"7","quelle":"nfc2025","seite":"Akzession 2000057 (Verkostung P. Hale, 11/11/2020)","original":"Intermediate to high"},{"merkmal":"verwendung","wert":"tafel","quelle":"nfc2025","seite":"Akzession 2000057","original":"Dessert"},{"merkmal":"pflueckreife","wert":"9","quelle":"nfc2025","seite":"Akzession 2000057","original":"Late September"},{"merkmal":"genussreife_ende","wert":"1","quelle":"nfc2025","seite":"Akzession 2000057","original":"January"},{"merkmal":"bluete_zeit","wert":"5","quelle":"nfc2025","seite":"Akzession 2000057","original":"Klasse 5 (10 % der Blüten offen, Tag 124)"},{"merkmal":"hochstamm","wert":"gut","original":"bildet schöne Hochstämme","quelle":"illustr_hb_4","band":"IV","seite":"131","belege":[{"quelle":"illustr_hb_4","band":"IV","seite":"131"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Landsberger_Renette&oldid=250533090"}]},{"merkmal":"ertrag_beginn","wert":"frueh","original":"trägt früh und sehr reich","quelle":"illustr_hb_4","band":"IV","seite":"131","belege":[{"quelle":"illustr_hb_4","band":"IV","seite":"131"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Landsberger_Renette&oldid=250533090"}]},{"merkmal":"standort_boden","wert":"3","original":"stellt wenig Ansprüche an den Boden","quelle":"illustr_hb_4","band":"IV","seite":"131","belege":[{"quelle":"illustr_hb_4","band":"IV","seite":"131"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Landsberger_Renette&oldid=250533090"}]},{"merkmal":"standort_klima","wert":"3","original":"passt in kühle Lagen","quelle":"illustr_hb_4","band":"IV","seite":"131","belege":[{"quelle":"illustr_hb_4","band":"IV","seite":"131"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Landsberger_Renette&oldid=250533090"}]},{"merkmal":"anfaelligkeit_krebs","wert":"7","original":"auf nassen, mageren Böden tritt Obstbaumkrebs auf","quelle":"illustr_hb_4","band":"IV","seite":"131","belege":[{"quelle":"illustr_hb_4","band":"IV","seite":"131"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Landsberger_Renette&oldid=250533090"}]},{"merkmal":"anfaelligkeit_mehltau","wert":"7","original":"an warmen, trockenen Standorten Mehltau","quelle":"illustr_hb_4","band":"IV","seite":"131","belege":[{"quelle":"illustr_hb_4","band":"IV","seite":"131"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Landsberger_Renette&oldid=250533090"}]},{"merkmal":"lagerfaehigkeit","wert":"5","original":"Engelbrecht gibt November bis Februar an","quelle":"engelbrecht1889","seite":"543 (Nr. 490)"}],"texte":[{"thema":"ueberblick","text":"Großfrüchtige, gelbe Winterrenette aus Landsberg an der Warthe, gezogen um 1850. Der Baum wächst stark, trägt früh und reich und eignet sich auch für kühle Lagen. Engelbrecht stellte sie 1889 zu den roten Renetten und bewertete sie fast als sehr gute Tafel- und Haushaltsfrucht.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Landsberger_Renette&oldid=250533090"},{"quelle":"engelbrecht1889","seite":"543 (Nr. 490)"}]},{"thema":"herkunft","text":"Justizrat Burchardt zog die Sorte um 1850 in Landsberg an der Warthe; Wikipedia nennt sie einen Sämling von Harberts Renette. Burchardt schickte Zweige seiner wichtigsten Sorten an den Verein für Pomologie und Gartenbau in Meiningen, in dessen Schriften die Sorte mehrfach besprochen wurde. Die erste ausführliche Beschreibung lieferte Oberdieck in seiner Anleitung (S. 191); Synonyme waren dem Handbuch nicht bekannt. 1889 erhielt Engelbrecht Früchte aus Gelnhausen, Jeinsen, Hildesheim, Meiningen, Groß Camin und Ehrenfeld bei Köln.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Landsberger_Renette&oldid=250533090"},{"quelle":"illustr_hb_4","band":"IV","seite":"131"},{"quelle":"engelbrecht1889","seite":"543 (Nr. 490)"}]},{"thema":"frucht","text":"Engelbrecht maß 78 mm Breite und 62 bis 63 mm Höhe. Er beschreibt die Frucht als abgestumpft rundlich, das Handbuch als plattrund mit Neigung zur Kugelform; sie ist mittelgroß, oft groß. Der breiteste Teil liegt in der Mitte, häufig etwas zum Stiel hin; die Hälften sind gleich oder etwas ungleich, der Querschnitt ziemlich rund. Der kleine, halb offene bis geschlossene Kelch sitzt in einer mitteltiefen Grube, die das Handbuch weit und schüsselförmig nennt; flache Falten laufen zum Bauch. Der holzige Stiel ist etwa 16 mm lang, nach Engelbrecht mitteldick, nach dem Handbuch dünn; die Stielgrube ist tief und trichterförmig.","belege":[{"quelle":"engelbrecht1889","seite":"543 (Nr. 490)"},{"quelle":"illustr_hb_4","band":"IV","seite":"131"}]},{"thema":"schale","text":"Die glatte, etwas geschmeidige Schale ist mattglänzend, anfangs hellgrün bzw. gelbgrün und wird später hellgelb; das Handbuch nennt sie blass- bis strohgelb. Die Sonnenseite ist meist nur leicht gerötet, verwaschen oder schwach gestreift; an schattig hängenden Früchten fehlt die Röte oft ganz. Die Punkte sind sehr fein, bräunlich und hell umrandet. Engelbrecht fand die Stielgrube nur zart berostet, im Handbuch zieht sich der Rost oft strahlig über die Stielwölbung. Die Früchte welken nicht.","belege":[{"quelle":"engelbrecht1889","seite":"543 (Nr. 490)"},{"quelle":"illustr_hb_4","band":"IV","seite":"131"}]},{"thema":"schnitt","text":"Engelbrecht beschreibt ein zwiebelförmiges Kernhaus von 44 mm Breite und 31 mm Höhe. Die Kammern (12:20 mm) sind stielwärts spitz, kelchwärts meist abgerundet, zuweilen abgestumpft oder etwas zugespitzt, zerrissen, mäßig geräumig und offen; die Achsenhöhle ist ziemlich breit. Je Kammer liegen ein bis zwei mittelgroße, meist vollkommene, eiförmige, gespitzte braune Kerne. Die Kelchhöhle ist ein Kegel, der zwei Drittel bis drei Viertel des Weges zur Achsenhöhle reicht. Das Handbuch nennt das Kernhaus hohlachsig mit ziemlich geräumigen Kammern und gelbbraunen Kernen; seine Angabe, die Kelchhöhle sei kurz und sitze auf dem Kernhaus auf, weicht von Engelbrecht ab. Oberdieck fand das Kernhaus oft offen. Am Schnitt ist das Fleisch hell gelblichweiß.","belege":[{"quelle":"engelbrecht1889","seite":"543 (Nr. 490)"},{"quelle":"illustr_hb_4","band":"IV","seite":"131"}]},{"thema":"fleisch_geschmack","text":"Das Fleisch ist fein, markig bis mürbe und sehr saftig; das Handbuch nennt es ziemlich fest, beim Kauen aber mürbe. Engelbrecht fand es mäßig stark gewürzt, mit etwas vorherrschender, mild weiniger Säure und ausreichender Süße. Das Handbuch beschreibt den Geschmack als gut und süßweinig, ohne besonderes Gewürz; es stellt die Frucht geschmacklich in den zweiten Rang.","belege":[{"quelle":"engelbrecht1889","seite":"543 (Nr. 490)"},{"quelle":"illustr_hb_4","band":"IV","seite":"131"}]},{"thema":"reife_lagerung","text":"Engelbrecht gibt November bis Februar an. Nach dem Handbuch reift die Frucht im November und hält sich gut bis in den Januar; sie verträgt frühes Pflücken.","belege":[{"quelle":"engelbrecht1889","seite":"543 (Nr. 490)"},{"quelle":"illustr_hb_4","band":"IV","seite":"131"}]},{"thema":"baum","text":"Der Baum wächst stark und schnell, bildet schöne Hochstämme und trägt früh und sehr reich. Schon in der Baumschule fielen die jungen Bäume durch raschen Wuchs auf. Oberdieck berichtet, dass ein Baum beim Sturm am 24. August 1860 kaum Früchte verlor. Die Sorte stellt wenig Ansprüche an den Boden und passt in kühle Lagen; auf nassen, mageren Böden tritt Obstbaumkrebs auf, an warmen, trockenen Standorten Mehltau.","belege":[{"quelle":"illustr_hb_4","band":"IV","seite":"131"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Landsberger_Renette&oldid=250533090"}]},{"thema":"verwendung","text":"Tafelapfel und für alle Zwecke im Haushalt gut brauchbar. Das Handbuch empfahl die Sorte wegen Wuchs und Ertrag ausdrücklich auch für den Anbau auf dem Land.","belege":[{"quelle":"illustr_hb_4","band":"IV","seite":"131"},{"quelle":"engelbrecht1889","seite":"543 (Nr. 490)"}]},{"thema":"unterscheidung","text":"Kleinere Früchte von älteren Hochstämmen ähneln nach dem Handbuch einem sehr großen Edlen Winterborsdorfer.","belege":[{"quelle":"illustr_hb_4","band":"IV","seite":"131"}]},{"thema":"frucht","text":"Nach den Erhebungen der National Fruit Collection: die Sorte bildet mittelgroße bis große, walzenförmige Früchte mit gelber Grundfarbe und orangefarbener Deckfarbe. Die Schale ist kaum berostet, das Fruchtfleisch weiß. Bei der Verkostung war das Fleisch sehr weich und mäßig saftig bis saftig, der Geschmack mäßig süß und mäßig bis deutlich sauer, mit schwachem Aroma. In der Sammlung als Tafelapfel geführt; pflückreif Ende September, lagerfähig bis Januar.","belege":[{"quelle":"nfc2025","seite":"Akzession 2000057"}]}],"bilder":[{"url":"https://archive.org/download/bub_gb_tR4EMgEACAAJ/page/n557_w800.jpg","seite":"https://archive.org/details/bub_gb_tR4EMgEACAAJ/page/n557","art":"schnitt","urheber":"Theodor Engelbrecht (Zeichnung), Albert Probst (Holzschnitt)","lizenz":"gemeinfrei","quelle":"engelbrecht1889","titel":"Längsschnitt-Umriss bei Engelbrecht 1889, S. 543 (ganze Buchseite)"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/d/d1/Landsberger_Reinette.jpg/960px-Landsberger_Reinette.jpg","seite":"https://commons.wikimedia.org/wiki/File:Landsberger_Reinette.jpg","art":"frucht","urheber":"Gordon Joly","lizenz":"CC BY-SA 2.0","quelle":"commons","titel":"Landsberger Reinette.jpg"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/c8/Landsberger_Renette_jm55222.jpg/960px-Landsberger_Renette_jm55222.jpg","seite":"https://commons.wikimedia.org/wiki/File:Landsberger_Renette_jm55222.jpg","art":"frucht","urheber":"joergens.mi","lizenz":"CC BY-SA 3.0","quelle":"commons","titel":"Landsberger Renette jm55222.jpg"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/76/Deutsche_Pomologie_-_Aepfel_-_038.jpg/960px-Deutsche_Pomologie_-_Aepfel_-_038.jpg","seite":"https://commons.wikimedia.org/wiki/File:Deutsche_Pomologie_-_Aepfel_-_038.jpg","art":"tafel","urheber":"Wilhelm Lauche (Deutsche Pomologie, 1882)","lizenz":"gemeinfrei","quelle":"lauche_dp1882","titel":"Deutsche Pomologie - Aepfel - 038.jpg (Landsberger Reinette)"},{"url":"https://upload.wikimedia.org/wikipedia/commons/7/73/Cross_section_of_Landsberger_Reinette%2C_National_Fruit_Collection_%28acc._2000-057%29.jpg","seite":"https://commons.wikimedia.org/wiki/File:Cross_section_of_Landsberger_Reinette,_National_Fruit_Collection_(acc._2000-057).jpg","art":"schnitt","urheber":"National Fruit Collection, Brogdale","lizenz":"OGL 2.0","quelle":"nfc-commons","titel":"Cross section of Landsberger Reinette, National Fruit Collection (acc. 2000-057)"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/f/fb/Apfel_098_Landsberger_Renette_%28fcm%29.jpg/960px-Apfel_098_Landsberger_Renette_%28fcm%29.jpg","seite":"https://commons.wikimedia.org/wiki/File:Apfel_098_Landsberger_Renette_(fcm).jpg","art":"frucht","urheber":"Photograph: Frank C. Müller , Frankfurt am Main","lizenz":"CC BY-SA 4.0","quelle":"commons-fotos","titel":"Apfel 098 Landsberger Renette (fcm)"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/7f/Apfel_099_Landsberger_Renette_%28fcm%29.jpg/960px-Apfel_099_Landsberger_Renette_%28fcm%29.jpg","seite":"https://commons.wikimedia.org/wiki/File:Apfel_099_Landsberger_Renette_(fcm).jpg","art":"frucht","urheber":"Photograph: Frank C. Müller , Frankfurt am Main","lizenz":"CC BY-SA 4.0","quelle":"commons-fotos","titel":"Apfel 099 Landsberger Renette (fcm)"},{"url":"https://upload.wikimedia.org/wikipedia/commons/f/fe/Apfelgalerie_Landsberger-Renette.jpg","seite":"https://commons.wikimedia.org/wiki/File:Apfelgalerie_Landsberger-Renette.jpg","art":"frucht","urheber":"Weltalf ( Diskussion )","lizenz":"CC BY-SA 3.0","quelle":"commons-fotos","titel":"Apfelgalerie Landsberger-Renette"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/b/bf/Korb_mit_Landsberger_Renette.jpg/960px-Korb_mit_Landsberger_Renette.jpg","seite":"https://commons.wikimedia.org/wiki/File:Korb_mit_Landsberger_Renette.jpg","art":"frucht","urheber":"Levin Holtkamp","lizenz":"CC BY-SA 4.0","quelle":"commons-fotos","titel":"Korb mit Landsberger Renette"},{"url":"https://upload.wikimedia.org/wikipedia/commons/a/a4/LandsbergerRenette073.JPG","seite":"https://commons.wikimedia.org/wiki/File:LandsbergerRenette073.JPG","art":"frucht","urheber":"Don Manfredo","lizenz":"CC BY-SA 3.0","quelle":"commons-fotos","titel":"LandsbergerRenette073"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/3/3c/Malus_Landsberger-Renette.jpg/960px-Malus_Landsberger-Renette.jpg","seite":"https://commons.wikimedia.org/wiki/File:Malus_Landsberger-Renette.jpg","art":"frucht","urheber":"User:MarkusHagenlocher","lizenz":"CC BY-SA 3.0","quelle":"commons-fotos","titel":"Malus Landsberger-Renette"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/84/Pomological_Watercolor_POM00002457.jpg/960px-Pomological_Watercolor_POM00002457.jpg","seite":"https://commons.wikimedia.org/wiki/File:Pomological_Watercolor_POM00002457.jpg","art":"tafel","urheber":"Schutt, Ellen Isham, 1873-1955","lizenz":"gemeinfrei","quelle":"usda-pomological","titel":"P