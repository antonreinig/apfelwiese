{"id":"herrgottsapfel","name":"Herrgottsapfel","synonyme":[{"name":"Kindsbacher Apfel","beleg":{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Herrgottsapfel&oldid=226812895"}},{"name":"Schragenapfel","beleg":{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Herrgottsapfel&oldid=226812895"}}],"herkunft":{"text":"Alte Sorte aus der Westpfalz, bereits 1539 im Kräuterbuch des Hieronymus Bock erwähnt. Schwerpunkt der heutigen Verbreitung ist die Gemeinde Kindsbach im Landkreis Kaiserslautern.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Herrgottsapfel&oldid=226812895"}],"land":"DE","landSicher":true,"ort":"Westpfalz (Kindsbach)","jahr":1539},"merkmale":[{"merkmal":"frucht_groesse","wert":"5","original":"Die rotgestreiften Äpfel sind mittelgroß","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Herrgottsapfel&oldid=226812895"},{"merkmal":"schale_deckfarbe_farbton","wert":"rot","original":"Die rotgestreiften Äpfel sind mittelgroß","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Herrgottsapfel&oldid=226812895"},{"merkmal":"schale_deckfarbe_art","wert":"gestreift","original":"Die rotgestreiften Äpfel sind mittelgroß","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Herrgottsapfel&oldid=226812895"},{"merkmal":"fleisch_festigkeit","wert":"3","original":"schmecken süß-säuerlich und sind besonders mürbe","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Herrgottsapfel&oldid=226812895"},{"merkmal":"geschmack_suesse","wert":"5","original":"schmecken süß-säuerlich und sind besonders mürbe","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Herrgottsapfel&oldid=226812895"},{"merkmal":"geschmack_saeure","wert":"5","original":"schmecken süß-säuerlich und sind besonders mürbe","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Herrgottsapfel&oldid=226812895"},{"merkmal":"pflueckreife","wert":"9","original":"können ab September geerntet werden","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Herrgottsapfel&oldid=226812895"},{"merkmal":"genussreife_beginn","wert":"10","original":"sind ab Oktober genussreif und bis in den November oder Dezember lagerfähig","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Herrgottsapfel&oldid=226812895"},{"merkmal":"genussreife_ende","wert":"11","original":"sind ab Oktober genussreif und bis in den November oder Dezember lagerfähig","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Herrgottsapfel&oldid=226812895"},{"merkmal":"genussreife_ende","wert":"12","original":"sind ab Oktober genussreif und bis in den November oder Dezember lagerfähig","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Herrgottsapfel&oldid=226812895"},{"merkmal":"verwendung","wert":"kueche","original":"eignen sich auch zur Zubereitung von Apfelmus, Saft oder als Kuchenbelag","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Herrgottsapfel&oldid=226812895"},{"merkmal":"verwendung","wert":"most","original":"eignen sich auch zur Zubereitung von Apfelmus, Saft oder als Kuchenbelag","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Herrgottsapfel&oldid=226812895"},{"merkmal":"baum_wuchs","wert":"7","original":"Die Sorte ist starkwüchsig","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Herrgottsapfel&oldid=226812895"},{"merkmal":"verwendung","wert":"tafel","original":"Neben dem Frischverzehr eignen sich die Früchte für Apfelmus, Saft und als Kuchenbelag","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Herrgottsapfel&oldid=226812895"},{"merkmal":"hochstamm","wert":"gut","original":"als Hochstamm für neue Obstwiesen empfohlen","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Herrgottsapfel&oldid=226812895"},{"merkmal":"standort_klima","wert":"3","original":"Sie eignet sich für mittlere Lagen und Höhenlagen","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Herrgottsapfel&oldid=226812895"},{"merkmal":"lagerfaehigkeit","wert":"5","original":"halten bis November oder Dezember","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Herrgottsapfel&oldid=226812895"}],"texte":[{"thema":"ueberblick","text":"Mittelgroßer, rot gestreifter Apfel aus der Westpfalz, genussreif ab Oktober, mit süß-säuerlichem, besonders mürbem Fleisch. Etwa zwei Dutzend Altbäume sind erhalten, vor allem in Hausgärten. 2004 war er „Pfälzischer Obstbaum des Jahres“.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Herrgottsapfel&oldid=226812895"}]},{"thema":"herkunft","text":"Die Sorte wird schon 1539 im Kräuterbuch des Hieronymus Bock genannt. Heute liegt der Schwerpunkt ihrer Verbreitung in Kindsbach im Landkreis Kaiserslautern, daher auch der Name Kindsbacher Apfel. In den alten pomologischen Werken des 19. Jahrhunderts (Illustrirtes Handbuch, Lauche, Engelbrecht) ist sie unter keinem ihrer Namen beschrieben.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Herrgottsapfel&oldid=226812895"}]},{"thema":"fleisch_geschmack","text":"Das Fleisch ist besonders mürbe und schmeckt süß-säuerlich. Früher fütterte man Kleinkinder mit dem ausgelöffelten Fruchtfleisch.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Herrgottsapfel&oldid=226812895"}]},{"thema":"reife_lagerung","text":"Geerntet wird ab September, genussreif sind die Früchte ab Oktober und halten bis November oder Dezember. Sie sind transportempfindlich.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Herrgottsapfel&oldid=226812895"}]},{"thema":"baum","text":"Die Sorte wächst stark und wird deshalb als Hochstamm für neue Obstwiesen empfohlen; als Buschbaum passt sie auch in kleinere Gärten. Sie eignet sich für mittlere Lagen und Höhenlagen.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Herrgottsapfel&oldid=226812895"}]},{"thema":"verwendung","text":"Neben dem Frischverzehr eignen sich die Früchte für Apfelmus, Saft und als Kuchenbelag.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Herrgottsapfel&oldid=226812895"}]}],"bilder":[],"regionen":[{"region":"DE-RP","art":"herkunft","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Herrgottsapfel&oldid=226812895"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Herrgottsapfel&oldid=226812895"}]},{"region":"DE-RP","art":"verbreitung","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Herrgottsapfel&oldid=226812895"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Herrgottsapfel&oldid=226812895"}],"original":"Schwerpunkt der heutigen Verbreitung ist die Gemeinde Kindsbach"},{"region":"DE-RP","art":"regionalsorte","belege":[{"quelle":"rg_pv-obstsorte-des-jahres","seite":"Pfälzer Obstbaum des Jahres 2004"},{"quelle":"rg_sl-vgb-kartierung","seite":"Lokalsorte der Westpfalz"}],"original":"Herrgottsapfel"},{"region":"DE-RP","art":"empfehlung","belege":[{"quelle":"rg_rp-streuobst-sortenempfehlung-2018"}],"original":"Herrgottsapfel"}],"gefaehrdung":[{"stufe":"Rote Liste der gefährdeten einheimischen Nutzpflanzen in Deutschland","belege":[{"quelle":"rg_ble-rote-liste"}],"original":"Herrgottsapfel"}]}