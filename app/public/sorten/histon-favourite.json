itt","urheber":"National Fruit Collection, Brogdale","lizenz":"OGL 2.0","quelle":"nfc-commons","titel":"Cross section of Histon Favourite, National Fruit Collection (acc. 1953-050)"},{"url":"https://upload.wikimedia.org/wikipedia/commons/2/2a/Histon_Favourite_on_tree%2C_National_Fruit_Collection_%28acc._1953-050%29.jpg","seite":"https://commons.wikimedia.org/wiki/File:Histon_Favourite_on_tree,_National_Fruit_Collection_(acc._1953-050).jpg","art":"baum","urheber":"National Fruit Collection, Brogdale","lizenz":"OGL 2.0","quelle":"nfc-commons","titel":"Histon Favourite on tree, National Fruit Collection (acc. 1953-050)"}],"farbmessung":[{"bild":"https://upload.wikimedia.org/wikipedia/commons/4/49/Cross_section_of_Histon_Favourite%2C_National_Fruit_Collection_%28acc._1953-050%29.jpg","methode":"NFC-Foto","verfahren":"Foto (NFC-Fototafel: 4 ganze Früchte, 2 Schnitte, Fototisch); Weißabgleich über den Hintergrund; Frucht per Hintergrundmodell freigestellt; Schalenpixel ohne Glanzlichter einzeln klassifiziert: Grundfarbe aus gelbgrünen Pixeln, Deckfarbe = Pixel mit deutlich höherem a* als die Grundfarbe (auch dunkle Rot- und Braunrottöne), Anteile über Pixel; Höhe/Breite aus dem Längsschnitt","grundfarbe":"#c2be4c","deckfarbe":"#c46650","deckfarbeAnteil":0.43,"fleischfarbe":"#f7f1e3","hoeheZuBreite":0.837}],"bildabgleich":{"bild":"https://upload.wikimedia.org/wikipedia/commons/4/49/Cross_section_of_Histon_Favourite%2C_National_Fruit_Collection_%28acc._1953-050%29.jpg","seite":"https://commons.wikimedia.org/wiki/File:Cross_section_of_Histon_Favourite,_National_Fruit_Collection_(acc._1953-050).jpg","verfahren":"Umriss der NFC-Seitenansichten gegen den Modellumriss (Rastersuche über Höhe/Breite, Kegel- und Walzenform), Lage am Stielrest erkannt, Rippung aus der Stielansicht; Version 3","werte":{"hoeheZuBreite":0.84,"konisch":0.04,"walze":0,"rippung":0,"unregelmaessig":0.19},"guete":0.0126}}