{"id":"dithmarscher-paradiesapfel","name":"Dithmarscher Paradiesapfel","synonyme":[{"name":"Weißer Paradiesapfel","beleg":{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Dithmarscher_Paradiesapfel&oldid=240142589"}}],"herkunft":{"text":"Aus Dithmarschen (Schleswig-Holstein), 1859 erstmals vorgestellt; vermutlich aus einer Kreuzung von Prinzenapfel und einem Taubenapfel hervorgegangen.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Dithmarscher_Paradiesapfel&oldid=240142589"}],"land":"DE","landSicher":true,"ort":"Dithmarschen","jahr":1859},"merkmale":[{"merkmal":"frucht_groesse","wert":"5","original":"Die Früchte sind mittelgroß und schwach gerippt","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Dithmarscher_Paradiesapfel&oldid=240142589"},{"merkmal":"frucht_rippung","wert":"3","original":"Die Früchte sind mittelgroß und schwach gerippt","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Dithmarscher_Paradiesapfel&oldid=240142589"},{"merkmal":"frucht_symmetrie","wert":"schief","original":"wobei eine Seite oft abgeflacht ist","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Dithmarscher_Paradiesapfel&oldid=240142589"},{"merkmal":"schale_grundfarbe","wert":"weisslichgelb","original":"Die Schale ist gelblichweiß","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Dithmarscher_Paradiesapfel&oldid=240142589"},{"merkmal":"schale_deckfarbe_anteil","wert":"5","original":"auf der Sonnenseite oft mit rötlichen Streifen","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Dithmarscher_Paradiesapfel&oldid=240142589"},{"merkmal":"schale_deckfarbe_art","wert":"gestreift","original":"auf der Sonnenseite oft mit rötlichen Streifen","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Dithmarscher_Paradiesapfel&oldid=240142589"},{"merkmal":"fleisch_farbe","wert":"weiss","original":"Das Fruchtfleisch ist weiß und mäßig saftig","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Dithmarscher_Paradiesapfel&oldid=240142589"},{"merkmal":"fleisch_saftigkeit","wert":"5","original":"Das Fruchtfleisch ist weiß und mäßig saftig","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Dithmarscher_Paradiesapfel&oldid=240142589"},{"merkmal":"geschmack_saeure","wert":"3","original":"fein gewürzt mit wenig Säure","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Dithmarscher_Paradiesapfel&oldid=240142589"},{"merkmal":"geschmack_aroma","wert":"fein gewürzt","original":"fein gewürzt mit wenig Säure","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Dithmarscher_Paradiesapfel&oldid=240142589"},{"merkmal":"pflueckreife","wert":"9","original":"Pflück- und genussreif ist die Sorte ab September","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Dithmarscher_Paradiesapfel&oldid=240142589"},{"merkmal":"genussreife_beginn","wert":"9","original":"Pflück- und genussreif ist die Sorte ab September","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Dithmarscher_Paradiesapfel&oldid=240142589"},{"merkmal":"verwendung","wert":"tafel","original":"ist eine alte Tafelapfelsorte","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Dithmarscher_Paradiesapfel&oldid=240142589"},{"merkmal":"baum_wuchs","wert":"7","original":"Der Baum ist starkwüchsig","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Dithmarscher_Paradiesapfel&oldid=240142589"},{"merkmal":"gesundheit","wert":"7","original":"ist relativ wenig anfällig für Krankheiten","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Dithmarscher_Paradiesapfel&oldid=240142589"},{"merkmal":"ertrag_beginn","wert":"frueh","original":"ist relativ wenig anfällig für Krankheiten und trägt früh","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Dithmarscher_Paradiesapfel&oldid=240142589"},{"merkmal":"ertrag_alternanz","wert":"alternierend","original":"Nachteile sind zweijährige Alternanz","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Dithmarscher_Paradiesapfel&oldid=240142589"},{"merkmal":"standort_klima","wert":"3","original":"eignet sich die Sorte vor allem für Küstenklima und Mittelgebirgslagen","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Dithmarscher_Paradiesapfel&oldid=240142589"},{"merkmal":"lagerfaehigkeit","wert":"3","original":"Bei längerer Lagerung verliert der Apfel sein Aroma","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Dithmarscher_Paradiesapfel&oldid=240142589"}],"texte":[{"thema":"ueberblick","text":"Der Dithmarscher Paradiesapfel, auch Weißer Paradiesapfel, ist ein alter norddeutscher Herbst-Tafelapfel mit gelblichweißer, sonnenseits rötlich gestreifter Schale und weißem, fein gewürztem Fleisch. 2019 wurde er Streuobstsorte des Jahres in Norddeutschland.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Dithmarscher_Paradiesapfel&oldid=240142589"}]},{"thema":"herkunft","text":"Die Sorte stammt aus Dithmarschen und wurde 1859 erstmals vorgestellt; vermutet wird eine Kreuzung aus Prinzenapfel und einem Taubenapfel. Früher war sie in Schleswig-Holstein und Hamburg verbreitet, wo noch viele alte Bäume stehen. Seit 1995 wird sie wieder häufiger in Privatgärten gepflanzt.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Dithmarscher_Paradiesapfel&oldid=240142589"}]},{"thema":"frucht","text":"Die Früchte sind mittelgroß und schwach gerippt; eine Seite ist oft abgeflacht. Die Schale ist gelblichweiß, auf der Sonnenseite oft rötlich gestreift.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Dithmarscher_Paradiesapfel&oldid=240142589"}]},{"thema":"fleisch_geschmack","text":"Das Fruchtfleisch ist weiß und mäßig saftig, der Geschmack fein gewürzt mit wenig Säure.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Dithmarscher_Paradiesapfel&oldid=240142589"}]},{"thema":"reife_lagerung","text":"Pflück- und genussreif ab September. Bei längerer Lagerung verliert der Apfel sein Aroma.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Dithmarscher_Paradiesapfel&oldid=240142589"}]},{"thema":"baum","text":"Der Baum wächst stark, ist relativ wenig anfällig für Krankheiten und trägt früh. Nachteile sind zweijährige Alternanz und Neigung zum Vorerntefruchtfall. Weil zu heiße Sommer das Aroma beeinträchtigen, eignet sich die Sorte vor allem für Küstenklima und Mittelgebirgslagen.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Dithmarscher_Paradiesapfel&oldid=240142589"}]}],"bilder":[{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/78/Dithmarscher_Paradies.jpg/960px-Dithmarscher_Paradies.jpg","seite":"https://commons.wikimedia.org/wiki/File:Dithmarscher_Paradies.jpg","art":"frucht","urheber":"Bahnmoeller","lizenz":"CC BY-SA 3.0","quelle":"commons","titel":"Dithmarscher Paradies.jpg"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/a/a1/Dithmarscher_Paradiesapfel.jpg/960px-Dithmarscher_Paradiesapfel.jpg","seite":"https://commons.wikimedia.org/wiki/File:Dithmarscher_Paradiesapfel.jpg","art":"frucht","urheber":"Hinnerk11","lizenz":"CC BY-SA 4.0","quelle":"commons-fotos","titel":"Dithmarscher Paradiesapfel"}],"regionen":[{"region":"DE-SH","art":"herkunft","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Dithmarscher_Paradiesapfel&oldid=240142589"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Dithmarscher_Paradiesapfel&oldid=240142589"},{"quelle":"rg_shhh-pv-sortenempfehlung","seite":"Spalte Herkunft"}]},{"region":"DE-SH","art":"verbreitung","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Dithmarscher_Paradiesapfel&oldid=240142589"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Dithmarscher_Paradiesapfel&oldid=240142589"},{"quelle":"rg_shhh-pv-sortenempfehlung","seite":"Spalte Herkunft"}],"original":"Früher war sie in Schleswig-Holstein und Hamburg verbreitet"},{"region":"DE-HH","art":"verbreitung","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Dithmarscher_Paradiesapfel&oldid=240142589"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Dithmarscher_Paradiesapfel&oldid=240142589"},{"quelle":"rg_shhh-pv-sortenempfehlung","seite":"Spalte Herkunft"}],"original":"Früher war sie in Schleswig-Holstein und Hamburg verbreitet"},{"region":"DE-SH","art":"empfehlung","belege":[{"quelle":"rg_shhh-pv-sortenempfehlung"},{"quelle":"rg_sh-bund-leitfaden-2019","seite":"S. 16–17"}],"original":"Dithmarscher Paradiesapfel"},{"region":"DE-HH","art":"empfehlung","belege":[{"quelle":"rg_shhh-pv-sortenempfehlung"}],"original":"Dithmarscher Paradiesapfel"}],"gefaehrdung":[{"stufe":"Rote Liste der gefährdeten einheimischen Nutzpflanzen in Deutschland","belege":[{"quelle":"rg_ble-rote-liste"}],"original":"Dithmarscher Paradiesapfel"}]}