{"id":"weisser-matapfel","name":"Weißer Matapfel","synonyme":[{"name":"Weisser Matapfel","beleg":{"quelle":"engelbrecht1889","seite":"691 (Nr. 623)"}},{"name":"Würzapfel","beleg":{"quelle":"illustr_hb_1","band":"I","seite":"369"}},{"name":"Würz-Apfel","beleg":{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Weißer_Matapfel&oldid=200197315"}},{"name":"Weißer Würzapfel","beleg":{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Weißer_Matapfel&oldid=200197315"}},{"name":"Tiefbutzen","beleg":{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Weißer_Matapfel&oldid=200197315"}},{"name":"Stielapfel","beleg":{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Weißer_Matapfel&oldid=200197315"}},{"name":"Cromelor","beleg":{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Weißer_Matapfel&oldid=200197315"}},{"name":"Spätblühender Matapfel","beleg":{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Weißer_Matapfel&oldid=200197315"}}],"herkunft":{"text":"Zufallssämling aus Süddeutschland, nach Wikipedia um 1810 entstanden. Das Handbuch (1859) hielt ihn für wahrscheinlich am Rhein heimisch und nennt ihn häufig am Rhein bei Koblenz, in Nassau, in der Wetterau, an der Bergstraße, in der Pfalz, im Lahntal, am Main und in Franken; als frühe Literatur nennt es Diel und den Teutschen Obstgärtner von 1797.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Weißer_Matapfel&oldid=200197315"},{"quelle":"illustr_hb_1","band":"I","seite":"369"}]},"merkmale":[{"merkmal":"frucht_breite","wert":66,"original":"Gestalt 66:55—58 (65:50—52, Illustr. Handb.)","quelle":"engelbrecht1889","seite":"691 (Nr. 623)"},{"merkmal":"frucht_hoehe","wert":56.5,"original":"Gestalt 66:55—58","quelle":"engelbrecht1889","seite":"691 (Nr. 623)"},{"merkmal":"frucht_hoehe_breite","wert":0.86,"original":"Gestalt 66:55—58","quelle":"engelbrecht1889","seite":"691 (Nr. 623)"},{"merkmal":"frucht_form","wert":"rund","original":"stark abgestumpft rundlich, wenig stielbauchig","quelle":"engelbrecht1889","seite":"691 (Nr. 623)"},{"merkmal":"frucht_breiteste_stelle","wert":"stiel","original":"wenig stielbauchig","quelle":"engelbrecht1889","seite":"691 (Nr. 623)"},{"merkmal":"frucht_symmetrie","wert":"symmetrisch","original":"Hälften meistens fast gleich","quelle":"engelbrecht1889","seite":"691 (Nr. 623)"},{"merkmal":"frucht_rippung","wert":"3","original":"Querschn. ziemlich rund","quelle":"engelbrecht1889","seite":"691 (Nr. 623)"},{"merkmal":"frucht_kronung","wert":"5","original":"Einsenk. … zwischen breiten, zum Theil flach zum Bauche laufenden Falten","quelle":"engelbrecht1889","seite":"691 (Nr. 623)"},{"merkmal":"kelch_offenheit","wert":"offen","original":"Kelch offen, gross, meist grün, wollig","quelle":"engelbrecht1889","seite":"691 (Nr. 623)"},{"merkmal":"kelchgrube_tiefe","wert":"5","original":"Einsenk. mitteltief, weit","quelle":"engelbrecht1889","seite":"691 (Nr. 623)"},{"merkmal":"kelchgrube_weite","wert":"7","original":"Einsenk. mitteltief, weit","quelle":"engelbrecht1889","seite":"691 (Nr. 623)"},{"merkmal":"stiel_dicke","wert":"5","original":"Stiel holzig oder etwas fleischig, mitteldick bis dick, etwa 6 mm lang","quelle":"engelbrecht1889","seite":"691 (Nr. 623)"},{"merkmal":"stiel_dicke","wert":"7","original":"mitteldick bis dick","quelle":"engelbrecht1889","seite":"691 (Nr. 623)"},{"merkmal":"stielgrube_tiefe","wert":"7","original":"Höhle ziemlich tief, mittelweit, eben, hellbraun berostet","quelle":"engelbrecht1889","seite":"691 (Nr. 623)"},{"merkmal":"stielgrube_weite","wert":"5","original":"Höhle ziemlich tief, mittelweit","quelle":"engelbrecht1889","seite":"691 (Nr. 623)"},{"merkmal":"schale_berostung_stielgrube","wert":"5","original":"Höhle … hellbraun berostet","quelle":"engelbrecht1889","seite":"691 (Nr. 623)"},{"merkmal":"schale_beschaffenheit","wert":"glatt","original":"Schale glatt, beduftet, fast etwas geschmeidig, glänzend","quelle":"engelbrecht1889","seite":"691 (Nr. 623)"},{"merkmal":"schale_beschaffenheit","wert":"bereift","original":"Schale glatt, beduftet","quelle":"engelbrecht1889","seite":"691 (Nr. 623)"},{"merkmal":"schale_beschaffenheit","wert":"glaenzend","original":"fast etwas geschmeidig, glänzend","quelle":"engelbrecht1889","seite":"691 (Nr. 623)"},{"merkmal":"schale_grundfarbe","wert":"gruengelb","original":"hellgrün, später grünlichgelb bis gelb","quelle":"engelbrecht1889","seite":"691 (Nr. 623)"},{"merkmal":"schale_grundfarbe","wert":"gelb","original":"hellgrün, später grünlichgelb bis gelb","quelle":"engelbrecht1889","seite":"691 (Nr. 623)"},{"merkmal":"schale_deckfarbe_anteil","wert":"5","original":"sonnenw. mehr oder weniger lebhaft geröthet","quelle":"engelbrecht1889","seite":"691 (Nr. 623)"},{"merkmal":"schale_deckfarbe_farbton","wert":"hellrot","original":"mehr oder weniger lebhaft geröthet","quelle":"engelbrecht1889","seite":"691 (Nr. 623)"},{"merkmal":"schale_deckfarbe_art","wert":"gestreift","original":"deutlich, oft stark dunkler gestreift","quelle":"engelbrecht1889","seite":"691 (Nr. 623)"},{"merkmal":"schale_lentizellen_anzahl","wert":"5","original":"Punkte mittelzahlreich, fein, oft etwas fühlbar, braun, etwas hell umflossen","quelle":"engelbrecht1889","seite":"691 (Nr. 623)"},{"merkmal":"schale_lentizellen_groesse","wert":"3","original":"Punkte mittelzahlreich, fein","quelle":"engelbrecht1889","seite":"691 (Nr. 623)"},{"merkmal":"schale_lentizellen_art","wert":"braun","original":"Punkte … braun, etwas hell umflossen","quelle":"engelbrecht1889","seite":"691 (Nr. 623)"},{"merkmal":"schale_berostung_wangen","wert":"3","original":"Anflüge von Rost nicht häufig","quelle":"engelbrecht1889","seite":"691 (Nr. 623)"},{"merkmal":"kernhaus_form","wert":"zwiebel","original":"Kernhaus 38:31, zwiebelförm.","quelle":"engelbrecht1889","seite":"691 (Nr. 623)"},{"merkmal":"kernfaecher_oeffnung","wert":"geschlossen","original":"Kammern