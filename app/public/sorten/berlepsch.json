","urheber":"Bahnmoeller","lizenz":"CC BY-SA 3.0","quelle":"commons-fotos","titel":"Goldrenette Freiherr v Berlepsch 2"},{"url":"https://upload.wikimedia.org/wikipedia/commons/2/27/Goldrenette_Freiherr_von_Berlepsch.jpg","seite":"https://commons.wikimedia.org/wiki/File:Goldrenette_Freiherr_von_Berlepsch.jpg","art":"frucht","urheber":"Eduard Lucas, Johann Georg Conrad Oberdieck","lizenz":"gemeinfrei","quelle":"commons-fotos","titel":"Goldrenette Freiherr von Berlepsch"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/b/b5/Malus_Goldrenette_F._v._Berlepsch.jpg/960px-Malus_Goldrenette_F._v._Berlepsch.jpg","seite":"https://commons.wikimedia.org/wiki/File:Malus_Goldrenette_F._v._Berlepsch.jpg","art":"frucht","urheber":"Sven Teschke","lizenz":"CC BY-SA 2.0 DE","quelle":"commons-fotos","titel":"Malus Goldrenette F. v. Berlepsch"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/7a/Pommes_Berlepsch_rouges.jpg/960px-Pommes_Berlepsch_rouges.jpg","seite":"https://commons.wikimedia.org/wiki/File:Pommes_Berlepsch_rouges.jpg","art":"frucht","urheber":"DesClics","lizenz":"CC BY-SA 4.0","quelle":"commons-fotos","titel":"Pommes Berlepsch rouges"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/9e/Freiherr_von_Berlepsch_jm55173.jpg/960px-Freiherr_von_Berlepsch_jm55173.jpg","seite":"https://commons.wikimedia.org/wiki/File:Freiherr_von_Berlepsch_jm55173.jpg","art":"baum","urheber":"joergens.mi","lizenz":"CC BY-SA 3.0","quelle":"commons-fotos","titel":"Freiherr von Berlepsch jm55173"}],"munq":49,"akzessionen":[{"sammlung":"UK National Fruit Collection (Brogdale)","nummer":"1947084","name":"Freiherr von Berlepsch"}],"farbmessung":[{"bild":"https://upload.wikimedia.org/wikipedia/commons/c/c2/Cross_section_of_Freiherr_von_Berlepsch%2C_National_Fruit_Collection_%28acc._1947-084%29.jpg","methode":"NFC-Foto","verfahren":"Foto (NFC-Fototafel: 4 ganze Früchte, 2 Schnitte, Fototisch); Weißabgleich über den Hintergrund; Frucht per Hintergrundmodell freigestellt; Schalenpixel ohne Glanzlichter einzeln klassifiziert: Grundfarbe aus gelbgrünen Pixeln, Deckfarbe = Pixel mit deutlich höherem a* als die Grundfarbe (auch dunkle Rot- und Braunrottöne), Anteile über Pixel; Höhe/Breite aus dem Längsschnitt","grundfarbe":"#d1ae43","deckfarbe":"#c44941","deckfarbeAnteil":0.55,"fleischfarbe":"#eadac6","hoeheZuBreite":0.855}]}