{"id":"jakob-lebel","name":"Jakob Lebel","synonyme":[{"name":"Jacob Lebel","beleg":{"quelle":"engelbrecht1889","seite":"292 (Nr. 260)"}},{"name":"Jacques Lebel","beleg":{"quelle":"engelbrecht1889","seite":"292 (Nr. 260)"}},{"name":"Gelber Mecklenburger","beleg":{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Jakob_Lebel&oldid=252548747"}},{"name":"Eisenbahner","beleg":{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Jakob_Lebel&oldid=252548747"}}],"herkunft":{"text":"Zufallssämling, um 1825 in Amiens (Frankreich) von Jacques Lebel gefunden und nach ihm benannt; ab 1849 von der Baumschule Leroy verbreitet. Schon das Illustrirte Handbuch nennt nach Leroys Katalog Amiens und Lebel als Herkunft.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Jakob_Lebel&oldid=252548747"},{"quelle":"illustr_hb_4","band":"IV","seite":"257"}],"land":"FR","landSicher":true,"ort":"Amiens","jahr":1825},"merkmale":[{"merkmal":"frucht_breite","wert":77,"original":"Gestalt 77:57—61, häufig grösser","quelle":"engelbrecht1889","seite":"292 (Nr. 260)"},{"merkmal":"frucht_hoehe","wert":59,"original":"Gestalt 77:57—61, häufig grösser","quelle":"engelbrecht1889","seite":"292 (Nr. 260)"},{"merkmal":"frucht_hoehe_breite","wert":0.77,"original":"Gestalt 77:57—61","quelle":"engelbrecht1889","seite":"292 (Nr. 260)"},{"merkmal":"frucht_form","wert":"flachrund","original":"flachrund, meistens mittelbauch.","quelle":"engelbrecht1889","seite":"292 (Nr. 260)"},{"merkmal":"frucht_form","wert":"flachrund","original":"sehr flach gedrückt","quelle":"illustr_hb_4","band":"IV","seite":"257"},{"merkmal":"frucht_breiteste_stelle","wert":"mitte","original":"meistens mittelbauch.","quelle":"engelbrecht1889","seite":"292 (Nr. 260)"},{"merkmal":"frucht_symmetrie","wert":"schief","original":"Hälften bei grossen Früchten sehr, bei kleinen Früchten etwas ungleich","quelle":"engelbrecht1889","seite":"292 (Nr. 260)"},{"merkmal":"kelch_of