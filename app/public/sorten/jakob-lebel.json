:"292 (Nr. 260)"},{"merkmal":"genussreife_ende","wert":"1","original":"Ende Octob. bis Januar","quelle":"engelbrecht1889","seite":"292 (Nr. 260)"},{"merkmal":"baum_wuchs","wert":"7","original":"Der Baum wächst stark","quelle":"illustr_hb_4","band":"IV","seite":"257"},{"merkmal":"ploidie","wert":"triploid","original":"Da diese Sorte triploid ist, ist sie als Befruchter nicht geeignet","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Jakob_Lebel&oldid=252548747"},{"merkmal":"kernhaus_breite_mm","wert":35,"original":"Kernhaus 35:35","quelle":"engelbrecht1889","seite":"292 (Nr. 260)"},{"merkmal":"kernhaus_hoehe_mm","wert":35,"original":"Kernhaus 35:35","quelle":"engelbrecht1889","seite":"292 (Nr. 260)"},{"merkmal":"kernfach_breite_mm","wert":11,"original":"Kammern 11:17","quelle":"engelbrecht1889","seite":"292 (Nr. 260)"},{"merkmal":"kernfach_hoehe_mm","wert":17,"original":"Kammern 11:17","quelle":"engelbrecht1889","seite":"292 (Nr. 260)"},{"merkmal":"frucht_breite","wert":82,"quelle":"nfc2025","seite":"Akzession 1949110 (Smith 1971)"},{"merkmal":"frucht_hoehe","wert":63,"quelle":"nfc2025","seite":"Akzession 1949110 (Smith 1971)"},{"merkmal":"frucht_groesse","wert":"7","quelle":"nfc2025","seite":"Akzession 1949110 (Smith 1971)","original":"Large"},{"merkmal":"frucht_form","wert":"breitrundkonisch","quelle":"nfc2025","seite":"Akzession 1949110 (Smith 1971)","original":"Broad globose conical"},{"merkmal":"frucht_hoehe_breite","wert":0.768,"quelle":"nfc2025","seite":"Akzession 1949110 (Smith 1971)"},{"merkmal":"frucht_rippung","wert":"1","quelle":"nfc2025","seite":"Akzession 1949110 (Smith 1971)","original":"Very light"},{"merkmal":"schale_grundfarbe","wert":"gruengelb","quelle":"nfc2025","seite":"Akzession 1949110 (Smith 1971)","original":"Green yellow"},{"merkmal":"schale_deckfarbe_anteil","wert":"3","quelle":"nfc2025","seite":"Akzession 1949110 (Smith 1971)","original":"Low"},{"merkmal":"schale_deckfarbe_farbton","wert":"orange","quelle":"nfc2025","seite":"Akzession 1949110 (Smith 1971)","original":"Orange"},{"merkmal":"schale_deckfarbe_art","wert":"gestreift","quelle":"nfc2025","seite":"Akzession 1949110 (Smith 1971)","original":"Only stripes"},{"merkmal":"fleisch_farbe","wert":"gruenlich","quelle":"nfc2025","seite":"Akzession 1949110 (Smith 1971)","original":"Greenish"},{"merkmal":"verwendung","wert":"kueche","quelle":"nfc2025","seite":"Akzession 1949110","original":"Culinary"},{"merkmal":"pflueckreife","wert":"9","quelle":"nfc2025","seite":"Akzession 1949110","original":"Early September"},{"merkmal":"genussreife_ende","wert":"12","quelle":"nfc2025","seite":"Akzession 1949110","original":"December"},{"merkmal":"bluete_zeit","wert":"5","quelle":"nfc2025","seite":"Akzession 1949110","original":"Klasse 5 (10 % der Blüten offen, Tag 126)"},{"merkmal":"ploidie","wert":"triploid","quelle":"nfc2025","seite":"Akzession 1949110","original":"Akzessionsname \"Jacques Lebel (3n)\""},{"merkmal":"standort_boden","wert":"3","original":"Er stellt geringe Ansprüche an den Boden","quelle":"illustr_hb_4","band":"IV","seite":"257","belege":[{"quelle":"illustr_hb_4","band":"IV","seite":"257"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Jakob_Lebel&oldid=252548747"}]},{"merkmal":"standort_klima","wert":"3","original":"eignet sich für höhere Lagen","quelle":"illustr_hb_4","band":"IV","seite":"257","belege":[{"quelle":"illustr_hb_4","band":"IV","seite":"257"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Jakob_Lebel&oldid=252548747"}]},{"merkmal":"anfaelligkeit_schorf","wert":"7","original":"sie ist anfällig für Schorf und Stippe","quelle":"illustr_hb_4","band":"IV","seite":"257","belege":[{"quelle":"illustr_hb_4","band":"IV","seite":"257"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Jakob_Lebel&oldid=252548747"}]},{"merkmal":"lagerfaehigkeit","wert":"5","original":"Engelbrecht gibt als Genussreife Ende Oktober bis Januar an","quelle":"engelbrecht1889","seite":"292 (Nr. 260)"},{"merkmal":"lagerfaehigkeit","wert":"3","original":"Ohne Kühllager halten die Früchte bis November","quelle":"engelbrecht1889","seite":"292 (Nr. 260)","belege":[{"quelle":"engelbrecht1889","seite":"292 (Nr. 260)"},{"quelle":"illustr_hb_4","band":"IV","seite":"257"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Jakob_Lebel&oldid=252548747"}]}],"texte":[{"thema":"ueberblick","text":"Französische Sorte aus Amiens, die schon im 19. Jahrhundert in Deutschland angebaut wurde. In den 1920er-Jahren gehörte Jakob Lebel zu den drei zu Reichsobstsorten gewählten Apfelsorten. Der große, flache Herbstapfel dient vor allem in der Küche und zum Mosten; Engelbrecht bewertete ihn 1889 als brauchbare Tafel- und sehr gute Haushaltsfrucht.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Jakob_Lebel&oldid=252548747"},{"quelle":"engelbrecht1889","seite":"292 (Nr. 260)"}]},{"thema":"herkunft","text":"Nach Wikipedia fand Jacques Lebel den Sämling um 1825 in Amiens; die Baumschule Leroy brachte die Sorte ab 1849 in den Handel. Oberdieck erhielt sein Reis von der Société van Mons und bezog sich für die Herkunft auf Leroys Katalog. In Rheinland-Pfalz ist die Sorte seit 1902 verzeichnet. Um 1900 entstand aus Jakob Lebel und Ontario die Sorte Edler von Leipzig.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Jakob_Lebel&oldid=252548747"},{"quelle":"illustr_hb_4","band":"IV","seite":"257"}]},{"thema":"frucht","text":"Engelbrecht maß 77 mm Breite und 57 bis 61 mm Höhe, häufig auch größere Früchte; Leroy gibt bis 108 mm Breite an. Die Frucht ist flachrund mit dem breitesten Teil meist in der Mitte; bei großen Früchten sind die Hälften stark ungleich. Breite, flache Rippen ziehen ungleich über die Frucht, sodass der Querschnitt nicht ganz rund ist. Der geschlossene oder wenig offene Kelch sitzt in einer ziemlich flachen, weiten Grube, die nach dem Handbuch von unregelmäßigen Fleischperlen und Beulen umgeben ist. Der Stiel ist dick und sehr kurz (oft nur 5 mm).","belege":[{"quelle":"engelbrecht1889","seite":"292 (Nr. 260)"},{"quelle":"illustr_hb_4","band":"IV","seite":"257"}]},{"thema":"schale","text":"Die geschmeidige, glänzende Schale ist anfangs hell grünlichgelb und wird später hellgelb. Die Sonnenseite ist etwas goldiger oder schwach rot angehaucht und trägt spärliche, manchmal kaum erkennbare dunklere Streifen; Oberdieck sah die Streifen im Hannoverschen nur an stark besonnten Früchten. Die Schalenpunkte sind vereinzelt und sehr fein, Rostanflüge selten. Die Stielgrube ist weit und rau, nach dem Handbuch strahlig berostet; Engelbrecht nennt sie mäßig tief, Oberdieck flach. Auf dem Lager wird die Schale fettig.","belege":[{"quelle":"engelbrecht1889","seite":"292 (Nr. 260)"},{"quelle":"illustr_hb_4","band":"IV","seite":"257"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Jakob_Lebel&oldid=252548747"}]},{"thema":"schnitt","text":"Das Kernhaus ist eizwiebelförmig und etwa so hoch wie breit (35:35 mm). Die fast glattwandigen, mäßig geräumigen Kammern sind stielwärts spitz, kelchwärts abgerundet und nicht oder nur wenig offen. Engelbrecht beschreibt die Achsenhöhle als schmal, das Handbuch das Kernhaus als geschlossen oder mit nur ganz kleiner hohler Achse. Je Kammer liegen ein bis zwei kaum mittelgroße, länglich eiförmige, lang gespitzte, kaffeebraune Kerne, oft unvollkommen. Die Kelchhöhle ist kegel- bis kegeltrichterförmig und reicht ein Drittel bis zwei Fünftel des Weges zur Achsenhöhle; das Handbuch nennt die Kelchröhre sehr breit und oft trichterförmig. Das Fleisch ist am Schnitt hell gelblichweiß.","belege":[{"quelle":"engelbrecht1889","seite":"292 (Nr. 260)"},{"quelle":"illustr_hb_4","band":"IV","seite":"257"}]},{"thema":"fleisch_geschmack","text":"Das Fleisch ist ziemlich fein, markig und saftig. Engelbrecht fand kaum Gewürz, eine angenehme, etwas vorherrschende Säure und ziemlich viel Süße; das Handbuch spricht von edlem, weinartigem Zuckergeschmack. Nach Wikipedia ist das Fleisch säuerlich und mürbe.","belege":[{"quelle":"engelbrecht1889","seite":"292 (Nr. 260)"},{"quelle":"illustr_hb_4","band":"IV","seite":"257"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Jakob_Lebel&oldid=252548747"}]},{"thema":"reife_lagerung","text":"Engelbrecht gibt als Genussreife Ende Oktober bis Januar an; Oberdieck fand die Früchte in manchen Jahren schon Ende September mürbe und setzte die gewöhnliche Reife in den Oktober. Gepflückt wird ab Mitte September bis Oktober, zum Frischverzehr möglichst spät. Ohne Kühllager halten die Früchte bis November, im Kühllager bis Januar. Die Früchte fallen vor der Ernte leicht ab.","belege":[{"quelle":"engelbrecht1889","seite":"292 (Nr. 260)"},{"quelle":"illustr_hb_4","band":"IV","seite":"257"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Jakob_Lebel&oldid=252548747"}]},{"thema":"baum","text":"Der Baum wächst stark und bildet dicke Triebe, die sich unter der Last der Früchte neigen. Er stellt geringe Ansprüche an den Boden und eignet sich für höhere Lagen; wegen des lockeren Fruchtsitzes ist ein windgeschützter Standort günstig. Die Sorte ist triploid und als Befruchter ungeeignet; sie ist anfällig für Schorf und Stippe.","belege":[{"quelle":"illustr_hb_4","band":"IV","seite":"257"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Jakob_Lebel&oldid=252548747"}]},{"thema":"verwendung","text":"Engelbrecht vergab 1889 das Zeichen für Tafelfrüchte (o) und für sehr gute Haushaltsfrüchte (††). Heute gilt Jakob Lebel vor allem als Back- und Mostapfel.","belege":[{"quelle":"engelbrecht1889","seite":"292 (Nr. 260)"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Jakob_Lebel&oldid=252548747"}]},{"thema":"frucht","text":"Nach den Erhebungen der National Fruit Collection: große, breit rundlich-kegelförmige Frucht mit grünlich gelber Grundfarbe und gestreifter orangefarbener Deckfarbe auf einem kleinen Teil der Schale. Das Fruchtfleisch ist grünlich. Küchenapfel, pflückreif Anfang September und lagerfähig bis Dezember.","belege":[{"quelle":"nfc2025","seite":"Akzession 1949110"}]}],"bilder":[{"url":"https://archive.org/download/bub_gb_tR4EMgEACAAJ/page/n308_w800.jpg","seite":"https://archive.org/details/bub_gb_tR4EMgEACAAJ/page/n308","art":"schnitt","urheber":"Theodor Engelbrecht (Zeichnung), Albert Probst (Holzschnitt)","lizenz":"gemeinfrei","quelle":"engelbrecht1889","titel":"Längsschnitt-Umriss bei Engelbrecht 1889, S. 292 (ganze Buchseite)"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/5/53/Malus-Jakob-Lebel.jpg/960px-Malus-Jakob-Lebel.jpg","seite":"https://commons.wikimedia.org/wiki/File:Malus-Jakob-Lebel.jpg","art":"frucht","urheber":"Sven Teschke","lizenz":"CC BY-SA 2.0 de","quelle":"commons","titel":"Malus-Jakob-Lebel.jpg"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/4/4f/Jakob_Lebel_jm55265.jpg/960px-Jakob_Lebel_jm55265.jpg","seite":"https://commons.wikimedia.org/wiki/File:Jakob_Lebel_jm55265.jpg","art":"frucht","urheber":"joergens.mi","lizenz":"CC BY-SA 3.0","quelle":"commons","titel":"Jakob Lebel jm55265.jpg"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/6/69/Jakob_Lebel_%28apple%29_jm179965.jpg/960px-Jakob_Lebel_%28apple%29_jm179965.jpg","seite":"https://commons.wikimedia.org/wiki/File:Jakob_Lebel_(apple)_jm179965.jpg","art":"schnitt","urheber":"joergens.mi","lizenz":"CC BY-SA 3.0","quelle":"commons","titel":"Jakob Lebel (apple) jm179965.jpg"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/a/a3/Apple_Blossom_Jacques_Lebel.jpg/960px-Apple_Blossom_Jacques_Lebel.jpg","seite":"https://commons.wikimedia.org/wiki/File:Apple_Blossom_Jacques_Lebel.jpg","art":"bluete","urheber":"El tommo","lizenz":"CC0","quelle":"commons","titel":"Apple Blossom Jacques Lebel.jpg"},{"url":"https://upload.wikimedia.org/wikipedia/commons/f/f4/Cro