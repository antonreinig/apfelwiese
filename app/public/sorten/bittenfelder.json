{"id":"bittenfelder","name":"Bittenfelder","synonyme":[{"name":"Bittenfelder Sämling","beleg":{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Bittenfelder&oldid=225386873"}}],"herkunft":{"text":"Zufallssämling aus Bittenfeld, heute Ortsteil von Waiblingen (Rems-Murr-Kreis, Baden-Württemberg), nach dem Ort benannt und in Württemberg verbreitet.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Bittenfelder&oldid=225386873"},{"quelle":"web_bogl_bw","url":"https://www.bogl-bw.de/bittenfelder/"}],"land":"DE","landSicher":true,"ort":"Bittenfeld (Waiblingen)"},"merkmale":[{"merkmal":"frucht_groesse","wert":"3","original":"Die Früchte sind meist klein bis maximal mittelgroß","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Bittenfelder&oldid=225386873"},{"merkmal":"frucht_groesse","wert":"5","original":"Die Früchte sind meist klein bis maximal mittelgroß","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Bittenfelder&oldid=225386873"},{"merkmal":"frucht_form","wert":"flachrund","original":"mittelgroß bis klein, plattrund","quelle":"web_bogl_bw","url":"https://www.bogl-bw.de/bittenfelder/"},{"merkmal":"schale_grundfarbe","wert":"gelb","original":"anfangs hellgrün …, verfärben sich aber bei zunehmender Reife zitronengelb","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Bittenfelder&oldid=225386873"},{"merkmal":"schale_grundfarbe","wert":"gelb","original":"hellgrün, später zitronengelb","quelle":"web_bogl_bw","url":"https://www.bogl-bw.de/bittenfelder/"},{"merkmal":"schale_deckfarbe_anteil","wert":"5","original":"zitronengelb mit sonnenwärts rot-oranger Deckfarbe","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Bittenfelder&oldid=225386873"},{"merkmal":"schale_deckfarbe_farbton","wert":"orange","original":"mit sonnenwärts rot-oranger Deckfarbe","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Bittenfelder&oldid=225386873"},{"merkmal":"schale_deckfarbe_art","wert":"marmoriert","original":"sonnenseits leicht marmoriert","quelle":"web_bogl_bw","url":"https://www.bogl-bw.de/bittenfelder/"},{"merkmal":"schale_beschaffenheit","wert":"matt","original":"bei matter, nicht fettiger Schale","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Bittenfelder&oldid=225386873"},{"merkmal":"fleisch_festigkeit","wert":"7","original":"Das Fleisch ist sehr fest","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Bittenfelder&oldid=225386873"},{"merkmal":"verwendung","wert":"most","original":"zählt zu den besten Sorten für Gär- und Süßmost","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Bittenfelder&oldid=225386873"},{"merkmal":"verwendung","wert":"most","original":"eine der besten Sorten für Gär- und Süßmost","quelle":"web_bogl_bw","url":"https://www.bogl-bw.de/bittenfelder/"},{"merkmal":"genussreife_ende","wert":"3","original":"Die Äpfel reifen Ende Oktober bis Mitte November und sind bis März lagerfähig","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Bittenfelder&oldid=225386873"},{"merkmal":"baum_wuchs","wert":"7","original":"wächst danach jedoch verhältnismäßig stark","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Bittenfelder&oldid=225386873"},{"merkmal":"baum_wuchs","wert":"7","original":"als Jungbaum eher schwach, später stark bis sehr stark","quelle":"web_bogl_bw","url":"https://www.bogl-bw.de/bittenfelder/"},{"merkmal":"ploidie","wert":"diploid","original":"diploid","quelle":"web_bogl_bw","url":"https://www.bogl-bw.de/bittenfelder/"},{"merkmal":"gesundheit","wert":"7","original":"Die Bäume sind robust, langlebig, frosthart und wenig krankheitsanfällig","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Bittenfelder&oldid=225386873","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Bittenfelder&oldid=225386873"},{"quelle":"web_bogl_bw","url":"https://www.bogl-bw.de/bittenfelder/"}]},{"merkmal":"ertrag_beginn","wert":"spaet","original":"Der Ertrag setzt sehr spät ein","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Bittenfelder&oldid=225386873","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Bittenfelder&oldid=225386873"},{"quelle":"web_bogl_bw","url":"https://www.bogl-bw.de/bittenfelder/"}]},{"merkmal":"ertrag_alternanz","wert":"regelmaessig","original":"ist dann aber regelmäßig","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Bittenfelder&oldid=225386873","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Bittenfelder&oldid=225386873"},{"quelle":"web_bogl_bw","url":"https://www.bogl-bw.de/bittenfelder/"}]},{"merkmal":"lagerfaehigkeit","wert":"7","original":"lassen sich bis März lagern","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Bittenfelder&oldid=225386873","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Bittenfelder&oldid=225386873"},{"quelle":"web_bogl_bw","url":"https://www.bogl-bw.de/bittenfelder/"}]}],"texte":[{"thema":"ueberblick","text":"Der Bittenfelder ist ein kleiner, spät reifender Mostapfel aus Württemberg. Die saftigen Früchte haben viel Zucker und viel Säure und gelten als eine der besten Sorten für Gär- und Süßmost. Daneben wird die Sorte als Sämlingsunterlage für Hoch- und Halbstämme genutzt.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Bittenfelder&oldid=225386873"},{"quelle":"web_bogl_bw","url":"https://www.bogl-bw.de/bittenfelder/"}]},{"thema":"herkunft","text":"Die Sorte ist ein Zufallssämling aus Bittenfeld, einem Ortsteil von Waiblingen im Rems-Murr-Kreis, und nach diesem Ort benannt. Verbreitet ist sie vor allem in Württemberg.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Bittenfelder&oldid=225386873"},{"quelle":"web_bogl_bw","url":"https://www.bogl-bw.de/bittenfelder/"}]},{"thema":"frucht","text":"Die Früchte sind meist klein, höchstens mittelgroß und nach BOGL plattrund. Früchte aus dem Kroneninneren bleiben oft grün und kleiner.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Bittenfelder&oldid=225386873"},{"quelle":"web_bogl_bw","url":"https://www.bogl-bw.de/bittenfelder/"}]},{"thema":"schale","text":"Die matte, nicht fettige Schale ist anfangs hellgrün und wird mit zunehmender Reife zitronengelb. Sonnenseits trägt sie eine rotorange Deckfarbe, nach BOGL leicht marmoriert. Die Schale ist fest.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Bittenfelder&oldid=225386873"},{"quelle":"web_bogl_bw","url":"https://www.bogl-bw.de/bittenfelder/"}]},{"thema":"fleisch_geschmack","text":"Das Fleisch ist sehr fest. Trotz des hohen Zuckergehalts tritt die Säure deutlich hervor; BOGL nennt die Früchte außerdem gerbstoffhaltig. Beschattete Früchte schmecken deutlich saurer und bitterer. Angaben zum Kernhaus und zur Kelchhöhle fehlen in den vorliegenden Quellen.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Bittenfelder&oldid=225386873"},{"quelle":"web_bogl_bw","url":"https://www.bogl-bw.de/bittenfelder/"}]},{"thema":"reife_lagerung","text":"Die Äpfel reifen nach Wikipedia Ende Oktober bis Mitte November, nach BOGL Mitte Oktober bis Mitte November, und lassen sich bis März lagern. Sie hängen sehr fest am Baum, oft bis nach dem ersten Schnee. Vorzeitig gefallene Früchte faulen außergewöhnlich langsam; BOGL vermerkt keine Lagerfäulen. An kühlen Standorten reifen sie zu spät und bilden zu wenig Zucker.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Bittenfelder&oldid=225386873"},{"quelle":"web_bogl_bw","url":"https://www.bogl-bw.de/bittenfelder/"}]},{"thema":"baum","text":"Die Bäume sind robust, langlebig, frosthart und wenig krankheitsanfällig. Als Jungbaum wächst die Sorte eher schwach, später stark bis sehr stark, mit weit ausladender Krone, die jährlich ausgelichtet werden muss. Der Ertrag setzt sehr spät ein, ist dann aber regelmäßig. BOGL nennt die Sorte diploid, aber einen schlechten Befruchter. Nach Wikipedia ist sie weitgehend selbstfruchtbar, weshalb ihre Sämlinge recht einheitlich ausfallen.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Bittenfelder&oldid=225386873"},{"quelle":"web_bogl_bw","url":"https://www.bogl-bw.de/bittenfelder/"}]},{"thema":"verwendung","text":"Hauptnutzung ist Gär- und Süßmost. Wegen der geringen Größe und der kräftigen Säure wird die Sorte nicht allgemein als Tafelapfel empfohlen. Sämlinge dienen als Unterlage für die Veredlung von Hoch- und Halbstämmen und nehmen alle Sorten gut an.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Bittenfelder&oldid=225386873"},{"quelle":"web_bogl_bw","url":"https://www.bogl-bw.de/bittenfelder/"}]}],"bilder":[{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/4/40/Malus_Bittenfelder_4527.jpg/960px-Malus_Bittenfelder_4527.jpg","seite":"https://commons.wikimedia.org/wiki/File:Malus_Bittenfelder_4527.jpg","art":"frucht","urheber":"Sven Teschke","lizenz":"CC BY-SA 3.0 de","quelle":"commons","titel":"Malus Bittenfelder 4527.jpg"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/5/58/Bittenfelder_auf_H%C3%A4nger.jpg/960px-Bittenfelder_auf_H%C3%A4nger.jpg","seite":"https://commons.wikimedia.org/wiki/File:Bittenfelder_auf_H%C3%A4nger.jpg","art":"frucht","urheber":"Bigcubefan","lizenz":"CC BY-SA 4.0","quelle":"commons","titel":"Bittenfelder auf Hänger.jpg"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/5/5f/Malus_domestica_Bittenfelder_IP1110001.jpg/960px-Malus_domestica_Bittenfelder_IP1110001.jpg","seite":"https://commons.wikimedia.org/wiki/File:Malus_domestica_Bittenfelder_IP1110001.jpg","art":"frucht","urheber":"Leo Michels","lizenz":"CC0","quelle":"commons","titel":"Malus domestica Bittenfelder IP1110001.jpg"},{"url":"https://upload.wikimedia.org/wikipedia/commons/9/92/Malus-Bittenfelder-S%C3%A4mling.jpg","seite":"https://commons.wikimedia.org/wiki/File:Malus-Bittenfelder-S%C3%A4mling.jpg","art":"frucht","urheber":"unbekannt","lizenz":"CC BY-SA 2.0 DE","quelle":"commons-fotos","titel":"Malus-Bittenfelder-Sämling"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/5/56/Bittenfelder_S%C3%A4mling_%28apple%29_jm179433.jpg/960px-Bittenfelder_S%C3%A4mling_%28apple%29_jm179433.jpg","seite":"https://commons.wikimedia.org/wiki/File:Bittenfelder_S%C3%A4mling_(apple)_jm179433.jpg","art":"baum","urheber":"joergens.mi","lizenz":"CC BY-SA 3.0","quelle":"commons-fotos","titel":"Bittenfelder Sämling (apple) jm179433"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/7c/Bittenfelder_am_Baum.jpg/960px-Bittenfelder_am_Baum.jpg","seite":"https://commons.wikimedia.org/wiki/File:Bittenfelder_am_Baum.jpg","art":"baum","urheber":"Bigcubefan","lizenz":"CC BY-SA 4.0","quelle":"commons-fotos","titel":"Bittenfelder am Baum"}],"regionen":[{"region":"DE-BW","art":"herkunft","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Bittenfelder&oldid=225386873"},{"quelle":"web_bogl_bw","url":"https://www.bogl-bw.de/bittenfelder/"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Bittenfelder&oldid=225386873"},{"quelle":"web_bogl_bw","url":"https://www.bogl-bw.de/bittenfelder/"},{"quelle":"rg_ni-elbtalaue-poster"}]},{"region":"DE-BW","art":"verbreitung","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Bittenfelder&oldid=225386873"},{"quelle":"web_bogl_bw","url":"https://www.bogl-bw.de/bittenfelder/"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Bittenfelder&oldid=225386873"},{"quelle":"web_bogl_bw","url":"https://www.bogl-bw.de/bittenfelder/"},{"quelle":"rg_ni-elbtalaue-poster"}],"original":"Verbreitet ist sie vor allem in Württemberg"},{"region":"DE-SN","art":"empfehlung","belege":[{"quelle":"rg_sn-smul-streuobst-2012","seite":"S. 19–21"}],"original":"Bittenfelder"},{"region":"DE-BW","art":"regionalsorte","belege":[{"quelle":"rg_slowfood-arche"}],"original":"Bittenfelder Sämling"}],"gefaehrdung":[{"stufe":"Rote Liste der gefährdeten einheimischen Nutzpflanzen in Deutschland","belege":[{"quelle":"rg_ble-rote-liste"}],"original":"Bittenfelder Sämling"},{"stufe":"Passagier der Arche des Geschmacks","belege":[{"quelle":"rg_slowfood-arche"}],"original":"Bittenfelder Sämling"}]}