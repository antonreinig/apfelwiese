ig bis Oktober.","belege":[{"quelle":"nfc2025","seite":"Akzession 1968068"}]}],"bilder":[{"url":"https://upload.wikimedia.org/wikipedia/commons/a/ab/Jamba_69_on_tree%2C_National_Fruit_Collection_%28acc._1968-068%29.jpg","seite":"https://commons.wikimedia.org/wiki/File:Jamba_69_on_tree,_National_Fruit_Collection_(acc._1968-068).jpg","art":"baum","urheber":"National Fruit Collection, Brogdale","lizenz":"OGL 2.0","quelle":"nfc-commons","titel":"Jamba 69 on tree, National Fruit Collection (acc. 1968-068)"},{"url":"https://upload.wikimedia.org/wikipedia/commons/6/63/Cross_section_of_Jamba_69%2C_National_Fruit_Collection_%28acc._1968-068%29.jpg","seite":"https://commons.wikimedia.org/wiki/File:Cross_section_of_Jamba_69,_National_Fruit_Collection_(acc._1968-068).jpg","art":"schnitt","urheber":"National Fruit Collection, Brogdale","lizenz":"OGL 2.0","quelle":"nfc-commons","titel":"Cross section of Jamba 69, National Fruit Collection (acc. 1968-068)"},{"url":"https://upload.wikimedia.org/wikipedia/commons/7/7f/Malus_Jamba.JPG","seite":"https://commons.wikimedia.org/wiki/File:Malus_Jamba.JPG","art":"frucht","urheber":"Genet","lizenz":"CC BY-SA 3.0","quelle":"commons-fotos","titel":"Malus Jamba"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/8e/Malus_Jamba_4413.jpg/960px-Malus_Jamba_4413.jpg","seite":"https://commons.wikimedia.org/wiki/File:Malus_Jamba_4413.jpg","art":"frucht","urheber":"Sven Teschke","lizenz":"CC BY-SA 3.0 DE","quelle":"commons-fotos","titel":"Malus Jamba 4413"}],"farbmessung":[{"bild":"https://upload.wikimedia.org/wikipedia/commons/6/63/Cross_section_of_Jamba_69%2C_National_Fruit_Collection_%28acc._1968-068%29.jpg","methode":"NFC-Foto","verfahren":"Foto (NFC-Fototafel: 4 ganze Früchte, 2 Schnitte, Fototisch); Weißabgleich über den Hintergrund; Frucht per Hintergrundmodell freigestellt; Schalenpixel ohne Glanzlichter einzeln klassifiziert: Grundfarbe aus gelbgrünen Pixeln, Deckfarbe = Pixel mit deutlich höherem a* als die Grundfarbe (auch dunk