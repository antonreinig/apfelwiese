:"commons-fotos","titel":"Biesterfelder Renette Schild"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/3/3d/Biesterfelder_Renette_Bl%C3%BCtenseite.jpg/960px-Biesterfelder_Renette_Bl%C3%BCtenseite.jpg","seite":"https://commons.wikimedia.org/wiki/File:Biesterfelder_Renette_Bl%C3%BCtenseite.jpg","art":"bluete","urheber":"Bahnmoeller","lizenz":"CC BY-SA 3.0","quelle":"commons-fotos","titel":"Biesterfelder Renette Blütenseite"}],"munq":1106.1,"akzessionen":[{"sammlung":"UK National Fruit Collection (Brogdale)","nummer":"1951056","name":"Biesterfelder Renette"}],"farbmessung":[{"bild":"https://upload.wikimedia.org/wikipedia/commons/3/39/Cross_section_of_Biesterfelder-Renette%2C_National_Fruit_Collection_%28acc._1951-056%29.jpg","methode":"NFC-Foto","verfahren":"Foto (NFC-Fototafel: 4 ganze Früchte, 2 Schnitte, Fototisch); Weißabgleich über den Hintergrund; Frucht per Hintergrundmodell freigestellt; Schalenpixel ohne Glanzlichter einzeln klassifiziert: Grundfarbe aus gelbgrünen Pixeln, Deckfarbe = Pixel mit deutlich höherem a* als die Grundfarbe (auch dunkle Rot- und Braunrottöne), Anteile über Pixel; Höhe/Breite aus dem Längsschnitt","grundfarbe":"#aaae2a","deckfarbe":"#a43f47","deckfarbeAnteil":0.69,"fleischfarbe":"#e4d8c0","hoeheZuBreite":0.833}]}