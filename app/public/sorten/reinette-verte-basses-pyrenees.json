dia.org/wikipedia/commons/c/c7/Cross_section_of_Reinette_Verte_%28Basses-Pyrenees%29%2C_National_Fruit_Collection_%28acc._1948-273%29.jpg","seite":"https://commons.wikimedia.org/wiki/File:Cross_section_of_Reinette_Verte_(Basses-Pyrenees),_National_Fruit_Collection_(acc._1948-273).jpg","art":"schnitt","urheber":"National Fruit Collection, Brogdale","lizenz":"OGL 2.0","quelle":"nfc-commons","titel":"Cross section of Reinette Verte (Basses-Pyrenees), National Fruit Collection (acc. 1948-273)"},{"url":"https://upload.wikimedia.org/wikipedia/commons/9/91/Reinette_Verte_%28Basses-Pyrenees%29_on_tree%2C_National_Fruit_Collection_%28acc._1948-273%29.jpg","seite":"https://commons.wikimedia.org/wiki/File:Reinette_Verte_(Basses-Pyrenees)_on_tree,_National_Fruit_Collection_(acc._1948-273).jpg","art":"baum","urheber":"National Fruit Collection, Brogdale","lizenz":"OGL 2.0","quelle":"nfc-commons","titel":"Reinette Verte (Basses-Pyrenees) on tree, National Fruit Collection (acc. 1948-273)"}],"farbmessung":[{"bild":"https://upload.wikimedia.org/wikipedia/commons/c/c7/Cross_section_of_Reinette_Verte_%28Basses-Pyrenees%29%2C_National_Fruit_Collection_%28acc._1948-273%29.jpg","methode":"NFC-Foto","verfahren":"Foto (NFC-Fototafel: 4 ganze Früchte, 2 Schnitte, Fototisch); Weißabgleich über den Hintergrund; Frucht per Hintergrundmodell freigestellt; Schalenpixel ohne Glanzlichter einzeln klassifiziert: Grundfarbe aus gelbgrünen Pixeln, Deckfarbe = Pixel mit deutlich höherem a* als die Grundfarbe (auch dunkle Rot- und Braunrottöne), Anteile über Pixel; Höhe/Breite aus dem Längsschnitt","grundfarbe":"#999b3b","deckfarbe":"#754d39","deckfarbeAnteil":0.3,"fleischfarbe":"#ccccb1","hoeheZuBreite":0.968}]}