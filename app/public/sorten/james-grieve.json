{"id":"james-grieve","name":"James Grieve","synonyme":[{"name":"Grieve","beleg":{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=James_Grieve_(Apfel)&oldid=261459997"}},{"name":"Jems Griev","beleg":{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=James_Grieve_(Apfel)&oldid=261459997"}},{"name":"Dzems Griw","beleg":{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=James_Grieve_(Apfel)&oldid=261459997"}}],"herkunft":{"text":"Edinburgh (Schottland): vom Obergärtner James Grieve als Sämling eines frei abgeblühten Cox Orange herangezogen und von seinem Arbeitgeber, der Baumschule Dickson, nach ihm benannt; 1893 erstmals beschrieben und ab den 1890er-Jahren verbreitet.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=James_Grieve_(Apfel)&oldid=261459997"}]},"merkmale":[{"merkmal":"frucht_groesse","wert":"5","original":"Die Frucht ist mittelgroß","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=James_Grieve_(Apfel)&oldid=261459997"},{"merkmal":"frucht_form","wert":"rund","original":"rund bis stielbauchig","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=James_Grieve_(Apfel)&oldid=261459997"},{"merkmal":"frucht_breiteste_stelle","wert":"stiel","original":"rund bis stielbauchig","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=James_Grieve_(Apfel)&oldid=261459997"},{"merkmal":"frucht_rippung","wert":"3","original":"auch Rippen sind nur schwach erkennbar","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=James_Grieve_(Apfel)&oldid=261459997"},{"merkmal":"schale_grundfarbe","wert":"gelb","original":"im Sommer ein leuchtendes gelbgrün, das sich bis in den Herbst in ein Gelb ändert","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=James_Grieve_(Apfel)&oldid=261459997"},{"merkmal":"schale_deckfarbe_farbton","wert":"orange","original":"ein Orange,