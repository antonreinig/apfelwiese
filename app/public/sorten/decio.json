edia.org/wiki/File:Cross_section_of_Decio,_National_Fruit_Collection_(acc._1983-032).jpg","art":"schnitt","urheber":"National Fruit Collection, Brogdale","lizenz":"OGL 2.0","quelle":"nfc-commons","titel":"Cross section of Decio, National Fruit Collection (acc. 1983-032)"},{"url":"https://upload.wikimedia.org/wikipedia/commons/7/71/Decio_on_tree%2C_National_Fruit_Collection_%28acc._1983-032%29.jpg","seite":"https://commons.wikimedia.org/wiki/File:Decio_on_tree,_National_Fruit_Collection_(acc._1983-032).jpg","art":"baum","urheber":"National Fruit Collection, Brogdale","lizenz":"OGL 2.0","quelle":"nfc-commons","titel":"Decio on tree, National Fruit Collection (acc. 1983-032)"}],"farbmessung":[{"bild":"https://upload.wikimedia.org/wikipedia/commons/0/0b/Cross_section_of_Decio%2C_National_Fruit_Collection_%28acc._1983-032%29.jpg","methode":"NFC-Foto","verfahren":"Foto (NFC-Fototafel: 4 ganze Früchte, 2 Schnitte, Fototisch); Weißabgleich über den Hintergrund; Frucht per Hintergrundmodell freigestellt; Schalenpixel ohne Glanzlichter einzeln klassifiziert: Grundfarbe aus gelbgrünen Pixeln, Deckfarbe = Pixel mit deutlich höherem a* als die Grundfarbe (auch dunkle Rot- und Braunrottöne), Anteile über Pixel; Höhe/Breite aus dem Längsschnitt","grundfarbe":"#aaac44","deckfarbe":"#9a7355","deckfarbeAnteil":0.05,"rostfarbe":"#846c40","fleischfarbe":"#d8d1c0","hoeheZuBreite":0.853}]}