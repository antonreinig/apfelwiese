{"id":"heuchelheimer-schneeapfel","name":"Heuchelheimer Schneeapfel","synonyme":[{"name":"Schneeweißer Streifling","beleg":{"quelle":"web_pomologen_verein","url":"https://www.pomologen-verein.de/media/user_upload/Landesgruppen/Faltblatt_Lokalsorte_2003.pdf"}},{"name":"Gießener Schneeapfel","beleg":{"quelle":"web_pomologen_verein","url":"https://www.pomologen-verein.de/media/user_upload/Landesgruppen/Faltblatt_Lokalsorte_2003.pdf"}}],"herkunft":{"text":"Zufallssämling des 19. Jahrhunderts aus Heuchelheim bei Gießen (Hessen). Der Mutterbaum soll um 1900 auf dem Gelände des Kindergartens in der Wilhelmstraße gestanden haben. Hessische Lokalsorte 2003.","belege":[{"quelle":"web_pomologen_verein","url":"https://www.pomologen-verein.de/media/user_upload/Landesgruppen/Faltblatt_Lokalsorte_2003.pdf"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Heuchelheimer_Schneeapfel&oldid=257764605"}]},"merkmale":[{"merkmal":"frucht_groesse","wert":"5","original":"mittelgroß bis groß","quelle":"web_pomologen_verein","url":"https://www.pomologen-verein.de/media/user_upload/Landesgruppen/Faltblatt_Lokalsorte_2003.pdf"},{"merkmal":"frucht_groesse","wert":"7","original":"mittelgroß bis groß","quelle":"web_pomologen_verein","url":"https://www.pomologen-verein.de/media/user_upload/Landesgruppen/Faltblatt_Lokalsorte_2003.pdf"},{"merkmal":"frucht_form","wert":"rund","original":"Variabel, kugelig bis leicht hochgebaut, unten abgeplattet","quelle":"web_pomologen_verein","url":"https://www.pomologen-verein.de/media/user_upload/Landesgruppen/Faltblatt_Lokalsorte_2003.pdf"},{"merkmal":"frucht_breiteste_stelle","wert":"mitte","original":"mittelbauchig","quelle":"web_pomologen_verein","url":"https://www.pomologen-verein.de/media/user_upload/Landesgruppen/Faltblatt_Lokalsorte_2003.pdf"},{"merkmal":"frucht_rippung","wert":"3","original":"im Querschnitt unregelmäßig, schwach gerippt","quelle":"web_pomologen_verein","url":"https://www.pomologen-verein.de/media/user_upload/Landesgruppen/Faltblatt_Lokalsorte_2003.pdf"},{"merkmal":"schale_beschaffenheit","wert":"glatt","original":"Glatt und glänzend, im Lager fettig bis klebrig werdend","quelle":"web_pomologen_verein","url":"https://www.pomologen-verein.de/media/user_upload/Landesgruppen/Faltblatt_Lokalsorte_2003.pdf"},{"merkmal":"schale_beschaffenheit","wert":"glaenzend","original":"Glatt und glänzend","quelle":"web_pomologen_verein","url":"https://www.pomologen-verein.de/media/user_upload/Landesgruppen/Faltblatt_Lokalsorte_2003.pdf"},{"merkmal":"schale_beschaffenheit","wert":"fettig","original":"im Lager fettig bis klebrig werdend","quelle":"web_pomologen_verein","url":"https://www.pomologen-verein.de/media/user_upload/Landesgruppen/Faltblatt_Lokalsorte_2003.pdf"},{"merkmal":"schale_grundfarbe","wert":"gelb","original":"bei Vollreife hellgelb bis weißgelb","quelle":"web_pomologen_verein","url":"https://www.pomologen-verein.de/media/user_upload/Landesgruppen/Faltblatt_Lokalsorte_2003.pdf"},{"merkmal":"schale_grundfarbe","wert":"weisslichgelb","original":"bei Vollreife hellgelb bis weißgelb","quelle":"web_pomologen_verein","url":"https://www.pomologen-verein.de/media/user_upload/Landesgruppen/Faltblatt_Lokalsorte_2003.pdf"},{"merkmal":"schale_deckfarbe_anteil","wert":"7","original":"stiel- und sonnenseits stark rot gestreift und gesprenkelt, bis ¾ der Oberfläche","quelle":"web_pomologen_verein","url":"https://www.pomologen-verein.de/media/user_upload/Landesgruppen/Faltblatt_Lokalsorte_2003.pdf"},{"merkmal":"schale_deckfarbe_farbton","wert":"rot","original":"stark rot gestreift und gesprenkelt","quelle":"web_pomologen_verein","url":"https://www.pomologen-verein.de/media/user_upload/Landesgruppen/Faltblatt_Lokalsorte_2003.pdf"},{"merkmal":"schale_deckfarbe_art","wert":"gestreift","original":"stark rot gestreift und gesprenkelt","quelle":"web_pomologen_verein","url":"https://www.pomologen-verein.de/media/user_upload/Landesgruppen/Faltblatt_Lokalsorte_2003.pdf"},{"merkmal":"schale_deckfarbe_art","wert":"getuepfelt","original":"stark rot gestreift und gesprenkelt","quelle":"web_pomologen_verein","url":"https://www.pomologen-verein.de/media/user_upload/Landesgruppen/Faltblatt_Lokalsorte_2003.pdf"},{"merkmal":"kelchgrube_tiefe","wert":"7","original":"Kelchgrube tief, mittelweit, typ. „kraterförmig“","quelle":"web_pomologen_verein","url":"https://www.pomologen-verein.de/media/user_upload/Landesgruppen/Faltblatt_Lokalsorte_2003.pdf"},{"merkmal":"kelchgrube_weite","wert":"5","original":"Kelchgrube tief, mittelweit","quelle":"web_pomologen_verein","url":"https://www.pomologen-verein.de/media/user_upload/Landesgruppen/Faltblatt_Lokalsorte_2003.pdf"},{"merkmal":"kelch_offenheit","wert":"geschlossen","original":"Kelch mittelgroß, geschlossen bis halboffen","quelle":"web_pomologen_verein","url":"https://www.pomologen-verein.de/media/user_upload/Landesgruppen/Faltblatt_Lokalsorte_2003.pdf"},{"merkmal":"kelch_offenheit","wert":"halboffen","original":"Kelch mittelgroß, geschlossen bis halboffen","quelle":"web_pomologen_verein","url":"https://www.pomologen-verein.de/media/user_upload/Landesgruppen/Faltblatt_Lokalsorte_2003.pdf"},{"merkmal":"kelchhoehle_form","wert":"dreieck_breit","original":"Kelchhöhle breit trichterförmig bis dreieckig","quelle":"web_pomologen_verein","url":"https://www.pomologen-verein.de/media/user_upload/Landesgruppen/Faltblatt_Lokalsorte_2003.pdf"},{"merkmal":"stielgrube_tiefe","wert":"7","original":"Stielgrube eng, tief, feinstrahlig berostet","quelle":"web_pomologen_verein","url":"https://www.pomologen-verein.de/media/user_upload/Landesgruppen/Faltblatt_Lokalsorte_2003.pdf"},{"merkmal":"stielgrube_weite","wert":"3","original":"Stielgrube eng, tief","quelle":"web_pomologen_verein","url":"https://www.pomologen-verein.de/media/user_upload/Landesgruppen/Faltblatt_Lokalsorte_2003.pdf"},{"merkmal":"schale_berostung_stielgrube","wert":"5","original":"feinstrahlig berostet, zimtfarben","quelle":"web_pomologen_verein","url":"https://www.pomologen-verein.de/media/user_upload/Landesgruppen/Faltblatt_Lokalsorte_2003.pdf"},{"merkmal":"stiel_laenge","wert":"3","original":"Stiel kurz bis mittellang, holzig","quelle":"web_pomologen_verein","url":"https://www.pomologen-verein.de/media/user_upload/Landesgruppen/Faltblatt_Lokalsorte_2003.pdf"},{"merkmal":"stiel_laenge","wert":"5","original":"Stiel kurz bis mittellang, holzig","quelle":"web_pomologen_verein","url":"https://www.pomologen-verein.de/media/user_upload/Landesgruppen/Faltblatt_Lokalsorte_2003.pdf"},{"merkmal":"kernhaus_form","wert":"zwiebel","original":"Gefäßbündel schwach ausgeprägt, flachzwiebelförmig","quelle":"web_pomologen_verein","url":"https://www.pomologen-verein.de/media/user_upload/Landesgruppen/Faltblatt_Lokalsorte_2003.pdf"},{"merkmal":"kernfaecher_form","wert":"bohnen","original":"Kernhauswände bohnenförmig, breit, glänzend","quelle":"web_pomologen_verein","url":"https://www.pomologen-verein.de/media/user_upload/Landesgruppen/Faltblatt_Lokalsorte_2003.pdf"},{"merkmal":"kerne_form","wert":"rundlich","original":"Kerne zahlreich, gut ausgebildet, rundlich-breit","quelle":"web_pomologen_verein","url":"https://www.pomologen-verein.de/media/user_upload/Landesgruppen/Faltblatt_Lokalsorte_2003.pdf"},{"merkmal":"kerne_form","wert":"breit","original":"Kerne zahlreich, gut ausgebildet, rundlich-breit","quelle":"web_pomologen_verein","url":"https://www.pomologen-verein.de/media/user_upload/Landesgruppen/Faltblatt_Lokalsorte_2003.pdf"},{"merkmal":"fleisch_farbe","wert":"weiss","original":"Fruchtfleisch Weiß, locker, relativ weich","quelle":"web_pomologen_verein","url":"https://www.pomologen-verein.de/media/user_upload/Landesgruppen/Faltblatt_Lokalsorte_2003.pdf"},{"merkmal":"fleisch_festigkeit","wert":"3","original":"locker, relativ weich","quelle":"web_pomologen_verein","url":"https://www.pomologen-verein.de/media/user_upload/Landesgruppen/Faltblatt_Lokalsorte_2003.pdf"},{"merkmal":"fleisch_saftigkeit","wert":"7","original":"saftig","quelle":"web_pomologen_verein","url":"https://www.pomologen-verein.de/media/user_upload/Landesgruppen/Faltblatt_Lokalsorte_2003.pdf"},{"merkmal":"geschmack_saeure","wert":"5","original":"leicht säuerlich, ausgewogenes Zucker-Säure-Verhältnis","quelle":"web_pomologen_verein","url":"https://www.pomologen-verein.de/media/user_upload/Landesgruppen/Faltblatt_Lokalsorte_2003.pdf"},{"merkmal":"geschmack_suesse","wert":"5","original":"ausgewogenes Zucker-Säure-Verhältnis","quelle":"web_pomologen_verein","url":"https://www.pomologen-verein.de/media/user_upload/Landesgruppen/Faltblatt_Lokalsorte_2003.pdf"},{"merkmal":"geschmack_aroma","wert":"aromatisch, schwacher Duft","original":"aromatisch, schwacher Duft","quelle":"web_pomologen_verein","url":"https://www.pomologen-verein.de/media/user_upload/Landesgruppen/Faltblatt_Lokalsorte_2003.pdf"},{"merkmal":"genussreife_beginn","wert":"9","original":"Ende September, in höheren Lagen bis Mitte Oktober, vom Baum essbar","quelle":"web_pomologen_verein","url":"https://www.pomologen-verein.de/media/user_upload/Landesgruppen/Faltblatt_Lokalsorte_2003.pdf"},{"merkmal":"genussreife_ende","wert":"4","original":"Haltbarkeit bis April","quelle":"web_pomologen_verein","url":"https://www.pomologen-verein.de/media/user_upload/Landesgruppen/Faltblatt_Lokalsorte_2003.pdf"},{"merkmal":"bluete_zeit","wert":"5","original":"Mittelfrüh bis mittelspät, witterungsunempfindlich","quelle":"web_pomologen_verein","url":"https://www.pomologen-verein.de/media/user_upload/Landesgruppen/Faltblatt_Lokalsorte_2003.pdf"},{"merkmal":"baum_wuchs","wert":"5","original":"Mittelstark, breitkugelig, wenig verzweigt","quelle":"web_pomologen_verein","url":"https://www.pomologen-verein.de/media/user_upload/Landesgruppen/Faltblatt_Lokalsorte_2003.pdf"},{"merkmal":"verwendung","wert":"tafel","original":"Früchte werden als Tafelobst geschätzt","quelle":"web_pomologen_verein","url":"https://www.pomologen-verein.de/media/user_upload/Landesgruppen/Faltblatt_Lokalsorte_2003.pdf"},{"merkmal":"verwendung","wert":"kueche","original":"auch als Wirtschaftsapfel hervorragend geeignet","quelle":"web_pomologen_verein","url":"https://www.pomologen-verein.de/media/user_upload/Landesgruppen/Faltblatt_Lokalsorte_2003.pdf"},{"merkmal":"verwendung","wert":"most","original":"besonders für Obstsalat und für sortenreine Säfte und Weine","quelle":"web_pomologen_verein","url":"https://www.pomologen-verein.de/media/user_upload/Landesgruppen/Faltblatt_Lokalsorte_2003.pdf"},{"merkmal":"frucht_form","wert":"rund","original":"kugelig bis leicht hoch gebaut","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Heuchelheimer_Schneeapfel&oldid=257764605"},{"merkmal":"frucht_rippung","wert":"3","original":"schwach gerippter Schale","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Heuchelheimer_Schneeapfel&oldid=257764605"},{"merkmal":"schale_beschaffenheit","wert":"glatt","original":"glatt glänzender und schwach gerippter Schale","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Heuchelheimer_Schneeapfel&oldid=257764605"},{"merkmal":"schale_beschaffenheit","wert":"glaenzend","original":"glatt glänzender … Schale","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Heuchelheimer_Schneeapfel&oldid=257764605"},{"merkmal":"fleisch_farbe","wert":"weiss","original":"Das Fruchtfleisch ist hellweiß","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Heuchelheimer_Schneeapfel&oldid=257764605"},{"merkmal":"geschmack_suesse","wert":"5","original":"aromatisch mit ausgewogenem Zucker-Säure-Verhältnis","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Heuchelheimer_Schneeapfel&oldid=257764605"},{"merkmal":"geschmack_saeure","wert":"5","original":"aromatisch mit ausgewogenem Zucker-Säure-Verhältnis","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Heuchelheimer_Schneeapfel&oldid=257764605"},{"merkmal":"genussreife_beginn","wert":"9","original":"reift Ende September bis Mitte Oktober","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Heuchelheimer_Schneeapfel&oldid=257764605"},{"merkmal":"baum_wuchs","wert":"5","original":"Mittelstarker Wuchs","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Heuchelheimer_Schneeapfel&oldid=257764605"},{"merkmal":"verwendung","wert":"tafel","original":"sowohl als Tafel- als auch als Wirtschaftsapfel","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Heuchelheimer_Schneeapfel&oldid=257764605"},{"merkmal":"verwendung","wert":"kueche","original":"besonders geeignet zur Verwendung als Backapfel","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Heuchelheimer_Schneeapfel&oldid=257764605"},{"merkmal":"verwendung","wert":"most","original":"oder als sortenreiner Mostapfel","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Heuchelheimer_Schneeapfel&oldid=257764605"}],"texte":[{"thema":"ueberblick","text":"Hessische Regionalsorte aus Heuchelheim bei Gießen: ein mittelgroßer bis großer, kugeliger, hellgelber Apfel mit kräftigen roten Streifen und schneeweißem, kaum bräunendem Fleisch. Er reift ab Ende September und dient als Tafel-, Back- und Saftapfel. 2003 wurde er zur Hessischen Lokalsorte ernannt.","belege":[{"quelle":"web_pomologen_verein","url":"https://www.pomologen-verein.de/media/user_upload/Landesgruppen/Faltblatt_Lokalsorte_2003.pdf"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Heuchelheimer_Schneeapfel&oldid=257764605"}]},{"thema":"herkunft","text":"Die Sorte entstand im 19. Jahrhundert als Zufallssämling in Heuchelheim bei Gießen. In den 1930er- und 1940er-Jahren wurde sie als „Schneeweißer Streifling“ (Zorn) und „Gießener Schneeapfel“ (Schmidt 1949) geführt. Die örtliche Baumschule Rinn vermehrte sie unter Philipp Rinn I. bis in die 1950er-Jahre. Nach einem Bildbericht über diese Baumschule in der Zeitschrift „Deutsche Baumschule“ 1979 wurden Reiser und Bäume weit über Hessen hinaus verschickt. Der Pomologen-Verein ernannte die Sorte 2003 zur Hessischen Lokalsorte.","belege":[{"quelle":"web_pomologen_verein","url":"https://www.pomologen-verein.de/media/user_upload/Landesgruppen/Faltblatt_Lokalsorte_2003.pdf"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Heuchelheimer_Schneeapfel&oldid=257764605"}]},{"thema":"frucht","text":"Die Frucht ist mittelgroß bis groß und in der Form veränderlich: kugelig bis leicht hochgebaut, unten abgeplattet, mittelbauchig, im Querschnitt unregelmäßig und schwach gerippt. Die Kelchgrube ist tief und mittelweit, nach dem Pomologen-Verein typisch kraterförmig mit schwach wulstigem Rand. Der mittelgroße Kelch ist geschlossen bis halb offen, die Kelchblätter sind breit, kurz und am Grund getrennt. Der holzige, braune, am Ende verdickte Stiel ist kurz bis mittellang und sitzt in enger, tiefer Stielgrube.","belege":[{"quelle":"web_pomologen_verein","url":"https://www.pomologen-verein.de/media/user_upload/Landesgruppen/Faltblatt_Lokalsorte_2003.pdf"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Heuchelheimer_Schneeapfel&oldid=257764605"}]},{"thema":"schale","text":"Die Schale ist glatt und glänzend und wird im Lager fettig bis klebrig. In der Vollreife ist die Grundfarbe hellgelb bis weißgelb; stiel- und sonnenseits ist die Frucht bis zu drei Vierteln kräftig rot gestreift und gesprenkelt. Die Schalenpunkte sind unauffällig. Die Stielgrube ist fein strahlig, zimtfarben berostet. Die Früchte duften angenehm.","belege":[{"quelle":"web_pomologen_verein","url":"https://www.pomologen-verein.de/media/user_upload/Landesgruppen/Faltblatt_Lokalsorte_2003.pdf"}]},{"thema":"schnitt","text":"Nach dem Sortenblatt des Pomologen-Vereins ist das Kernhaus flach zwiebelförmig, die Gefäßbündellinie nur schwach ausgeprägt. Die Kernhauswände sind bohnenförmig, breit und glänzend. Die Kerne sind zahlreich, gut ausgebildet, rundlich bis breit und hell kastanienbraun. Die Kelchhöhle wird als breit trichterförmig bis dreieckig beschrieben. Am Schnitt ist das Fleisch weiß und bräunt nach dem Anschneiden kaum.","belege":[{"quelle":"web_pomologen_verein","url":"https://www.pomologen-verein.de/media/user_upload/Landesgruppen/Faltblatt_Lokalsorte_2003.pdf"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Heuchelheimer_Schneeapfel&oldid=257764605"}]},{"thema":"fleisch_geschmack","text":"Das Fruchtfleisch ist weiß, locker, relativ weich und saftig. Der Geschmack ist leicht säuerlich und aromatisch, Zucker und Säure halten sich die Waage. Das Fleisch bleibt auch beim Kochen weiß.","belege":[{"quelle":"web_pomologen_verein","url":"https://www.pomologen-verein.de/media/user_upload/Landesgruppen/Faltblatt_Lokalsorte_2003.pdf"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Heuchelheimer_Schneeapfel&oldid=257764605"}]},{"thema":"reife_lagerung","text":"Die Früchte reifen Ende September, in höheren Lagen bis Mitte Oktober, und sind vom Baum essbar. Sie halten bis April, neigen aber ab Februar zum Welken und verlieren Aroma.","belege":[{"quelle":"web_pomologen_verein","url":"https://www.pomologen-verein.de/media/user_upload/Landesgruppen/Faltblatt_Lokalsorte_2003.pdf"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Heuchelheimer_Schneeapfel&oldid=257764605"}]},{"thema":"verwendung","text":"Der Schneeapfel wird als Tafelapfel geschätzt und eignet sich ebenso als Wirtschaftsapfel. Weil das Fleisch nicht bräunt, empfehlen ihn die Quellen besonders für Obstsalat, als Backapfel und für sortenreine Säfte und Apfelweine.","belege":[{"quelle":"web_pomologen_verein","url":"https://www.pomologen-verein.de/media/user_upload/Landesgruppen/Faltblatt_Lokalsorte_2003.pdf"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Heuchelheimer_Schneeapfel&oldid=257764605"}]},{"thema":"baum","text":"Der Baum wächst mittelstark mit breitkugeliger, wenig verzweigter Krone; das einjährige Holz ist rötlich, das Laub hellgrün und gesund. Er braucht einen konsequenten Erziehungsschnitt und später regelmäßiges Auslichten. Die Sorte ist anspruchslos an Boden und Klima, frosthart, auch in Lagen bis 500 m geeignet und nur schwach schorfanfällig. Die Blüte ist mittelfrüh bis mittelspät und witterungsunempfindlich. Der Ertrag setzt mittelfrüh ein und wechselt stark zwischen sehr hohen und geringen Ernten.","belege":[{"quelle":"web_pomologen_verein","url":"https://www.pomologen-verein.de/media/user_upload/Landesgruppen/Faltblatt_Lokalsorte_2003.pdf"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Heuchelheimer_Schneeapfel&oldid=257764605"}]}],"bilder":[{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/f/f4/Malus_Heuchelheimer_Schneeapfel_4324.jpg/960px-Malus_Heuchelheimer_Schneeapfel_4324.jpg","seite":"https://commons.wikimedia.org/wiki/File:Malus_Heuchelheimer_Schneeapfel_4324.jpg","art":"frucht","urheber":"Sven Teschke","lizenz":"CC BY-SA 3.0 de","quelle":"commons","titel":"Malus Heuchelheimer Schneeapfel 4324.jpg"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/6/67/Apfel_068_Heuchelheimer_Schneeapfel_%28fcm%29.jpg/960px-Apfel_068_Heuchelheimer_Schneeapfel_%28fcm%29.jpg","seite":"https://commons.wikimedia.org/wiki/File:Apfel_068_Heuchelheimer_Schneeapfel_(fcm).jpg","art":"frucht","urheber":"Photograph: Frank C. Müller , Frankfurt am Main","lizenz":"CC BY-SA 4.0","quelle":"commons-fotos","titel":"Apfel 068 Heuchelheimer Schneeapfel (fcm)"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/5/5a/Apfel_069_Heuchelheimer_Schneeapfel_%28fcm%29.jpg/960px-Apfel_069_Heuchelheimer_Schneeapfel_%28fcm%29.jpg","seite":"https://commons.wikimedia.org/wiki/File:Apfel_069_Heuchelheimer_Schneeapfel_(fcm).jpg","art":"frucht","urheber":"Photograph: Frank C. Müller , Frankfurt am Main","lizenz":"CC BY-SA 4.0","quelle":"commons-fotos","titel":"Apfel 069 Heuchelheimer Schneeapfel (fcm)"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/10/Heuchelheimer_Schneeapfel.jpg/960px-Heuchelheimer_Schneeapfel.jpg","seite":"https://commons.wikimedia.org/wiki/File:Heuchelheimer_Schneeapfel.jpg","art":"frucht","urheber":"Bahnmoeller","lizenz":"CC BY-SA 3.0","quelle":"commons-fotos","titel":"Heuchelheimer Schneeapfel"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/0/03/Heuchelheimer_Schneeapfel_jm55255.jpg/960px-Heuchelheimer_Schneeapfel_jm55255.jpg","seite":"https://commons.wikimedia.org/wiki/File:Heuchelheimer_Schneeapfel_jm55255.jpg","art":"baum","urheber":"joergens.mi","lizenz":"CC BY-SA 3.0","quelle":"commons-fotos","titel":"Heuchelheimer Schneeapfel jm55255"}]}