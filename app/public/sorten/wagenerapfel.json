za C","lizenz":"gemeinfrei","quelle":"usda-pomological","titel":"Pomological Watercolor POM00003959"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/f/f8/Pomological_Watercolor_POM00004009.jpg/960px-Pomological_Watercolor_POM00004009.jpg","seite":"https://commons.wikimedia.org/wiki/File:Pomological_Watercolor_POM00004009.jpg","art":"tafel","urheber":"Amanda Newton","lizenz":"gemeinfrei","quelle":"usda-pomological","titel":"Pomological Watercolor POM00004009"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/6/63/Pomological_Watercolor_POM00004010.jpg/960px-Pomological_Watercolor_POM00004010.jpg","seite":"https://commons.wikimedia.org/wiki/File:Pomological_Watercolor_POM00004010.jpg","art":"tafel","urheber":"Arnold, Mary Daisy, ca. 1873-1955","lizenz":"gemeinfrei","quelle":"usda-pomological","titel":"Pomological Watercolor POM00004010"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/5/54/Pomological_Watercolor_POM00004012.jpg/960px-Pomological_Watercolor_POM00004012.jpg","seite":"https://commons.wikimedia.org/wiki/File:Pomological_Watercolor_POM00004012.jpg","art":"tafel","urheber":"Amanda Newton","lizenz":"gemeinfrei","quelle":"usda-pomological","titel":"Pomological Watercolor POM00004012"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/8f/Pomological_Watercolor_POM00004097.jpg/960px-Pomological_Watercolor_POM00004097.jpg","seite":"https://commons.wikimedia.org/wiki/File:Pomological_Watercolor_POM00004097.jpg","art":"tafel","urheber":"Royal Charles Steadman","lizenz":"gemeinfrei","quelle":"usda-pomological","titel":"Pomological Watercolor POM00004097"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/f/ff/Biennial_report_of_the_Montana_State_Board_of_Horticulture_to_the_Legislative_Assembly_of_the_state_of_Montana_for_the_years_%281901%29_%2819746929174%29.jpg/960px-Biennial_report_of_the_Montana_State_Board_of_Horticulture_to_the_Legislative_Assembly_of_the_state_of_Montana_for_the_years_%281901%29_%281