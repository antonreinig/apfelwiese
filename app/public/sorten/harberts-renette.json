{"id":"harberts-renette","name":"Harberts Renette","synonyme":[{"name":"Harbert's Reinette","beleg":{"quelle":"engelbrecht1889","seite":"593 (Nr. 536)"}},{"name":"Harbert's reinettenartiger Rambour","beleg":{"quelle":"engelbrecht1889","seite":"593 (Nr. 536)"}},{"name":"Reinette Harbert","beleg":{"quelle":"engelbrecht1889","seite":"593 (Nr. 536)"}},{"name":"Harberts Reinette","beleg":{"quelle":"illustr_hb_4","band":"IV","seite":"163"}},{"name":"Harberts Rambourreinette","beleg":{"quelle":"illustr_hb_4","band":"IV","seite":"163"}},{"name":"Harberts Rambur-Renette","beleg":{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Harberts_Renette&oldid=260386346"}},{"name":"Harberts Renett","beleg":{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Harberts_Renette&oldid=260386346"}}],"herkunft":{"text":"Vermutlich in Westfalen entstanden, nach Diels Vermutung in einem Kloster; Herkunft nicht sicher bekannt. Diel erhielt die Sorte vom Landpfennigmeister Carl Ludwig Anton Maria Harbert in Arnsberg und beschrieb sie 1828 als Harbert's reinettenartigen Rambour. Ab 1830 verbreitete Harbert sie, 1857 empfahl die Versammlung Deutscher Pomologen in Gotha sie zum allgemeinen Anbau.","belege":[{"quelle":"illustr_hb_4","band":"IV","seite":"163"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Harberts_Renette&oldid=260386346"}]},"merkmale":[{"merkmal":"frucht_breite","wert":87,"original":"Gestalt 87:71—75","quelle":"engelbrecht1889","seite":"593 (Nr. 536)"},{"merkmal":"frucht_hoehe","wert":73,"original":"Gestalt 87:71—75","quelle":"engelbrecht1889","seite":"593 (Nr. 536)"},{"merkmal":"frucht_hoehe_breite","wert":0.84,"original":"Gestalt 87:71—75","quelle":"engelbrecht1889","seite":"593 (Nr. 536)"},{"merkmal":"frucht_form","wert":"stumpfkonisch","original":"abgestumpft flachrund kegelf.","quelle":"engelbrecht1889","seite":"593 (Nr. 536)"},{"merkmal":"frucht_breiteste_stelle","wert":"stiel","original":"etwas stiel