merkmal":"schale_deckfarbe_art","wert":"verwaschen","quelle":"nfc2025","seite":"Akzession 1948653 (Smith 1971); Akzession 1970085 (NFC-Früchte)","original":"Flush with stripes"},{"merkmal":"schale_berostung_gesamt","wert":"3","quelle":"nfc2025","seite":"Akzession 1970085 (NFC-Früchte)","original":"Low"},{"merkmal":"fleisch_farbe","wert":"weiss","quelle":"nfc2025","seite":"Akzession 1948653 (Smith 1971); Akzession 1970085 (NFC-Früchte)","original":"White"},{"merkmal":"verwendung","wert":"kueche","quelle":"nfc2025","seite":"Akzession 1948653; Akzession 1970085","original":"Culinary"},{"merkmal":"pflueckreife","wert":"10","quelle":"nfc2025","seite":"Akzession 1948653","original":"Early October"},{"merkmal":"pflueckreife","wert":"10","quelle":"nfc2025","seite":"Akzession 1970085","original":"Mid October"},{"merkmal":"genussreife_ende","wert":"1","quelle":"nfc2025","seite":"Akzession 1970085","original":"January"},{"merkmal":"genussreife_ende","wert":"2","quelle":"nfc2025","seite":"Akzession 1948653","original":"February"},{"merkmal":"bluete_zeit","wert":"3","quelle":"nfc2025","seite":"Akzession 1948653","original":"Klasse 4 (10 % der Blüten offen, Tag 123)"},{"merkmal":"bluete_zeit","wert":"5","quelle":"nfc2025","seite":"Akzession 1948653","original":"Klasse 4 (10 % der Blüten offen, Tag 123)"},{"merkmal":"bluete_zeit","wert":"5","quelle":"nfc2025","seite":"Akzession 1970085","original":"Klasse 5 (10 % der Blüten offen, Tag 126)"},{"merkmal":"hochstamm","wert":"gut","original":"er eignet sich auch für den Streuobstbau","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Bismarckapfel&oldid=246654755"},{"merkmal":"standort_klima","wert":"3","original":"für den Streuobstbau und für höhere Lagen","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Bismarckapfel&oldid=246654755"},{"merkmal":"ertrag_beginn","wert":"mittel","original":"Der Ertrag setzt mittelfrüh ein","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Bismarckapfel&oldid=246654755"},{"merkmal":"ertrag_alternanz","wert":"regelmaessig","original":"ist eher regelmäßig","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Bismarckapfel&oldid=246654755"},{"merkmal":"bluete_frost","wert":"3","original":"Die Blüte beginnt mittelfrüh und gilt als wenig empfindlich","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Bismarckapfel&oldid=246654755"},{"merkmal":"anfaelligkeit_schorf","wert":"5","original":"etwas anfällig für Schorf, Obstbaumkrebs und Mehltau","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Bismarckapfel&oldid=246654755"},{"merkmal":"anfaelligkeit_krebs","wert":"5","original":"etwas anfällig für Schorf, Obstbaumkrebs und Mehltau","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Bismarckapfel&oldid=246654755"},{"merkmal":"anfaelligkeit_mehltau","wert":"5","original":"etwas anfällig für Schorf, Obstbaumkrebs und Mehltau","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Bismarckapfel&oldid=246654755"},{"merkmal":"lagerfaehigkeit","wert":"7","original":"hält sich im besten Fall bis März","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Bismarckapfel&oldid=246654755"}],"texte":[{"thema":"ueberblick","text":"Der Bismarckapfel ist ein großer, plattrunder Koch- und Wirtschaftsapfel, der sich gut lagern lässt. Weil er sich gut als Busch ziehen lässt, ist er im Gartenobstbau bis heute ziemlich verbreitet; er eignet sich auch für den Streuobstbau und für höhere Lagen.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Bismarckapfel&oldid=246654755"}]},{"thema":"herkunft","text":"Die Sorte stammt aus dem Ort Bismarck auf Tasmanien, wo sie um 1870 bekannt wurde, und gelangte über Neuseeland und England um 1888 nach Europa.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Bismarckapfel&oldid=246654755"}]},{"thema":"frucht","text":"Die Früchte sind groß, plattrund und schwach gerippt. Die Grundfarbe ist gelb- bis weißgrünlich, die Deckfarbe hellrot bis braunrot.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Bismarckapfel&oldid=246654755"}]},{"thema":"fleisch_geschmack","text":"Das Fruchtfleisch ist weiß und schmeckt säuerlich mit schwacher Würze. Angaben zum Kernhaus und zur Kelchhöhle fehlen in der vorliegenden Quelle.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Bismarckapfel&oldid=246654755"}]},{"thema":"reife_lagerung","text":"Als Winterapfel ist der Bismarckapfel ab November genussreif und hält sich im besten Fall bis März.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Bismarckapfel&oldid=246654755"}]},{"thema":"baum","text":"Der Baum wächst in den ersten Jahren stark, später schwächer; gelegentliche kräftige Rückschnitte bleiben nötig. Der Ertrag setzt mittelfrüh ein und ist eher regelmäßig. Die Blüte beginnt mittelfrüh und gilt als wenig empfindlich. Das Holz ist frostfest, der Baum aber etwas anfällig für Schorf, Obstbaumkrebs und Mehltau. Auf guten Böden ist Anbau bis in mittlere Höhenlagen möglich.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Bismarckapfel&oldid=246654755"}]},{"thema":"verwendung","text":"Die Früchte eignen sich sehr gut zum Kochen, Braten und Backen und sind noch als Tafelapfel brauchbar.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Bismarckapfel&oldid=246654755"}]},{"thema":"unterscheidung","text":"Der Bismarckapfel ist nicht dieselbe Sorte wie der Fürst Bismarck. Engelbrecht beschreibt unter diesem Namen 1889 eine Gold-Reinette von Frensdorff, kleiner (55:46–47 mm), abgestumpft rundlich eiförmig und von Dezember bis April genussreif.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Bismarckapfel&oldid=246654755"},{"quelle":"engelbrecht1889","seite":"606 (Nr. 548)"}]},{"thema":"frucht","text":"Nach den Erhebungen der National Fruit Collection: großer, breit rundlich-kegelförmiger Apfel mit weißlich grüner Grundfarbe und flächiger und gestreifter orangefarbener Deckfarbe auf einem mittleren bis großen Teil der Schale. Das Fruchtfleisch ist weiß, die Schale wenig berostet. Küchenapfel, pflückreif Mitte Oktober und lagerfähig bis Januar.","belege":[{"quelle":"nfc2025","seite":"Akzession 1948653, 1970085"}]}],"bilder":[{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/0/06/Malus_Bismarckapfel_4523.jpg/960px-Malus_Bismarckapfel_4523.jpg","seite":"https://commons.wikimedia.org/wiki/File:Malus_Bismarckapfel_4523.jpg","art":"frucht","urheber":"Sven Teschke","lizenz":"CC BY-SA 3.0 de","quelle":"commons","titel":"Malus Bismarckapfel 4523.jpg"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/0/0d/Bismarck_Apfel_jm55140.jpg/960px-Bismarck_Apfel_jm55140.jpg","seite":"https://commons.wikimedia.org/wiki/File:Bismarck_Apfel_jm55140.jpg","art":"frucht","urheber":"joergens.mi","lizenz":"CC BY-SA 3.0","quelle":"commons","titel":"Bismarck Apfel jm55140.jpg"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/0/09/Apple_seeds_-_variety_Bismarckapfel_%28aka%29.jpg/960px-Apple_seeds_-_variety_Bismarckapfel_%28aka%29.jpg","seite":"https://commons.wikimedia.org/wiki/File:Apple_seeds_-_variety_Bismarckapfel_(aka).jpg","art":"frucht","urheber":"André Karwath aka Aka","lizenz":"CC BY-SA 2.5","quelle":"commons","titel":"Apple seeds - variety Bismarckapfel (aka).jpg"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/5/5c/Bismarckapfel_%28Panorama%29.jpg/960px-Bismarckapfel_%28Panorama%29.jpg","seite":"https://commons.wikimedia.org/wiki/File:Bismarckapfel_(Panorama).jpg","art":"frucht","urheber":"Conrad Nutschan in Zusammenarbeit mit Stefanie Stallknecht und Marco Werner","lizenz":"CC BY-SA 3.0","quelle":"commons","titel":"Bismarckapfel (Panorama).j