lle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Ontarioapfel&oldid=260295298"},{"merkmal":"geschmack_saeure","wert":"7","original":"Ausgereift ist der Apfel spritzig säuerlich","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Ontarioapfel&oldid=260295298"},{"merkmal":"pflueckreife","wert":"10","original":"Mitte Oktober bis Mitte November ist er pflückreif","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Ontarioapfel&oldid=260295298"},{"merkmal":"pflueckreife","wert":"11","original":"Mitte Oktober bis Mitte November ist er pflückreif","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Ontarioapfel&oldid=260295298"},{"merkmal":"genussreife_beginn","wert":"12","original":"kann von Dezember bis Mai gegessen werden","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Ontarioapfel&oldid=260295298"},{"merkmal":"genussreife_ende","wert":"5","original":"kann von Dezember bis Mai gegessen werden","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Ontarioapfel&oldid=260295298"},{"merkmal":"verwendung","wert":"tafel","original":"Tafelobstsorte","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Ontarioapfel&oldid=260295298"},{"merkmal":"verwendung","wert":"kueche","original":"Er eignet sich auch als Backapfel und für die Fruchtsaft-Herstellung","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Ontarioapfel&oldid=260295298"},{"merkmal":"verwendung","wert":"most","original":"Er eignet sich auch als Backapfel und für die Fruchtsaft-Herstellung","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Ontarioapfel&oldid=260295298"},{"merkmal":"frucht_groesse","wert":"5","quelle":"nfc2025","seite":"Akzession 1923058 (NFC-Früchte)","original":"Medium to large"},{"merkmal":"frucht_groesse","wert":"7","quelle":"nfc2025","seite":"Akzession 1923058 (NFC-Früchte)","original":"Medium to large"},{"merkmal":"frucht_form","wert":"breitrundkonisch","quelle":"nfc2025","seite":"Akzession 1923058 (NFC-Früchte)","original":"Broad globose conical"},{"merkmal":"frucht_rippung","wert":"7","quelle":"nfc2025","seite":"Akzession 1923058 (NFC-Früchte)","original":"Strong"},{"merkmal":"schale_grundfarbe","wert":"gruengelb","quelle":"nfc2025","seite":"Akzession 1923058 (NFC-Früchte)","original":"Green yellow"},{"merkmal":"schale_deckfarbe_farbton","wert":"rot","quelle":"nfc2025","seite":"Akzession 1923058 (NFC-Früchte)","original":"Red"},{"merkmal":"schale_deckfarbe_art","wert":"marmoriert","quelle":"nfc2025","seite":"Akzession 1923058 (NFC-Früchte)","original":"Mottled"},{"merkmal":"fleisch_farbe","wert":"weiss","quelle":"nfc2025","seite":"Akzession 1923058 (NFC-Früchte)","original":"White"},{"merkmal":"verwendung","wert":"kueche","quelle":"nfc2025","seite":"Akzession 1923058","original":"Culinary"},{"merkmal":"pflueckreife","wert":"10","quelle":"nfc2025","seite":"Akzession 1923058","original":"Late October"},{"merkmal":"genussreife_ende","wert":"4","quelle":"nfc2025","seite":"Akzession 1923058","original":"April"},{"merkmal":"bluete_zeit","wert":"5","quelle":"nfc2025","seite":"Akzession 1923058","original":"Klasse 5 (10 % der Blüten offen, Tag 127)"},{"merkmal":"frucht_groesse","wert":"5","quelle":"nfc2025","seite":"Akzession 1965037 (NFC-Früchte)","original":"Medium to large"},{"merkmal":"frucht_groesse","wert":"7","quelle":"nfc2025","seite":"Akzession 1965037 (NFC-Früchte)","original":"Medium to large"},{"merkmal":"frucht_form","wert":"breitrundkonisch","quelle":"nfc2025","seite":"Akzession 1965037 (NFC-Früchte)","original":"Broad globose conical"},{"merkmal":"frucht_rippung","wert":"7","quelle":"nfc2025","seite":"Akzession 1965037 (NFC-Früchte)","original":"Strong"},{"merkmal":"schale_grundfarbe","wert":"gruengelb","quelle":"nfc2025","seite":"Akzession 1965037 (NFC-Früchte)","original":"Green yellow"},{"merkmal":"schale_deckfarbe_farbton","wert":"rot","quelle":"nfc2025","seite":"Akzession 1965037 (NFC-Früchte)","original":"Red"},{"merkmal":"schale_deckfarbe_art","wert":"marmoriert","quelle":"nfc2025","seite":"Akzession 1965037 (NFC-Früchte)","original":"Mottled"},{"merkmal":"fleisch_farbe","wert":"weiss","quelle":"nfc2025","seite":"Akzession 1965037 (NFC-Früchte)","original":"White"},{"merkmal":"verwendung","wert":"kueche","quelle":"nfc2025","seite":"Akzession 1965037","original":"Culinary"},{"merkmal":"pflueckreife","wert":"10","quelle":"nfc2025","seite":"Akzession 1965037","original":"Late October"},{"merkmal":"genussreife_ende","wert":"4","quelle":"nfc2025","seite":"Akzession 1965037","original":"April"},{"merkmal":"bluete_zeit","wert":"5","quelle":"nfc2025","seite":"Akzession 1965037","original":"Klasse 6 (10 % der Blüten offen, Tag 131)"},{"merkmal":"bluete_zeit","wert":"7","quelle":"nfc2025","seite":"Akzession 1965037","original":"Klasse 6 (10 % der Blüten offen, Tag 131)"}],"texte":[{"thema":"ueberblick","text":"Großfrüchtiger, lange lagerfähiger Winterapfel aus Kanada, der heute noch in West- und Mitteleuropa angebaut wird. In den 1920er Jahren gehörte er zu den drei Apfelsorten, die zu Reichsobstsorten gewählt wurden. In den hier ausgewerteten alten Werken (Engelbrecht 1889, Illustrirtes Handbuch) ist er nicht beschrieben.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Ontarioapfel&oldid=260295298"}]},{"thema":"herkunft","text":"Charles Arnold kreuzte die Sorte um 1874 in Paris in der kanadischen Provinz Ontario aus Northern Spy und Wagenerapfel. Nach Europa kam sie 1882 über die Baumschule Transon Frères in Orléans. Aus Ontario gingen der Edle von Leipzig (mit Jakob Lebel, um 1900) und der Schweizer Orangenapfel (mit Cox Orangenrenette, 1935 in Wädenswil) hervor.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Ontarioapfel&oldid=260295298"}]},{"thema":"frucht","text":"Die Früchte sind groß und flachkugelig; wegen dieser Form eignet sich die Sorte schlecht für Sortieranlagen und hat im Erwerbsanbau an Bedeutung verloren. Die Stielgrube ist weit und kann stärker berostet sein.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Ontarioapfel&oldid=260295298"}]},{"thema":"schale","text":"Die Schale ist glatt und geschmeidig, grünlich-gelb, auf der Sonnenseite bläulich-rot bis dunkelrot verwaschen und bläulich bereift. Sie trägt kleine helle Schalenpunkte und vereinzelt Rostpunkte.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Ontarioapfel&oldid=260295298"}]},{"thema":"fleisch_geschmack","text":"Das Fleisch ist grünlich-weiß, weich, feinzellig und saftig. Ausgereift schmeckt der Apfel spritzig säuerlich; der Vitamin-C-Gehalt ist hoch.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Ontarioapfel&oldid=260295298"}]},{"thema":"reife_lagerung","text":"Pflückreif von Mitte Oktober bis Mitte November. Die Früchte brauchen Lagerzeit bis zur Genussreife, sind problemlos lagerfähig und können von Dezember bis Mai gegessen werden.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Ontarioapfel&oldid=260295298"}]},{"thema":"baum","text":"Der Baum wächst mittelstark und braucht nährstoffreiche Böden. Er blüht mittelspät; die Blüten sind ungewöhnlich frosthart, sodass er auch in frostigen Jahren trägt und als Pollenspender geschätzt wird. Das Holz ist dagegen frostempfindlich, deshalb passt die Sorte in warme Lagen mit Spätfrostgefahr, nicht aber in Gegenden mit starken Winterfrösten.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Ontarioapfel&oldid=260295298"}]},{"thema":"verwendung","text":"Tafelapfel, außerdem als Backapfel und für Fruchtsaft geeignet.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Ontarioapfel&oldid=260295298"}]},{"thema":"frucht","text":"Nach den Erhebungen der National Fruit Collection: mittelgroßer bis großer, breit rundlich-kegelförmiger Apfel mit grünlich gelber Grundfarbe und marmorierter roter Deckfarbe. Das Fruchtfleisch ist weiß. In der Sammlung als Küchenapfel geführt; pflückreif Ende Oktober, lagerfähig bis April.","belege":[{"quelle":"nfc2025","seite":"Akzession 1923058"}]},{"thema":"frucht","text":"Nach den Erhebungen der National Fruit Collection: die Sorte bildet mittelgroße bis große, breit rundlich-kegelförmige Früchte mit grünlich gelber Grundfarbe und marmorierter roter Deckfarbe. Das Fruchtfleisch ist weiß. Küchenapfel, pflückreif Ende Oktober und lagerfähig bis April.","belege":[{"quelle":"nfc2025","seite":"Akzession 1965037"}]}],"bilder":[{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/98/Malus_Ontario_4241.jpg/960px-Malus_Ontario_4241.jpg","seite":"https://commons.wikimedia.org/wiki/File:Malus_Ontario_4241.jpg","art":"frucht","urheber":"Sven Teschke","lizenz":"CC BY-SA 3.0 de","quelle":"commons","titel":"Malus Ontario 4241.jpg"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/a/a4/Ontario_jm55055.jpg/960px-Ontario_jm55055.jpg","seite":"https://commons.wikimedia.org/wiki/File:Ontario_jm55055.jpg","art":"frucht","urheber":"joergens.mi","lizenz":"CC BY-SA 3.0","quelle":"commons","titel":"Ontario jm55055.jpg"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/2/2f/Apple_seeds_Ontario.jpg/960px-Apple_seeds_Ontario.jpg","seite":"https://commons.wikimedia.org/wiki/File:Apple_seeds_Ontario.jpg","art":"frucht","urheber":"El tommo","lizenz":"CC0","quelle":"commons","titel":"Apple seeds Ontario.jpg"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/a/aa/Apple_Blossom_Ontario.jpg/960px-Apple_Blossom_Ontario.jpg","seite":"https://commons.wikimedia.org/wiki/File:Apple_Blossom_Ontario.jpg","art":"bluete","urheber":"El tommo","lizenz":"CC0","quelle":"commons","titel":"Apple Blossom Ontario.jpg"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/87/Krone_eines_Ontarioapf