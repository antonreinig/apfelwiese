{"id":"cornwalliser-nelkenapfel","name":"Cornwalliser Nelkenapfel","synonyme":[{"name":"Cornish Gilliflower","beleg":{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Cornwalliser_Nelkenapfel&oldid=255083760"}},{"name":"Cornish Gillyflower","beleg":{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Cornwalliser_Nelkenapfel&oldid=255083760"}},{"name":"Red Gilliflower","beleg":{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Cornwalliser_Nelkenapfel&oldid=255083760"}},{"name":"Calville d'Angleterre","beleg":{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Cornwalliser_Nelkenapfel&oldid=255083760"}},{"name":"Nelkenapfel","beleg":{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Cornwalliser_Nelkenapfel&oldid=255083760"}},{"name":"Calleville d'Angleterre","beleg":{"quelle":"engelbrecht1889","seite":"44 (Nr. 40)"}},{"name":"Julyflower","beleg":{"quelle":"illustr_hb_1","band":"I","seite":"201"}},{"name":"Cornish Julyflower","beleg":{"quelle":"illustr_hb_1","band":"I","seite":"201"}},{"name":"Pomme Regelans","beleg":{"quelle":"illustr_hb_1","band":"I","seite":"201"}}],"herkunft":{"text":"Zufallssämling aus einem Garten bei Truro in Cornwall (England). Sir Christopher Hawkins schickte die Sorte 1813 an die Horticultural Society in London; sie war nach seinen Angaben 10 bis 15 Jahre zuvor gefunden worden. Nach einer molekulargenetischen Untersuchung der Deutschen Genbank Obst ist sie eine Tochtersorte der alten englischen Sorte Gilliflower.","belege":[{"quelle":"illustr_hb_1","band":"I","seite":"201"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Cornwalliser_Nelkenapfel&oldid=255083760"}]},"merkmale":[{"merkmal":"frucht_breite","wert":75,"original":"Gestalt 75:80—82","quelle":"engelbrecht1889","seite":"44 (Nr. 40)"},{"merkmal":"frucht_hoehe","wert":81,"original":"Gestalt 75:80—82","quelle":"engelbrecht1889","seite":"44 (Nr. 40)"},{"merkmal":"frucht_hoehe_breite","wert":1.08,"original":"Gestalt 75:80—82","quelle":"engelbrecht1889","seite":"44 (Nr. 40)"},{"merkmal":"frucht_form","wert":"stumpfkonisch","original":"schwach abgest. kegelf.","quelle":"engelbrecht1889","seite":"44 (Nr. 40)"},{"merkmal":"frucht_breiteste_stelle","wert":"stiel","original":"stielbauchig","quelle":"engelbrecht1889","seite":"44 (Nr. 40)"},{"merkmal":"frucht_symmetrie","wert":"symmetrisch","original":"Hälften fast gleich","quelle":"engelbrecht1889","seite":"44 (Nr. 40)"},{"merkmal":"frucht_rippung","wert":"5","original":"Querschn. etwas kantig","quelle":"engelbrecht1889","seite":"44 (Nr. 40)"},{"merkmal":"frucht_kronung","wert":"5","original":"zwischen deutlichen, sich abflachend bis zum Stiele laufenden Rippen","quelle":"engelbrecht1889","seite":"44 (Nr. 40)"},{"merkmal":"kelch_offenheit","wert":"geschlossen","original":"Kelch geschlossen, selten fast halb offen","quelle":"engelbrecht1889","seite":"44 (Nr. 40)"},{"merkmal":"kelchgrube_tiefe","wert":"3","original":"Einsenkung ziemlich flach und enge","quelle":"engelbrecht1889","seite":"44 (Nr. 40)"},{"merkmal":"kelchgrube_weite","wert":"3","original":"Einsenkung ziemlich flach und enge","quelle":"engelbrecht1889","seite":"44 (Nr. 40)"},{"merkmal":"stiel_dicke","wert":"3","original":"Stiel holzig, dünn bis mitteldick, etwa 18 mm lang","quelle":"engelbrecht1889","seite":"44 (Nr. 40)"},{"merkmal":"stiel_dicke","wert":"5","original":"Stiel holzig, dünn bis mitteldick, etwa 18 mm lang","quelle":"engelbrecht1889","seite":"44 (Nr. 40)"},{"merkmal":"stielgrube_tiefe","wert":"7","original":"Höhle meistens ziemlich tief, mittelweit","quelle":"engelbrecht1889","seite":"44 (Nr. 40)"},{"merkmal":"stielgrube_weite","wert":"5","original":"Höhle meistens ziemlich tief, mittelweit","quelle":"engelbrecht1889","seite":"44 (Nr. 40)"},{"merkmal":"schale_berostung_stielgrube","wert":"3","original":"Höhle … etwas faltig, schwach berostet","quelle":"engelbrecht1889","seite":"44 (Nr. 40)"},{"merkmal":"schale_beschaffenheit","wert":"glatt","original":"Schale glatt","quelle":"engelbrecht1889","seite":"44 (Nr. 40)"},{"merkmal":"schale_grundfarbe","wert":"gelbgruen","original":"grün, später heller, etwas gelblichgrün, selten gelb","quelle":"engelbrecht1889","seite":"44 (Nr. 40)"},{"merkmal":"schale_deckfarbe_anteil","wert":"5","original":"sonnenw. trübroth überzogen","quelle":"engelbrecht1889","seite":"44 (Nr. 40)"},{"merkmal":"schale_deckfarbe_farbton","wert":"braunrot","original":"sonnenw. trübroth überzogen","quelle":"engelbrecht1889","seite":"44 (Nr. 40)"},{"merkmal":"schale_deckfarbe_art","wert":"verwaschen","original":"sonnenw. trübroth überzogen","quelle":"engelbrecht1889","seite":"44 (Nr. 40)"},{"merkmal":"schale_deckfarbe_art","wert":"gestreift","original":"wenigstens schattenw. deutlich dunkler gestreift","quelle":"engelbrecht1889","seite":"44 (Nr. 40)"},{"merkmal":"schale_lentizellen_anzahl","wert":"3","original":"Punkte sparsam, fein bis mitteldick, bräunlich","quelle":"engelbrecht1889","seite":"44 (Nr. 40)"},{"merkmal":"schale_lentizellen_groesse","wert":"3","original":"Punkte … fein bis mitteldick","quelle":"engelbrecht1889","seite":"44 (Nr. 40)"},{"merkmal":"schale_lentizellen_groesse","wert":"5","original":"Punkte … fein bis mitteldick","quelle":"engelbrecht1889","seite":"44 (Nr. 40)"},{"merkmal":"schale_lentizellen_art","wert":"braun","original":"Punkte … bräunlich","quelle":"engelbrecht1889","seite":"44 (Nr. 40)"},{"merkmal":"schale_berostung_wangen","wert":"3","original":"Rostfiguren finden sich selten","quelle":"engelbrecht1889","seite":"44 (Nr. 40)"},{"merkmal":"kernhaus_form","wert":"eifoermig","original":"Kernhaus 41:52, meistens eiförmig","quelle":"engelbrecht1889","seite":"44 (Nr. 40)"},{"merkmal":"kernfaecher_oeffnung","wert":"teilweise","original":"Kammern … mittelgeräumig, wenig offen","quelle":"engelbrecht1889","seite":"44 (Nr. 40)"},{"merkmal":"kernhaus_achse","wert":"offen","original":"Achsenh. schmal","quelle":"engelbrecht1889","seite":"44 (Nr. 40)"},{"merkmal":"kerne_form","wert":"eifoermig","original":"Kerne meist zu 1, mässig gross, ziemlich vollkommen, eiförmig, gespitzt","quelle":"engelbrecht1889","seite":"44 (Nr. 40)"},{"merkmal":"kelchhoehle_form","wert":"trichter_kurz","original":"Kelchhöhle kegel- bis kegeltrichterförmig, ⅓ bis ⅗ zur Achsenh.","quelle":"engelbrecht1889","seite":"44 (Nr. 40)"},{"merkmal":"fleisch_farbe","wert":"cremeweiss","original":"Fleisch hellgrüngelblich bis gelblichweiss","quelle":"engelbrecht1889","seite":"44 (Nr. 40)"},{"merkmal":"fleisch_festigkeit","wert":"3","original":"erst ziemlich fest, später mürbe, fast locker","quelle":"engelbrecht1889","seite":"44 (Nr. 40)"},{"merkmal":"fleisch_saftigkeit","wert":"7","original":"fast locker, saftig","quelle":"engelbrecht1889","seite":"44 (Nr. 40)"},{"merkmal":"geschmack_suesse","wert":"5","original":"etwas vorherrschend, doch mild weinig, fast ebenso süss","quelle":"engelbrecht1889","seite":"44 (Nr. 40)"},{"merkmal":"geschmack_saeure","wert":"5","original":"etwas vorherrschend, doch mild weinig, fast ebenso süss","quelle":"engelbrecht1889","seite":"44 (Nr. 40)"},{"merkmal":"geschmack_aroma","wert":"calvillartig gewürzt","original":"calvillartig gewürzt","quelle":"engelbrecht1889","seite":"44 (Nr. 40)"},{"merkmal":"verwendung","wert":"tafel","original":"oo+ (Kopfzeile)","quelle":"engelbrecht1889","seite":"44 (Nr. 40)"},{"merkmal":"verwendung","wert":"kueche","original":"oo+ (Kopfzeile)","quelle":"engelbrecht1889","seite":"44 (Nr. 40)"},{"merkmal":"genussreife_beginn","wert":"12","original":"December bis März","quelle":"engelbrecht1889","seite":"44 (Nr. 40)"},{"merkmal":"genussreife_ende","wert":"3","original":"December bis März","quelle":"engelbrecht1889","seite":"44 (Nr. 40)"},{"merkmal":"frucht_groesse","wert":"7","original":"ein großer 3½“ hoher und fast ebenso breiter Apfel","quelle":"illustr_hb_1","band":"I","seite":"201"},{"merkmal":"frucht_form","wert":"konisch","original":"so daß sie eine deutlich zugespitzte Form erhält","quelle":"illustr_hb_1","band":"I","seite":"201"},{"merkmal":"frucht_breiteste_stelle","wert":"stiel","original":"der Bauch sitzt etwas unter der Mitte","quelle":"illustr_hb_1","band":"I","seite":"201"},{"merkmal":"kelch_offenheit","wert":"geschlossen","original":"Kelch: großblättrig, geschlossen","quelle":"illustr_hb_1","band":"I","seite":"201"},{"merkmal":"kelchgrube_weite","wert":"3","original":"in einer gewöhnlich nur kleinen, mit Falten besetzten Einsenkung","quelle":"illustr_hb_1","band":"I","seite":"201"},{"merkmal":"frucht_kronung","wert":"5","original":"in einer gewöhnlich nur kleinen, mit Falten besetzten Einsenkung","quelle":"illustr_hb_1","band":"I","seite":"201"},{"merkmal":"stiel_dicke","wert":"7","original":"Stiel … ziemlich stark und holzig","quelle":"illustr_hb_1","band":"I","seite":"201"},{"merkmal":"schale_beschaffenheit","wert":"glaenzend","original":"Schale: fein, glänzend","quelle":"illustr_hb_1","band":"I","seite":"201"},{"merkmal":"schale_grundfarbe","wert":"gruen","original":"vom Baum dunkelgrün, welche Farbe auch auf der Schattenseite bleibt","quelle":"illustr_hb_1","band":"I","seite":"201"},{"merkmal":"schale_deckfarbe_anteil","wert":"5","original":"Die Sonnenseite ist braunröthlich … glänzend bräunlich roth gestreift","quelle":"illustr_hb_1","band":"I","seite":"201"},{"merkmal":"schale_deckfarbe_farbton","wert":"braunrot","original":"braunröthlich … dunkelbraunroth verwaschen","quelle":"illustr_hb_1","band":"I","seite":"201"},{"merkmal":"schale_deckfarbe_art","wert":"gestreift","original":"glänzend bräunlich roth gestreift","quelle":"illustr_hb_1","band":"I","seite":"201"},{"merkmal":"schale_deckfarbe_art","wert":"verwaschen","original":"manche Stellen sind dunkelbraunroth verwaschen","quelle":"illustr_hb_1","band":"I","seite":"201"},{"merkmal":"fleisch_farbe","wert":"gelblich","original":"Fleisch: ziemlich fest, später mürber werdend, gelblich","quelle":"illustr_hb_1","band":"I","seite":"201"},{"merkmal":"geschmack_suesse","wert":"7","original":"von süßweinigem Geschmack","quelle":"illustr_hb_1","band":"I","seite":"201"},{"merkmal":"geschmack_saeure","wert":"5","original":"von süßweinigem Geschmack","quelle":"illustr_hb_1","band":"I","seite":"201"},{"merkmal":"geschmack_aroma","wert":"gewürzhaft, feiner nelkenartiger Geruch","original":"gewürzhaft … und einem feinen nelkenartigen Geruch","quelle":"illustr_hb_1","band":"I","seite":"201"},{"merkmal":"kernfaecher_oeffnung","wert":"offen","original":"Kernhaus: offen, sehr groß","quelle":"illustr_hb_1","band":"I","seite":"201"},{"merkmal":"kelchhoehle_form","wert":"dreieck_lang","original":"Kelchröhre: ein ziemlich tiefer, spitzer Kegel","quelle":"illustr_hb_1","band":"I","seite":"201"},{"merkmal":"genussreife_beginn","wert":"12","original":"Reife und Nutzung: December bis April","quelle":"illustr_hb_1","band":"I","seite":"201"},{"merkmal":"genussreife_ende","wert":"4","original":"Reife und Nutzung: December bis April","quelle":"illustr_hb_1","band":"I","seite":"201"},{"merkmal":"verwendung","wert":"tafel","original":"Ein sehr delicater Winterapfel … einer unsrer besten Desertäpfel","quelle":"illustr_hb_1","band":"I","seite":"201"},{"merkmal":"frucht_groesse","wert":"7","original":"Die Früchte sind vergleichsweise groß","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Cornwalliser_Nelkenapfel&oldid=255083760"},{"merkmal":"frucht_form","wert":"konisch","original":"Ihre Form ist konisch und deutlich ausgeprägt gerippt","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Cornwalliser_Nelkenapfel&oldid=255083760"},{"merkmal":"schale_grundfarbe","wert":"gruen","original":"rot gefärbt auf einem grünen Untergrund","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Cornwalliser_Nelkenapfel&oldid=255083760"},{"merkmal":"schale_beschaffenheit","wert":"glatt","original":"Die Schale des Apfels ist glatt und nur schwach berostet","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Cornwalliser_Nelkenapfel&oldid=255083760"},{"merkmal":"schale_lentizellen_anzahl","wert":"3","original":"nur wenige bräunliche Punkte","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Cornwalliser_Nelkenapfel&oldid=255083760"},{"merkmal":"schale_lentizellen_art","wert":"braun","original":"nur wenige bräunliche Punkte","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Cornwalliser_Nelkenapfel&oldid=255083760"},{"merkmal":"fleisch_farbe","wert":"cremeweiss","original":"Das Fruchtfleisch selbst ist cremefarben und fest","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Cornwalliser_Nelkenapfel&oldid=255083760"},{"merkmal":"fleisch_festigkeit","wert":"7","original":"cremefarben und fest","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Cornwalliser_Nelkenapfel&oldid=255083760"},{"merkmal":"ploidie","wert":"diploid","original":"Der Baum ist diploid","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Cornwalliser_Nelkenapfel&oldid=255083760"},{"merkmal":"bluete_zeit","wert":"5","original":"Er blüht in Europa mittel bis spät","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Cornwalliser_Nelkenapfel&oldid=255083760"},{"merkmal":"bluete_zeit","wert":"7","original":"Er blüht in Europa mittel bis spät","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Cornwalliser_Nelkenapfel&oldid=255083760"},{"merkmal":"pflueckreife","wert":"10","original":"Die Ernte … findet in Österreich in der zweiten Oktoberhälfte statt","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Cornwalliser_Nelkenapfel&oldid=255083760"},{"merkmal":"verwendung","wert":"tafel","original":"eignet sich deshalb vor allem als Tafelapfel","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Cornwalliser_Nelkenapfel&oldid=255083760"},{"merkmal":"kernhaus_breite_mm","wert":41,"original":"Kernhaus 41:52","quelle":"engelbrecht1889","seite":"44 (Nr. 40)"},{"merkmal":"kernhaus_hoehe_mm","wert":52,"original":"Kernhaus 41:52","quelle":"engelbrecht1889","seite":"44 (Nr. 40)"},{"merkmal":"frucht_breite","wert":70,"quelle":"nfc2025","seite":"Akzession 1947116 (Smith 1971)"},{"merkmal":"frucht_hoehe","wert":65,"quelle":"nfc2025","seite":"Akzession 1947116 (Smith 1971)"},{"merkmal":"frucht_groesse","wert":"5","quelle":"nfc2025","seite":"Akzession 1947116 (Smith 1971)","original":"Medium to large"},{"merkmal":"frucht_groesse","wert":"7","quelle":"nfc2025","seite":"Akzession 1947116 (Smith 1971)","original":"Medium to large"},{"merkmal":"frucht_form","wert":"konisch","quelle":"nfc2025","seite":"Akzession 1947116 (Smith 1971)","original":"Conical"},{"merkmal":"frucht_hoehe_breite","wert":0.929,"quelle":"nfc2025","seite":"Akzession 1947116 (Smith 1971)"},{"merkmal":"frucht_rippung","wert":"5","quelle":"nfc2025","seite":"Akzession 1947116 (Smith 1971)","original":"Medium"},{"merkmal":"schale_grundfarbe","wert":"gruengelb","quelle":"nfc2025","seite":"Akzession 1947116 (Smith 1971)","original":"Green yellow"},{"merkmal":"schale_deckfarbe_farbton","wert":"rot","quelle":"nfc2025","seite":"Akzession 1947116 (Smith 1971)","original":"Red"},{"merkmal":"fleisch_farbe","wert":"gelblich","quelle":"nfc2025","seite":"Akzession 1947116 (Smith 1971)","original":"Yellowish"},{"merkmal":"fleisch_festigkeit","wert":"3","quelle":"nfc2025","seite":"Akzession 1947116 (Verkostung P. Hale, 23/10/2019)","original":"Soft to intermediate"},{"merkmal":"fleisch_festigkeit","wert":"5","quelle":"nfc2025","seite":"Akzession 1947116 (Verkostung P. Hale, 23/10/2019)","original":"Soft to intermediate"},{"merkmal":"fleisch_saftigkeit","wert":"5","quelle":"nfc2025","seite":"Akzession 1947116 (Verkostung P. Hale, 23/10/2019)","original":"Intermediate"},{"merkmal":"geschmack_suesse","wert":"5","quelle":"nfc2025","seite":"Akzession 1947116 (Verkostung P. Hale, 23/10/2019)","original":"Intermediate to high"},{"merkmal":"geschmack_suesse","wert":"7","quelle":"nfc2025","seite":"Akzession 1947116 (Verkostung P. Hale, 23/10/2019)","original":"Intermediate to high"},{"merkmal":"geschmack_saeure","wert":"5","quelle":"nfc2025","seite":"Akzession 1947116 (Verkostung P. Hale, 23/10/2019)","original":"Intermediate"},{"merkmal":"verwendung","wert":"tafel","quelle":"nfc2025","seite":"Akzession 1947116","original":"Dessert"},{"merkmal":"pflueckreife","wert":"10","quelle":"nfc2025","seite":"Akzession 1947116","original":"Mid October"},{"merkmal":"genussreife_ende","wert":"3","quelle":"nfc2025","seite":"Akzession 1947116","original":"March"},{"merkmal":"bluete_zeit","wert":"5","quelle":"nfc2025","seite":"Akzession 1947116","original":"Klasse 5 (10 % der Blüten offen, Tag 127)"}],"texte":[{"thema":"ueberblick","text":"Der Cornwalliser Nelkenapfel ist ein großer, kegelförmiger, gerippter Winterapfel aus Cornwall mit trüb- bis braunroter Deckfarbe auf grüner bis gelblichgrüner Grundfarbe. Er ist für sein blumiges, an Nelken erinnerndes Aroma bekannt und wird vor allem als Tafelapfel genutzt. Der Baum trägt nur mäßig, deshalb blieb die Sorte ein Liebhaberapfel.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Cornwalliser_Nelkenapfel&oldid=255083760"},{"quelle":"illustr_hb_1","band":"I","seite":"201"},{"quelle":"engelbrecht1889","seite":"44 (Nr. 40)"}]},{"thema":"herkunft","text":"Nach dem Pomological Magazine, das das Illustrirte Handbuch (1859) zitiert, wurde der Apfel in einem Garten bei Truro in Cornwall gefunden. Wikipedia berichtet, Sir Christopher Hawkins habe ihn 1813 an die Horticultural Society in London geschickt, die ihn ihren Mitgliedern empfahl; 1826 war er unter dem Namen Calville d'Angleterre im elsässischen Bollwiller bekannt. In Deutschland verbreitete ihn nach dem Handbuch vor allem Leutnant Donauer, der Reiser aus London erhielt. Eine Fingerprint-Analyse der Deutschen Genbank Obst ergab, dass er eine Tochtersorte der alten englischen Sorte Gilliflower ist. Der englische Name geht laut Hogg auf das französische girofle (Nelke) zurück.","belege":[{"quelle":"illustr_hb_1","band":"I","seite":"201"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Cornwalliser_Nelkenapfel&oldid=255083760"}]},{"thema":"frucht","text":"Engelbrecht maß 75 mm Breite bei 80 bis 82 mm Höhe; die Frucht ist also höher als breit. Er beschreibt sie als schwach abgestumpft kegelförmig und stielbauchig, mit fast gleichen Hälften. Das Handbuch nennt einen großen, 3½ Zoll hohen und fast ebenso breiten Apfel; vom Bauch etwas unter der Mitte nimmt er zum Kelch stärker ab und wirkt deutlich zugespitzt, die obere Hälfte ist durch zahlreiche Rippen uneben. Deutliche Rippen laufen sich abflachend bis zum Stiel, der Querschnitt ist etwas kantig.","belege":[{"quelle":"engelbrecht1889","seite":"44 (Nr. 40)"},{"quelle":"illustr_hb_1","band":"I","seite":"201"}]},{"thema":"schale","text":"Die glatte Schale ist zuerst grün, später heller und etwas gelblichgrün, selten gelb. Engelbrecht beschreibt die Sonnenseite trübrot überzogen und dunkler gestreift. Nach dem Handbuch ist die Frucht vom Baum dunkelgrün; die Sonnenseite ist braunrötlich mit Grün untermischt, glänzend bräunlich rot gestreift und stellenweise dunkelbraunrot verwaschen, um den Kelch zeigen sich zahlreiche feine dunkelrote Punkte. Die Schalenpunkte sind spärlich, fein bis mitteldick und bräunlich; Rostfiguren kommen selten vor. Die Frucht welkt nicht.","belege":[{"quelle":"engelbrecht1889","seite":"44 (Nr. 40)"},{"quelle":"illustr_hb_1","band":"I","seite":"201"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Cornwalliser_Nelkenapfel&oldid=255083760"}]},{"thema":"schnitt","text":"Das Kernhaus ist nach Engelbrecht meist eiförmig (41:52 mm). Die Kammern sind stielwärts spitz, kelchwärts abgerundet, sehr zerrissen, mittelgeräumig und wenig offen; die Achsenhöhle ist schmal. Meist liegt ein mäßig großer, ziemlich vollkommener, eiförmiger, gespitzter Kern je Kammer. Die Kelchhöhle ist kegel- bis kegeltrichterförmig und reicht ein Drittel bis drei Fünftel zur Achsenhöhle. Das Handbuch beschreibt das Kernhaus dagegen als offen und sehr groß, mit mehreren guten Samen und einer grünen Ader im Fleisch, die Kelchröhre als ziemlich tiefen, spitzen Kegel. Die Kelchgrube ist ziemlich flach und eng, die Stielgrube ziemlich tief, mittelweit, etwas faltig und schwach berostet.","belege":[{"quelle":"engelbrecht1889","seite":"44 (Nr. 40)"},{"quelle":"illustr_hb_1","band":"I","seite":"201"}]},{"thema":"fleisch_geschmack","text":"Engelbrecht nennt das Fleisch hellgrüngelblich bis gelblichweiß, ziemlich fein bis fein, erst ziemlich fest, später mürbe, saftig und calvillartig gewürzt; die Säure herrscht etwas vor, ist aber mild, die Süße fast ebenso stark. Das Handbuch beschreibt ein gelbliches, gewürzhaftes Fleisch von süßweinigem Geschmack mit feinem Nelkengeruch. Wikipedia nennt das Fleisch cremefarben und fest, nach längerer Lagerung mürber; Hogg zählte den Apfel 1860 wegen seines Aromas zu den besten.","belege":[{"quelle":"engelbrecht1889","seite":"44 (Nr. 40)"},{"quelle":"illustr_hb_1","band":"I","seite":"201"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Cornwalliser_Nelkenapfel&oldid=255083760"}]},{"thema":"reife_lagerung","text":"Die Früchte werden spät geerntet, in Österreich in der zweiten Oktoberhälfte. Genussreif sind sie nach Engelbrecht von Dezember bis März, nach dem Handbuch von Dezember bis April.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Cornwalliser_Nelkenapfel&oldid=255083760"},{"quelle":"engelbrecht1889","seite":"44 (Nr. 40)"},{"quelle":"illustr_hb_1","band":"I","seite":"201"}]},{"thema":"baum","text":"Nach Hogg, den das Handbuch zitiert, wird der Baum nur mittelgroß und trägt mäßig, und zwar an den Spitzen der Nebenzweige, was beim Schnitt zu beachten ist; auch auf Wildling wächst er nicht besonders stark. Wikipedia nennt den Baum diploid und damit als Befruchter geeignet; er blüht mittel bis spät. Die Blätter sind klein, oval und schmal.","belege":[{"quelle":"illustr_hb_1","band":"I","seite":"201"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Cornwalliser_Nelkenapfel&oldid=255083760"}]},{"thema":"unterscheidung","text":"Nach Wikipedia sind viele in Deutschland unter dem Namen Cornwalliser Nelkenapfel verbreitete Bäume in Wahrheit London Pepping, weil der Coburger Pomologe Donauer Edelreiser unter falschem Namen weitergab. Die Sorte Cornish Pine stammt vermutlich vom Cornwalliser Nelkenapfel ab und schmeckt ähnlich.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Cornwalliser_Nelkenapfel&oldid=255083760"}]},{"thema":"frucht","text":"Nach den Erhebungen der National Fruit Collection: die Sorte bildet mittelgroße bis große, kegelförmige Früchte mit grünlich gelber Grundfarbe und roter Deckfarbe. Das Fruchtfleisch ist gelblich. Das Fleisch ist weich bis mittelfest und mäßig saftig; im Geschmack mäßig bis deutlich süß und mäßig sauer, mit mittlerem Aroma. Tafelapfel, pflückreif Mitte Oktober und lagerfähig bis März.","belege":[{"quelle":"nfc2025","seite":"Akzession 1947116"}]}],"bilder":[{"url":"https://archive.org/download/bub_gb_tR4EMgEACAAJ/page/n62_w800.jpg","seite":"https://archive.org/details/bub_gb_tR4EMgEACAAJ/page/n62","art":"schnitt","urheber":"Theodor Engelbrecht (Zeichnung), Albert Probst (Holzschnitt)","lizenz":"gemeinfrei","quelle":"engelbrecht1889","titel":"Längsschnitt-Umriss bei Engelbrecht 1889, S. 44 (ganze Buchseite)"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/5/5d/Cornish_gillyflower.jpg/960px-Cornish_gillyflower.jpg","seite":"https://commons.wikimedia.org/wiki/File:Cornish_gillyflower.jpg","art":"bluete","urheber":"Theroadislong","lizenz":"CC BY 3.0","quelle":"commons","titel":"Cornish gillyflower.jpg"},{"url":"https://upload.wikimedia.org/wikipedia/commons/d/d0/Cross_section_of_Cornish_Gilliflower%2C_National_Fruit_Collection_%28acc._1947-116%29.jpg","seite":"https://commons.wikimedia.org/wiki/File:Cross_section_of_Cornish_Gilliflower,_National_Fruit_Collection_(acc._1947-116).jpg","art":"schnitt","urheber":"National Fruit Collection, Brogdale","lizenz":"OGL 2.0","quelle":"nfc-commons","titel":"Cross section of Cornish Gilliflower, National Fruit Collection (acc. 1947-116)"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/e/e5/The_Pomological_magazine_%28Pl._140%29_%288744838482%29.jpg/960px-The_Pomological_magazine_%28Pl._140%29_%288744838482%29.jpg","seite":"https://commons.wikimedia.org/wiki/File:The_Pomological_magazine_(Pl._140)_(8744838482).jpg","art":"tafel","urheber":"Lindley, John","lizenz":"gemeinfrei","quelle":"pomological-magazine","titel":"The Pomological magazine (Pl. 140) (8744838482)"},{"url":"https://upload.wikimedia.org/wikipedia/commons/f/fa/Cornish_Gilliflower_on_tree%2C_National_Fruit_Collection_%28acc._1947-116%29.jpg","seite":"https://commons.wikimedia.org/wiki/File:Cornish_Gilliflower_on_tree,_National_Fruit_Collection_(acc._1947-116).jpg","art":"baum","urheber":"National Fruit Collection, Brogdale","lizenz":"OGL 2.0","quelle":"nfc-commons","titel":"Cornish Gilliflower on tree, National Fruit Collection (acc. 1947-116)"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/78/Nelkenapfel_%28Westfalen%29_Europom_Luxemburg_325.jpg/960px-Nelkenapfel_%28Westfalen%29_Europom_Luxemburg_325.jpg","seite":"https://commons.wikimedia.org/wiki/File:Nelkenapfel_(Westfalen)_Europom_Luxemburg_325.jpg","art":"frucht","urheber":"Trollfreie Zone","lizenz":"CC BY-SA 3.0","quelle":"commons-fotos","titel":"Nelkenapfel (Westfalen) Europom Luxemburg 325"}],"munq":116,"akzessionen":[{"sammlung":"UK National Fruit Collection (Brogdale)","nummer":"1947116","name":"Cornish Gilliflower"}],"farbmessung":[{"bild":"https://upload.wikimedia.org/wikipedia/commons/d/d0/Cross_section_of_Cornish_Gilliflower%2C_National_Fruit_Collection_%28acc._1947-116%29.jpg","methode":"NFC-Foto","verfahren":"Foto (NFC-Fototafel: 4 ganze Früchte, 2 Schnitte, Fototisch); Weißabgleich über den Hintergrund; Frucht per Hintergrundmodell freigestellt; Schalenpixel ohne Glanzlichter einzeln klassifiziert: Grundfarbe aus gelbgrünen Pixeln, Deckfarbe = Pixel mit deutlich höherem a* als die Grundfarbe (auch dunkle Rot- und Braunrottöne), Anteile über Pixel; Höhe/Breite aus dem Längsschnitt","grundfarbe":"#8f9330","deckfarbe":"#6f4034","deckfarbeAnteil":0.47,"fleischfarbe":"#c6c4ad","hoeheZuBreite":0.968}]}