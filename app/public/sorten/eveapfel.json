lustr_hb_4","band":"IV","seite":"185"}]},"merkmale":[{"merkmal":"frucht_breite","wert":68,"original":"Gestalt 68:60—69 (Scan)","quelle":"engelbrecht1889","seite":"68 (Nr. 60)"},{"merkmal":"frucht_hoehe","wert":64.5,"original":"Gestalt 68:60—69 (Scan)","quelle":"engelbrecht1889","seite":"68 (Nr. 60)"},{"merkmal":"frucht_hoehe_breite","wert":0.95,"original":"Gestalt 68:60—69 (Scan)","quelle":"engelbrecht1889","seite":"68 (Nr. 60)"},{"merkmal":"frucht_form","wert":"eifoermig","original":"etwas abgestumpft eiförmig","quelle":"engelbrecht1889","seite":"68 (Nr. 60)"},{"merkmal":"frucht_breiteste_stelle","wert":"stiel","original":"wenig stielbauch.","quelle":"engelbrecht1889","seite":"68 (Nr. 60)"},{"merkmal":"frucht_symmetrie","wert":"schief","original":"Hälften meistens merklich ungleich","quelle":"engelbrecht1889","seite":"68 (Nr. 60)"},{"merkmal":"frucht_rippung","wert":"5","original":"zwischen flach, doch deutlich über d. Frucht laufenden Rippen. Querschn. flachkantig","quelle":"engelbrecht1889","seite":"68 (Nr. 60)"},{"merkmal":"frucht_kronung","wert":"5","original":"Einsenk. … zwischen flach, doch deutlich über d. Frucht laufenden Rippen","quelle":"engelbrecht1889","seite":"68 (Nr. 60)"},{"merkmal":"kelch_offenheit","wert":"geschlossen","original":"Kelch geschlossen, grün, kurzwollig","quelle":"engelbrecht1889","seite":"68 (Nr. 60)"},{"merkmal":"kelchgrube_tiefe","wert":"5","original":"Einsenk. mässig tief, mittelweit","quelle":"engelbrecht1889","seite":"68 (Nr. 60)"},{"merkmal":"kelchgrube_weite","wert":"5","original":"Einsenk. mässig tief, mittelweit","quelle":"engelbrecht1889","seite":"68 (Nr. 60)"},{"merkmal":"stiel_dicke","wert":"3","original":"Stiel meistens holzig, dünn oder mitteldick, etwa 14 mm l.","quelle":"engelbrecht1889","seite":"68 (Nr. 60)"},{"merkmal":"stiel_dicke","wert":"5","original":"Stiel meistens holzig, dünn oder mitteldick, etwa 14 mm l.","quelle":"engelbrecht1889","seite":"68 (Nr. 60)"},{"merkmal":"stielgrube_tiefe","wert":"5","original":"Höhle mässig tief, mittelweit, schwach faltig, häufig mit Fleischwulst","quelle":"engelbrecht1889","seite":"68 (Nr. 60)"},{"merkmal":"stielgrube_weite","wert":"5","original":"Höhle mässig tief, mittelweit, schwach faltig, häufig mit Fleischwulst","quelle":"engelbrecht1889","seite":"68 (Nr. 60)"},{"merkmal":"schale_berostung_stielgrube","wert":"3","original":"Höhle … wenig berostet","quelle":"engelbrecht1889","seite":"68 (Nr. 60)"},{"merkmal":"schale_beschaffenheit","wert":"glatt","original":"Schale glatt, geschmeidig, selbst etwas fettig und glänzend","quelle":"engelbrecht1889","seite":"68 (Nr. 60)"},{"merkmal":"schale_beschaffenheit","wert":"fettig","original":"Schale glatt, geschmeidig, selbst etwas fettig und glänzend","quelle":"engelbrecht1889","seite":"68 (Nr. 60)"},{"merkmal":"schale_beschaffenheit","wert":"glaenzend","original":"Schale glatt, geschmeidig, selbst etwas fettig und glänzend","quelle":"engelbrecht1889","seite":"68 (Nr. 60)"},{"merkmal":"schale_grundfarbe","wert":"weisslichgelb","original":"hellgrün, später hell, fast wachsartig gelb","quelle":"engelbrecht1889","seite":"68 (Nr. 60)"},{"merkmal":"schale_deckfarbe_anteil","wert":"1","original":"sonnenw. selten leicht röthlicher Anflug","quelle":"engelbrecht1889","seite":"68 (Nr. 60)"},{"merkmal":"schale_lentizellen_anzahl","wert":"5","original":"Punkte ziemlich zahlreich, fein, meistens nur Dupfen","quelle":"engelbrecht1889","seite":"68 (Nr. 60)"},{"merkmal":"schale_lentizellen_groesse","wert":"3","original":"Punkte ziemlich zahlreich, fein, meistens nur Dupfen","quelle":"engelbrecht1889","seite":"68 (Nr. 60)"},{"merkmal":"kernhaus_form","wert":"eifoermig","original":"Kernhaus 37:37, breit eiförmig","quelle":"engelbrecht1889","seite":"68 (Nr. 60)"},{"merkmal":"kernfaecher_oeffnung","wert":"teilweise","original":"Kammern 11:24, … mittelgeräumig, etwas, doch oft nur stielw. offen","quelle":"engelbrecht1889","seite":"68 (Nr. 60)"},{"merkmal":"kernhaus_achse","wert":"offen","original":"Achsenh. mittelbre