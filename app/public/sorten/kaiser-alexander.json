{"id":"kaiser-alexander","name":"Kaiser Alexander","synonyme":[{"name":"Kaiser Alexander von Russland","beleg":{"quelle":"engelbrecht1889","seite":"305 (Nr. 273)"}},{"name":"Grand Alexandre","beleg":{"quelle":"engelbrecht1889","seite":"305 (Nr. 273)"}},{"name":"Alexander","beleg":{"quelle":"engelbrecht1889","seite":"305 (Nr. 273)"}},{"name":"Aporta Nalivia","beleg":{"quelle":"illustr_hb_1","band":"I","seite":"109"}},{"name":"Aporta","beleg":{"quelle":"illustr_hb_1","band":"I","seite":"109"}},{"name":"Emperor Alexander","beleg":{"quelle":"illustr_hb_1","band":"I","seite":"109"}},{"name":"Alexander Apple","beleg":{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Kaiser_Alexander_(Apfel)&oldid=251114881"}},{"name":"Président Napoleon","beleg":{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Kaiser_Alexander_(Apfel)&oldid=251114881"}},{"name":"Albertin","beleg":{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Kaiser_Alexander_(Apfel)&oldid=251114881"}},{"name":"Allerweltsapfel","beleg":{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Kaiser_Alexander_(Apfel)&oldid=251114881"}},{"name":"Car Alexandr","beleg":{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Kaiser_Alexander_(Apfel)&oldid=251114881"}}],"herkunft":{"text":"Südrussland oder Ukraine; in Russland zuerst Aporta genannt, nach Zar Alexander I. benannt. 1817 wurden Probefrüchte aus Riga nach England geschickt; aus Kurland wurde die Sorte in England und Deutschland eingeführt.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Kaiser_Alexander_(Apfel)&oldid=251114881"},{"quelle":"illustr_hb_1","band":"I","seite":"109"}],"ort":"Südrussland oder Ukraine","jahr":1817},"merkmale":[{"merkmal":"frucht_breite","wert":108,"original":"Gestalt 108:85—89, auch etwas kleiner","quelle":"engelbrecht1889","seite":"305 (Nr. 273)"},{"merkmal":"frucht_hoehe","wert":87,"or