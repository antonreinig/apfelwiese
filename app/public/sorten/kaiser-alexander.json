iginal":"saftig","quelle":"engelbrecht1889","seite":"305 (Nr. 273)"},{"merkmal":"geschmack_saeure","wert":"5","original":"schwach gewürzt, wenig vorherrschend weinig, fast ebenso süss","quelle":"engelbrecht1889","seite":"305 (Nr. 273)"},{"merkmal":"geschmack_suesse","wert":"5","original":"schwach gewürzt, wenig vorherrschend weinig, fast ebenso süss","quelle":"engelbrecht1889","seite":"305 (Nr. 273)"},{"merkmal":"geschmack_suesse","wert":"7","original":"fein gewürzten weinigen Zuckergeschmack","quelle":"illustr_hb_1","band":"I","seite":"109"},{"merkmal":"geschmack_aroma","wert":"fein himbeerartig","original":"fein himbeerartigem weinreichen Zuckergeschmack","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Kaiser_Alexander_(Apfel)&oldid=251114881"},{"merkmal":"verwendung","wert":"tafel","original":"o†† (Kopfzeile)","quelle":"engelbrecht1889","seite":"305 (Nr. 273)"},{"merkmal":"verwendung","wert":"kueche","original":"o†† (Kopfzeile)","quelle":"engelbrecht1889","seite":"305 (Nr. 273)"},{"merkmal":"verwendung","wert":"doerren","original":"zum Dörren und Kochen ganz ausgezeichnet gut","quelle":"illustr_hb_1","band":"I","seite":"109"},{"merkmal":"genussreife_beginn","wert":"10","original":"Ende October bis Anfang Januar","quelle":"engelbrecht1889","seite":"305 (Nr. 273)"},{"merkmal":"genussreife_ende","wert":"1","original":"Ende October bis Anfang Januar","quelle":"engelbrecht1889","seite":"305 (Nr. 273)"},{"merkmal":"genussreife_ende","wert":"2","original":"Essbar vom November bis Februar","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Kaiser_Alexander_(Apfel)&oldid=251114881"},{"merkmal":"baum_wuchs","wert":"7","original":"Wuchs sehr lebhaft","quelle":"illustr_hb_1","band":"I","seite":"109"},{"merkmal":"kernhaus_breite_mm","wert":57,"original":"Kernhaus 57:39","quelle":"engelbrecht1889","seite":"305 (Nr. 273)"},{"merkmal":"kernhaus_hoehe_mm","wert":39,"original":"Kernhaus 57:39","quelle":"engelbrecht1889","seite":"305 (Nr. 273)"},{"merkmal":"kernfach_breite_mm","wert":12,"original":"Kammern 12:18","quelle":"engelbrecht1889","seite":"305 (Nr. 273)"},{"merkmal":"kernfach_hoehe_mm","wert":18,"original":"Kammern 12:18","quelle":"engelbrecht1889","seite":"305 (Nr. 273)"},{"merkmal":"frucht_breite","wert":100,"quelle":"nfc2025","seite":"Akzession 1999072 (Smith 1971)"},{"merkmal":"frucht_hoehe","wert":75,"quelle":"nfc2025","seite":"Akzession 1999072 (Smith 1971)"},{"merkmal":"frucht_groesse","wert":"7","quelle":"nfc2025","seite":"Akzession 1999072 (Smith 1971)","original":"Large"},{"merkmal":"frucht_form","wert":"konisch","quelle":"nfc2025","seite":"Akzession 1999072 (Smith 1971)","original":"Conical"},{"merkmal":"frucht_hoehe_breite","wert":0.75,"quelle":"nfc2025","seite":"Akzession 1999072 (Smith 1971)"},{"merkmal":"frucht_rippung","wert":"1","quelle":"nfc2025","seite":"Akzession 1999072 (Smith 1971)","original":"Very light"},{"merkmal":"schale_grundfarbe","wert":"gelb","quelle":"nfc2025","seite":"Akzession 1999072 (Smith 1971)","original":"Yellow"},{"merkmal":"schale_deckfarbe_farbton","wert":"rot","quelle":"nfc2025","seite":"Akzession 1999072 (Smith 1971)","original":"Red"},{"merkmal":"fleisch_farbe","wert":"gelblich","quelle":"nfc2025","seite":"Akzession 1999072 (Smith 1971)","original":"Yellowish"},{"merkmal":"fleisch_festigkeit","wert":"3","quelle":"nfc2025","seite":"Akzession 1999072 (Verkostung P. Hale, 16/08/2023)","original":"Soft"},{"merkmal":"fleisch_saftigkeit","wert":"3","quelle":"nfc2025","seite":"Akzession 1999072 (Verkostung P. Hale, 16/08/2023)","original":"Low"},{"merkmal":"geschmack_suesse","wert":"3","quelle":"nfc2025","seite":"Akzession 1999072 (Verkostung P. Hale, 16/08/2023)","original":"Very low"},{"merkmal":"geschmack_saeure","wert":"5","quelle":"nfc2025","seite":"Akzession 1999072 (Verkostung P. Hale, 16/08/2023)","original":"Intermediate"},{"merkmal":"verwendung","wert":"kueche","quelle":"nfc2025","seite":"Akzession 1999072","original":"Culinary"},{"merkmal":"pflueckreife","wert":"9","quelle":"nfc2025","seite":"Akzession 1999072","original":"Mid September"},{"merkmal":"genussreife_ende","wert":"10","quelle":"nfc2025","seite":"Akzession 1999072","original":"October"},{"merkmal":"bluete_zeit","wert":"5","quelle":"nfc2025","seite":"Akzession 1999072","original":"Klasse 5 (10 % der Blüten offen, Tag 125)"},{"merkmal":"verwendung","wert":"tafel","original":"Lucas schätzte die Sorte als Marktapfel und Tafelapfel zweiten Ranges","quelle":"illustr_hb_1","band":"I","seite":"109"},{"merkmal":"verwendung","wert":"kueche","original":"zum Dörren und Kochen hielt er sie für ausgezeichnet","quelle":"illustr_hb_1","band":"I","seite":"109"},{"merkmal":"ertrag_beginn","wert":"frueh","original":"Er trägt früh und sehr reich","quelle":"illustr_hb_1","band":"I","seite":"109"},{"merkmal":"gesundheit","wert":"7","original":"ist wenig empfindlich","quelle":"illustr_hb_1","band":"I","seite":"109"},{"merkmal":"standort_klima","wert":"7","original":"Lucas empfiehlt etwas vor Stürmen geschützte Lagen","quelle":"illustr_hb_1","band":"I","seite":"109"},{"merkmal":"lagerfaehigkeit","wert":"5","original":"Genussreif ist die Frucht nach Engelbrecht von Ende Oktober bis Anfang Januar","quelle":"engelbrecht1889","seite":"305 (Nr. 273)"}],"texte":[{"thema":"ueberblick","text":"Sehr großer, rot gestreifter Herbstapfel russischer Herkunft aus der Gruppe der Ramboure. Lucas hielt ihn 1859 für die wertvollste der sehr großfrüchtigen Sorten und für einen der besten Marktäpfel; als Tafelfrucht stuft er ihn in den zweiten Rang. Engelbrecht bewertete ihn als brauchbare Tafel- und sehr gute Haushaltsfrucht (o††).","belege":[{"quelle":"illustr_hb_1","band":"I","seite":"109"},{"quelle":"engelbrecht1889","seite":"305 (Nr. 273)"}]},{"thema":"herkunft","text":"Das Illustrirte Handbuch nennt die Sorte südrussisch; sie kam auf mehreren Wegen aus Russland nach Deutschland und England, in Russland hieß sie ursprünglich Aporta oder Aporta Nalivia. Diel beschrieb sie als Kaiser Alexander von Russland. Nach Wikipedia ist sie seit 1817 bekannt: Der Mecklenburger Pomologe Müschen berichtete von Probefrüchten, die 1817 aus Riga nach England geschickt wurden, und von der Einführung aus Kurland. Der Name bezieht sich auf Zar Alexander I. Engelbrecht erhielt 1889 Früchte aus Gelnhausen bei Hanau, Meiningen, Lich (Hessen), Potsdam und Langwarden (Oldenburg).","belege":[{"quelle":"illustr_hb_1","band":"I","seite":"109"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Kaiser_Alexander_(Apfel)&oldid=251114881"},{"quelle":"engelbrecht1889","seite":"305 (Nr. 273)"}]},{"thema":"frucht","text":"Engelbrecht maß 108 mm Breite und 85 bis 89 mm Höhe; das Handbuch nennt 3½ bis 4 Zoll Breite und 3 bis 3½ Zoll Höhe und berichtet von noch größeren Früchten. Die Frucht ist flach kegelförmig, sehr stielbauchig und verjüngt sich zum Kelch zu einer stumpfen Spitze; die Hälften sind kaum verschieden. Breite, sehr flache Rippen laufen über die Frucht, der Querschnitt ist fast rund. Der halb bis ganz offene Kelch sitzt in einer tiefen Grube, die Engelbrecht etwas eng, das Handbuch weit nennt. Der holzige Stiel ist etwa 27 mm lang und sitzt in einer sehr tiefen, ziemlich weiten, faltigen und berosteten Stielgrube.","belege":[{"quelle":"engelbrecht1889","seite":"305 (Nr. 273)"},{"quelle":"illustr_hb_1","band":"I","seite":"109"}]},{"thema":"schale","text":"Die glatte, etwas geschmeidige und glänzende Schale ist anfangs hellgrün, später grünlichgelb bis hellgelb. Auf der Sonnenseite ist sie weithin fein rot getüpfelt und mit kurzen, breiten dunkel karminroten Streifen und Flammen gezeichnet; nach dem Handbuch bedecken die Streifen den größten Teil der Frucht, dazwischen ist sie marmoriert und punktiert, und in voller Sonne fließen die Streifen zusammen. Die Schalenpunkte sind spärlich, fein und braun. Der Duft ist deutlich, die Früchte welken nicht.","belege":[{"quelle":"engelbrecht1889","seite":"305 (Nr. 273)"},{"quelle":"illustr_hb_1","band":"I","seite":"109"}]},{"thema":"schnitt","text":"Das Kernhaus ist groß und zwiebelförmig (57:39 mm); nach dem Handbuch sitzt es auf dem Stiel auf. Die ziemlich geräumigen Kammern sind stielwärts stumpf gespitzt, kelchwärts stark abgerundet, etwas zerrissen und nach Engelbrecht mäßig weit offen; das Handbuch nennt das Kernhaus nur wenig offen. Die Achsenhöhle ist ziemlich breit. Je Kammer liegen zwei kleinere, meist vollkommene, kurz eiförmige, gespitzte braune Kerne; das Handbuch erwähnt viele, oft taube Kerne. Die Kelchhöhle ist kegelförmig und reicht bis zur Hälfte des Weges zur Achsenhöhle; das Handbuch beschreibt sie als kräftigen, stumpf zugespitzten Kegel. Das Fleisch ist weißlich.","belege":[{"quelle":"engelbrecht1889","seite":"305 (Nr. 273)"},{"quelle":"illustr_hb_1","band":"I","seite":"109"}]},{"thema":"fleisch_geschmack","text":"Das weiße Fleisch ist halbfein, locker, mürbe und saftig. Engelbrecht fand es schwach gewürzt, mit kaum vorherrschender Säure und fast gleich starker Süße; das Handbuch spricht von einem angenehmen, fein gewürzten, weinigen Zuckergeschmack, Wikipedia von einem fein himbeerartigen Aroma.","belege":[{"quelle":"engelbrecht1889","seite":"305 (Nr. 273)"},{"quelle":"illustr_hb_1","band":"I","seite":"109"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Kaiser_Alexander_(Apfel)&oldid=251114881"}]},{"thema":"reife_lagerung","text":"Genussreif ist die Frucht nach Engelbrecht von Ende Oktober bis Anfang Januar, nach dem Handbuch Ende Oktober und November mit Haltbarkeit bis Januar; Wikipedia nennt November bis Februar.","belege":[{"quelle":"engelbrecht1889","seite":"305 (Nr. 273)"},{"quelle":"illustr_hb_1","band":"I","seite":"109"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Kaiser_Alexander_(Apfel)&oldid=251114881"}]},{"thema":"baum","text":"Nach dem Handbuch wächst der Baum sehr lebhaft mit gut aufstrebenden Ästen und einer breit gewölbten, geschlossenen Krone. Er trägt früh und sehr reich und ist wenig empfindlich. Lucas empfiehlt etwas vor Stürmen geschützte Lagen, besonders Gärten, auch als Pyramide auf Wildling. Die Sommertriebe sind kräftig, hell bräunlichrot und stark punktiert, die Blätter sehr groß und dick.","belege":[{"quelle":"illustr_hb_1","band":"I","seite":"109"}]},{"thema":"verwendung","text":"Lucas schätzte die Sorte als Marktapfel und Tafelapfel zweiten Ranges; zum Dörren und Kochen hielt er sie für ausgezeichnet. Escoffier empfahl um 1900 ausgehöhlte Alexanderäpfel als Gefäß für einen gefüllten Salat.","belege":[{"quelle":"illustr_hb_1","band":"I","seite":"109"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Kaiser_Alexander_(Apfel)&oldid=251114881"}]},{"thema":"unterscheidung","text":"Nach dem Handbuch ist Kirkes Sondersgleichen der Sorte so ähnlich, dass Oberdieck eine der beiden für entbehrlich hielt; auch der Liebensteiner Knollenapfel gleicht ihr sehr.","belege":[{"quelle":"illustr_hb_1","band":"I","seite":"109"}]},{"thema":"frucht","text":"Nach den Erhebungen der National Fruit Collection: große, kegelförmige Frucht mit gelber Grundfarbe und roter Deckfarbe. Das Fruchtfleisch ist gelblich. Bei der Verkostung war das Fleisch weich und wenig saftig, der Geschmack sehr wenig süß und mäßig sauer, mit sehr schwachem Aroma. Küchenapfel, pflückreif Mitte September und lagerfähig bis Oktober.","belege":[{"quelle":"nfc2025","seite":"Akzession 1999072, 2011014"}]}],"bilder":[{"url":"https://archive.org/download/bub_gb_tR4EMgEACAAJ/page/n321_w800.jpg","seite":"https://archive.org/details/bub_gb_tR4EMgEACAAJ/page/n321","art":"schnitt","urheber":"Theodor Engelbrecht (Zeichnung), Albert Probst (Holzschnitt)","lizenz":"gemeinfrei","quelle":"engelbrecht1889","titel":"Längsschnitt-Umriss bei Engelbrecht 1889, S. 305 (ganze Buchseite)"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/90/Deutsche_Pomologie_-_Aepfel_-_016.jpg/960px-Deutsche_Pomologie_-_Aepfel_-_016.jpg","seite":"https://commons.wikimedia.org/wiki/File:Deutsche_Pomologie_-_Aepfel_-_016.jpg","art":"tafel","urheber":"Wilhelm Lauche","lizenz":"Public domain","quelle":"lauche_dp1882","titel":"Deutsche Pomologie - Aepfel - 016.jpg"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/78/Alexander_%28apple%29.jpg/960px-Alexander_%28apple%29.jpg","seite":"https://commons.wikimedia.org/wiki/File:Alexander_(apple).jpg","art":"frucht","urheber":"Aron Ambrosiani","lizenz":"CC BY-SA 4.0","quelle":"commons-fotos","titel":"Alexander (apple)"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/f/f4/Grand_Alexandre_-_OPL_Peillac.jpg/960px-Grand_Alexandre_-_OPL_Peillac.jpg","seite":"https://commons.wikimedia.org/wiki/File:Grand_Alexandre_-_OPL_Peillac.jpg","art":"frucht","urheber":"Varmin","lizenz":"CC BY-SA 3.0","quelle":"commons-fotos","titel":"Grand Alexandre - OPL Peillac"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/4/49/Grand_Alexandre%2C_Ailly-le-Haut-Clocher%2C_Somme%2C_Fr%2CApple_festival_03et04-11-2018_%28118%29.jpg/960px-Grand_Alexandre%2C_Ailly-le-Haut-Clocher%2C_Somme%2C_Fr%2CApple_festival_03et04-11-2018_%28118%29.jpg","seite":"https://commons.wikimedia.org/wiki/File:Grand_Alexandre,_Ailly-le-Haut-Clocher,_Somme,_Fr,Apple_festival_03et04-11-2018_(118).jpg","art":"frucht","urheber":"APictche","lizenz":"CC BY-SA 4.0","quelle":"commons-fotos","titel":"Grand Alexandre, Ailly-le-Haut-Clocher, Somme, Fr,Apple festival 03et04-11-2018 (118)"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/3/3d/Grand_Alexandre%2C_Mons-Boubert%2C_29_oct._2017.jpg/960px-Grand_Alexandre%2C_Mons-Boubert%2C_29_oct._2017.jpg","seite":"https://commons.wikimedia.org/wiki/File:Grand_Alexandre,_Mons-Boubert,_29_oct._2017.jpg","art":"frucht","urheber":"APictche","lizenz":"CC BY-SA 4.0","quelle":"commons-fotos","titel":"Grand Alexandre, Mons-Boubert, 29 oct. 2017"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/99/Grand_Alexandre%2C_Mons-Boubert%2C_Somme%2C_Fr%2C_expo