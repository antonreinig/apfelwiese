{"id":"schoener-aus-wiedenbrueck","name":"Schöner aus Wiedenbrück","synonyme":[{"name":"Schöner von Wiedenbrück","beleg":{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Schöner_aus_Wiedenbrück&oldid=266165884"}},{"name":"Schöne aus Wiedenbrück","beleg":{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Schöner_aus_Wiedenbrück&oldid=266165884"}}],"herkunft":{"text":"Lokalsorte aus Wiedenbrück in Westfalen. Nach Wikipedia um 1900 von der Baumschule Dürbusch in Wiedenbrück gezüchtet; eine Baumschulbeschreibung nennt dagegen einen Zufallssämling, entdeckt 1880.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Schöner_aus_Wiedenbrück&oldid=266165884"},{"quelle":"web_biobaumversand","url":"https://biobaumversand.de/Apfelbaum-Schoener-aus-Wiedenbrueck/003438710324651"}],"land":"DE","landSicher":true,"ort":"Wiedenbrück","jahr":1900},"merkmale":[{"merkmal":"schale_grundfarbe","wert":"gruen","original":"Ein einheitlich hellgrün gefärbter Apfel","quelle":"web_biobaumversand","url":"https://biobaumversand.de/Apfelbaum-Schoener-aus-Wiedenbrueck/003438710324651"},{"merkmal":"schale_deckfarbe_anteil","wert":"3","original":"zarte gelbe Behauchung und einzelne hellrote Streifen","quelle":"web_biobaumversand","url":"https://biobaumversand.de/Apfelbaum-Schoener-aus-Wiedenbrueck/003438710324651"},{"merkmal":"schale_deckfarbe_farbton","wert":"hellrot","original":"einzelne hellrote Streifen","quelle":"web_biobaumversand","url":"https://biobaumversand.de/Apfelbaum-Schoener-aus-Wiedenbrueck/003438710324651"},{"merkmal":"schale_deckfarbe_art","wert":"gestreift","original":"einzelne hellrote Streifen","quelle":"web_biobaumversand","url":"https://biobaumversand.de/Apfelbaum-Schoener-aus-Wiedenbrueck/003438710324651"},{"merkmal":"schale_berostung_wangen","wert":"0","original":"die Frucht ist komplett rostfrei","quelle":"web_biobaumversand","url":"https://biobaumversand.de/Apfelbaum-Schoener-aus-Wiedenbrueck/003438710324651"},{"merkmal":"fleisch_festigkeit","wert":"3","original":"Das süßsäuerliche, aromatische Fruchtfleisch ist lockerzellig","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Schöner_aus_Wiedenbrück&oldid=266165884"},{"merkmal":"fleisch_festigkeit","wert":"3","original":"Fruchtfleisch locker, sehr aromatisch, saftig","quelle":"web_biobaumversand","url":"https://biobaumversand.de/Apfelbaum-Schoener-aus-Wiedenbrueck/003438710324651"},{"merkmal":"fleisch_saftigkeit","wert":"7","original":"Fruchtfleisch locker, sehr aromatisch, saftig","quelle":"web_biobaumversand","url":"https://biobaumversand.de/Apfelbaum-Schoener-aus-Wiedenbrueck/003438710324651"},{"merkmal":"geschmack_suesse","wert":"5","original":"Das süßsäuerliche, aromatische Fruchtfleisch","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Schöner_aus_Wiedenbrück&oldid=266165884"},{"merkmal":"geschmack_saeure","wert":"5","original":"Das süßsäuerliche, aromatische Fruchtfleisch","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Schöner_aus_Wiedenbrück&oldid=266165884"},{"merkmal":"verwendung","wert":"kueche","original":"ein sehr guter Koch- und Wirtschaftsapfel","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Schöner_aus_Wiedenbrück&oldid=266165884"},{"merkmal":"verwendung","wert":"tafel","original":"in den ersten Wochen nach der Ernte eignet er sich auch als Tafelobst","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Schöner_aus_Wiedenbrück&oldid=266165884"},{"merkmal":"verwendung","wert":"most","original":"Back- und Mostsorte","quelle":"web_biobaumversand","url":"https://biobaumversand.de/Apfelbaum-Schoener-aus-Wiedenbrueck/003438710324651"},{"merkmal":"pflueckreife","wert":"9","original":"Die Früchte sind im September ernte- und genussreif","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Schöner_aus_Wiedenbrück&oldid=266165884"},{"merkmal":"genussreife_beginn","wert":"9","original":"Die Früchte sind im September ernte- und genussreif, sie bleiben bis November haltbar","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Schöner_aus_Wiedenbrück&oldid=266165884"},{"merkmal":"genussreife_ende","wert":"11","original":"Die Früchte sind im September ernte- und genussreif, sie bleiben bis November haltbar","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Schöner_aus_Wiedenbrück&oldid=266165884"},{"merkmal":"bluete_zeit","wert":"7","original":"Frost ist für die spätblühende Sorte meist kein Problem","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Schöner_aus_Wiedenbrück&oldid=266165884"},{"merkmal":"bluete_zeit","wert":"7","original":"Blütezeit: spät","quelle":"web_biobaumversand","url":"https://biobaumversand.de/Apfelbaum-Schoener-aus-Wiedenbrueck/003438710324651"},{"merkmal":"baum_wuchs","wert":"7","original":"Der Schöne aus Wiedenbrück hat einen kräftigen Wuchs","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Schöner_aus_Wiedenbrück&oldid=266165884"},{"merkmal":"lagerfaehigkeit","wert":"3","original":"halten sich bis November","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Schöner_aus_Wiedenbrück&oldid=266165884","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Schöner_aus_Wiedenbrück&oldid=266165884"},{"quelle":"web_biobaumversand","url":"https://biobaumversand.de/Apfelbaum-Schoener-aus-Wiedenbrueck/003438710324651"}]},{"merkmal":"standort_boden","wert":"3","original":"gedeiht aber auch auf schweren, lehmigen Böden","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Schöner_aus_Wiedenbrück&oldid=266165884","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Schöner_aus_Wiedenbrück&oldid=266165884"},{"quelle":"web_biobaumversand","url":"https://biobaumversand.de/Apfelbaum-Schoener-aus-Wiedenbrueck/003438710324651"}]},{"merkmal":"ertrag_beginn","wert":"frueh","original":"Er trägt früh, später reich und regelmäßig","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Schöner_aus_Wiedenbrück&oldid=266165884","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Schöner_aus_Wiedenbrück&oldid=266165884"},{"quelle":"web_biobaumversand","url":"https://biobaumversand.de/Apfelbaum-Schoener-aus-Wiedenbrueck/003438710324651"}]},{"merkmal":"ertrag_alternanz","wert":"regelmaessig","original":"Er trägt früh, später reich und regelmäßig","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Schöner_aus_Wiedenbrück&oldid=266165884","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Schöner_aus_Wiedenbrück&oldid=266165884"},{"quelle":"web_biobaumversand","url":"https://biobaumversand.de/Apfelbaum-Schoener-aus-Wiedenbrueck/003438710324651"}]},{"merkmal":"bluete_frost","wert":"3","original":"Da er spät blüht, leidet er selten unter Spätfrost","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Schöner_aus_Wiedenbrück&oldid=266165884","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Schöner_aus_Wiedenbrück&oldid=266165884"},{"quelle":"web_biobaumversand","url":"https://biobaumversand.de/Apfelbaum-Schoener-aus-Wiedenbrueck/003438710324651"}]},{"merkmal":"anfaelligkeit_schorf","wert":"3","original":"für Schorf und tierische Schädlinge ist er wenig anfällig","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Schöner_aus_Wiedenbrück&oldid=266165884","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Schöner_aus_Wiedenbrück&oldid=266165884"},{"quelle":"web_biobaumversand","url":"https://biobaumversand.de/Apfelbaum-Schoener-aus-Wiedenbrueck/003438710324651"}]}],"texte":[{"thema":"ueberblick","text":"Der Schöne aus Wiedenbrück ist eine westfälische Lokalsorte und ein früher Herbstapfel, der im September reif wird und sich bis November hält. Er gilt vor allem als Koch- und Wirtschaftsapfel und ist in den ersten Wochen nach der Ernte auch zum Rohessen geeignet. In den alten Werken des Materials ist die Sorte nicht beschrieben, die Angaben sind daher spärlich; zum Schnitt (Kernhaus, Kelchhöhle) liegt keine Quelle vor.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Schöner_aus_Wiedenbrück&oldid=266165884"}]},{"thema":"herkunft","text":"Nach Wikipedia züchtete die Baumschule Dürbusch in Wiedenbrück die Sorte um 1900. Eine Baumschulbeschreibung nennt dagegen einen 1880 entdeckten Zufallssämling, der sich danach im deutschsprachigen Raum verbreitet habe. Die Angaben widersprechen sich und sind nicht durch ältere Literatur gesichert.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Schöner_aus_Wiedenbrück&oldid=266165884"},{"quelle":"web_biobaumversand","url":"https://biobaumversand.de/Apfelbaum-Schoener-aus-Wiedenbrueck/003438710324651"}]},{"thema":"schale","text":"Die Schale ist nach der Baumschulbeschreibung einheitlich hellgrün, leicht gelb behaucht und mit einzelnen hellroten Streifen gezeichnet; Rost fehlt.","belege":[{"quelle":"web_biobaumversand","url":"https://biobaumversand.de/Apfelbaum-Schoener-aus-Wiedenbrueck/003438710324651"}]},{"thema":"fleisch_geschmack","text":"Das Fleisch ist locker, saftig und aromatisch und schmeckt süßsäuerlich. Etwa vier Wochen nach der Ernte wird es mürbe.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Schöner_aus_Wiedenbrück&oldid=266165884"},{"quelle":"web_biobaumversand","url":"https://biobaumversand.de/Apfelbaum-Schoener-aus-Wiedenbrueck/003438710324651"}]},{"thema":"reife_lagerung","text":"Die Früchte sind im September pflück- und genussreif und halten sich bis November.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Schöner_aus_Wiedenbrück&oldid=266165884"},{"quelle":"web_biobaumversand","url":"https://biobaumversand.de/Apfelbaum-Schoener-aus-Wiedenbrueck/003438710324651"}]},{"thema":"verwendung","text":"Wikipedia nennt ihn einen sehr guten Koch- und Wirtschaftsapfel, der kurz nach der Ernte auch als Tafelobst taugt. Nach der Baumschulbeschreibung eignen sich die mürben Früchte gut für Kuchen und Apfelmus, außerdem für Most.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Schöner_aus_Wiedenbrück&oldid=266165884"},{"quelle":"web_biobaumversand","url":"https://biobaumversand.de/Apfelbaum-Schoener-aus-Wiedenbrueck/003438710324651"}]},{"thema":"baum","text":"Der Baum wächst kräftig und bildet auf kräftigen, gut verzweigten Leitästen eine breite Krone. Er bevorzugt humusreiche Standorte, gedeiht aber auch auf schweren, lehmigen Böden. Er trägt früh, später reich und regelmäßig. Da er spät blüht, leidet er selten unter Spätfrost; für Schorf und tierische Schädlinge ist er wenig anfällig.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Schöner_aus_Wiedenbrück&oldid=266165884"},{"quelle":"web_biobaumversand","url":"https://biobaumversand.de/Apfelbaum-Schoener-aus-Wiedenbrueck/003438710324651"}]}],"bilder":[{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/a/a9/Sch%C3%B6ner_von_Wiedenbr%C3%BCck.jpg/960px-Sch%C3%B6ner_von_Wiedenbr%C3%BCck.jpg","seite":"https://commons.wikimedia.org/wiki/File:Sch%C3%B6ner_von_Wiedenbr%C3%BCck.jpg","art":"frucht","urheber":"AtaraxiaArt","lizenz":"CC BY-SA 4.0","quelle":"commons","titel":"Schöner von Wiedenbrück.jpg"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/c5/Sch%C3%B6ner_von_Wiedenbr%C3%BCck_einige_Tage_gelagert.jpg/960px-Sch%C3%B6ner_von_Wiedenbr%C3%BCck_einige_Tage_gelagert.jpg","seite":"https://commons.wikimedia.org/wiki/File:Sch%C3%B6ner_von_Wiedenbr%C3%BCck_einige_Tage_gelagert.jpg","art":"frucht","urheber":"AtaraxiaArt","lizenz":"CC BY-SA 4.0","quelle":"commons","titel":"Schöner von Wiedenbrück einige Tage gelagert.jpg"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/2/21/Schoener_von_Wiedenbr%C3%BCck_Schaedlingsbefall_2022.jpg/960px-Schoener_von_Wiedenbr%C3%BCck_Schaedlingsbefall_2022.jpg","seite":"https://commons.wikimedia.org/wiki/File:Schoener_von_Wiedenbr%C3%BCck_Schaedlingsbefall_2022.jpg","art":"frucht","urheber":"AtaraxiaArt","lizenz":"CC BY-SA 4.0","quelle":"commons-fotos","titel":"Schoener von Wiedenbrück Schaedlingsbefall 2022"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/c4/Sch%C3%B6ner_von_Wiedenbr%C3%BCck_kurz_nach_der_Ernte.jpg/960px-Sch%C3%B6ner_von_Wiedenbr%C3%BCck_kurz_nach_der_Ernte.jpg","seite":"https://commons.wikimedia.org/wiki/File:Sch%C3%B6ner_von_Wiedenbr%C3%BCck_kurz_nach_der_Ernte.jpg","art":"frucht","urheber":"AtaraxiaArt","lizenz":"CC BY-SA 4.0","quelle":"commons-fotos","titel":"Schöner von Wiedenbrück kurz nach der Ernte"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/b/b1/Apfelbaum_Sch%C3%B6ner_von_Wiedenbr%C3%BCck_im_Hitzesommer_2018.jpg/960px-Apfelbaum_Sch%C3%B6ner_von_Wiedenbr%C3%BCck_im_Hitzesommer_2018.jpg","seite":"https://commons.wikimedia.org/wiki/File:Apfelbaum_Sch%C3%B6ner_von_Wiedenbr%C3%BCck_im_Hitzesommer_2018.jpg","art":"baum","urheber":"AtaraxiaArt","lizenz":"CC BY-SA 4.0","quelle":"commons-fotos","titel":"Apfelbaum Schöner von Wiedenbrück im Hitzesommer 2018"}],"regionen":[{"region":"DE-NW","art":"herkunft","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Schöner_aus_Wiedenbrück&oldid=266165884"},{"quelle":"web_biobaumversand","url":"https://biobaumversand.de/Apfelbaum-Schoener-aus-Wiedenbrueck/003438710324651"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Schöner_aus_Wiedenbrück&oldid=266165884"},{"quelle":"web_biobaumversand","url":"https://biobaumversand.de/Apfelbaum-Schoener-aus-Wiedenbrueck/003438710324651"}]},{"region":"DE-NW","art":"empfehlung","belege":[{"quelle":"rg_nw-koordinierungsausschuss-2023"}],"original":"Schöner aus Wiedenbrück"},{"region":"DE-NW","art":"regionalsorte","belege":[{"quelle":"rg_nw-koordinierungsausschuss-2023","seite":"Spalte Bemerkungen"},{"quelle":"rg_nw-lwl-obstsorten"}],"original":"Schöner aus Wiedenbrück"}],"gefaehrdung":[{"stufe":"Rote Liste der gefährdeten einheimischen Nutzpflanzen in Deutschland","belege":[{"quelle":"rg_ble-rote-liste"}],"original":"Schöner aus Wiedenbrück"}]}