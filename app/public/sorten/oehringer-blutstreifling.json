{"id":"oehringer-blutstreifling","name":"Öhringer Blutstreifling","synonyme":[],"herkunft":{"text":"Zufallssämling aus Unterohrn bei Öhringen (Hohenlohe, Baden-Württemberg), bekannt seit Anfang des 20. Jahrhunderts und 1907 erstmals von Fr. Lucas beschrieben.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Öhringer_Blutstreifling&oldid=270887555"},{"quelle":"web_kob","url":"https://www.kob-bavendorf.de/files/bereiche/Streuobst/Projekte%20Streuobst/Sortenpatenschaften/SP_Hohenlohekreis_oA.pdf"}]},"merkmale":[{"merkmal":"frucht_groesse","wert":"5","original":"Die Früchte sind mittelgroß und abgeflacht","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Öhringer_Blutstreifling&oldid=270887555"},{"merkmal":"frucht_form","wert":"flachrund","original":"Die Früchte sind mittelgroß und abgeflacht","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Öhringer_Blutstreifling&oldid=270887555"},{"merkmal":"schale_beschaffenheit","wert":"glatt","original":"Die Schale ist glatt und wachsartig","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Öhringer_Blutstreifling&oldid=270887555"},{"merkmal":"schale_grundfarbe","wert":"weisslichgelb","original":"von strohgelber Grundfarbe","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Öhringer_Blutstreifling&oldid=270887555"},{"merkmal":"schale_deckfarbe_anteil","wert":"5","original":"sonnenseitig einem kräftigen Rot","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Öhringer_Blutstreifling&oldid=270887555"},{"merkmal":"schale_deckfarbe_farbton","wert":"rot","original":"sonnenseitig einem kräftigen Rot mit einzelnen dunkelroten Streifen","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Öhringer_Blutstreifling&oldid=270887555"},{"merkmal":"schale_deckfarbe_art","wert":"gestreift","original":"mit einzelnen dunkelroten Streifen","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Öhringer_Blutstreifling&oldid=270887555"},{"merkmal":"fleisch_farbe","wert":"weiss","original":"Das weißliche Fruchtfleisch ist fest und saftig","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Öhringer_Blutstreifling&oldid=270887555"},{"merkmal":"fleisch_festigkeit","wert":"7","original":"Das weißliche Fruchtfleisch ist fest und saftig","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Öhringer_Blutstreifling&oldid=270887555"},{"merkmal":"fleisch_saftigkeit","wert":"7","original":"Das weißliche Fruchtfleisch ist fest und saftig","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Öhringer_Blutstreifling&oldid=270887555"},{"merkmal":"geschmack_suesse","wert":"7","original":"mit einem süßen Geschmack und wenig Säure","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Öhringer_Blutstreifling&oldid=270887555"},{"merkmal":"geschmack_saeure","wert":"3","original":"mit einem süßen Geschmack und wenig Säure","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Öhringer_Blutstreifling&oldid=270887555"},{"merkmal":"verwendung","wert":"tafel","original":"sowohl als Tafelapfel als auch als Saft- oder Mostapfel","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Öhringer_Blutstreifling&oldid=270887555"},{"merkmal":"verwendung","wert":"most","original":"sowohl als Tafelapfel als auch als Saft- oder Mostapfel","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Öhringer_Blutstreifling&oldid=270887555"},{"merkmal":"baum_wuchs","wert":"7","original":"Der Baum wächst anfangs stark","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Öhringer_Blutstreifling&oldid=270887555"},{"merkmal":"frucht_groesse","wert":"5","original":"Die mittelgroßen Früchte","quelle":"web_kob","url":"https://www.kob-bavendorf.de/files/bereiche/Streuobst/Projekte%20Streuobst/Sortenpatenschaften/SP_Hohenlohekreis_oA.pdf"},{"merkmal":"fleisch_saftigkeit","wert":"7","original":"saftig-süß","quelle":"web_kob","url":"https://www.kob-bavendorf.de/files/bereiche/Streuobst/Projekte%20Streuobst/Sortenpatenschaften/SP_Hohenlohekreis_oA.pdf"},{"merkmal":"geschmack_suesse","wert":"7","original":"saftig-süß und enthalten wenig Säure","quelle":"web_kob","url":"https://www.kob-bavendorf.de/files/bereiche/Streuobst/Projekte%20Streuobst/Sortenpatenschaften/SP_Hohenlohekreis_oA.pdf"},{"merkmal":"geschmack_saeure","wert":"3","original":"enthalten wenig Säure und Aroma","quelle":"web_kob","url":"https://www.kob-bavendorf.de/files/bereiche/Streuobst/Projekte%20Streuobst/Sortenpatenschaften/SP_Hohenlohekreis_oA.pdf"},{"merkmal":"verwendung","wert":"tafel","original":"Der Tafel- und Wirtschaftsapfel","quelle":"web_kob","url":"https://www.kob-bavendorf.de/files/bereiche/Streuobst/Projekte%20Streuobst/Sortenpatenschaften/SP_Hohenlohekreis_oA.pdf"},{"merkmal":"verwendung","wert":"kueche","original":"Der Tafel- und Wirtschaftsapfel","quelle":"web_kob","url":"https://www.kob-bavendorf.de/files/bereiche/Streuobst/Projekte%20Streuobst/Sortenpatenschaften/SP_Hohenlohekreis_oA.pdf"},{"merkmal":"pflueckreife","wert":"10","original":"Sie werden im Oktober geerntet","quelle":"web_kob","url":"https://www.kob-bavendorf.de/files/bereiche/Streuobst/Projekte%20Streuobst/Sortenpatenschaften/SP_Hohenlohekreis_oA.pdf"},{"merkmal":"genussreife_ende","wert":"4","original":"sind bis April lagerfähig","quelle":"web_kob","url":"https://www.kob-bavendorf.de/files/bereiche/Streuobst/Projekte%20Streuobst/Sortenpatenschaften/SP_Hohenlohekreis_oA.pdf"}],"texte":[{"thema":"ueberblick","text":"Hohenloher Lokalsorte aus der Gegend von Öhringen, ein mittelgroßer, flacher Apfel mit strohgelber Grundfarbe und kräftig roter, dunkel gestreifter Sonnenseite. Das weißliche Fleisch ist fest, saftig und süß mit wenig Säure. Die Sorte dient als Tafel-, Wirtschafts- und Mostapfel; 2019 wählte der Landesverband für Obstbau, Garten und Landschaft Baden-Württemberg sie zur Streuobstsorte des Jahres. In den Werken des 19. Jahrhunderts kommt sie nicht vor.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Öhringer_Blutstreifling&oldid=270887555"},{"quelle":"web_kob","url":"https://www.kob-bavendorf.de/files/bereiche/Streuobst/Projekte%20Streuobst/Sortenpatenschaften/SP_Hohenlohekreis_oA.pdf"}]},{"thema":"herkunft","text":"Die Sorte entstand als Zufallssämling in Unterohrn bei Öhringen und ist seit Anfang des 20. Jahrhunderts bekannt. Die erste Beschreibung stammt von Fr. Lucas, nach dem Kompetenzzentrum Obstbau Bodensee aus dem Jahr 1907.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Öhringer_Blutstreifling&oldid=270887555"},{"quelle":"web_kob","url":"https://www.kob-bavendorf.de/files/bereiche/Streuobst/Projekte%20Streuobst/Sortenpatenschaften/SP_Hohenlohekreis_oA.pdf"}]},{"thema":"frucht","text":"Die Früchte sind mittelgroß und abgeflacht.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Öhringer_Blutstreifling&oldid=270887555"},{"quelle":"web_kob","url":"https://www.kob-bavendorf.de/files/bereiche/Streuobst/Projekte%20Streuobst/Sortenpatenschaften/SP_Hohenlohekreis_oA.pdf"}]},{"thema":"schale","text":"Die Schale ist glatt und wachsartig. In der Reife ist die Grundfarbe strohgelb; die Sonnenseite ist kräftig rot mit einzelnen dunkelroten Streifen.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Öhringer_Blutstreifling&oldid=270887555"}]},{"thema":"fleisch_geschmack","text":"Das Fruchtfleisch ist weißlich, fest und saftig. Der Geschmack ist süß mit wenig Säure und wenig Aroma.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Öhringer_Blutstreifling&oldid=270887555"},{"quelle":"web_kob","url":"https://www.kob-bavendorf.de/files/bereiche/Streuobst/Projekte%20Streuobst/Sortenpatenschaften/SP_Hohenlohekreis_oA.pdf"}]},{"thema":"reife_lagerung","text":"Geerntet wird im Oktober; die Früchte lassen sich bis in den April lagern.","belege":[{"quelle":"web_kob","url":"https://www.kob-bavendorf.de/files/bereiche/Streuobst/Projekte%20Streuobst/Sortenpatenschaften/SP_Hohenlohekreis_oA.pdf"}]},{"thema":"baum","text":"Der Baum wächst anfangs stark und braucht einen kräftigen Erziehungsschnitt; mit Beginn des Ertrags lässt der Wuchs nach. Die hochgebaute, kugelige Krone bleibt mittelgroß. Die Erträge sind hoch und regelmäßig.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Öhringer_Blutstreifling&oldid=270887555"},{"quelle":"web_kob","url":"https://www.kob-bavendorf.de/files/bereiche/Streuobst/Projekte%20Streuobst/Sortenpatenschaften/SP_Hohenlohekreis_oA.pdf"}]},{"thema":"verwendung","text":"Tafel- und Wirtschaftsapfel, zudem für Saft und Most geeignet.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Öhringer_Blutstreifling&oldid=270887555"},{"quelle":"web_kob","url":"https://www.kob-bavendorf.de/files/bereiche/Streuobst/Projekte%20Streuobst/Sortenpatenschaften/SP_Hohenlohekreis_oA.pdf"}]}],"bilder":[{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/cc/%C3%96hringer_Blutstreifling_jm55056.jpg/960px-%C3%96hringer_Blutstreifling_jm55056.jpg","seite":"https://commons.wikimedia.org/wiki/File:%C3%96hringer_Blutstreifling_jm55056.jpg","art":"frucht","urheber":"joergens.mi","lizenz":"CC BY-SA 3.0","quelle":"commons","titel":"Öhringer Blutstreifling jm55056.jpg"},{"url":"https://upload.wikimedia.org/wikipedia/commons/9/90/ApfelOehringerBlutstreifling167.JPG","seite":"https://commons.wikimedia.org/wiki/File:ApfelOehringerBlutstreifling167.JPG","art":"frucht","urheber":"manfred.sause@volloeko.de","lizenz":"CC BY-SA 3.0","quelle":"commons-fotos","titel":"ApfelOehringerBlutstreifling167"},{"url":"https://upload.wikimedia.org/wikipedia/commons/0/00/ApfelOehringerBlutstreifling168.JPG","seite":"https://commons.wikimedia.org/wiki/File:ApfelOehringerBlutstreifling168.JPG","art":"frucht","urheber":"manfred.sause@volloeko.de","lizenz":"CC BY-SA 3.0","quelle":"commons-fotos","titel":"ApfelOehringerBlutstreifling168"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/89/%C3%96hringer_Blutstreifling_%28apple%29_jm179339.jpg/960px-%C3%96hringer_Blutstreifling_%28apple%29_jm179339.jpg","seite":"https://commons.wikimedia.org/wiki/File:%C3%96hringer_Blutstreifling_(apple)_jm179339.jpg","art":"baum","urheber":"joergens.mi","lizenz":"CC BY-SA 3.0","quelle":"commons-fotos","titel":"Öhringer Blutstreifling (apple) jm179339"}]}