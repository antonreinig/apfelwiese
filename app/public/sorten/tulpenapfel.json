{"id":"tulpenapfel","name":"Tulpenapfel","synonyme":[{"name":"Rode Tulpappel","beleg":{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Tulpenapfel&oldid=200036919"}}],"herkunft":{"text":"Herkunft unbekannt; im Rheinland schon um 1900 verbreitet.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Tulpenapfel&oldid=200036919"}],"jahr":1900},"merkmale":[{"merkmal":"verwendung","wert":"kueche","original":"wird als Wirtschaftsapfel genutzt","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Tulpenapfel&oldid=200036919"},{"merkmal":"genussreife_beginn","wert":"9","original":"Der Apfel reift von September bis November","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Tulpenapfel&oldid=200036919"},{"merkmal":"genussreife_ende","wert":"11","original":"Der Apfel reift von September bis November","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Tulpenapfel&oldid=200036919"},{"merkmal":"baum_wuchs","wert":"5","original":"Der Baum ist mittelstark bis stark wachsend","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Tulpenapfel&oldid=200036919"},{"merkmal":"baum_wuchs","wert":"7","original":"Der Baum ist mittelstark bis stark wachsend","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Tulpenapfel&oldid=200036919"},{"merkmal":"gesundheit","wert":"7","original":"gilt als robuste Streuobstsorte","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Tulpenapfel&oldid=200036919"},{"merkmal":"hochstamm","wert":"gut","original":"gilt als robuste Streuobstsorte","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Tulpenapfel&oldid=200036919"}],"texte":[{"thema":"ueberblick","text":"Der Tulpenapfel ist eine alte Regionalsorte, die am Rhein um Bonn, im Bergischen Land und in den Niederlanden (dort als „rode tulpappel“) bekannt ist. Er ist im Streuobst unter diesem Namen noch verbreitet und wird als Wirtschaftsapfel genutzt. Eine pomologische Fruchtbeschreibung liegt in den hier ausgewerteten Quellen nicht vor.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Tulpenapfel&oldid=200036919"}]},{"thema":"herkunft","text":"Die Herkunft ist unbekannt. Im Rheinland war die Sorte nach Wikipedia schon um 1900 verbreitet.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Tulpenapfel&oldid=200036919"}]},{"thema":"reife_lagerung","text":"Die Früchte reifen nach Wikipedia von September bis November.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Tulpenapfel&oldid=200036919"}]},{"thema":"baum","text":"Der Baum wächst mittelstark bis stark und gilt als robuste Streuobstsorte.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Tulpenapfel&oldid=200036919"}]},{"thema":"verwendung","text":"Der Tulpenapfel wird als Wirtschaftsapfel genutzt.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Tulpenapfel&oldid=200036919"}]},{"thema":"unterscheidung","text":"Ein Zusammenhang mit dem Tulpenapfel Diels ist nicht belegt. Diels Tulpenapfel reifte nach dem Handbuch (1859) im August und wird dort mit dem Florianer Rosenapfel gleichgesetzt; der rheinische Tulpenapfel reift nach Wikipedia von September bis November.","belege":[{"quelle":"illustr_hb_1","band":"I","seite":"431–432"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Tulpenapfel&oldid=200036919"}]}],"bilder":[{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/0/01/Malus_Tulpenapfel_4165.jpg/960px-Malus_Tulpenapfel_4165.jpg","seite":"https://commons.wikimedia.org/wiki/File:Malus_Tulpenapfel_4165.jpg","art":"frucht","urheber":"Sven Teschke","lizenz":"CC BY-SA 3.0 de","quelle":"commons","titel":"Malus Tulpenapfel 4165.jpg"},{"url":"https://upload.wikimedia.org/wikipedia/commons/8/81/Pom.Mon.Hefte_1857_Gr._b%C3%B6hmische_S.-Blutbirn_%2B_Tulpenapfel.jpg","seite":"https://commons.wikimedia.org/wiki/File:Pom.Mon.Hefte_1857_Gr._b%C3%B6hmische_S.-Blutbirn_%2B_Tulpenapfel.jpg","art":"tafel","urheber":"Unknown author Unknown author","lizenz":"gemeinfrei","quelle":"pomologische-monatshefte","titel":"Pom.Mon.Hefte 1857 Gr. böhmische S.-Blutbirn + Tulpenapfel"}],"regionen":[{"region":"DE-NW","art":"verbreitung","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Tulpenapfel&oldid=200036919"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Tulpenapfel&oldid=200036919"}],"original":"im Rheinland schon um 1900 verbreitet"},{"region":"DE-RP","art":"verbreitung","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Tulpenapfel&oldid=200036919"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Tulpenapfel&oldid=200036919"}],"original":"im Rheinland schon um 1900 verbreitet"},{"region":"DE-NW","art":"empfehlung","belege":[{"quelle":"rg_nw-koordinierungsausschuss-2023"}],"original":"Tulpenapfel"},{"region":"DE-NW","art":"regionalsorte","belege":[{"quelle":"rg_nw-koordinierungsausschuss-2023","seite":"Spalte Bemerkungen"}],"original":"Tulpenapfel"},{"region":"DE-RP","art":"empfehlung","belege":[{"quelle":"rg_rp-streuobst-sortenempfehlung-2018"}],"original":"Tulpenapfel"}],"gefaehrdung":[{"stufe":"Rote Liste der gefährdeten einheimischen Nutzpflanzen in Deutschland","belege":[{"quelle":"rg_ble-rote-liste"}],"original":"Tulpenapfel"}]}