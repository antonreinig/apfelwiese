ia.org/wikipedia/commons/d/dc/Egremont_Russet_Apple.jpg","seite":"https://commons.wikimedia.org/wiki/File:Egremont_Russet_Apple.jpg","art":"frucht","urheber":"AJR","lizenz":"CC BY-SA 3.0","quelle":"commons-fotos","titel":"Egremont Russet Apple"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/c2/Pomological_Watercolor_POM00002123.jpg/960px-Pomological_Watercolor_POM00002123.jpg","seite":"https://commons.wikimedia.org/wiki/File:Pomological_Watercolor_POM00002123.jpg","art":"tafel","urheber":"Passmore, Deborah Griscom, 1840-1911","lizenz":"gemeinfrei","quelle":"usda-pomological","titel":"Pomological Watercolor POM00002123"},{"url":"https://upload.wikimedia.org/wikipedia/commons/0/08/Egremont_Russet_%28EMLA_1%29_on_tree%2C_National_Fruit_Collection_%28acc._1979-159%29.jpg","seite":"https://commons.wikimedia.org/wiki/File:Egremont_Russet_(EMLA_1)_on_tree,_National_Fruit_Collection_(acc._1979-159).jpg","art":"baum","urheber":"National Fruit Collection, Brogdale","lizenz":"OGL 2.0","quelle":"nfc-commons","titel":"Egremont Russet (EMLA 1) on tree, National Fruit Collection (acc. 1979-159)"},{"url":"https://upload.wikimedia.org/wikipedia/commons/d/de/Scrummy_2_-_geograph.org.uk_-_974352.jpg","seite":"https://commons.wikimedia.org/wiki/File:Scrummy_2_-_geograph.org.uk_-_974352.jpg","art":"baum","urheber":"Jonathan Billinger","lizenz":"CC BY-SA 2.0","quelle":"commons-fotos","titel":"Scrummy 2 - geograph.org.uk - 974352"}],"farbmessung":[{"bild":"https://upload.wikimedia.org/wikipedia/commons/d/d4/Cross_section_of_Egremont_Russet_%28EMLA_1%29%2C_National_Fruit_Collection_%28acc._1979-159%29.jpg","methode":"NFC-Foto","verfahren":"Foto (NFC-Fototafel: 4 ganze Früchte, 2 Schnitte, Fototisch); Weißabgleich über den Hintergrund; Frucht per Hintergrundmodell freigestellt; Schalenpixel ohne Glanzlichter einzeln klassifiziert: Grundfarbe aus gelbgrünen Pixeln, Deckfarbe = Pixel mit deutlich höherem a* als die Grundfarbe (auch dunkle Rot- und Braunrottöne), Anteile über Pixel; Höhe/Breite aus dem Längsschnitt","grundfarbe":"#bc9242","deckfarbe":"#a64e31","deckfarbeAnteil":0.13,"rostfarbe":"#946742","fleischfarbe":"#dbd2be","hoeheZuBreite":0.841},{"bild":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/c2/Pomological_Watercolor_POM00002123.jpg/960px-Pomological_Watercolor_POM00002123.jpg","methode":"Aquarell","verfahren":"Aquarell (USDA Pomological Watercolor, ca. 1886–1942); Papierton als Weißpunkt; Frucht vor Papier freigestellt; Schalenpixel einzeln klassifiziert (Deckfarbe = deutlich höheres a* als die Grundfarbe, Anteile über Pixel); Höhe/Breite aus dem gemalten Längsschnitt, sonst aus der Seitenansicht; gemessen an einer 480 px breiten Kopie; Farbwiedergabe des Malers, nicht fotometrisch","grundfarbe":"#fabf50","deckfarbe":"#ca4810","deckfarbeAnteil":0.74,"fleischfarbe":"#f9e5bf","hoeheZuBreite":0.804}]}