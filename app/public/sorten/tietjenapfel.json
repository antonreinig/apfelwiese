{"id":"tietjenapfel","name":"Tietjenapfel","synonyme":[{"name":"Uphuser Tietjenapfel","beleg":{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Tietjenapfel&oldid=223003072"}},{"name":"Uphuser Tietzenapfel","beleg":{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Tietjenapfel&oldid=223003072"}}],"herkunft":{"text":"Uphusen (Stadt Achim) südlich von Bremen; vermutlich Zufallssämling, Ende des 19. Jahrhunderts vom Dorfschullehrer und Heimatdichter Friedrich Seebode gefunden und vermehrt; 1907 erstmals im Sortenverzeichnis der Provinz Hannover erwähnt.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Tietjenapfel&oldid=223003072"},{"quelle":"web_pomologen_verein","url":"https://www.pomologen-verein.de/media/user_upload/Landesgruppen/2017_Tietjenapfel_Beschreibung.pdf"}],"land":"DE","landSicher":true,"ort":"Uphusen (Achim)","jahr":1907},"merkmale":[{"merkmal":"frucht_form","wert":"rund","original":"Kugelig, zum Kelch verjüngt","quelle":"web_pomologen_verein","url":"https://www.pomologen-verein.de/media/user_upload/Landesgruppen/2017_Tietjenapfel_Beschreibung.pdf"},{"merkmal":"schale_beschaffenheit","wert":"glatt","original":"Glatt, nicht fettend","quelle":"web_pomologen_verein","url":"https://www.pomologen-verein.de/media/user_upload/Landesgruppen/2017_Tietjenapfel_Beschreibung.pdf"},{"merkmal":"schale_grundfarbe","wert":"gruen","original":"Die Frucht ist grün mit roten Backen","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Tietjenapfel&oldid=223003072"},{"merkmal":"schale_deckfarbe_farbton","wert":"rot","original":"grün mit roten Backen","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Tietjenapfel&oldid=223003072"},{"merkmal":"fleisch_festigkeit","wert":"7","original":"Fest, markig, saftig","quelle":"web_pomologen_verein","url":"https://www.pomologen-verein.de/media/user_upload/Landesgruppen/2017_Tietjenapfel_Beschreibung.pdf"},{"merkmal":"fleisch_festigkeit","wert":"5","original":"Fest, markig, saftig","quelle":"web_pomologen_verein","url":"https://www.pomologen-verein.de/media/user_upload/Landesgruppen/2017_Tietjenapfel_Beschreibung.pdf"},{"merkmal":"fleisch_saftigkeit","wert":"7","original":"Fest, markig, saftig","quelle":"web_pomologen_verein","url":"https://www.pomologen-verein.de/media/user_upload/Landesgruppen/2017_Tietjenapfel_Beschreibung.pdf"},{"merkmal":"geschmack_suesse","wert":"5","original":"süß-säuerlich mit einer charakteristischen leicht holzigen Note","quelle":"web_pomologen_verein","url":"https://www.pomologen-verein.de/media/user_upload/Landesgruppen/2017_Tietjenapfel_Beschreibung.pdf"},{"merkmal":"geschmack_saeure","wert":"5","original":"süß-säuerlich mit einer charakteristischen leicht holzigen Note","quelle":"web_pomologen_verein","url":"https://www.pomologen-verein.de/media/user_upload/Landesgruppen/2017_Tietjenapfel_Beschreibung.pdf"},{"merkmal":"geschmack_aroma","wert":"leicht holzige Note","original":"mit einer charakteristischen leicht holzigen Note","quelle":"web_pomologen_verein","url":"https://www.pomologen-verein.de/media/user_upload/Landesgruppen/2017_Tietjenapfel_Beschreibung.pdf"},{"merkmal":"verwendung","wert":"tafel","original":"ist eine Tafelapfel-Sorte aus Uphusen","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Tietjenapfel&oldid=223003072"},{"merkmal":"pflueckreife","wert":"10","original":"Pflückreife Oktober","quelle":"web_pomologen_verein","url":"https://www.pomologen-verein.de/media/user_upload/Landesgruppen/2017_Tietjenapfel_Beschreibung.pdf"},{"merkmal":"genussreife_beginn","wert":"10","original":"Genussreife Oktober – November/Anfang Dezember","quelle":"web_pomologen_verein","url":"https://www.pomologen-verein.de/media/user_upload/Landesgruppen/2017_Tietjenapfel_Beschreibung.pdf"},{"merkmal":"genussreife_ende","wert":"11","original":"Genussreife Oktober – November/Anfang Dezember","quelle":"web_pomologen_verein","url":"https://www.pomologen-verein.de/media/user_upload/Landesgruppen/2017_Tietjenapfel_Beschreibung.pdf"},{"merkmal":"genussreife_ende","wert":"12","original":"Genussreife Oktober – November/Anfang Dezember","quelle":"web_pomologen_verein","url":"https://www.pomologen-verein.de/media/user_upload/Landesgruppen/2017_Tietjenapfel_Beschreibung.pdf"},{"merkmal":"baum_wuchs","wert":"5","original":"Mittelstark wachsend, gesund, sehr fruchtbar","quelle":"web_pomologen_verein","url":"https://www.pomologen-verein.de/media/user_upload/Landesgruppen/2017_Tietjenapfel_Beschreibung.pdf"},{"merkmal":"baum_wuchs","wert":"7","original":"Dabei ist der ‘Tietjenapfel’ starkwüchsig und breitkronig","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Tietjenapfel&oldid=223003072"},{"merkmal":"lagerfaehigkeit","wert":"5","original":"bis Anfang Dezember genussreif","quelle":"web_pomologen_verein","url":"https://www.pomologen-verein.de/media/user_upload/Landesgruppen/2017_Tietjenapfel_Beschreibung.pdf","belege":[{"quelle":"web_pomologen_verein","url":"https://www.pomologen-verein.de/media/user_upload/Landesgruppen/2017_Tietjenapfel_Beschreibung.pdf"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Tietjenapfel&oldid=223003072"}]},{"merkmal":"gesundheit","wert":"7","original":"Beide beschreiben ihn als gesund und anspruchslos","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Tietjenapfel&oldid=223003072","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Tietjenapfel&oldid=223003072"},{"quelle":"web_pomologen_verein","url":"https://www.pomologen-verein.de/media/user_upload/Landesgruppen/2017_Tietjenapfel_Beschreibung.pdf"}]},{"merkmal":"standort_boden","wert":"3","original":"er gedeiht auch auf nährstoffarmen Sandböden","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Tietjenapfel&oldid=223003072","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Tietjenapfel&oldid=223003072"},{"quelle":"web_pomologen_verein","url":"https://www.pomologen-verein.de/media/user_upload/Landesgruppen/2017_Tietjenapfel_Beschreibung.pdf"}]},{"merkmal":"anfaelligkeit_schorf","wert":"3","original":"ist kaum schorfanfällig und trägt reich und regelmäßig","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Tietjenapfel&oldid=223003072","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Tietjenapfel&oldid=223003072"},{"quelle":"web_pomologen_verein","url":"https://www.pomologen-verein.de/media/user_upload/Landesgruppen/2017_Tietjenapfel_Beschreibung.pdf"}]},{"merkmal":"ertrag_alternanz","wert":"regelmaessig","original":"ist kaum schorfanfällig und trägt reich und regelmäßig","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Tietjenapfel&oldid=223003072","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Tietjenapfel&oldid=223003072"},{"quelle":"web_pomologen_verein","url":"https://www.pomologen-verein.de/media/user_upload/Landesgruppen/2017_Tietjenapfel_Beschreibung.pdf"}]}],"texte":[{"thema":"ueberblick","text":"Der Tietjenapfel ist eine Lokalsorte aus Uphusen bei Achim südlich von Bremen und wird als Tafelapfel genutzt. Er gilt als robuster, kaum schorfanfälliger Herbstapfel und wurde 2017 zur Streuobstsorte des Jahres in Norddeutschland gewählt.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Tietjenapfel&oldid=223003072"},{"quelle":"web_pomologen_verein","url":"https://www.pomologen-verein.de/media/user_upload/Landesgruppen/2017_Tietjenapfel_Beschreibung.pdf"}]},{"thema":"herkunft","text":"Die Sorte entstand vermutlich als Zufallssämling. Ende des 19. Jahrhunderts fand sie der Dorfschullehrer und Heimatdichter Friedrich Seebode bei einer Wanderung in der Uphuser Dünenlandschaft und vermehrte sie mit Schülern im Schulgarten. Benannt ist sie nach dem Geburtsnamen seiner Ehefrau, einer geborenen Tietjen. Im Sortenverzeichnis für den Obstanbau der Provinz Hannover erscheint der Apfel nach Wikipedia zuerst 1907. Verbreitet ist er im Raum Achim.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Tietjenapfel&oldid=223003072"},{"quelle":"web_pomologen_verein","url":"https://www.pomologen-verein.de/media/user_upload/Landesgruppen/2017_Tietjenapfel_Beschreibung.pdf"}]},{"thema":"frucht","text":"Die Frucht ist kugelig und verjüngt sich zum Kelch. Wird nicht ausgedünnt, bleiben die Früchte wegen der hohen Fruchtbarkeit klein.","belege":[{"quelle":"web_pomologen_verein","url":"https://www.pomologen-verein.de/media/user_upload/Landesgruppen/2017_Tietjenapfel_Beschreibung.pdf"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Tietjenapfel&oldid=223003072"}]},{"thema":"schale","text":"Die Schale ist glatt und wird nicht fettig. Wikipedia beschreibt die Frucht als grün mit roten Backen.","belege":[{"quelle":"web_pomologen_verein","url":"https://www.pomologen-verein.de/media/user_upload/Landesgruppen/2017_Tietjenapfel_Beschreibung.pdf"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Tietjenapfel&oldid=223003072"}]},{"thema":"fleisch_geschmack","text":"Das Fruchtfleisch ist fest, markig und saftig. Der Geschmack ist süßsäuerlich mit einer charakteristischen, leicht holzigen Note.","belege":[{"quelle":"web_pomologen_verein","url":"https://www.pomologen-verein.de/media/user_upload/Landesgruppen/2017_Tietjenapfel_Beschreibung.pdf"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Tietjenapfel&oldid=223003072"}]},{"thema":"reife_lagerung","text":"Die Früchte werden im Oktober gepflückt und sind von Oktober bzw. November bis Anfang Dezember genussreif.","belege":[{"quelle":"web_pomologen_verein","url":"https://www.pomologen-verein.de/media/user_upload/Landesgruppen/2017_Tietjenapfel_Beschreibung.pdf"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Tietjenapfel&oldid=223003072"}]},{"thema":"baum","text":"Die Angaben zum Wuchs gehen auseinander: Wikipedia nennt den Baum starkwüchsig und breitkronig, das Sortenblatt der Norddeutschen Apfeltage mittelstark wachsend. Beide beschreiben ihn als gesund und anspruchslos; er gedeiht auch auf nährstoffarmen Sandböden, ist kaum schorfanfällig und trägt reich und regelmäßig.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Tietjenapfel&oldid=223003072"},{"quelle":"web_pomologen_verein","url":"https://www.pomologen-verein.de/media/user_upload/Landesgruppen/2017_Tietjenapfel_Beschreibung.pdf"}]},{"thema":"verwendung","text":"Der Tietjenapfel wird als Tafelapfel gegessen; das Sortenblatt empfiehlt ihn wegen Robustheit und regelmäßiger Erträge als Apfel zur Selbstversorgung.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Tietjenapfel&oldid=223003072"},{"quelle":"web_pomologen_verein","url":"https://www.pomologen-verein.de/media/user_upload/Landesgruppen/2017_Tietjenapfel_Beschreibung.pdf"}]}],"bilder":[{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/c5/Tietjenapfel.jpg/960px-Tietjenapfel.jpg","seite":"https://commons.wikimedia.org/wiki/File:Tietjenapfel.jpg","art":"frucht","urheber":"SybilKaesedick","lizenz":"CC BY-SA 4.0","quelle":"commons","titel":"Tietjenapfel.jpg"}],"regionen":[{"region":"DE-NI","art":"herkunft","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Tietjenapfel&oldid=223003072"},{"quelle":"web_pomologen_verein","url":"https://www.pomologen-verein.de/media/user_upload/Landesgruppen/2017_Tietjenapfel_Beschreibung.pdf"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Tietjenapfel&oldid=223003072"},{"quelle":"web_pomologen_verein","url":"https://www.pomologen-verein.de/media/user_upload/Landesgruppen/2017_Tietjenapfel_Beschreibung.pdf"}]},{"region":"DE-NI","art":"verbreitung","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Tietjenapfel&oldid=223003072"},{"quelle":"web_pomologen_verein","url":"https://www.pomologen-verein.de/media/user_upload/Landesgruppen/2017_Tietjenapfel_Beschreibung.pdf"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Tietjenapfel&oldid=223003072"},{"quelle":"web_pomologen_verein","url":"https://www.pomologen-verein.de/media/user_upload/Landesgruppen/2017_Tietjenapfel_Beschreibung.pdf"}],"original":"Verbreitet ist er im Raum Achim."},{"region":"DE-SH","art":"empfehlung","belege":[{"quelle":"rg_shhh-pv-sortenempfehlung"}],"original":"Uphuser Tietjenapfel"},{"region":"DE-HH","art":"empfehlung","belege":[{"quelle":"rg_shhh-pv-sortenempfehlung"}],"original":"Uphuser Tietjenapfel"}],"gefaehrdung":[{"stufe":"Rote Liste der gefährdeten einheimischen Nutzpflanzen in Deutschland","belege":[{"quelle":"rg_ble-rote-liste"}],"original":"Tietjenapfel"}]}