{"id":"luxemburger-renette","name":"Luxemburger Renette","synonyme":[{"name":"Luxemburger Reinette","beleg":{"quelle":"engelbrecht1889","seite":"339 (Nr. 302)"}},{"name":"Reinette des Vergers","beleg":{"quelle":"engelbrecht1889","seite":"339 (Nr. 302)"}},{"name":"Obstgarten-Reinette","beleg":{"quelle":"illustr_hb_1","band":"I","seite":"115"}},{"name":"Coastress","beleg":{"quelle":"illustr_hb_1","band":"I","seite":"115"}}],"herkunft":{"text":"Stammt aus den Ardennen im Großherzogtum Luxemburg. Oberförster Koltz empfahl sie 1856 in der Monatsschrift für Pomologie, Augustin Wilhelm in Luxemburg brachte sie in den Handel.","belege":[{"quelle":"illustr_hb_1","band":"I","seite":"115"},{"quelle":"engelbrecht1889","seite":"339 (Nr. 302)"}],"land":"LU","landSicher":true,"ort":"Ardennen, Luxemburg","jahr":1856},"merkmale":[{"merkmal":"frucht_breite","wert":71,"original":"Gestalt 71:52—56","quelle":"engelbrecht1889","seite":"339 (Nr. 302)"},{"merkmal":"frucht_hoehe","wert":54,"original":"Gestalt 71:52—56","quelle":"engelbrecht1889","seite":"339 (Nr. 302)"},{"merkmal":"frucht_hoehe_breite","wert":0.76,"original":"Gestalt 71:52—56","quelle":"engelbrecht1889","seite":"339 (Nr. 302)"},{"merkmal":"frucht_form","wert":"rund","original":"abgestumpft rundlich bis länglich rund","quelle":"engelbrecht1889","seite":"339 (Nr. 302)"},{"merkmal":"frucht_breiteste_stelle","wert":"stiel","original":"wenig stielbauch.","quelle":"engelbrecht1889","seite":"339 (Nr. 302)"},{"merkmal":"frucht_symmetrie","wert":"schief","original":"Hälften meistens nicht ganz gleich","quelle":"engelbrecht1889","seite":"339 (Nr. 302)"},{"merkmal":"frucht_rippung","wert":"5","original":"Querschn. nicht ganz rund, oft deutlich kantig","quelle":"engelbrecht1889","seite":"339 (Nr. 302)"},{"merkmal":"frucht_rippung","wert":"7","original":"Querschn. nicht ganz rund, oft deutlich kantig","quelle":"engelbrecht1889","seite":"339 (Nr. 302)"},{"merkmal":"frucht_kronung","wert":"5","original":"Einsenk. … zwischen ziemlich flach