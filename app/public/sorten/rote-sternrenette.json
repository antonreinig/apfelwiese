,"quelle":"engelbrecht1889","seite":"524 (Nr. 471)"},{"merkmal":"frucht_hoehe_breite","wert":0.8,"original":"Gestalt 68:54—55","quelle":"engelbrecht1889","seite":"524 (Nr. 471)"},{"merkmal":"frucht_form","wert":"rund","original":"stark abgest. rundlich bis flachrund","quelle":"engelbrecht1889","seite":"524 (Nr. 471)"},{"merkmal":"frucht_form","wert":"flachrund","original":"stark abgest. rundlich bis flachrund","quelle":"engelbrecht1889","seite":"524 (Nr. 471)"},{"merkmal":"frucht_breiteste_stelle","wert":"mitte","original":"nicht oder wenig stielbauch.","quelle":"engelbrecht1889","seite":"524 (Nr. 471)"},{"merkmal":"frucht_breiteste_stelle","wert":"stiel","original":"nicht oder wenig stielbauch.","quelle":"engelbrecht1889","seite":"524 (Nr. 471)"},{"merkmal":"frucht_symmetrie","wert":"symmetrisch","original":"Hälften gleich","quelle":"engelbrecht1889","seite":"524 (Nr. 471)"},{"merkmal":"frucht_rippung","wert":"1","original":"Querschn. rund","quelle":"engelbrecht1889","seite":"524 (Nr. 471)"},{"merkmal":"frucht_kronung","wert":"1","original":"Einsenk. … eben oder wenig und kurzfaltig","quelle":"engelbrecht1889","seite":"524 (Nr. 471)"},{"merkmal":"kelch_offenheit","wert":"offen","original":"Kelch offen, ziemlich breit, braun, wollig","quelle":"engelbrecht1889","seite":"524 (Nr. 471)"},{"merkmal":"kelchgrube_tiefe","wert":"5","original":"Einsenk. mässig tief, meistens nur mittelweit","quelle":"engelbrecht1889","seite":"524 (Nr. 471)"},{"merkmal":"kelchgrube_weite","wert":"5","original":"meistens nur mittelweit","quelle":"engelbrecht1889","seite":"524 (Nr. 471)"},{"merkmal":"stiel_dicke","wert":"5","original":"Stiel holzig, mitteldick, an 18 mm lang, oft kürzer","quelle":"engelbrecht1889","seite":"524 (Nr. 471)"},{"merkmal":"stielgrube_tiefe","wert":"5","original":"Höhle mitteltief, mittelweit, eben, hellbraun berostet","quelle":"engelbrecht1889","seite":"524 (Nr. 471)"},{"merkmal":"stielgrube_weite","wert":"5","original":"Höhle mitteltief, mittelweit","quelle":"engel