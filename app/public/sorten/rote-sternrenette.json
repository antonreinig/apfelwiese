l":"20240509 Rote Sternrenette Apfelbaumallee Breitwieser Bruch 04"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/4/4b/Apfelbl%C3%BCte_Rote_Sternrenette.jpg/960px-Apfelbl%C3%BCte_Rote_Sternrenette.jpg","seite":"https://commons.wikimedia.org/wiki/File:Apfelbl%C3%BCte_Rote_Sternrenette.jpg","art":"bluete","urheber":"Hinnerk11","lizenz":"CC BY-SA 4.0","quelle":"commons-fotos","titel":"Apfelblüte Rote Sternrenette"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/0/05/Rote_Sternrenette_Freilichtmuseum_Roscheider_Hof_Bl%C3%BCte_H6.jpg/960px-Rote_Sternrenette_Freilichtmuseum_Roscheider_Hof_Bl%C3%BCte_H6.jpg","seite":"https://commons.wikimedia.org/wiki/File:Rote_Sternrenette_Freilichtmuseum_Roscheider_Hof_Bl%C3%BCte_H6.jpg","art":"bluete","urheber":"Helge Klaus Rieder","lizenz":"CC0 1.0","quelle":"commons-fotos","titel":"Rote Sternrenette Freilichtmuseum Roscheider Hof Blüte H6"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/17/Rote_Sternrenette_Freilichtmuseum_Roscheider_Hof_Bl%C3%BCte_und_Knospe_H7.jpg/960px-Rote_Sternrenette_Freilichtmuseum_Roscheider_Hof_Bl%C3%BCte_und_Knospe_H7.jpg","seite":"https://commons.wikimedia.org/wiki/File:Rote_Sternrenette_Freilichtmuseum_Roscheider_Hof_Bl%C3%BCte_und_Knospe_H7.jpg","art":"bluete","urheber":"Helge Klaus Rieder","lizenz":"CC0 1.0","quelle":"commons-fotos","titel":"Rote Sternrenette Freilichtmuseum Roscheider Hof Blüte und Knospe H7"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/0/05/Pomological_Watercolor_POM00000030.jpg/960px-Pomological_Watercolor_POM00000030.jpg","seite":"https://commons.wikimedia.org/wiki/File:Pomological_Watercolor_POM00000030.jpg","art":"tafel","urheber":"William Henry Prestele","lizenz":"gemeinfrei","quelle":"usda-pomological","titel":"Pomological Watercolor POM00000030"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/0/03/Pomological_Watercolor_POM00002356.jpg/960px-Pomological_Watercolor_POM00002356.jpg","seite":"https://commons.wikimedia.org/wiki/File:Pomological_Watercolor_POM00002356.jpg","art":"tafel","urheber":"Arnold, Mary Daisy, ca. 1873-1955","lizenz":"gemeinfrei","quelle":"usda-pomological","titel":"Pomological Watercolor POM00002356"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/0/07/Pomological_Watercolor_POM00003157.jpg/960px-Pomological_Watercolor_POM00003157.jpg","seite":"https://commons.wikimedia.org/wiki/File:Pomological_Watercolor_POM00003157.jpg","art":"tafel","urheber":"Amanda Newton","lizenz":"gemeinfrei","quelle":"usda-pomological","titel":"Pomological Watercolor POM00003157"},{"url":"https://upload.wikimedia.org/wikipedia/commons/0/02/Reinette_Rouge_Etoilee_on_tree%2C_National_Fruit_Collection_%28acc._2000-082%29.jpg","seite":"https://commons.wikimedia.org/wiki/File:Reinette_Rouge_Etoilee_on_tree,_National_Fruit_Collection_(acc._2000-082).jpg","art":"baum","urheber":"National Fruit Collection, Brogdale","lizenz":"OGL 2.0","quelle":"nfc-commons","titel":"Reinette Rouge Etoilee on tree, National Fruit Collection (acc. 2000-082)"}],"munq":46,"akzessionen":[{"sammlung":"UK National Fruit Collection (Brogdale)","nummer":"2000082","name":"Reinette Rouge Etoilee"}],"farbmessung":[{"bild":"https://thumb.wikimedia.org/wikipedia/commons/thumb/0/03/Pomological_Watercolor_POM00002356.jpg/960px-Pomological_Watercolor_POM00002356.jpg","methode":"Aquarell","verfahren":"Aquarell (USDA Pomological Watercolor, ca. 1886–1942); Papierton als Weißpunkt; Frucht vor Papier freigestellt; Schalenpixel einzeln klassifiziert (Deckfarbe = deutlich höheres a* als die Grundfarbe, Anteile über Pixel); Höhe/Breite aus dem gemalten Längsschnitt, sonst aus der Seitenansicht; gemessen an einer 480 px breiten Kopie; Farbwiedergabe des Malers, nicht fotometrisch","grundfarbe":"#bcb665","deckfarbe":"#984020","deckfarbeAnteil":0.19,"fleischfarbe":"#f6f3e7","hoeheZuBreite":0.772},{"bild":"https://thumb.wikimedia.org/wikipedia/commons/thumb/0/05/Pomological_Watercolor_POM00000030.jpg/960px-Pomological_Watercolor_POM00000030.jpg","methode":"Umrisszeichnung","verfahren":"Umrisszeichnung (USDA Pomological Watercolor, ungefärbter Längsschnitt in Bleistift/Tusche); nur Höhe/Breite aus der konvexen Hülle des gezeichneten Umrisses ohne Stiel; gemessen an einer 480 px breiten Kopie","hoeheZuBreite":0.808}]}