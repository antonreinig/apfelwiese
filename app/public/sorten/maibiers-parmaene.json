{"id":"maibiers-parmaene","name":"Maibiers Parmäne","synonyme":[{"name":"Maibier's Parmäne","beleg":{"quelle":"engelbrecht1889","seite":"518 (Nr. 466)"}}],"herkunft":{"text":"Zufallsfund aus einem Privatgarten in Moritzburg bei Dresden, vor 1860 entdeckt. Benannt nach dem Dresdner Handelsgärtner Maibier, einem Schwager des Gartenbesitzers, der die Sorte bekannt machte und verbreitete. Erstbeschreibung 1861 durch Gustav von Flotow.","belege":[{"quelle":"lauche_erg1883","seite":"135 (Nr. 757)"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Maibiers_Parmäne&oldid=257856602"},{"quelle":"engelbrecht1889","seite":"518 (Nr. 466)"}]},"merkmale":[{"merkmal":"frucht_breite","wert":89,"original":"Gestalt 89:77—79","quelle":"engelbrecht1889","seite":"518 (Nr. 466)"},{"merkmal":"frucht_hoehe","wert":78,"original":"Gestalt 89:77—79","quelle":"engelbrecht1889","seite":"518 (Nr. 466)"},{"merkmal":"frucht_hoehe_breite","wert":0.88,"original":"Gestalt 89:77—79","quelle":"engelbrecht1889","seite":"518 (Nr. 466)"},{"merkmal":"frucht_form","wert":"rundkonisch","original":"abgestumpft rundlich kegelf.","quelle":"engelbrecht1889","seite":"518 (Nr. 466)"},{"merkmal":"frucht_breiteste_stelle","wert":"stiel","original":"wenig stielbauch.","quelle":"engelbrecht1889","seite":"518 (Nr. 466)"},{"merkmal":"frucht_symmetrie","wert":"symmetrisch","original":"Hälften meistens wenig verschieden","quelle":"engelbrecht1889","seite":"518 (Nr. 466)"},{"merkmal":"kelch_offenheit","wert":"geschlossen","original":"Kelch geschlossen bis fast halb offen","quelle":"engelbrecht1889","seite":"518 (Nr. 466)"},{"merkmal":"kelch_offenheit","wert":"halboffen","original":"Kelch geschlossen bis fast halb offen","quelle":"engelbrecht1889","seite":"518 (Nr. 466)"},{"merkmal":"kelchgrube_tiefe","wert":"5","original":"Einsenk. mitteltief, mässig weit","quelle":"engelbrecht1889","seite":"518 (Nr. 466)"},{"merkmal":"kelchgrube_weite","wert":"5","original":"Einsenk. mitteltief, mässig weit","quel