mal":"pflueckreife","wert":"10","original":"Der Apfel ist ab Ende Oktober pflückreif","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Altländer_Pfannkuchenapfel&oldid=256410190"},{"merkmal":"genussreife_beginn","wert":"2","original":"ab Februar genussreif","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Altländer_Pfannkuchenapfel&oldid=256410190"},{"merkmal":"geschmack_saeure","wert":"5","original":"Der Geschmack ist süßsäuerlich","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Altländer_Pfannkuchenapfel&oldid=256410190"},{"merkmal":"geschmack_suesse","wert":"5","original":"Der Geschmack ist süßsäuerlich","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Altländer_Pfannkuchenapfel&oldid=256410190"},{"merkmal":"verwendung","wert":"kueche","original":"große Früchte wurden früher zur Verwendung als Küchenapfel bis Juni gelagert","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Altländer_Pfannkuchenapfel&oldid=256410190"},{"merkmal":"baum_wuchs","wert":"3","original":"Der Baum wächst nur schwach bis mittelstark","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Altländer_Pfannkuchenapfel&oldid=256410190"},{"merkmal":"baum_wuchs","wert":"5","original":"Der Baum wächst nur schwach bis mittelstark","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Altländer_Pfannkuchenapfel&oldid=256410190"},{"merkmal":"frucht_groesse","wert":"7","quelle":"nfc2025","seite":"Akzession 1951163 (NFC-Früchte)","original":"Large"},{"merkmal":"frucht_form","wert":"breitrundkonisch","quelle":"nfc2025","seite":"Akzession 1951163 (NFC-Früchte)","original":"Broad globose conical"},{"merkmal":"schale_grundfarbe","wert":"gelb","quelle":"nfc2025","seite":"Akzession 1951163 (NFC-Früchte)","original":"Yellow"},{"merkmal":"schale_deckfarbe_anteil","wert":"1","quelle":"nfc2025","seite":"Akzession 1951163 (NFC-Früchte)","original":"Very low"},{"merkmal":"schale_deckfarbe_farbton","wert":"rot","quelle":"nfc2025","seite":"Akzession 1951163 (NFC-Früchte)","original":"Red"},{"merkmal":"schale_deckfarbe_art","wert":"gestreift","quelle":"nfc2025","seite":"Akzession 1951163 (NFC-Früchte)","original":"Flush with stripes"},{"merkmal":"schale_deckfarbe_art","wert":"verwaschen","quelle":"nfc2025","seite":"Akzession 1951163 (NFC-Früchte)","original":"Flush with stripes"},{"merkmal":"fleisch_farbe","wert":"cremeweiss","quelle":"nfc2025","seite":"Akzession 1951163 (NFC-Früchte)","original":"Cream"},{"merkmal":"fleisch_festigkeit","wert":"5","quelle":"nfc2025","seite":"Akzession 1951163 (Verkostung P. Hale, 05/11/2020)","original":"Intermediate to firm"},{"merkmal":"fleisch_festigkeit","wert":"7","quelle":"nfc2025","seite":"Akzession 1951163 (Verkostung P. Hale, 05/11/2020)","original":"Intermediate to firm"},{"merkmal":"fleisch_saftigkeit","wert":"5","quelle":"nfc2025","seite":"Akzession 1951163 (Verkostung P. Hale, 05/11/2020)","original":"Intermediate to high"},{"merkmal":"fleisch_saftigkeit","wert":"7","quelle":"nfc2025","seite":"Akzession 1951163 (Verkostung P. Hale, 05/11/2020)","original":"Intermediate to high"},{"merkmal":"geschmack_suesse","wert":"5","quelle":"nfc2025","seite":"Akzession 1951163 (Verkostung P. Hale, 05/11/2020)","original":"Intermediate"},{"merkmal":"geschmack_saeure","wert":"5","quelle":"nfc2025","seite":"Akzession 1951163 (Verkostung P. Hale, 05/11/2020)","original":"Intermediate"},{"merkmal":"verwendung","wert":"kueche","quelle":"nfc2025","seite":"Akzession 1951163","original":"Culinary"},{"merkmal":"pflueckreife","wert":"10","quelle":"nfc2025","seite":"Akzession 1951163","original":"Mid October"},{"merkmal":"genussreife_ende","wert":"12","quelle":"nfc2025","seite":"Akzession 1951163","original":"December"},{"merkmal":"bluete_zeit","wert":"5","quelle":"nfc2025","seite":"Akzession 1951163","original":"Klasse 5 (10 % der Blüten offen, Tag 125)"},{"merkmal":"ertrag_beginn","wert":"spaet","original":"Er trägt spät","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Altländer_Pfannkuchenapfel&oldid=256410190"},{"merkmal":"ertrag_alternanz","wert":"alternierend","original":"dann reich, aber nicht regelmäßig","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Altländer_Pfannkuchenapfel&oldid=256410190"},{"merkmal":"standort_boden","wert":"7","original":"bevorzugt gut mit Wasser versorgte, nährstoffreiche Böden","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Altländer_Pfannkuchenapfel&oldid=256410190"},{"merkmal":"standort_feuchte","wert":"feucht","original":"bevorzugt gut mit Wasser versorgte, nährstoffreiche Böden","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Altländer_Pfannkuchenapfel&oldid=256410190"},{"merkmal":"gesundheit","wert":"7","original":"ist wenig anfällig für Krankheiten","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Altländer_Pfannkuchenapfel&oldid=256410190"},{"merkmal":"lagerfaehigkeit","wert":"7","original":"Große Früchte wurden früher bis in den Juni gelagert","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Altländer_Pfannkuchenapfel&oldid=256410190"}],"texte":[{"thema":"ueberblick","text":"Der Altländer Pfannkuchenapfel ist eine alte Lokalsorte aus dem Alten Land. Die mittelgroßen bis großen Früchte sind breit und flach, oft unregelmäßig, grüngelb mit roten Streifen. Er ist ein Winterapfel, der ab Februar genussreif wird; große Früchte dienten früher als lange gelagerter Küchenapfel.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Altländer_Pfannkuchenapfel&oldid=256410190"}]},{"thema":"herkunft","text":"Die Sorte ist vor 1840 als Zufallssämling im Alten Land entstanden; die Eltern sind unbekannt. Sie war früher eine gängige Marktsorte im Erwerbsanbau und wird heute nur noch von Liebhabern gepflanzt. Sie steht auf der Roten Liste der gefährdeten einheimischen Nutzpflanzen in Deutschland und wurde 2006 zur Streuobstsorte des Jahres in Norddeutschland gewählt.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Altländer_Pfannkuchenapfel&oldid=256410190"}]},{"thema":"frucht","text":"Die Früchte werden mittelgroß bis groß. Sie sind breitkugelig bis flach und häufig unregelmäßig geformt.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Altländer_Pfannkuchenapfel&oldid=256410190"}]},{"thema":"schale","text":"Die Grundfarbe ist grüngelb, darauf liegt eine rote, streifige Deckfarbe.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Altländer_Pfannkuchenapfel&oldid=256410190"}]},{"thema":"fleisch_geschmack","text":"Der Geschmack ist süßsäuerlich mit nur leichtem Aroma.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Altländer_Pfannkuchenapfel&oldid=256410190"}]},{"thema":"reife_lagerung","text":"Pflückreif ist der Apfel ab Ende Oktober, genussreif ab Februar; er zählt zu den Winteräpfeln. Große Früchte wurden früher bis in den Juni gelagert.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Altländer_Pfannkuchenapfel&oldid=256410190"}]},{"thema":"baum","text":"Der Baum wächst schwach bis mittelstark und bildet eine breite Krone. Er trägt spät, dann reich, aber nicht regelmäßig. Die Sorte bevorzugt gut mit Wasser versorgte, nährstoffreiche Böden und ist wenig anfällig für Krankheiten.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Altländer_Pfannkuchenapfel&oldid=256410190"}]},{"thema":"verwendung","text":"Große Früchte wurden früher als Küchenapfel genutzt und dafür bis Juni aufbewahrt.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Altländer_Pfannkuchenapfel&oldid=256410190"}]},{"thema":"frucht","text":"Nach den Erhebungen der National Fruit Collection: große, breit rundlich-kegelförmige Frucht mit gelber Grundfarbe und flächiger und gestreifter roter Deckfarbe auf einem sehr kleinen Teil der Schale. Das Fruchtfleisch ist cremefarben. Bei der Verkostung war das Fleisch mittelfest bis fest und mäßig saftig bis saftig, der Geschmack mäßig süß und mäßig sauer, mit schwachem bis mittlerem Aroma. In der Sammlung als Küchenapfel geführt; pflückreif Mitte Oktober, lagerfähig bis Dezember.","belege":[{"quelle":"nfc2025","seite":"Akzession 1951163"}]}],"bilder":[{"url":"https://upload.wikimedia.org/wikipedia/commons/4/43/Malus_-_Altl%C3%A4nder_Pfannkuchenapfel.JPG","seite":"https://commons.wikimedia.org/wiki/File:Malus_-_Altl%C3%A4nder_Pfannkuchenapfel.JPG","art":"frucht","urheber":"Genet","lizenz":"CC BY-SA 3.0","quelle":"commons","titel":"Malus - Altländer Pfannkuchenapfel.JPG"},{"url":"https://upload.wikimedia.org/wikipedia/commons/5/53/Cross_section_of_Altlander_Pfannkuchenapfel%2C_National_Fruit_Collection_%28acc._1951-163%29.jpg","seite":"https://commons.wikimedia.org/wiki/File:Cross_section_of_Altlander_Pfannkuchenapfel,_National_Fruit_Collection_(acc._1951-163).jpg","art":"schnitt","urheber":"National Fruit Collection, Brogdale","lizenz":"OGL 2.0","quelle":"nfc-commons","titel":"Cross section of Altlander Pfannkuchenapfel, National Fruit Collection (acc. 1951-163)"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/d/de/Malus_Altl%C3%A4nder_Pfannkuchen_4611.jpg/960px-Malus_Altl%C3%A4nder_Pfannkuchen_4611.jpg","seite":"https://commons.wikimedia.org/wiki/File:Malus_Altl%C3%A4nder_Pfannkuchen_4611.jpg","art":"frucht","urheber":"Sven Teschke","lizenz":"CC BY-SA 3.0 DE","quelle":"commons-fotos","titel":"Malus Altländer Pfannkuchen 4611"},{"url":"https://upload.wikimedia.org/wikipedia/commons/b/b1/Malus_-_Altlaender_Pfannkuchenapfel.JPG","seite":"https://commons.wikimedia.org/wiki/File:Malus_-_Altlaender_Pfannkuchenapfel.JPG","art":"baum","urheber":"Genet","lizenz":"CC BY-SA 3.0","quelle":"commons-fotos","titel"