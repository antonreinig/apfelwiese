otos","titel":"Ingrid Marie (AW) (apple) jm179443"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/93/Ingrid_Marie_%28apple%29_jm179449.jpg/960px-Ingrid_Marie_%28apple%29_jm179449.jpg","seite":"https://commons.wikimedia.org/wiki/File:Ingrid_Marie_(apple)_jm179449.jpg","art":"baum","urheber":"joergens.mi","lizenz":"CC BY-SA 3.0","quelle":"commons-fotos","titel":"Ingrid Marie (apple) jm179449"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/6/67/Apfelbl%C3%BCte_Ingrid_Marie.jpg/960px-Apfelbl%C3%BCte_Ingrid_Marie.jpg","seite":"https://commons.wikimedia.org/wiki/File:Apfelbl%C3%BCte_Ingrid_Marie.jpg","art":"bluete","urheber":"Hinnerk11","lizenz":"CC BY-SA 4.0","quelle":"commons-fotos","titel":"Apfelblüte Ingrid Marie"}],"munq":32,"akzessionen":[{"sammlung":"UK National Fruit Collection (Brogdale)","nummer":"1965025","name":"Karin Schneider (Red Ingrid Marie)"},{"sammlung":"UK National Fruit Collection (Brogdale)","nummer":"1968017","name":"Ingrid Marie"}],"farbmessung":[{"bild":"https://upload.wikimedia.org/wikipedia/commons/a/a1/Cross_section_of_Ingrid_Marie_%28LA%29%2C_National_Fruit_Collection_%28acc._1968-017%29.jpg","methode":"NFC-Foto","verfahren":"Foto (NFC-Fototafel: 4 ganze Früchte, 2 Schnitte, Fototisch); Weißabgleich über den Hintergrund; Frucht per Hintergrundmodell freigestellt; Schalenpixel ohne Glanzlichter einzeln klassifiziert: Grundfarbe aus gelbgrünen Pixeln, Deckfarbe = Pixel mit deutlich höherem a* als die Grundfarbe (auch dunkle Rot- und Braunrottöne), Anteile über Pixel; Höhe/Breite aus dem Längsschnitt","grundfarbe":"#b3ab58","deckfarbe":"#833947","deckfarbeAnteil":0.75,"rostfarbe":"#8b7048","fleischfarbe":"#d2d2c6","hoeheZuBreite":0.795}],"regionen":[{"region":"DE-BY","art":"empfehlung","belege":[{"quelle":"rg_by-lwg-3151"}],"original":"Ingrid Marie"}],"gefaehrdung":[{"stufe":"Rote Liste der gefährdeten einheimischen Nutzpflanzen in Deutschland","belege":[{"quelle":"rg_ble-rote-liste"}],"original":"Ingrid Marie"}]}