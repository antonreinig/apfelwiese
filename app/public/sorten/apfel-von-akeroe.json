{"id":"apfel-von-akeroe","name":"Apfel von Åkerö","synonyme":[{"name":"Åkerö","beleg":{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Apfel_von_Åkerö&oldid=246648563"}},{"name":"Apfel von Akerö","beleg":{"quelle":"engelbrecht1889","seite":"99 (Nr. 89)"}},{"name":"Herbstapfel","beleg":{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Apfel_von_Åkerö&oldid=246648563"}}],"herkunft":{"text":"Vermutlich im 15. Jahrhundert als Zufallssämling in den Niederlanden entstanden, 1759 nach Schweden eingeführt und 1858 nach Schloss Åkerö (Gemeinde Flen, Södermanland) benannt.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Apfel_von_Åkerö&oldid=246648563"}],"land":"NL","landSicher":false,"jahr":1450},"merkmale":[{"merkmal":"frucht_breite","wert":67,"original":"Gestalt 67:65—69","quelle":"engelbrecht1889","seite":"99 (Nr. 89)"},{"merkmal":"frucht_hoehe","wert":67,"original":"Gestalt 67:65—69","quelle":"engelbrecht1889","seite":"99 (Nr. 89)"},{"merkmal":"frucht_hoehe_breite","wert":1,"original":"Gestalt 67:65—69","quelle":"engelbrecht1889","seite":"99 (Nr. 89)"},{"merkmal":"frucht_form","wert":"eifoermig","original":"etwas abgestumpft länglichei- bis eiwalzenförm.","quelle":"engelbrecht1889","seite":"99 (Nr. 89)"},{"merkmal":"frucht_form","wert":"walzenfoermig","original":"etwas abgestumpft länglichei- bis eiwalzenförm.","quelle":"engelbrecht1889","seite":"99 (Nr. 89)"},{"merkmal":"frucht_form","wert":"eifoermig","original":"leicht abgeflacht und ei- beziehungsweise walzenförmig","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Apfel_von_Åkerö&oldid=246648563"},{"merkmal":"frucht_form","wert":"walzenfoermig","original":"leicht abgeflacht und ei- beziehungsweise walzenförmig","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Apfel_von_Åkerö&oldid=246648563"},{"merkmal":"frucht_breiteste_stelle","wert":"stiel","original":"wenig stielbauch.","quell