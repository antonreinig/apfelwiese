a.pdf"},{"merkmal":"frucht_hoehe","wert":65,"original":"rund 65 mm hoch und 82 mm breit","quelle":"web_bund_lemgo","url":"https://www.obstsortendatenbank.de/osdb/nda/prinz_albrecht_von_preussen_nda.pdf"},{"merkmal":"frucht_hoehe_breite","wert":0.79,"original":"rund 65 mm hoch und 82 mm breit","quelle":"web_bund_lemgo","url":"https://www.obstsortendatenbank.de/osdb/nda/prinz_albrecht_von_preussen_nda.pdf"},{"merkmal":"frucht_form","wert":"flachrund","original":"Die großen, flachrunden Früchte","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Prinz_Albrecht_von_Preußen&oldid=271471644"},{"merkmal":"frucht_form","wert":"flachrund","original":"Die Frucht ist flachrund, Formfaktor 78 – 80","quelle":"web_bund_lemgo","url":"https://www.obstsortendatenbank.de/osdb/nda/prinz_albrecht_von_preussen_nda.pdf"},{"merkmal":"frucht_breiteste_stelle","wert":"mitte","original":"mittelbauchig, größte Breite bei 24 mm Höhe","quelle":"web_bund_lemgo","url":"https://www.obstsortendatenbank.de/osdb/nda/prinz_albrecht_von_preussen_nda.pdf"},{"merkmal":"schale_grundfarbe","wert":"gelb","original":"hellgelbe bis grüngelbe Grundfarbe","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Prinz_Albrecht_von_Preußen&oldid=271471644"},{"merkmal":"schale_grundfarbe","wert":"gruengelb","original":"hellgelbe bis grüngelbe Grundfarbe","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Prinz_Albrecht_von_Preußen&oldid=271471644"},{"merkmal":"schale_grundfarbe","wert":"gelb","original":"Die Fruchtschale ist fein, glänzend, blassgelb","quelle":"web_bund_lemgo","url":"https://www.obstsortendatenbank.de/osdb/nda/prinz_albrecht_von_preussen_nda.pdf"},{"merkmal":"schale_deckfarbe_farbton","wert":"rot","original":"Deckfarbe von karminrot bis trübrot","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Prinz_Albrecht_von_Preußen&oldid=271471644"},{"merkmal":"schale_deckfarbe_farbton","wert":"braunrot","original":"Deckfa