von_preussen_nda.pdf"},{"merkmal":"kernhaus_achse","wert":"offen","original":"Das Kernhaus ist hohlachsig","quelle":"web_bund_lemgo","url":"https://www.obstsortendatenbank.de/osdb/nda/prinz_albrecht_von_preussen_nda.pdf"},{"merkmal":"kernfaecher_oeffnung","wert":"teilweise","original":"mit schwach geöffneten Kammern","quelle":"web_bund_lemgo","url":"https://www.obstsortendatenbank.de/osdb/nda/prinz_albrecht_von_preussen_nda.pdf"},{"merkmal":"genussreife_ende","wert":"12","original":"nur bis Dezember lagerfähig","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Prinz_Albrecht_von_Preußen&oldid=271471644"},{"merkmal":"genussreife_beginn","wert":"10","original":"Reifezeit: Ende Oktober, hält bis Dezember","quelle":"web_bund_lemgo","url":"https://www.obstsortendatenbank.de/osdb/nda/prinz_albrecht_von_preussen_nda.pdf"},{"merkmal":"genussreife_ende","wert":"12","original":"Reifezeit: Ende Oktober, hält bis Dezember","quelle":"web_bund_lemgo","url":"https://www.obstsortendatenbank.de/osdb/nda/prinz_albrecht_von_preussen_nda.pdf"},{"merkmal":"verwendung","wert":"tafel","original":"gilt daher vorrangig als Tafelobst","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Prinz_Albrecht_von_Preußen&oldid=271471644"},{"merkmal":"verwendung","wert":"tafel","original":"eine große, schöne Tafel- und Wirtschaftsfrucht","quelle":"web_bund_lemgo","url":"https://www.obstsortendatenbank.de/osdb/nda/prinz_albrecht_von_preussen_nda.pdf"},{"merkmal":"verwendung","wert":"kueche","original":"eine große, schöne Tafel- und Wirtschaftsfrucht","quelle":"web_bund_lemgo","url":"https://www.obstsortendatenbank.de/osdb/nda/prinz_albrecht_von_preussen_nda.pdf"},{"merkmal":"baum_wuchs","wert":"5","original":"mittelstarkes, gedrungenes Wachstum","quelle":"web_bund_lemgo","url":"https://www.obstsortendatenbank.de/osdb/nda/prinz_albrecht_von_preussen_nda.pdf"},{"merkmal":"ploidie","wert":"diploid","original":"Die mittelspäte Blüte dieser diploiden Sorte","que