riginal":"Kernhaus 46:47, eizwiebelf. bis zwiebelf.","quelle":"engelbrecht1889","seite":"64 (Nr. 56)"},{"merkmal":"kernfaecher_oeffnung","wert":"offen","original":"Kammern … zerrissen, geräumig, weit offen","quelle":"engelbrecht1889","seite":"64 (Nr. 56)"},{"merkmal":"kernhaus_achse","wert":"offen","original":"Achsenh. breit","quelle":"engelbrecht1889","seite":"64 (Nr. 56)"},{"merkmal":"kernhaus_achse","wert":"offen","original":"Kernhaus: hohlachsig","quelle":"lauche_erg1883","seite":"121 (Nr. 750)"},{"merkmal":"kerne_form","wert":"eifoermig","original":"Kerne … länglich, seltener rundlich eiförmig, gespitzt, hellbraun","quelle":"engelbrecht1889","seite":"64 (Nr. 56)"},{"merkmal":"kerne_form","wert":"lang","original":"große, lang-zugespitzte, hellbraune Samen","quelle":"lauche_erg1883","seite":"121 (Nr. 750)"},{"merkmal":"kelchhoehle_form","wert":"dreieck_breit","original":"Kelchhöhle kegelf., kaum 1/2 zur Achsenh.","quelle":"engelbrecht1889","seite":"64 (Nr. 56)"},{"merkmal":"kelchhoehle_form","wert":"dreieck_lang","original":"Kelchröhre lang-kegelförmig","quelle":"lauche_erg1883","seite":"121 (Nr. 750)"},{"merkmal":"fleisch_farbe","wert":"weiss","original":"Fleisch weisslich, kaum halbfein oder etwas grob, locker, mürbe","quelle":"engelbrecht1889","seite":"64 (Nr. 56)"},{"merkmal":"fleisch_farbe","wert":"weiss","original":"Fleisch: weiß, zart, locker","quelle":"lauche_erg1883","seite":"121 (Nr. 750)"},{"merkmal":"fleisch_festigkeit","wert":"3","original":"locker, mürbe","quelle":"engelbrecht1889","seite":"64 (Nr. 56)"},{"merkmal":"fleisch_saftigkeit","wert":"7","original":"locker, mürbe, saftig, ohne Gewürz","quelle":"engelbrecht1889","seite":"64 (Nr. 56)"},{"merkmal":"geschmack_saeure","wert":"7","original":"vorherrschend, ziemlich kräftig weinsäuerlich, kaum merklich süss","quelle":"engelbrecht1889","seite":"64 (Nr. 56)"},{"merkmal":"geschmack_suesse","wert":"3","original":"vorherrschend, ziemlich kräftig weinsäuerlich, kaum merklich süss","quelle":"engelbrecht1