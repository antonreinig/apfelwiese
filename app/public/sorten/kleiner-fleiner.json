{"id":"kleiner-fleiner","name":"Kleiner Fleiner","synonyme":[{"name":"Petit Fleiner","beleg":{"quelle":"engelbrecht1889","seite":"720 (Nr. 648)"}},{"name":"Fleiner Petit","beleg":{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Kleiner_Fleiner&oldid=192398681"}},{"name":"Glasfleiner","beleg":{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Kleiner_Fleiner&oldid=192398681"}},{"name":"Fleiner","beleg":{"quelle":"illustr_hb_1","band":"I","seite":"179"}}],"herkunft":{"text":"Alte württembergische Sorte, benannt nach dem Ort Flein bei Heilbronn, von dem sie nach dem Illustrirten Handbuch (1859) stammen soll. Die ersten eindeutigen Beschreibungen stammen von Christ (1794) und Schiller (1795).","belege":[{"quelle":"illustr_hb_1","band":"I","seite":"179"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Kleiner_Fleiner&oldid=192398681"}]},"merkmale":[{"merkmal":"frucht_breite","wert":56,"original":"Gestalt 56:50—53, oft grösser","quelle":"engelbrecht1889","seite":"720 (Nr. 648)"},{"merkmal":"frucht_hoehe","wert":51.5,"original":"Gestalt 56:50—53, oft grösser","quelle":"engelbrecht1889","seite":"720 (Nr. 648)"},{"merkmal":"frucht_hoehe_breite","wert":0.92,"original":"Gestalt 56:50—53, oft grösser","quelle":"engelbrecht1889","seite":"720 (Nr. 648)"},{"merkmal":"frucht_form","wert":"stumpfkonisch","original":"abgestumpft, kegelf., sehr stielbauch.","quelle":"engelbrecht1889","seite":"720 (Nr. 648)"},{"merkmal":"frucht_breiteste_stelle","wert":"stiel","original":"abgestumpft, kegelf., sehr stielbauch.","quelle":"engelbrecht1889","seite":"720 (Nr. 648)"},{"merkmal":"frucht_symmetrie","wert":"schief","original":"Hälften meistens ungleich","quelle":"engelbrecht1889","seite":"720 (Nr. 648)"},{"merkmal":"frucht_rippung","wert":"1","original":"Querschn. rund","quelle":"engelbrecht1889","seite":"720 (Nr. 648)"},{"merkmal":"frucht_kronung","wert":"1","original":"Einsenk. tief, etwas enge, zwischen kleinen, kurzen Falten","quelle":"engelbrecht1889","seite":"720 (Nr. 648)"},{"merkmal":"frucht_groesse","wert":"5","original":"abgestumpft kegelförmiger Apfel, von mittlerer Größe","quelle":"illustr_hb_1","band":"I","seite":"179"},{"merkmal":"frucht_form","wert":"stumpfkonisch","original":"sehr wohlgebildeter, abgestumpft kegelförmiger Apfel","quelle":"illustr_hb_1","band":"I","seite":"179"},{"merkmal":"frucht_breiteste_stelle","wert":"stiel","original":"Der Bauch den untern Theil der Frucht einnehmend","quelle":"illustr_hb_1","band":"I","seite":"179"},{"merkmal":"frucht_rippung","wert":"3","original":"die Rundung ist fast eben und nur durch sanfte Erhabenheiten unterbrochen","quelle":"illustr_hb_1","band":"I","seite":"179"},{"merkmal":"frucht_kronung","wert":"1","original":"von feinen Falten umgeben, die auf dem Rand der Kelchwölbung verschwinden","quelle":"illustr_hb_1","band":"I","seite":"179"},{"merkmal":"frucht_groesse","wert":"3","original":"Der kleine bis mittelgroße, kegelförmige Apfel","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Kleiner_Fleiner&oldid=192398681"},{"merkmal":"frucht_groesse","wert":"5","original":"Der kleine bis mittelgroße, kegelförmige Apfel","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Kleiner_Fleiner&oldid=192398681"},{"merkmal":"frucht_form","wert":"konisch","original":"Der kleine bis mittelgroße, kegelförmige Apfel","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Kleiner_Fleiner&oldid=192398681"},{"merkmal":"kelch_offenheit","wert":"halboffen","original":"Kelch halb offen, grün und braun, locker bewollt","quelle":"engelbrecht1889","seite":"720 (Nr. 648)"},{"merkmal":"kelchgrube_tiefe","wert":"7","original":"Einsenk. tief, etwas enge","quelle":"engelbrecht1889","seite":"720 (Nr. 648)"},{"merkmal":"kelchgrube_weite","wert":"3","original":"Einsenk. tief, etwas enge","quelle":"engelbrecht1889","seite":"720 (Nr. 648)"},{"merkmal":"kelch_offenheit","wert":"offen","origi