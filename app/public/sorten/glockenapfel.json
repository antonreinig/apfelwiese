{"id":"glockenapfel","name":"Glockenapfel","synonyme":[{"name":"Weißer Winterglockenapfel","beleg":{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Glockenapfel&oldid=264475840"}},{"name":"Altländer Glockenapfel","beleg":{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Glockenapfel&oldid=264475840"}},{"name":"Schweizer Glockenapfel","beleg":{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Glockenapfel&oldid=264475840"}},{"name":"Echter Glocken","beleg":{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Glockenapfel&oldid=264475840"}},{"name":"Cloche","beleg":{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Glockenapfel&oldid=264475840"}},{"name":"Zvonkové","beleg":{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Glockenapfel&oldid=264475840"}}],"herkunft":{"text":"Zufallssämling unbekannter Herkunft, vermutlich Mitte des 19. Jahrhunderts entstanden; genannt werden die Schweiz bzw. Süddeutschland, das Alte Land an der Niederelbe, Holstein und Tschechien.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Glockenapfel&oldid=264475840"},{"quelle":"web_bogl_bw","url":"https://www.bogl-bw.de/glockenapfel/"},{"quelle":"web_streuobst_bayern","url":"https://www.streuobst-in-bayern.de/detail/id=629ef5bd318c8c7de04d403b"}]},"merkmale":[{"merkmal":"frucht_groesse","wert":"7","original":"Die kurz gestielten, (behangabhängig) großen Früchte","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Glockenapfel&oldid=264475840"},{"merkmal":"frucht_form","wert":"glockenfoermig","original":"namensgebende hochgebaute Glockenform","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Glockenapfel&oldid=264475840"},{"merkmal":"stiel_laenge","wert":"3","original":"Die kurz gestielten … Früchte","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Glockenapfel&oldid=264475840"},{"merkmal":"kelchgrube_weite","wert":"7","original":"mit einer weiten, höckerig begrenzten Kelchgrube","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Glockenapfel&oldid=264475840"},{"merkmal":"frucht_kronung","wert":"9","original":"mit einer weiten, höckerig begrenzten Kelchgrube","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Glockenapfel&oldid=264475840"},{"merkmal":"schale_beschaffenheit","wert":"rau","original":"Die etwas raue Schale hat eine grün-gelbe Grundfarbe","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Glockenapfel&oldid=264475840"},{"merkmal":"schale_grundfarbe","wert":"gruengelb","original":"Die etwas raue Schale hat eine grün-gelbe Grundfarbe","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Glockenapfel&oldid=264475840"},{"merkmal":"schale_deckfarbe_anteil","wert":"1","original":"gelegentlich (ein Anflug) rötliche Deckfarbe","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Glockenapfel&oldid=264475840"},{"merkmal":"fleisch_farbe","wert":"weiss","original":"Das fast weiße Fruchtfleisch ist wenig saftig, sehr fest","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Glockenapfel&oldid=264475840"},{"merkmal":"fleisch_festigkeit","wert":"7","original":"Das fast weiße Fruchtfleisch ist wenig saftig, sehr fest","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Glockenapfel&oldid=264475840"},{"merkmal":"fleisch_saftigkeit","wert":"3","original":"Das fast weiße Fruchtfleisch ist wenig saftig, sehr fest","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Glockenapfel&oldid=264475840"},{"merkmal":"geschmack_saeure","wert":"9","original":"etwas herb mit ausgeprägter, etwas scharfer Säure","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Glockenapfel&oldid=264475840"},{"merkmal":"geschmack_aroma","wert":"aromatisch, etwas herb","original":"Der Geschmack ist besonders aromatisch, etwas herb","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Glockenapfel&oldid=264475840"},{"merkmal":"pflueckreife","wert":"10","original":"im Oktober pflückreif und ab Dezember genussreif","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Glockenapfel&oldid=264475840"},{"merkmal":"genussreife_beginn","wert":"12","original":"im Oktober pflückreif und ab Dezember genussreif","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Glockenapfel&oldid=264475840"},{"merkmal":"verwendung","wert":"tafel","original":"zum Frischverzehr wie auch zur Verarbeitung","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Glockenapfel&oldid=264475840"},{"merkmal":"ploidie","wert":"diploid","original":"Die diploide Sorte ist teilweise selbstfruchtbar","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Glockenapfel&oldid=264475840"},{"merkmal":"baum_wuchs","wert":"7","original":"Die anfangs stark-, später mittelstarkwüchsigen Bäume","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Glockenapfel&oldid=264475840"},{"merkmal":"baum_wuchs","wert":"5","original":"Die anfangs stark-, später mittelstarkwüchsigen Bäume","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Glockenapfel&oldid=264475840"},{"merkmal":"frucht_groesse","wert":"7","original":"Frucht groß, hochgebaut, glockenförmig","quelle":"web_bogl_bw","url":"https://www.bogl-bw.de/glockenapfel/"},{"merkmal":"frucht_form","wert":"glockenfoermig","original":"Frucht groß, hochgebaut, glockenförmig","quelle":"web_bogl_bw","url":"https://www.bogl-bw.de/glockenapfel/"},{"merkmal":"schale_grundfarbe","wert":"gelb","original":"Grundfarbe gelb, sonnenseits verwaschen gerötet","quelle":"web_bogl_bw","url":"https://www.bogl-bw.de/glockenapfel/"},{"merkmal":"schale_deckfarbe_anteil","wert":"5","original":"sonnenseits verwaschen gerötet","quelle":"web_bogl_bw","url":"https://www.bogl-bw.de/glockenapfel/"},{"merkmal":"schale_deckfarbe_art","wert":"verwaschen","original":"sonnenseits verwaschen gerötet","quelle":"web_bogl_bw","url":"https://www.bogl-bw.de/glockenapfel/"},{"merkmal":"fleisch_festigkeit","wert":"7","original":"festfleischig, nur mäßig saftig","quelle":"web_bogl_bw","url":"https://www.bogl-bw.de/glockenapfel/"},{"merkmal":"fleisch_saftigkeit","wert":"5","original":"festfleischig, nur mäßig saftig","quelle":"web_bogl_bw","url":"https://www.bogl-bw.de/glockenapfel/"},{"merkmal":"geschmack_saeure","wert":"7","original":"säurebetont","quelle":"web_bogl_bw","url":"https://www.bogl-bw.de/glockenapfel/"},{"merkmal":"genussreife_ende","wert":"3","original":"Lagerfähigkeit sehr gut, bis März haltbar","quelle":"web_bogl_bw","url":"https://www.bogl-bw.de/glockenapfel/"},{"merkmal":"verwendung","wert":"tafel","original":"Tafel- und Küchenapfel","quelle":"web_bogl_bw","url":"https://www.bogl-bw.de/glockenapfel/"},{"merkmal":"verwendung","wert":"kueche","original":"Tafel- und Küchenapfel","quelle":"web_bogl_bw","url":"https://www.bogl-bw.de/glockenapfel/"},{"merkmal":"ploidie","wert":"diploid","original":"Diploide Sorte und guter Befruchter","quelle":"web_bogl_bw","url":"https://www.bogl-bw.de/glockenapfel/"},{"merkmal":"baum_wuchs","wert":"5","original":"Wuchs mittelstark bis stark, später nachlassend","quelle":"web_bogl_bw","url":"https://www.bogl-bw.de/glockenapfel/"},{"merkmal":"baum_wuchs","wert":"7","original":"Wuchs mittelstark bis stark, später nachlassend","quelle":"web_bogl_bw","url":"https://www.bogl-bw.de/glockenapfel/"},{"merkmal":"frucht_groesse","wert":"5","original":"mittelgroß bis groß","quelle":"web_streuobst_bayern","url":"https://www.streuobst-in-bayern.de/detail/id=629ef5bd318c8c7de04d403b"},{"merkmal":"frucht_groesse","wert":"7","original":"mittelgroß bis groß","quelle":"web_streuobst_bayern","url":"https://www.streuobst-in-bayern.de/detail/id=629ef5bd318