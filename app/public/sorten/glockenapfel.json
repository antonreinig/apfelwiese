ayern","url":"https://www.streuobst-in-bayern.de/detail/id=629ef5bd318c8c7de04d403b"},{"merkmal":"geschmack_saeure","wert":"7","original":"angenehm zitronensäuerlich","quelle":"web_streuobst_bayern","url":"https://www.streuobst-in-bayern.de/detail/id=629ef5bd318c8c7de04d403b"},{"merkmal":"geschmack_aroma","wert":"zitronensäuerlich","original":"angenehm zitronensäuerlich","quelle":"web_streuobst_bayern","url":"https://www.streuobst-in-bayern.de/detail/id=629ef5bd318c8c7de04d403b"},{"merkmal":"genussreife_ende","wert":"5","original":"im Kühllager bis Mai, ohne zu welken","quelle":"web_streuobst_bayern","url":"https://www.streuobst-in-bayern.de/detail/id=629ef5bd318c8c7de04d403b"},{"merkmal":"verwendung","wert":"tafel","original":"überwiegend Frischverzehr, außerdem zum Backen, für Saft und als Edelbrand","quelle":"web_streuobst_bayern","url":"https://www.streuobst-in-bayern.de/detail/id=629ef5bd318c8c7de04d403b"},{"merkmal":"verwendung","wert":"kueche","original":"überwiegend Frischverzehr, außerdem zum Backen, für Saft und als Edelbrand","quelle":"web_streuobst_bayern","url":"https://www.streuobst-in-bayern.de/detail/id=629ef5bd318c8c7de04d403b"},{"merkmal":"verwendung","wert":"most","original":"überwiegend Frischverzehr, außerdem zum Backen, für Saft und als Edelbrand","quelle":"web_streuobst_bayern","url":"https://www.streuobst-in-bayern.de/detail/id=629ef5bd318c8c7de04d403b"},{"merkmal":"verwendung","wert":"brennen","original":"überwiegend Frischverzehr, außerdem zum Backen, für Saft und als Edelbrand","quelle":"web_streuobst_bayern","url":"https://www.streuobst-in-bayern.de/detail/id=629ef5bd318c8c7de04d403b"},{"merkmal":"baum_wuchs","wert":"7","original":"anfangs starker, im Vollertragsalter mittelstarker Wuchs","quelle":"web_streuobst_bayern","url":"https://www.streuobst-in-bayern.de/detail/id=629ef5bd318c8c7de04d403b"},{"merkmal":"baum_wuchs","wert":"5","original":"anfangs starker, im Vollertragsalter mittelstarker Wuchs","quelle":"web_streuobst_bayern","url":"https://www.streuobst-in-bayern.de/detail/id=629ef5bd318c8c7de04d403b"},{"merkmal":"bluete_zeit","wert":"4","original":"Die Blüten erscheinen mittelfrüh","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Glockenapfel&oldid=264475840"},{"merkmal":"genussreife_ende","wert":"6","original":"ber genussreif – womit sie zu den Winteräpfeln gehören –, und können im Kühllager sechs Monate (bis Juni) gelagert","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Glockenapfel&oldid=264475840"},{"merkmal":"frucht_groesse","wert":"5","quelle":"nfc2025","seite":"Akzession 1948613 (NFC-Früchte)","original":"Medium"},{"merkmal":"frucht_form","wert":"stumpfkonisch","quelle":"nfc2025","seite":"Akzession 1948613 (NFC-Früchte)","original":"Truncate conical"},{"merkmal":"frucht_rippung","wert":"7","quelle":"nfc2025","seite":"Akzession 1948613 (NFC-Früchte)","original":"Strong"},{"merkmal":"frucht_kronung","wert":"5","quelle":"nfc2025","seite":"Akzession 1948613 (NFC-Früchte)","original":"Medium"},{"merkmal":"schale_grundfarbe","wert":"gruengelb","quelle":"nfc2025","seite":"Akzession 1948613 (NFC-Früchte)","original":"Green yellow"},{"merkmal":"schale_deckfarbe_anteil","wert":"3","quelle":"nfc2025","seite":"Akzession 1948613 (NFC-Früchte)","original":"Low to medium"},{"merkmal":"schale_deckfarbe_anteil","wert":"5","quelle":"nfc2025","seite":"Akzession 1948613 (NFC-Früchte)","original":"Low to medium"},{"merkmal":"schale_deckfarbe_farbton","wert":"orange","quelle":"nfc2025","seite":"Akzession 1948613 (NFC-Früchte)","original":"Orange"},{"merkmal":"schale_deckfarbe_art","wert":"verwaschen","quelle":"nfc2025","seite":"Akzession 1948613 (NFC-Früchte)","original":"Washed out"},{"merkmal":"schale_berostung_gesamt","wert":"1","quelle":"nfc2025","seite":"Akzession 1948613 (NFC-Früchte)","original":"Very low"},{"merkmal":"fleisch_farbe","wert":"weiss","quelle":"nfc2025","seite":"Akzession 1948613 (NFC-Früchte)","original":"White"},{"merkmal":"verwendung","wert":"kueche","quelle":"nfc2025","seite":"Akzession 1948613","original":"Culinary"},{"merkmal":"pflueckreife","wert":"10","quelle":"nfc2025","seite":"Akzession 1948613","original":"Mid October"},{"merkmal":"genussreife_ende","wert":"4","quelle":"nfc2025","seite":"Akzession 1948613","original":"April"},{"merkmal":"bluete_zeit","wert":"3","quelle":"nfc2025","seite":"Akzession 1948613","original":"Klasse 4 (10 % der Blüten offen, Tag 122)"},{"merkmal":"bluete_zeit","wert":"5","quelle":"nfc2025","seite":"Akzession 1948613","original":"Klasse 4 (10 % der Blüten offen, Tag 122)"}],"texte":[{"thema":"ueberblick","text":"Der Glockenapfel ist ein großer, hochgebauter, glockenförmiger Winterapfel mit grüngelber bis gelber, kaum geröteter Schale. Das fast weiße, sehr feste Fleisch ist wenig saftig und deutlich säuerlich. Die Sorte lässt sich sehr gut lagern und dient als Tafel- und Verarbeitungsapfel. Sie war früher weit verbreitet und wird noch gelegentlich im Erwerbsanbau genutzt; 2024 war sie Streuobstsorte des Jahres in Norddeutschland.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Glockenapfel&oldid=264475840"},{"quelle":"web_bogl_bw","url":"https://www.bogl-bw.de/glockenapfel/"},{"quelle":"web_streuobst_bayern","url":"https://www.streuobst-in-bayern.de/detail/id=629ef5bd318c8c7de04d403b"}]},{"thema":"herkunft","text":"Die Herkunft ist unbekannt. Die Sorte ist vermutlich Mitte des 19. Jahrhunderts als Zufallssämling entstanden; genannt werden die Schweiz bzw. Süddeutschland, das Alte Land an der Niederelbe, Holstein und Tschechien. In den Werken von Lucas, Oberdieck und Engelbrecht (1859–1889) ist sie nicht beschrieben. Aus einer Kreuzung mit Red Delicious ging die 1969 eingeführte Sorte Gloster hervor.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Glockenapfel&oldid=264475840"},{"quelle":"web_bogl_bw","url":"https://www.bogl-bw.de/glockenapfel/"},{"quelle":"web_streuobst_bayern","url":"https://www.streuobst-in-bayern.de/detail/id=629ef5bd318c8c7de04d403b"}]},{"thema":"frucht","text":"Die Früchte sind groß, je nach Behang mittelgroß bis groß, und haben die namengebende hochgebaute Glockenform, oft ungleichmäßig. Die Kelchgrube ist weit, flach und uneben, von Höckern begrenzt. Der Stiel ist kurz (Wikipedia, BOGL) bzw. mittellang (Streuobst in Bayern) und sitzt in einer engen Stielgrube; wegen der kurzen Stiele drücken sich die Früchte gegenseitig ab, was zu etwa 20 % Vorerntefruchtfall führt. Angaben zum Schnitt nennen die Quellen kaum; die bayerische Sortenbeschreibung erwähnt ein weites Kerngehäuse.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Glockenapfel&oldid=264475840"},{"quelle":"web_bogl_bw","url":"https://www.bogl-bw.de/glockenapfel/"},{"quelle":"web_streuobst_bayern","url":"https://www.streuobst-in-bayern.de/detail/id=629ef5bd318c8c7de04d403b"}]},{"thema":"schale","text":"Die Grundfarbe ist grüngelb, in der Reife gelb bis weißlichgelb. Sonnenseits liegt gelegentlich ein Anflug rötlicher Deckfarbe; BOGL nennt die Sonnenseite verwaschen gerötet. Auf der Sonnenseite fallen dunkle Schalenpunkte auf. Wikipedia beschreibt die Schale als etwas rau, die bayerische Sortenbeschreibung als glatt und trocken. Die Stielgrube ist wenig berostet.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Glockenapfel&oldid=264475840"},{"quelle":"web_bogl_bw","url":"https://www.bogl-bw.de/glockenapfel/"},{"quelle":"web_streuobst_bayern","url":"https://www.streuobst-in-bayern.de/detail/id=629ef5bd318c8c7de04d403b"}]},{"thema":"fleisch_geschmack","text":"Das Fleisch ist fast weiß, sehr fest und wenig bis mäßig saftig und zerfällt auch beim Kochen kaum. Der Geschmack ist aromatisch, etwas herb, mit ausgeprägter, etwas scharfer, zitronenartiger Säure. Ein Glockenapfel enthält etwa 47,5 mg Polyphenole je 100 g Frischgewicht.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Glockenapfel&oldid=264475840"},{"quelle":"web_bogl_bw","url":"https://www.bogl-bw.de/glockenapfel/"},{"quelle":"web_streuobst_bayern","url":"https://www.streuobst-in-bayern.de/detail/id=629ef5bd318c8c7de04d403b"}]},{"thema":"reife_lagerung","text":"Gepflückt wird im Oktober; die Früchte sind bis zur Baumreife windfest und fallen danach ab. Genussreif sind sie ab Dezember. Im Normallager halten sie sich bis März, im Kühllager bis Mai oder Juni, ohne zu welken.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Glockenapfel&oldid=264475840"},{"quelle":"web_bogl_bw","url":"https://www.bogl-bw.de/glockenapfel/"},{"quelle":"web_streuobst_bayern","url":"https://www.streuobst-in-bayern.de/detail/id=629ef5bd318c8c7de04d403b"}]},{"thema":"baum","text":"Der Baum wächst anfangs stark, später mittelstark, mit steiler, hochrunder Krone und typisch hängenden Langtrieben, die unten verkahlen; er braucht fachkundigen Schnitt. Hochstämme neigen zu Alternanz und Vergreisung. Nach reichem Ertrag ist das junge Holz frostempfindlich, es kommt zu Spitzendürre. Die Sorte ist etwas schorfanfällig, wenig mehltauanfällig und neigt gelegentlich zu Obstbaumkrebs; gute Fruchtqualität braucht geschützte, warme Lagen und fruchtbare, feuchte Böden. Die Blüte ist mittelfrüh; die diploide Sorte ist teilweise selbstfruchtbar und ein guter Pollenspender.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Glockenapfel&oldid=264475840"},{"quelle":"web_bogl_bw","url":"https://www.bogl-bw.de/glockenapfel/"},{"quelle":"web_streuobst_bayern","url":"https://www.streuobst-in-bayern.de/detail/id=629ef5bd318c8c7de04d403b"}]},{"thema":"verwendung","text":"Der Glockenapfel wird überwiegend frisch gegessen, außerdem zum Backen, für Saft und als Edelbrand verwendet. Weil das Fleisch beim Kochen fest bleibt, eignet er sich gut für die Küche.","belege":[{"quelle":"web_streuobst_bayern","url":"https://www.streuobst-in-bayern.de/detail/id=629ef5bd318c8c7de04d403b"},{"quelle":"web_bogl_bw","url":"https://www.bogl-bw.de/glockenapfel/"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Glockenapfel&oldid=264475840"}]},{"thema":"unterscheidung","text":"Nach Wikipedia kann der Glockenapfel mit dem Tulpenapfel und der Gelben Schafsnase verwechselt werden. Der Herbst-Glockenapfel, den Oberdieck im Illustrirten Handbuch nach Diel beschreibt, ist eine andere Sorte: Er reift schon Ende September und trägt auf der Sonnenseite kurze blass- bis karminrote Streifen.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Glockenapfel&oldid=264475840"},{"quelle":"illustr_hb_4","band":"IV","seite":"207"}]},{"thema":"frucht","text":"Nach den Erhebungen der National Fruit Collection: mittelgroße, stumpf kegelförmige Frucht mit grünlich gelber Grundfarbe und verwaschener orangefarbener Deckfarbe auf einem kleinen bis mittleren Teil der Schale. Die Schale ist kaum berostet, das Fruchtfleisch weiß. In der Sammlung als Küchenapfel geführt; pflückreif Mitte Oktober, lagerfähig bis April.","belege":[{"quelle":"nfc2025","seite":"Akzession 1948613"}]}],"bilder":[{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/d/d0/Malus_Glockenapfel_4455.jpg/960px-Malus_Glockenapfel_4455.jpg","seite":"https://commons.wikimedia.org/wiki/File:Malus_Glockenapfel_4455.jpg","art":"frucht","urheber":"Sven Teschke","lizenz":"CC BY-SA 3.0 de","quelle":"commons","titel":"Malus Glockenapfel 4455.jpg"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/96/Glockenapfel_%28Apfel%29_jm26734.jpg/960px-Glockenapfel_%28Apfel%29_jm26734.jpg","seite":"https://commons.wikimedia.org/wiki/File:Glockenapfel_(Apfel)_jm26734.jpg","art":"frucht","urheber":"joergens.mi","lizenz":"CC BY-SA 3.0","quelle":"commons","titel":"Glockenapfel (Apfel) jm26734.jpg"},{"url":"https://upload.wikimedia.org/wikipedia/commons/2/2f/Cross_section_of_Glockenapfel%2C_National_Fruit_Collection_%28acc._1948-6