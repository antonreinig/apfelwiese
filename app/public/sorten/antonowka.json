{"id":"antonowka","name":"Antonowka","synonyme":[{"name":"Antonovka","beleg":{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Antonowka_(Apfel)&oldid=231620775"}},{"name":"Antonówka","beleg":{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Antonowka_(Apfel)&oldid=231620775"}},{"name":"Possarts Nalivia","beleg":{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Antonowka_(Apfel)&oldid=231620775"}}],"herkunft":{"text":"Zufallssämling aus dem Baltikum oder aus Russland. Lauche (1883) fand die Sorte in den russischen Ostseeprovinzen, besonders um Riga, häufig verbreitet.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Antonowka_(Apfel)&oldid=231620775"},{"quelle":"lauche_erg1883","seite":"7 (Nr. 693)"}]},"merkmale":[{"merkmal":"frucht_breite","wert":83,"original":"Gestalt 83:70—72","quelle":"engelbrecht1889","seite":"170 (Nr. 150)"},{"merkmal":"frucht_hoehe","wert":71,"original":"Gestalt 83:70—72","quelle":"engelbrecht1889","seite":"170 (Nr. 150)"},{"merkmal":"frucht_hoehe_breite","wert":0.86,"original":"Gestalt 83:70—72","quelle":"engelbrecht1889","seite":"170 (Nr. 150)"},{"merkmal":"frucht_breite","wert":80,"original":"etwa 85 mm hoher und 80 mm breiter Apfel","quelle":"lauche_erg1883","seite":"7 (Nr. 693)"},{"merkmal":"frucht_hoehe","wert":85,"original":"etwa 85 mm hoher und 80 mm breiter Apfel","quelle":"lauche_erg1883","seite":"7 (Nr. 693)"},{"merkmal":"frucht_hoehe_breite","wert":1.06,"original":"etwa 85 mm hoher und 80 mm breiter Apfel","quelle":"lauche_erg1883","seite":"7 (Nr. 693)"},{"merkmal":"frucht_groesse","wert":"7","original":"großer, kegelförmiger … Apfel","quelle":"lauche_erg1883","seite":"7 (Nr. 693)"},{"merkmal":"frucht_form","wert":"eifoermig","original":"abgest. rundlich eiförmig","quelle":"engelbrecht1889","seite":"170 (Nr. 150)"},{"merkmal":"frucht_form","wert":"konisch","original":"großer, kegelförmiger … Apfel","quelle":"lauche_erg18