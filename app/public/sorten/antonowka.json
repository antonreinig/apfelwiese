:"170 (Nr. 150)"},{"merkmal":"fleisch_farbe","wert":"cremeweiss","original":"Fleisch: gelblichweiß","quelle":"lauche_erg1883","seite":"8 (Nr. 693)"},{"merkmal":"fleisch_festigkeit","wert":"3","original":"etwas locker und brüchig","quelle":"engelbrecht1889","seite":"170 (Nr. 150)"},{"merkmal":"fleisch_festigkeit","wert":"3","original":"Fleisch: gelblichweiß, weich","quelle":"lauche_erg1883","seite":"8 (Nr. 693)"},{"merkmal":"fleisch_saftigkeit","wert":"7","original":"saftig","quelle":"engelbrecht1889","seite":"170 (Nr. 150)"},{"merkmal":"fleisch_saftigkeit","wert":"7","original":"weich, saftreich","quelle":"lauche_erg1883","seite":"8 (Nr. 693)"},{"merkmal":"geschmack_saeure","wert":"7","original":"vorherrschend, doch angenehm weinig, mässig süss","quelle":"engelbrecht1889","seite":"170 (Nr. 150)"},{"merkmal":"geschmack_suesse","wert":"5","original":"vorherrschend, doch angenehm weinig, mässig süss","quelle":"engelbrecht1889","seite":"170 (Nr. 150)"},{"merkmal":"geschmack_suesse","wert":"7","original":"von schwach-gewürztem, süßweinigem Geschmack","quelle":"lauche_erg1883","seite":"8 (Nr. 693)"},{"merkmal":"geschmack_saeure","wert":"5","original":"von schwach-gewürztem, süßweinigem Geschmack","quelle":"lauche_erg1883","seite":"8 (Nr. 693)"},{"merkmal":"geschmack_aroma","wert":"kaum merklich gewürzt","original":"kaum merklich gewürzt","quelle":"engelbrecht1889","seite":"170 (Nr. 150)"},{"merkmal":"geschmack_aroma","wert":"schwach gewürzt","original":"von schwach-gewürztem, süßweinigem Geschmack","quelle":"lauche_erg1883","seite":"8 (Nr. 693)"},{"merkmal":"genussreife_beginn","wert":"10","original":"October bis November","quelle":"engelbrecht1889","seite":"170 (Nr. 150)"},{"merkmal":"genussreife_ende","wert":"11","original":"October bis November","quelle":"engelbrecht1889","seite":"170 (Nr. 150)"},{"merkmal":"genussreife_beginn","wert":"11","original":"Reifezeit und Nutzung: November","quelle":"lauche_erg1883","seite":"8 (Nr. 693)"},{"merkmal":"genussreife_ende","wert":"11","original":"Reifezeit und Nutzung: November","quelle":"lauche_erg1883","seite":"8 (Nr. 693)"},{"merkmal":"verwendung","wert":"tafel","original":"o††","quelle":"engelbrecht1889","seite":"170 (Nr. 150)"},{"merkmal":"verwendung","wert":"kueche","original":"o††","quelle":"engelbrecht1889","seite":"170 (Nr. 150)"},{"merkmal":"verwendung","wert":"kueche","original":"Recht guter, ansehnlicher Apfel für die Wirthschaft","quelle":"lauche_erg1883","seite":"8 (Nr. 693)"},{"merkmal":"baum_wuchs","wert":"7","original":"er wächst kräftig, ist sehr tragbar","quelle":"lauche_erg1883","seite":"8 (Nr. 693)"},{"merkmal":"kernhaus_breite_mm","wert":43,"original":"Kernhaus 43:35","quelle":"engelbrecht1889","seite":"170 (Nr. 150)"},{"merkmal":"kernhaus_hoehe_mm","wert":35,"original":"Kernhaus 43:35","quelle":"engelbrecht1889","seite":"170 (Nr. 150)"},{"merkmal":"kernfach_breite_mm","wert":12,"original":"Kammern 12:18","quelle":"engelbrecht1889","seite":"170 (Nr. 150)"},{"merkmal":"kernfach_hoehe_mm","wert":18,"original":"Kammern 12:18","quelle":"engelbrecht1889","seite":"170 (Nr. 150)"},{"merkmal":"frucht_groesse","wert":"7","quelle":"nfc2025","seite":"Akzession 1948666 (NFC-Früchte)","original":"Large"},{"merkmal":"frucht_form","wert":"breitrundkonisch","quelle":"nfc2025","seite":"Akzession 1948666 (NFC-Früchte)","original":"Broad globose conical"},{"merkmal":"frucht_rippung","wert":"7","quelle":"nfc2025","seite":"Akzession 1948666 (NFC-Früchte)","original":"Strong"},{"merkmal":"frucht_kronung","wert":"9","quelle":"nfc2025","seite":"Akzession 1948666 (NFC-Früchte)","original":"Strong"},{"merkmal":"schale_grundfarbe","wert":"weisslichgelb","quelle":"nfc2025","seite":"Akzession 1948666 (NFC-Früchte)","original":"Whitish yellow"},{"merkmal":"schale_deckfarbe_anteil","wert":"0","quelle":"nfc2025","seite":"Akzession 1948666 (NFC-Früchte)","original":"Absent"},{"merkmal":"schale_berostung_gesamt","wert":"3","quelle":"nfc2025","seite":"Akzession 1948666 (NFC-Früchte)","original":"Low"},{"merkmal":"fleisch_farbe","wert":"weiss","quelle":"nfc2025","seite":"Akzession 1948666 (NFC-Früchte)","original":"White"},{"merkmal":"verwendung","wert":"kueche","quelle":"nfc2025","seite":"Akzession 1948666","original":"Culinary"},{"merkmal":"pflueckreife","wert":"9","quelle":"nfc2025","seite":"Akzession 1948666","original":"Early September"},{"merkmal":"genussreife_ende","wert":"12","quelle":"nfc2025","seite":"Akzession 1948666","original":"December"},{"merkmal":"bluete_zeit","wert":"3","quelle":"nfc2025","seite":"Akzession 1948666","original":"Klasse 4 (10 % der Blüten offen, Tag 122)"},{"merkmal":"bluete_zeit","wert":"5","quelle":"nfc2025","seite":"Akzession 1948666","original":"Klasse 4 (10 % der Blüten offen, Tag 122)"}],"texte":[{"thema":"ueberblick","text":"Alte Sorte aus dem Baltikum oder aus Russland mit großen, gelben bis grünlichgelben Früchten ohne Röte, die wenig aromatisch sind. Bekannt ist sie vor allem für ihre Frosthärte und ihre Widerstandsfähigkeit gegen Schorf; nach ihr ist die Schorfresistenz Va benannt. Engelbrecht ordnete sie 1889 den Rosenäpfeln zu.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Antonowka_(Apfel)&oldid=231620775"},{"quelle":"lauche_erg1883","seite":"8 (Nr. 693)"},{"quelle":"engelbrecht1889","seite":"170 (Nr. 150)"}]},{"thema":"herkunft","text":"Antonowka gilt als Zufallssämling aus dem Baltikum oder aus Russland. Nach Wikipedia ist sie in Deutschland seit 1826 durch Justizrat Possart bekannt. Lauche fand sie 1883 in den russischen Ostseeprovinzen, besonders um Riga, häufig, in Deutschland aber noch nicht verbreitet; die Königliche Gärtner-Lehranstalt erhielt Früchte und Reiser vom Garteninspektor Kuphaldt in Riga. Lauche hielt seine Beschreibung für die erste. Engelbrecht erhielt Früchte von Dr. Schlegelmilch in Coburg.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Antonowka_(Apfel)&oldid=231620775"},{"quelle":"lauche_erg1883","seite":"7 (Nr. 693)"},{"quelle":"engelbrecht1889","seite":"170 (Nr. 150)"}]},{"thema":"frucht","text":"Engelbrecht maß 83 mm Breite und 70–72 mm Höhe; Lauche beschreibt einen großen, kegelförmigen Apfel von etwa 85 mm Höhe und 80 mm Breite. Engelbrecht nennt die Frucht abgestumpft rundlich eiförmig, oft etwas länger gebaut, mit ziemlich gleichen Hälften. Am breitesten ist sie zum Stiel hin; um den Stiel rundet sie sich flach ab, zum Kelch nimmt sie stärker ab und endet stumpf zugespitzt. Flache, sehr deutliche Rippen laufen calvillartig über die Frucht, der Querschnitt ist flachkantig. Der Kelch ist geschlossen oder wenig offen und sitzt in einer tiefen, engen Einsenkung. Der Stiel ist nach Lauche kurz und stark, nach Engelbrecht dünn bis mitteldick und etwa 18 mm lang; er steht in einer tiefen, hellbraun berosteten Stielgrube, die Lauche eng und von starken Rippen umgeben, Engelbrecht mäßig weit und sehr faltig nennt.","belege":[{"quelle":"engelbrecht1889","seite":"170 (Nr. 150)"},{"quelle":"lauche_erg1883","seite":"7 (Nr. 693)"},{"quelle":"lauche_erg1883","seite":"8 (Nr. 693)"}]},{"thema":"schale","text":"Die Schale ist fein, glatt und glänzend, zuerst hellgrün, in der Reife gelb bzw. grünlichgelb, nach Lauche ohne jede Röte. Engelbrecht fand die Schalenpunkte zahlreich, fein, teils braun, teils nur als Tupfen; Lauche nennt sie zerstreut, hellgelb und wenig auffällig. Die Frucht riecht merklich.","belege":[{"quelle":"engelbrecht1889","seite":"170 (Nr. 150)"},{"quelle":"lauche_erg1883","seite":"8 (Nr. 693)"}]},{"thema":"schnitt","text":"Engelbrecht fand ein zwiebelförmiges Kernhaus von 43 mm Breite und 35 mm Höhe; Lauche beschreibt den von den Gefäßbündeln umgrenzten Bereich als herz-zwiebelförmig und kelchwärts lang zugespitzt. Die Kammern sind geräumig, stielwärts stumpf gespitzt, kelchwärts abgerundet, mit zerrissenen Wänden; Engelbrecht fand sie nicht oder wenig offen, Lauche geöffnet. Die Achsenhöhle ist schmal, nach Lauche ist das Kernhaus hohlachsig. Meist liegen zwei kleine, vollkommen ausgebildete, eiförmige, gespitzte, ziemlich dunkelbraune Kerne in jeder Kammer. Die Kelchhöhle ist kegelförmig und reicht nach Engelbrecht ⅖ zur Achsenhöhle; Lauche nennt die Kelchröhre lang kegelförmig. Das Fleisch ist am Schnitt gelblichweiß.","belege":[{"quelle":"engelbrecht1889","seite":"170 (Nr. 150)"},{"quelle":"lauche_erg1883","seite":"8 (Nr. 693)"}]},{"thema":"fleisch_geschmack","text":"Das Fleisch ist gelblichweiß, halbfein, etwas locker und brüchig bzw. weich und saftreich. Engelbrecht fand es kaum merklich gewürzt, angenehm weinig bei mäßiger Süße; Lauche beschreibt den Geschmack als schwach gewürzt und süßweinig. Auch Wikipedia nennt die Früchte wenig aromatisch.","belege":[{"quelle":"engelbrecht1889","seite":"170 (Nr. 150)"},{"quelle":"lauche_erg1883","seite":"8 (Nr. 693)"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Antonowka_(Apfel)&oldid=231620775"}]},{"thema":"reife_lagerung","text":"Engelbrecht gibt als Genussreife Oktober bis November an, Lauche November. Nach Wikipedia werden die Früchte im September reif.","belege":[{"quelle":"engelbrecht1889","seite":"170 (Nr. 150)"},{"quelle":"lauche_erg1883","seite":"8 (Nr. 693)"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Antonowka_(Apfel)&oldid=231620775"}]},{"thema":"baum","text":"Nach Lauche wächst der Baum kräftig, trägt sehr gut, gedeiht in jedem Boden und ist unempfindlich, weshalb er auch für hohe und raue Lagen empfohlen wurde. Die Sommertriebe sind stark, braun und punktiert, die Blätter groß, eirund und scharf gesägt. Wikipedia nennt die Sorte frosthart und widerstandsfähig gegen Schorf.","belege":[{"quelle":"lauche_erg1883","seite":"8 (Nr. 693)"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Antonowka_(Apfel)&oldid=231620775"}]},{"thema":"verwendung","text":"Lauche empfahl die Antonowka als recht guten, ansehnlichen Wirtschaftsapfel. Heute ist sie eine der wenigen Quellen für Schorfresistenz beim Apfel und wird deshalb in der Züchtung schorfresistenter Sorten verwendet, zum Beispiel für Reglindis und Angold.","belege":[{"quelle":"lauche_erg1883","seite":"8 (Nr. 693)"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Antonowka_(Apfel)&oldid=231620775"}]},{"thema":"unterscheidung","text":"Wikipedia führt „Possarts Nalivia“ als Synonym. Engelbrecht beschrieb 1889 beide Namen als getrennte Sorten: Possart's Nalivia (Nr. 21) stellte er zu den Calvillen, mit Genussreife Ende November bis Anfang Februar, offenen, fast glattwandigen Kammern und zwei bis drei Kernen je Kammer. Antonowka (Nr. 150) stellte er zu den Rosenäpfeln, mit Genussreife Oktober bis November und nicht oder wenig offenen Kammern.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Antonowka_(Apfel)&oldid=231620775"},{"quelle":"engelbrecht1889","seite":"24 (Nr. 21)"},{"quelle":"engelbrecht1889","seite":"170 (Nr. 150)"}]},{"thema":"frucht","text":"Nach den Erhebungen der National Fruit Collection: großer, breit rundlich-kegelförmiger Apfel mit weißlich gelber Grundfarbe, ohne Deckfarbe. Die Schale ist wenig berostet, das Fruchtfleisch weiß. Küchenapfel, pflückreif Anfang September und lagerfähig bis Dezember.","belege":[{"quelle":"nfc2025","seite":"Akzession 1948666"}]}],"bilder":[{"url":"https://archive.org/download/bub_gb_tR4EMgEACAAJ/page/n187_w800.jpg","seite":"https://archive.org/details/bub_gb_tR4EMgEACAAJ/page/n187","art":"schnitt","urheber":"Theodor Engelbrecht (Zeichnung), Albert Probst (Holzschnitt)","lizenz":"gemeinfrei","quelle":"engelbrecht1889","titel":"Längsschnitt-Umriss bei Engelbrecht 1889, S. 170 (ganze Buchseite)"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/a/a4/Antonowka_jm55130.jpg/960px-Antonowka_jm55130.jpg","seite":"https://commons.wikimedia.org/wiki/File:Antonowka_jm55130.jpg","art":"frucht","urheber":"joergens.mi","lizenz":"CC BY-SA 3.0","quelle":"commons","titel":"Antonowka jm55130.jpg"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/6/64/Deutsche_Pomologie_-_Aepfel_-_078.jpg/960px-Deutsche_Pomologie_-_Aepfel_-_078.jpg","seite":"https://commons.wikimedia.org/wiki/File:Deutsche_Pomologie_-_Aepfel_-_078.jpg","art":"tafel","urheber":"Wilhelm Lauche (Deutsche Pomologie, 1882)","lizenz":"gemeinfrei","quelle":"lauche_dp1882","titel":"Deutsche Pomologie - Aepfel - 078.jpg (Possart's Nalivia)"},{"url":"https://upload.wikimedia.org/wikipedia/commons/7/75/Cross_section_of_Antonovka%2C_National_Fruit_Collection_%28acc._1948-666%29.jpg","seite":"https://commons.wikimedia.org/wiki/File:Cross_section_of_Antonovka,_National_Fruit_Collection_(acc._1948-666).jpg","art":"schnitt","urheber":"National Fruit Collection, Brogdale","lizenz":"OGL 2.0","quelle":"nfc-commons","titel":"Cross section of Antonovka, National Fruit Collection (acc. 1948-666)"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/3/37/Antoonovka.jpg/960px-Antoonovka.jpg","seite":"https://commons.wikimedia.org/wiki/File:Antoonovka.jpg","art":"schnitt","urheber":"Epp","lizenz":"CC BY-SA 3.0","quelle":"commons-fotos","titel":"Antoonovka"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/2/2d/Antonauka-crop.jpg/960px-Antonauka-crop.jpg","seite":"https://commons.wikimedia.org/wiki/File:Antonauka-crop.jpg","art":"frucht","urheber":"Mr. Zabej","lizenz":"CC BY-SA 4.0","quelle":"commons-fotos","titel":"Antonauka-crop"},{"url":"https://upload.wikimedia.org/wikipedia/commons/8/8b/Antonovka.jpg","seite":"https://commons.wikimedia.org/wiki/File:Antonovka.jpg","art":"frucht","urheber":"No machine-readable author provided. Abrahami assumed (based on copyright claims)","lizenz":"CC BY-SA 2.5","quelle":"commons-fotos","titel":"Antonovka"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/7c/Antonovka-PI_588784.JPG/960px-Antonovka-PI_588784.JPG","seite":"https://commons.wikimedia.org/wiki/File:Antonovka-PI_588784.JPG","art":"frucht","urheber":"Accession was donated. 21-Aug-1984.