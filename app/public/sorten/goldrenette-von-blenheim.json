tuallers","lizenz":"CC BY-SA 3.0","quelle":"commons-fotos","titel":"Blenhein Orange Apple cultivars as grown at Priorwood Garden in 2020"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/3/34/Malus_Blenheim_Orange_5.jpg/960px-Malus_Blenheim_Orange_5.jpg","seite":"https://commons.wikimedia.org/wiki/File:Malus_Blenheim_Orange_5.jpg","art":"frucht","urheber":"Qweasdqwe","lizenz":"CC BY-SA 3.0","quelle":"commons-fotos","titel":"Malus Blenheim Orange 5"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/8b/Malus_goldrenette_von_blenheim.jpg/960px-Malus_goldrenette_von_blenheim.jpg","seite":"https://commons.wikimedia.org/wiki/File:Malus_goldrenette_von_blenheim.jpg","art":"frucht","urheber":"Hwman","lizenz":"CC BY-SA 2.5","quelle":"commons-fotos","titel":"Malus goldrenette von blenheim"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/0/0f/Malus-Goldrenette-von-Blenheim.jpg/960px-Malus-Goldrenette-von-Blenheim.jpg","seite":"https://commons.wikimedia.org/wiki/File:Malus-Goldrenette-von-Blenheim.jpg","art":"frucht","urheber":"unbekannt","lizenz":"CC BY-SA 2.0 DE","quelle":"commons-fotos","titel":"Malus-Goldrenette-von-Blenheim"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/17/Pomological_Watercolor_POM00001630.jpg/960px-Pomological_Watercolor_POM00001630.jpg","seite":"https://commons.wikimedia.org/wiki/File:Pomological_Watercolor_POM00001630.jpg","art":"tafel","urheber":"Arnold, Mary Daisy, ca. 1873-1955","lizenz":"gemeinfrei","quelle":"usda-pomological","titel":"Pomological Watercolor POM00001630"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/e/e3/Pomological_Watercolor_POM00001631.jpg/960px-Pomological_Watercolor_POM00001631.jpg","seite":"https://commons.wikimedia.org/wiki/File:Pomological_Watercolor_POM00001631.jpg","art":"tafel","urheber":"Heiges, Bertha","lizenz":"gemeinfrei","quelle":"usda-pomological","titel":"Pomological Watercolor POM00001631"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/