{"id":"dorheimer-streifling","name":"Dorheimer Streifling","synonyme":[],"herkunft":{"text":"Wetterauer Lokalsorte aus Dorheim bei Friedberg (Hessen), dort seit Generationen angebaut; erste Erwähnung 1949 durch H. Schmidt. 1995 spürte die NABU-Gruppe Friedberg acht Altbäume auf.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Dorheimer_Streifling&oldid=242133104"}],"land":"DE","landSicher":true,"ort":"Dorheim bei Friedberg","jahr":1949},"merkmale":[{"merkmal":"frucht_groesse","wert":"5","original":"Der druckfeste, duftende Apfel ist mittelgroß, kegelförmig","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Dorheimer_Streifling&oldid=242133104"},{"merkmal":"frucht_form","wert":"konisch","original":"mittelgroß, kegelförmig und leicht gerippt","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Dorheimer_Streifling&oldid=242133104"},{"merkmal":"frucht_rippung","wert":"3","original":"leicht gerippt","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Dorheimer_Streifling&oldid=242133104"},{"merkmal":"frucht_symmetrie","wert":"schief","original":"ungleichhälftig und stielbauchig","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Dorheimer_Streifling&oldid=242133104"},{"merkmal":"frucht_breiteste_stelle","wert":"stiel","original":"ungleichhälftig und stielbauchig","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Dorheimer_Streifling&oldid=242133104"},{"merkmal":"kelchgrube_tiefe","wert":"3","original":"Die flache Kelchgrube","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Dorheimer_Streifling&oldid=242133104"},{"merkmal":"frucht_kronung","wert":"5","original":"von schwachen Falten und Wülsten umgeben","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Dorheimer_Streifling&oldid=242133104"},{"merkmal":"kelch_offenheit","wert":"geschlossen","original":"der Kelch ist klein und geschlossen","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Dorheimer_Streifling&oldid=242133104"},{"merkmal":"kelchhoehle_form","wert":"trichter_kurz","original":"Die Kelchhöhle ist klein und trichterförmig","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Dorheimer_Streifling&oldid=242133104"},{"merkmal":"stielgrube_tiefe","wert":"7","original":"Stielgrube ist tief und eng","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Dorheimer_Streifling&oldid=242133104"},{"merkmal":"stielgrube_weite","wert":"3","original":"Stielgrube ist tief und eng","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Dorheimer_Streifling&oldid=242133104"},{"merkmal":"schale_berostung_stielgrube","wert":"0","original":"wenig bis gar nicht berostet","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Dorheimer_Streifling&oldid=242133104"},{"merkmal":"schale_berostung_stielgrube","wert":"3","original":"wenig bis gar nicht berostet","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Dorheimer_Streifling&oldid=242133104"},{"merkmal":"stiel_laenge","wert":"5","original":"Der holzige Stiel ist mittellang","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Dorheimer_Streifling&oldid=242133104"},{"merkmal":"schale_beschaffenheit","wert":"glatt","original":"Die Schale ist glatt und trocken","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Dorheimer_Streifling&oldid=242133104"},{"merkmal":"schale_beschaffenheit","wert":"fettig","original":"wird während der Lagerung leicht fettig","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Dorheimer_Streifling&oldid=242133104"},{"merkmal":"schale_grundfarbe","wert":"weisslichgelb","original":"Die Grundfarbe ist strohgelb mit lebhaften Streifen","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Dorheimer_Streifling&oldid=242133104"},{"merkmal":"schale_deckfarbe_art","wert":"gestreift","original":"strohgelb mit lebhaften Streifen","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Dorheimer_Streifling&oldid=242133104"},{"merkmal":"schale_deckfarbe_art","wert":"getuepfelt","original":"teilweise roten Sprenkeln","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Dorheimer_Streifling&oldid=242133104"},{"merkmal":"schale_deckfarbe_farbton","wert":"rot","original":"teilweise roten Sprenkeln","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Dorheimer_Streifling&oldid=242133104"},{"merkmal":"schale_lentizellen_art","wert":"hell","original":"hellen Lentizellen","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Dorheimer_Streifling&oldid=242133104"},{"merkmal":"schale_berostung_wangen","wert":"3","original":"sowie leichtem Rost","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Dorheimer_Streifling&oldid=242133104"},{"merkmal":"fleisch_farbe","wert":"cremeweiss","original":"Das gelblich-weiße, fein duftende Fruchtfleisch","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Dorheimer_Streifling&oldid=242133104"},{"merkmal":"fleisch_festigkeit","wert":"7","original":"ist fest, feinzellig, saftig und würzig","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Dorheimer_Streifling&oldid=242133104"},{"merkmal":"fleisch_saftigkeit","wert":"7","original":"fest, feinzellig, saftig und würzig","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Dorheimer_Streifling&oldid=242133104"},{"merkmal":"geschmack_suesse","wert":"5","original":"ausgeglichenen Zucker-Säureverhältnis","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Dorheimer_Streifling&oldid=242133104"},{"merkmal":"geschmack_saeure","wert":"5","original":"ausgeglichenen Zucker-Säureverhältnis","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Dorheimer_Streifling&oldid=242133104"},{"merkmal":"geschmack_aroma","wert":"würzig","original":"saftig und würzig","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Dorheimer_Streifling&oldid=242133104"},{"merkmal":"kernhaus_form","wert":"zwiebel","original":"Die Gefäßbündellinien des Kernhauses sind zwiebelförmig","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Dorheimer_Streifling&oldid=242133104"},{"merkmal":"kernhaus_achse","wert":"offen","original":"die Achsenhöhle ist offen","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Dorheimer_Streifling&oldid=242133104"},{"merkmal":"kernfaecher_form","wert":"mondsichel","original":"die Kernhauswände breit sichelförmig","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Dorheimer_Streifling&oldid=242133104"},{"merkmal":"kerne_form","wert":"rundlich","original":"Kerne darin gut ausgebildet, rundlich, eher klein","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Dorheimer_Streifling&oldid=242133104"},{"merkmal":"genussreife_beginn","wert":"11","original":"von November bis April genussreif","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Dorheimer_Streifling&oldid=242133104"},{"merkmal":"genussreife_ende","wert":"4","original":"von November bis April genussreif","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Dorheimer_Streifling&oldid=242133104"},{"merkmal":"verwendung","wert":"kueche","original":"als Wirtschafts-, Most- und Tafelapfel-Sorte geschätzt","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Dorheimer_Streifling&oldid=242133104"},{"merkmal":"verwendung","wert":"most","original":"als Wirtschafts-, Most- und Tafelapfel-Sorte geschätzt","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Dorheimer_Streifling&oldid=242133104"},{"merkmal":"verwendung","wert":"tafel","original":"als Wirtschafts-, Most- und Tafelapfel-Sorte geschätzt","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Dorheimer_Streifling&oldid=242133104"},{"merkmal":"baum_wuchs","wert":"5","original":"wächst anfangs schwach und entwickelt später einen mittelstarken Wuchs","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Dorheimer_Streifling&oldid=242133104"},{"merkmal":"bluete_zeit","wert":"4","original":"Die Blüte des Dorheimer Streiflings ist mittelfrüh und dabei frosthart","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Dorheimer_Streifling&oldid=242133104"},{"merkmal":"gesundheit","wert":"7","original":"ist robust, anspruchslos und ertragreich","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Dorheimer_Streifling&oldid=242133104"},{"merkmal":"standort_boden","wert":"3","original":"ist robust, anspruchslos und ertragreich","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Dorheimer_Streifling&oldid=242133104"},{"merkmal":"bluete_frost","wert":"3","original":"Die mittelfrühe Blüte gilt als frosthart","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Dorheimer_Streifling&oldid=242133104"},{"merkmal":"ertrag_alternanz","wert":"regelmaessig","original":"Die Erträge sind hoch und regelmäßig","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Dorheimer_Streifling&oldid=242133104"},{"merkmal":"ertrag_alternanz","wert":"alternierend","original":"im Alter alternierend","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Dorheimer_Streifling&oldid=242133104"},{"merkmal":"lagerfaehigkeit","wert":"7","original":"Genussreif von November bis April","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Dorheimer_Streifling&oldid=242133104"}],"texte":[{"thema":"ueberblick","text":"Seltene Wetterauer Lokalsorte aus Dorheim bei Friedberg: ein mittelgroßer, kegelförmiger, strohgelber Apfel mit lebhaften roten Streifen, gut lagerfähig von November bis April und vielseitig verwendbar. Er war Hessische Lokalsorte 2009.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Dorheimer_Streifling&oldid=242133104"}]},{"thema":"herkunft","text":"Die Sorte ist in Dorheim seit Generationen beheimatet; schriftlich erwähnt wurde sie zuerst 1949 von H. Schmidt in „Das Gartenjahr“. Sie galt als verschollen, bis die NABU-Gruppe Friedberg 1995 über Zeitungsanzeigen acht Altbäume mit einem geschätzten Alter um 80 Jahre fand. In den ausgewerteten Werken des 19. Jahrhunderts kommt sie nicht vor.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Dorheimer_Streifling&oldid=242133104"}]},{"thema":"frucht","text":"Die Frucht ist mittelgroß, etwa 100 bis 150 g schwer, druckfest und duftend, kegelförmig, leicht gerippt, ungleichhälftig und stielbauchig. Der kleine, geschlossene Kelch mit filzigen, dicht gedrängten Kelchblättern sitzt in flacher Grube zwischen schwachen Falten und Wülsten. Der holzige Stiel ist mittellang; die graubraune Stielgrube ist tief und eng, oft durch Wülste ungleich geformt und wenig oder gar nicht berostet.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Dorheimer_Streifling&oldid=242133104"}]},{"thema":"schale","text":"Die glatte, trockene Schale wird beim Lagern leicht fettig. Auf strohgelber Grundfarbe liegen lebhafte Streifen und teils rote Sprenkel; die Lentizellen sind hell, dazu kommt leichter Rost.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Dorheimer_Streifling&oldid=242133104"}]},{"thema":"schnitt","text":"Die Gefäßbündellinie des Kernhauses ist zwiebelförmig, die Achsenhöhle offen, die Kernhauswände sind breit sichelförmig. Die Kammern sind weit; die fast schwarzbraunen Kerne sind gut ausgebildet, rundlich und eher klein. Die Kelchhöhle ist klein und trichterförmig. Das Fleisch ist gelblich weiß.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Dorheimer_Streifling&oldid=242133104"}]},{"thema":"fleisch_geschmack","text":"Das gelblich weiße Fleisch ist fest, feinzellig, saftig und würzig, fein duftend, mit ausgeglichenem Zucker-Säure-Verhältnis; Wikipedia vergleicht den Geschmack mit dem Gravensteiner.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Dorheimer_Streifling&oldid=242133104"}]},{"thema":"reife_lagerung","text":"Genussreif von November bis April, mit ausgezeichneten Lagereigenschaften.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Dorheimer_Streifling&oldid=242133104"}]},{"thema":"baum","text":"Der Baum wächst anfangs schwach, später mittelstark, ist robust, anspruchslos und ertragreich und eignet sich auch zum Umveredeln älterer Bäume. Die mittelfrühe Blüte gilt als frosthart. Die Erträge sind hoch und regelmäßig, im Alter alternierend; Anfälligkeiten sind bisher nicht bekannt.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Dorheimer_Streifling&oldid=242133104"}]},{"thema":"verwendung","text":"Wirtschafts-, Most- und Tafelapfel; die Früchte eignen sich für Mus, Saft und Obstsalat.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Dorheimer_Streifling&oldid=242133104"}]}],"bilder":[{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/73/Malus_Dorheimer_Streifling_4255.jpg/960px-Malus_Dorheimer_Streifling_4255.jpg","seite":"https://commons.wikimedia.org/wiki/File:Malus_Dorheimer_Streifling_4255.jpg","art":"tafel","urheber":"Sven Teschke","lizenz":"CC BY-SA 3.0 de","quelle":"commons","titel":"Malus Dorheimer Streifling 4255.jpg"}],"regionen":[{"region":"DE-HE","art":"herkunft","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Dorheimer_Streifling&oldid=242133104"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Dorheimer_Streifling&oldid=242133104"}]},{"region":"DE-HE","art":"regionalsorte","belege":[{"quelle":"rg_he-pv-lokalsorte-2022","seite":"Hessische Lokalsorte 2009"}],"original":"Dorheimer Streifling"}],"gefaehrdung":[{"stufe":"selten","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Dorheimer_Streifling&oldid=242133104"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Dorheimer_Streifling&oldid=242133104"}],"original":"Sie galt als verschollen"},{"stufe":"Rote Liste der gefährdeten einheimischen Nutzpflanzen in Deutschland","belege":[{"quelle":"rg_ble-rote-liste"}],"original":"Dorheimer Streifling"}]}