l":"kelch_offenheit","wert":"geschlossen","original":"Kelch geschlossen, grün und braun, wollig","quelle":"engelbrecht1889","seite":"71 (Nr. 63)"},{"merkmal":"kelchgrube_tiefe","wert":"5","original":"Einsenk. mitteltief, mässig weit","quelle":"engelbrecht1889","seite":"71 (Nr. 63)"},{"merkmal":"kelchgrube_weite","wert":"5","original":"Einsenk. mitteltief, mässig weit","quelle":"engelbrecht1889","seite":"71 (Nr. 63)"},{"merkmal":"stiel_dicke","wert":"3","original":"Stiel holzig, dünn, etwa 13 mm l.","quelle":"engelbrecht1889","seite":"71 (Nr. 63)"},{"merkmal":"stielgrube_tiefe","wert":"7","original":"Höhle tief, etwas enge, faltig, etwas berostet","quelle":"engelbrecht1889","seite":"71 (Nr. 63)"},{"merkmal":"stielgrube_weite","wert":"3","original":"Höhle tief, etwas enge","quelle":"engelbrecht1889","seite":"71 (Nr. 63)"},{"merkmal":"schale_berostung_stielgrube","wert":"3","original":"Höhle … etwas berostet","quelle":"engelbrecht1889","seite":"71 (Nr. 63)"},{"merkmal":"schale_beschaffenheit","wert":"glatt","original":"Schale glatt, mattglänzend","quelle":"engelbrecht1889","seite":"71 (Nr. 63)"},{"merkmal":"schale_grundfarbe","wert":"gruengelb","original":"hellgrün, später hellgrünlichgelb bis hellgelb","quelle":"engelbrecht1889","seite":"71 (Nr. 63)"},{"merkmal":"schale_grundfarbe","wert":"gelb","original":"hellgrün, später hellgrünlichgelb bis hellgelb","quelle":"engelbrecht1889","seite":"71 (Nr. 63)"},{"merkmal":"schale_deckfarbe_anteil","wert":"1","original":"sonnenw. meistens unbedeutender, punktirter, röthlicher … Anflug","quelle":"engelbrecht1889","seite":"71 (Nr. 63)"},{"merkmal":"schale_deckfarbe_art","wert":"getuepfelt","original":"punktirter, röthlicher, oft undeutlich streifiger Anflug","quelle":"engelbrecht1889","seite":"71 (Nr. 63)"},{"merkmal":"schale_lentizellen_anzahl","wert":"3","original":"Punkte sparsam, fein, bräunlich oder nur Dupfen","quelle":"engelbrecht1889","seite":"71 (Nr. 63)"},{"merkmal":"schale_lentizellen_groesse","wert":"3","original":"Punkte sparsam, fein, bräunlich","quelle":"engelbrecht1889","seite":"71 (Nr. 63)"},{"merkmal":"schale_lentizellen_art","wert":"braun","original":"Punkte sparsam, fein, bräunlich","quelle":"engelbrecht1889","seite":"71 (Nr. 63)"},{"merkmal":"kernhaus_form","wert":"eifoermig","original":"Kernhaus 43:55, eiförmig","quelle":"engelbrecht1889","seite":"71 (Nr. 63)"},{"merkmal":"kernfaecher_form","wert":"mondsichel","original":"Kammern 12:36, sichelförmig","quelle":"engelbrecht1889","seite":"71 (Nr. 63)"},{"merkmal":"kernfaecher_oeffnung","wert":"offen","original":"zerrissen und ausgeblüht, mittelgeräumig, weit offen","quelle":"engelbrecht1889","seite":"71 (Nr. 63)"},{"merkmal":"kernhaus_achse","wert":"offen","original":"Achsenh. breit","quelle":"engelbrecht1889","seite":"71 (Nr. 63)"},{"merkmal":"kerne_form","wert":"eifoermig","original":"Kerne zu 0 bis 1, … lang eiförmig, lang gespitzt","quelle":"engelbrecht1889","seite":"71 (Nr. 63)"},{"merkmal":"kelchhoehle_form","wert":"dreieck_breit","original":"Kelchhöhle kegelf., ⅓ bis ½ zur Achsenh.","quelle":"engelbrecht1889","seite":"71 (Nr. 63)"},{"merkmal":"kelchhoehle_form","wert":"dreieck_lang","original":"Kelchhöhle kegelf., ⅓ bis ½ zur Achsenh.","quelle":"engelbrecht1889","seite":"71 (Nr. 63)"},{"merkmal":"fleisch_farbe","wert":"weiss","original":"Fleisch fast weisslich","quelle":"engelbrecht1889","seite":"71 (Nr. 63)"},{"merkmal":"fleisch_festigkeit","wert":"5","original":"etwas grob bis halbfein, markig, etwas locker","quelle":"engelbrecht1889","seite":"71 (Nr. 63)"},{"merkmal":"fleisch_saftigkeit","wert":"7","original":"etwas locker, saftig","quelle":"engelbrecht1889","seite":"71 (Nr. 63)"},{"merkmal":"geschmack_saeure","wert":"7","original":"vorherrschend ganz angenehm, nicht scharf weinig, wenig süss","quelle":"engelbrecht1889","seite":"71 (Nr. 63)"},{"merkmal":"geschmack_suesse","wert":"3","original":"vorherrschend … weinig, wenig süss","quelle":"engelbrecht1889","seite":"71 (Nr. 63)"},{"merkmal":"verwendung","wert":"tafel","original":"fast o++ (Kopfzeile)","quelle":"engelbrecht1889","seite":"71 (Nr. 63)"},{"merkmal":"verwendung","wert":"kueche","original":"fast o++ (Kopfzeile)","quelle":"engelbrecht1889","seite":"71 (Nr. 63)"},{"merkmal":"genussreife_beginn","wert":"10","original":"Ende Oct. bis Jan.","quelle":"engelbrecht1889","seite":"71 (Nr. 63)"},{"merkmal":"genussreife_ende","wert":"1","original":"Ende Oct. bis Jan.","quelle":"engelbrecht1889","seite":"71 (Nr. 63)"},{"merkmal":"ploidie","wert":"triploid","original":"Er ist eine triploide Kreuzung aus Prinzenapfel","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Doppelter_Melonenapfel&oldid=249151149"},{"merkmal":"frucht_groesse","wert":"7","original":"Die Frucht ist groß, etwa 80 mm breit und hoch","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Doppelter_Melonenapfel&oldid=249151149"},{"merkmal":"frucht_form","wert":"walzenfoermig","original":"länglich-hochgebaut, walzenförmig auch mal rundlicher","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Doppelter_Melonenapfel&oldid=249151149"},{"merkmal":"schale_deckfarbe_art","wert":"gestreift","original":"gelb/rot gestreift und gefleckt","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Doppelter_Melonenapfel&oldid=249151149"},{"merkmal":"fleisch_farbe","wert":"cremeweiss","original":"Das Fruchtfleisch ist gelblichweiß, fein locker und mürbe","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Doppelter_Melonenapfel&oldid=249151149"},{"merkmal":"fleisch_festigkeit","wert":"3","original":"fein locker und mürbe","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Doppelter_Melonenapfel&oldid=249151149"},{"merkmal":"geschmack_saeure","wert":"5","original":"Der Geschmack ist feinsäuerlich","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Doppelter_Melonenapfel&oldid=249151149"},{"merkmal":"bluete_zeit","wert":"7","original":"Er blüht spät, aber lang","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Doppelter_Melonenapfel&oldid=249151149"},{"merkmal":"kernhaus_breite_mm","wert":43,"original":"Kernhaus 43:55","quelle":"engelbrecht1889","seite":"71 (Nr. 63)"},{"merkmal":"kernhaus_hoehe_mm","wert":55,"original":"Kernhaus 43:55","quelle":"engelbrecht1889","seite":"71 (Nr. 63)"},{"merkmal":"kernfach_breite_mm","wert":12,"original":"Kammern 12:36","quelle":"engelbrecht1889","seite":"71 (Nr. 63)"},{"merkmal":"kernfach_hoehe_mm","wert":36,"original":"Kammern 12:36","quelle":"engelbrecht1889","seite":"71 (Nr. 63)"}],"texte":[{"thema":"ueberblick","text":"Sehr großer, hochgebauter, walzenförmiger Apfel aus Norddeutschland, verwandt mit dem Prinzenapfel. Er ist triploid, bildet meist nur wenige vollkommene Kerne und ist ein Herbst- und Frühwinterapfel für Tafel und Küche.","belege":[{"quelle":"engelbrecht1889","seite":"71 (Nr. 63)"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Doppelter_Melonenapfel&oldid=249151149"}]},{"thema":"herkunft","text":"Nach Wikipedia ist die Sorte ein triploider Abkömmling des Prinzenapfels mit unbekannter Vatersorte; der Namensteil „doppelt“ bezieht sich auf die viel größeren Früchte. Engelbrecht erhielt 1889 Früchte von Dr. Seelig in Kiel und vermerkte, die Sorte sei in der Provinz Schleswig-Holstein verbreitet und beliebt. Örtliche Namen wie Hasenkopf und Walzenapfel werden auch für den Prinzenapfel gebraucht.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Doppelter_Melonenapfel&oldid=249151149"},{"quelle":"engelbrecht1889","seite":"71 (Nr. 63)"}]},{"thema":"frucht","text":"Engelbrecht maß 89 mm Breite bei 86–91 mm Höhe, schmalere Früchte 78:86–90 mm, selten größere bis 102:93–102 mm. Die Frucht ist abgestumpft rundlich walzen- bis kegelwalzenförmig, in der Mitte oder wenig zum Stiel hin am breitesten, mit etwas ungleichen Hälften und flachkantigem Querschnitt. Der geschlossene Kelch sitzt mitteltief zwischen ziemlich starken, breit über die Frucht laufenden Rippen. Der dünne Stiel ist etwa 13 mm lang und steckt in tiefer, etwas enger, faltiger, leicht berosteter Grube.","belege":[{"quelle":"engelbrecht1889","seite":"71 (Nr. 63)"}]},{"thema":"schale","text":"Die glatte, mattglänzende Schale ist hellgrün, später hellgrünlichgelb bis hellgelb. Sonnenseits zeigt Engelbrecht meist nur einen unbedeutenden, punktierten, rötlichen, oft undeutlich streifigen Anflug; Wikipedia beschreibt die Frucht als gelb/rot gestreift und gefleckt. Die Lentizellen sind spärlich, fein und bräunlich oder nur als Tupfen sichtbar.","belege":[{"quelle":"engelbrecht1889","seite":"71 (Nr. 63)"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Doppelter_Melonenapfel&oldid=249151149"}]},{"thema":"schnitt","text":"Das Kernhaus ist hoch und eiförmig (43:55 mm). Die Kammern sind lang und sichelförmig (12:36 mm), kelchwärts oft kurz abgerundet, zerrissen und ausgeblüht, mittelgeräumig und weit offen; die Achsenhöhle ist breit. Je Kammer findet sich kein oder ein Kern; die Kerne sind klein bis mittelgroß, lang eiförmig und lang gespitzt, bräunlich, meist unvollkommen und klappern oft in der Kammer. Die Kelchhöhle ist kegelförmig und reicht ⅓ bis ½ zur Achsenhöhle. Das Fleisch ist fast weißlich.","belege":[{"quelle":"engelbrecht1889","seite":"71 (Nr. 63)"}]},{"thema":"fleisch_geschmack","text":"Engelbrecht beschreibt das Fleisch als fast weißlich, etwas grob bis halbfein, markig, etwas locker und saftig, ohne Gewürz, vorherrschend angenehm, aber nicht scharf weinig und wenig süß. Wikipedia nennt es gelblichweiß, fein, locker und mürbe, feinsäuerlich und ohne besonderes Aroma.","belege":[{"quelle":"engelbrecht1889","seite":"71 (Nr. 63)"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Doppelter_Melonenapfel&oldid=249151149"}]},{"thema":"reife_lagerung","text":"Genussreif nach Engelbrecht von Ende Oktober bis Januar; nach Wikipedia hält die Frucht auf dem Lager etwa vier Wochen.","belege":[{"quelle":"engelbrecht1889","seite":"71 (Nr. 63)"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Doppelter_Melonenapfel&oldid=249151149"}]},{"thema":"baum","text":"Der Baum wächst in der Jugend schwach, später stärker, mit dünnen, langen Trieben. Er bevorzugt Gebirgs- und Seeklima, blüht spät und lange und gilt als widerstandsfähig gegen schlechte Witterung, bekommt aber etwas Obstbaumkrebs. Er eignet sich vor allem für Hoch- und Halbstämme und kann sehr alt werden.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Doppelter_Melonenapfel&oldid=249151149"}]}],"bilder":[{"url":"https://archive.org/download/bub_gb_tR4EMgEACAAJ/page/n89_w800.jpg","seite":"https://archive.org/details/bub_gb_tR4EMgEACAAJ/page/n89","art":"schnitt","urheber":"Theodor Engelbrecht (Zeichnung), Albert Probst (Holzschnitt)","lizenz":"gemeinfrei","quelle":"engelbrecht1889","titel":"Längsschnitt-Umriss bei Engelbrecht 1889, S. 71 (ganze Buchseite)"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/0/01/Doppelter_Prinzenapfel_jm55153.jpg/960px-Doppelter_Prinzenapfel_jm55153.jpg","seite":"https://commons.wikimedia.org/wiki/File:Doppelter_Prinzenapfel_jm55153.jpg","art":"baum","urheber":"joergens.mi","lizenz":"CC BY-SA 3.0","quelle":"commons-fotos","titel":"Doppelter Prinzenapfel jm55153"}]}