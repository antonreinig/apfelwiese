{"id":"purpurroter-agatapfel","name":"Purpurroter Agatapfel","synonyme":[{"name":"Agatapfel","beleg":{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Purpurroter_Agatapfel&oldid=266251002"}},{"name":"Purpurroter Winteragatapfel","beleg":{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Purpurroter_Agatapfel&oldid=266251002"}},{"name":"Purpurrother Agatapfel","beleg":{"quelle":"engelbrecht1889","seite":"201 (Nr. 180)"}},{"name":"Purpurrother Winter-Agatapfel","beleg":{"quelle":"engelbrecht1889","seite":"201 (Nr. 180)"}},{"name":"Purpurrother Kronenapfel","beleg":{"quelle":"illustr_hb_1","band":"I","seite":"437 (Nr. 202)"}},{"name":"Rode Tulp Kroon","beleg":{"quelle":"illustr_hb_1","band":"I","seite":"437 (Nr. 202)"}},{"name":"Engelsche Aagt","beleg":{"quelle":"illustr_hb_1","band":"I","seite":"437 (Nr. 202)"}}],"herkunft":{"text":"Herkunft unbekannt, vermutlich aus Holland: Diel erhielt die Sorte von dort unter dem Namen Rode Tulp Kroon. Oberdieck fand um 1832 in Sulingen (Hannover) zwei alte Hochstämme, die wohl ebenfalls aus Holland stammten.","belege":[{"quelle":"illustr_hb_1","band":"I","seite":"437 (Nr. 202)"}],"land":"NL","landSicher":false},"merkmale":[{"merkmal":"frucht_groesse","wert":"3","original":"ein kleiner abgestumpft rundlicher … Tafelapfel","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Purpurroter_Agatapfel&oldid=266251002"},{"merkmal":"frucht_breite","wert":54,"original":"Gestalt 54:46","quelle":"engelbrecht1889","seite":"201 (Nr. 180)"},{"merkmal":"frucht_hoehe","wert":46,"original":"Gestalt 54:46","quelle":"engelbrecht1889","seite":"201 (Nr. 180)"},{"merkmal":"frucht_hoehe_breite","wert":0.85,"original":"Gestalt 54:46","quelle":"engelbrecht1889","seite":"201 (Nr. 180)"},{"merkmal":"frucht_form","wert":"rund","original":"etwas abgest. rundlich","quelle":"engelbrecht1889","seite":"201 (Nr. 180)"},{"merkmal":"frucht_form","wert":"rund","original":"Gestalt: kugelförmig","quelle":"illustr_hb_1","band":"I","seite":"437 (Nr. 202)"},{"merkmal":"frucht_form","wert":"rund","original":"abgestumpft rundlicher und gleichmäßig gebauter Tafelapfel","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Purpurroter_Agatapfel&oldid=266251002"},{"merkmal":"frucht_breiteste_stelle","wert":"mitte","original":"ziemlich mittelbauch.","quelle":"engelbrecht1889","seite":"201 (Nr. 180)"},{"merkmal":"frucht_breiteste_stelle","wert":"mitte","original":"Der Bauch sitzt in der Mitte","quelle":"illustr_hb_1","band":"I","seite":"437 (Nr. 202)"},{"merkmal":"frucht_symmetrie","wert":"symmetrisch","original":"Hälften gleich","quelle":"engelbrecht1889","seite":"201 (Nr. 180)"},{"merkmal":"frucht_rippung","wert":"1","original":"Querschn. rund","quelle":"engelbrecht1889","seite":"201 (Nr. 180)"},{"merkmal":"frucht_kronung","wert":"1","original":"zwischen sehr kleinen, flach und kaum zum Bauche laufenden Rippen","quelle":"engelbrecht1889","seite":"201 (Nr. 180)"},{"merkmal":"kelch_offenheit","wert":"geschlossen","original":"Kelch fast geschlossen","quelle":"engelbrecht1889","seite":"201 (Nr. 180)"},{"merkmal":"kelch_offenheit","wert":"geschlossen","original":"Kelch: starkblättrig, lange grün bleibend, fast geschlossen","quelle":"illustr_hb_1","band":"I","seite":"437 (Nr. 202)"},{"merkmal":"kelchgrube_tiefe","wert":"3","original":"Einsenk. flach, mittelweit","quelle":"engelbrecht1889","seite":"201 (Nr. 180)"},{"merkmal":"kelchgrube_weite","wert":"5","original":"Einsenk. flach, mittelweit","quelle":"engelbrecht1889","seite":"201 (Nr. 180)"},{"merkmal":"kelchgrube_tiefe","wert":"5","original":"sitzt in mäßig tiefer Senkung","quelle":"illustr_hb_1","band":"I","seite":"437 (Nr. 202)"},{"merkmal":"stiel_dicke","wert":"3","original":"Stiel holzig, dünn bis mitteldick, etwa 13 mm l.","quelle":"engelbrecht1889","seite":"201 (Nr. 180)"},{"merkmal":"stiel_dicke","wert":"5","original":"Stiel holzig, dünn bis mitteldick, etwa 13 mm l.","quelle":"engelbrecht1889","seite":"201 (Nr. 180)"},{"merkmal":"stiel_dicke","wert":"3","original":"Stiel: dünn, holzig","quelle":"illustr_hb_1","band":"I","seite":"437 (Nr. 202)"},{"merkmal":"stielgrube_tiefe","wert":"3","original":"Höhle ziemlich flach, mässig weit","quelle":"engelbrecht1889","seite":"201 (Nr. 180)"},{"merkmal":"stielgrube_weite","wert":"5","original":"Höhle ziemlich flach, mässig weit","quelle":"engelbrecht1889","seite":"201 (Nr. 180)"},{"merkmal":"stielgrube_weite","wert":"3","original":"sitzt in enger, nicht tiefer Höhle","quelle":"illustr_hb_1","band":"I","seite":"437 (Nr. 202)"},{"merkmal":"schale_berostung_stielgrube","wert":"0","original":"nicht oder wenig berostet","quelle":"engelbrecht1889","seite":"201 (Nr. 180)"},{"merkmal":"schale_berostung_stielgrube","wert":"3","original":"nicht oder wenig berostet","quelle":"engelbrecht1889","seite":"201 (Nr. 180)"},{"merkmal":"schale_beschaffenheit","wert":"bereift","original":"Schale etwas geschmeidig, beduftet, glänzend","quelle":"engelbrecht1889","seite":"201 (Nr. 180)"},{"merkmal":"schale_beschaffenheit","wert":"glaenzend","original":"Schale etwas geschmeidig, beduftet, glänzend","quelle":"engelbrecht1889","seite":"201 (Nr. 180)"},{"merkmal":"schale_beschaffenheit","wert":"bereift","original":"am Baume stark mit Duft belaufen","quelle":"illustr_hb_1","band":"I","seite":"437 (Nr. 202)"},{"merkmal":"schale_beschaffenheit","wert":"glaenzend","original":"Schale: zart, glänzend","quelle":"illustr_hb_1","band":"I","seite":"437 (Nr. 202)"},{"merkmal":"schale_beschaffenheit","wert":"bereift","original":"Die Schale ist bereift","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Purpurroter_Agatapfel&oldid=266251002"},{"merkmal":"schale_grundfarbe","wert":"gelb","original":"grünlichgelb, später gelb","quelle":"engelbrecht1889","seite":"201 (Nr. 180)"},{"merkmal":"schale_grundfarbe","wert":"gelb","original":"Grundfarbe grünlichgelb, später schön citronengelb","quelle":"illustr_hb_1","band":"I","seite":"437 (Nr. 202)"},{"merkmal":"schale_deckfarbe_anteil","wert":"7","original":"sonnenw. oft weithin dunkelcarmoisinroth, fast ringsum dunkler","quelle":"engelbrecht1889","seite":"201 (Nr. 180)"},{"merkmal":"schale_deckfarbe_anteil","wert":"9","original":"sonnenw. oft weithin dunkelcarmoisinroth, fast ringsum dunkler","quelle":"engelbrecht1889","seite":"201 (Nr. 180)"},{"merkmal":"schale_deckfarbe_farbton","wert":"dunkelrot","original":"dunkelcarmoisinroth, … mehr purpurroth","quelle":"engelbrecht1889","seite":"201 (Nr. 180)"},{"merkmal":"schale_deckfarbe_farbton","wert":"purpurrot","original":"dunkelcarmoisinroth, … mehr purpurroth","quelle":"engelbrecht1889","seite":"201 (Nr. 180)"},{"merkmal":"schale_deckfarbe_art","wert":"gestreift","original":"lang, oft bandartig gestreift","quelle":"engelbrecht1889","seite":"201 (Nr. 180)"},{"merkmal":"schale_deckfarbe_anteil","wert":"9","original":"bei besonnten die ganze Schale mit dunkler Purpurfarbe rein verwaschen (nach Diel)","quelle":"illustr_hb_1","band":"I","seite":"437 (Nr. 202)"},{"merkmal":"schale_deckfarbe_farbton","wert":"purpurrot","original":"mit dunkler Purpurfarbe rein verwaschen","quelle":"illustr_hb_1","band":"I","seite":"437 (Nr. 202)"},{"merkmal":"schale_deckfarbe_art","wert":"verwaschen","original":"mit dunkler Purpurfarbe rein verwaschen","quelle":"illustr_hb_1","band":"I","seite":"437 (Nr. 202)"},{"merkmal":"schale_deckfarbe_art","wert":"gestreift","original":"purpurrothen … bandartigen … Streifen","quelle":"illustr_hb_1","band":"I","seite":"437 (Nr. 202)"},{"merkmal":"schale_deckfarbe_farbton","wert":"purpurrot","original":"intensive rote (purpurne) Farbe und ist gestreift","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Purpurroter_Agatapfel&oldid=266251002"},{"merkmal":"schale_deckfarbe_art","wert":"gestreift","original":"intensive rote (purpurne) Farbe und ist gestreift","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Purpurroter_Agatapfel&oldid=266251002"