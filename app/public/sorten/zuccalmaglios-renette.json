ieder","lizenz":"CC0 1.0","quelle":"commons-fotos","titel":"Zuccalmaglios Renette Freilichtmuseum Roscheider Hof, Knospe H13"}],"munq":56,"akzessionen":[{"sammlung":"UK National Fruit Collection (Brogdale)","nummer":"1949082","name":"Von Zuccalmaglios Renette"}],"farbmessung":[{"bild":"https://upload.wikimedia.org/wikipedia/commons/b/bf/Cross_section_of_Von_Zuccalmaglios_Renette%2C_National_Fruit_Collection_%28acc._1949-082%29.jpg","methode":"NFC-Foto","verfahren":"Foto (NFC-Fototafel: 4 ganze Früchte, 2 Schnitte, Fototisch); Weißabgleich über den Hintergrund; Frucht per Hintergrundmodell freigestellt; Schalenpixel ohne Glanzlichter einzeln klassifiziert: Grundfarbe aus gelbgrünen Pixeln, Deckfarbe = Pixel mit deutlich höherem a* als die Grundfarbe (auch dunkle Rot- und Braunrottöne), Anteile über Pixel; Höhe/Breite aus dem Längsschnitt","grundfarbe":"#bbb24d","deckfarbe":"#b25f46","deckfarbeAnteil":0.29,"fleischfarbe":"#ded4ba","hoeheZuBreite":0.969}],"regionen":[{"region":"DE-NW","art":"herkunft","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Zuccalmaglios_Renette&oldid=237899955"},{"quelle":"engelbrecht1889","seite":"589 (Nr. 532)"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Zuccalmaglios_Renette&oldid=237899955"},{"quelle":"engelbrecht1889","seite":"589 (Nr. 532)"},{"quelle":"rg_bb-pv-sortenempfehlung","seite":"Spalte Besonderheiten/Herkunft"}]},{"region":"DE-BB","art":"empfehlung","belege":[{"quelle":"rg_bb-pv-sortenempfehlung"}],"original":"Zuccalmaglios Renette"},{"region":"DE-BE","art":"empfehlung","belege":[{"quelle":"rg_bb-pv-sortenempfehlung"}],"original":"Zuccalmaglios Renette"},{"region":"DE-SH","art":"empfehlung","belege":[{"quelle":"rg_shhh-pv-sortenempfehlung"}],"original":"Zuccamagliorenette"},{"region":"DE-HH","art":"empfehlung","belege":[{"quelle":"rg_shhh-pv-sortenempfehlung"}],"original":"Zuccamagliorenette"},{"region":"DE-TH","art":"empfehlung","belege":[{"quelle":"rg_th-grue