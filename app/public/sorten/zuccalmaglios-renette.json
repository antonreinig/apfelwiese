{"id":"zuccalmaglios-renette","name":"Zuccalmaglios Renette","synonyme":[{"name":"Von Zuccalmaglios Renette","beleg":{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Zuccalmaglios_Renette&oldid=237899955"}},{"name":"Zuccalmaglio","beleg":{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Zuccalmaglios_Renette&oldid=237899955"}},{"name":"Von Zuccalmaglio's Reinette","beleg":{"quelle":"engelbrecht1889","seite":"589 (Nr. 532)"}}],"herkunft":{"text":"1878 von Diedrich Uhlhorn jun. in Grevenbroich aus einer Kreuzung von Ananasrenette und Purpurrotem Agatapfel gezogen und nach seinem Schwiegervater Vinzenz Jakob von Zuccalmaglio benannt. Uhlhorn gab die Sorte an Schloesser in Ehrenfeld bei Köln weiter, der sie in seinem Verzeichnis 1888/89 führte.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Zuccalmaglios_Renette&oldid=237899955"},{"quelle":"engelbrecht1889","seite":"589 (Nr. 532)"}],"land":"DE","landSicher":true,"ort":"Grevenbroich","jahr":1878},"merkmale":[{"merkmal":"frucht_breite","wert":67,"original":"Gestalt 67:57—58","quelle":"engelbrecht1889","seite":"589 (Nr. 532)"},{"merkmal":"frucht_hoehe","wert":57.5,"original":"Gestalt 67:57—58","quelle":"engelbrecht1889","seite":"589 (Nr. 532)"},{"merkmal":"frucht_hoehe_breite","wert":0.86,"original":"Gestalt 67:57—58","quelle":"engelbrecht1889","seite":"589 (Nr. 532)"},{"merkmal":"frucht_form","wert":"eifoermig","original":"abgest. rundlich eiförm.","quelle":"engelbrecht1889","seite":"589 (Nr. 532)"},{"merkmal":"frucht_breiteste_stelle","wert":"stiel","original":"stielbauch. Stielwölb. etwas breiter als die Kelchw.","quelle":"engelbrecht1889","seite":"589 (Nr. 532)"},{"merkmal":"frucht_symmetrie","wert":"symmetrisch","original":"Hälften gleich","quelle":"engelbrecht1889","seite":"589 (Nr. 532)"},{"merkmal":"frucht_rippung","wert":"1","original":"Querschn. rund","quelle":"engelbrecht1889","seite":"589 (Nr. 532)"},{"merkmal":"frucht_kro