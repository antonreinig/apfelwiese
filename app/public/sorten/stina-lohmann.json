d/Landesgruppen/2009_Stina_Lohmann_Beschreibung.pdf"},{"merkmal":"geschmack_suesse","wert":"5","original":"schmeckt süßsäuerlich","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Stina_Lohmann&oldid=259606008"},{"merkmal":"geschmack_saeure","wert":"5","original":"schmeckt süßsäuerlich","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Stina_Lohmann&oldid=259606008"},{"merkmal":"verwendung","wert":"tafel","original":"als Tafelapfel oder Wirtschaftsapfel","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Stina_Lohmann&oldid=259606008"},{"merkmal":"verwendung","wert":"kueche","original":"Wirtschaftsapfel (als Kochapfel …)","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Stina_Lohmann&oldid=259606008"},{"merkmal":"verwendung","wert":"most","original":"zur Apfelsaftherstellung","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Stina_Lohmann&oldid=259606008"},{"merkmal":"pflueckreife","wert":"10","original":"Pflückreife Mitte bis Ende Oktober","quelle":"web_pomologen_verein","url":"https://www.pomologen-verein.de/media/user_upload/Landesgruppen/2009_Stina_Lohmann_Beschreibung.pdf"},{"merkmal":"genussreife_beginn","wert":"1","original":"zu Beginn des neuen Jahres genussreif","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Stina_Lohmann&oldid=259606008"},{"merkmal":"genussreife_beginn","wert":"2","original":"Genussreife Februar bis Mai","quelle":"web_pomologen_verein","url":"https://www.pomologen-verein.de/media/user_upload/Landesgruppen/2009_Stina_Lohmann_Beschreibung.pdf"},{"merkmal":"genussreife_ende","wert":"5","original":"Genussreife Februar bis Mai","quelle":"web_pomologen_verein","url":"https://www.pomologen-verein.de/media/user_upload/Landesgruppen/2009_Stina_Lohmann_Beschreibung.pdf"},{"merkmal":"baum_wuchs","wert":"7","original":"robust und stark wachsend","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Stina_Lohmann&oldid=259606008"},{"merkmal":"baum_wuchs","wert":"5","original":"mittelstark bis stark wachsend","quelle":"web_pomologen_verein","url":"https://www.pomologen-verein.de/media/user_upload/Landesgruppen/2009_Stina_Lohmann_Beschreibung.pdf"},{"merkmal":"frucht_breite","wert":78,"quelle":"nfc2025","seite":"Akzession 1951202 (NFC-Früchte)"},{"merkmal":"frucht_hoehe","wert":63.3,"quelle":"nfc2025","seite":"Akzession 1951202 (NFC-Früchte)"},{"merkmal":"frucht_groesse","wert":"7","quelle":"nfc2025","seite":"Akzession 1951202 (NFC-Früchte)","original":"Large"},{"merkmal":"frucht_form","wert":"flachrund","quelle":"nfc2025","seite":"Akzession 1951202 (NFC-Früchte)","original":"Flat globose"},{"merkmal":"frucht_hoehe_breite","wert":0.812,"quelle":"nfc2025","seite":"Akzession 1951202 (NFC-Früchte)"},{"merkmal":"frucht_rippung","wert":"5","quelle":"nfc2025","seite":"Akzession 1951202 (NFC-Früchte)","original":"Medium"},{"merkmal":"frucht_kronung","wert":"1","quelle":"nfc2025","seite":"Akzession 1951202 (NFC-Früchte)","original":"Weak to medium"},{"merkmal":"frucht_kronung","wert":"5","quelle":"nfc2025","seite":"Akzession 1951202 (NFC-Früchte)","original":"Weak to medium"},{"merkmal":"schale_grundfarbe","wert":"weisslichgelb","quelle":"nfc2025","seite":"Akzession 1951202 (NFC-Früchte)","original":"Whitish yellow"},{"merkmal":"schale_deckfarbe_anteil","wert":"3","quelle":"nfc2025","seite":"Akzession 1951202 (NFC-Früchte)","original":"Low to medium"},{"merkmal":"schale_deckfarbe_anteil","wert":"5","quelle":"nfc2025","seite":"Akzession 1951202 (NFC-Früchte)","original":"Low to medium"},{"merkmal":"schale_deckfarbe_farbton","wert":"orange","quelle":"nfc2025","seite":"Akzession 1951202 (NFC-Früchte)","original":"Orange"},{"merkmal":"schale_deckfarbe_art","wert":"gestreift","quelle":"nfc2025","seite":"Akzession 1951202 (NFC-Früchte)","original":"Flush with stripes"},{"merkmal":"schale_deckfarbe_art","wert":"verwaschen","quelle":"nfc2025","seite":"Akzession 1951202 (NFC-Früchte)","original":"Flush with stripes"},{"merkmal":"schale_berostung_gesamt","wert":"3","quelle":"nfc2025","seite":"Akzession 1951202 (NFC-Früchte)","original":"Low"},{"merkmal":"fleisch_farbe","wert":"cremeweiss","quelle":"nfc2025","seite":"Akzession 1951202 (NFC-Früchte)","original":"Cream"},{"merkmal":"fleisch_festigkeit","wert":"5","quelle":"nfc2025","seite":"Akzession 1951202 (Verkostung P. Hale, 01/11/2023)","original":"Intermediate"},{"merkmal":"fleisch_saftigkeit","wert":"5","quelle":"nfc2025","seite":"Akzession 1951202 (Verkostung P. Hale, 01/11/2023)","original":"Intermediate"},{"merkmal":"geschmack_suesse","wert":"5","quelle":"nfc2025","seite":"Akzession 1951202 (Verkostung P. Hale, 01/11/2023)","original":"Intermediate to high"},{"merkmal":"geschmack_suesse","wert":"7","quelle":"nfc2025","seite":"Akzession 1951202 (Verkostung P. Hale, 01/11/2023)","original":"Intermediate to high"},{"merkmal":"geschmack_saeure","wert":"5","quelle":"nfc2025","seite":"Akzession 1951202 (Verkostung P. Hale, 01/11/2023)","original":"Intermediate"},{"merkmal":"verwendung","wert":"tafel","quelle":"nfc2025","seite":"Akzession 1951202","original":"Dessert"},{"merkmal":"pflueckreife","wert":"10","quelle":"nfc2025","seite":"Akzession 1951202","original":"Early October"},{"merkmal":"genussreife_ende","wert":"3","quelle":"nfc2025","seite":"Akzession 1951202","original":"March"},{"merkmal":"bluete_zeit","wert":"5","quelle":"nfc2025","seite":"Akzession 1951202","original":"Klasse 5 (10 % der Blüten offen, Tag 128)"}],"texte":[{"thema":"ueberblick","text":"Stina Lohmann ist eine holsteinische Lokalsorte, die als Dauer- und Lagerapfel bekannt ist. Die Früchte werden im Oktober gepflückt und erst im neuen Jahr genussreif. Die Sorte ist in Schleswig-Holstein und im westlichen Mecklenburg verbreitet und wurde 2009 zur Streuobstsorte des Jahres in Norddeutschland gewählt.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Stina_Lohmann&oldid=259606008"},{"quelle":"web_pomologen_verein","url":"https://www.pomologen-verein.de/media/user_upload/Landesgruppen/2009_Stina_Lohmann_Beschreibung.pdf"}]},{"thema":"herkunft","text":"Die Sorte entstand um 1800 als Zufallssämling im Garten von Christina („Stina“) Lohmann in Kellinghusen in Holstein. Nach der Überlieferung konnte sie dank der langen Haltbarkeit ihrer Äpfel noch im Frühjahr Früchte verschenken, als das Lagerobst der Nachbarn schon verdorben war. Nach ihrem Tod 1860 erhielt die Sorte ihren Namen. Das Sortenblatt der Norddeutschen Apfeltage nennt als Hauptverbreitungsgebiet das mittlere Holstein auf Geestböden.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Stina_Lohmann&oldid=259606008"},{"quelle":"web_pomologen_verein","url":"https://www.pomologen-verein.de/media/user_upload/Landesgruppen/2009_Stina_Lohmann_Beschreibung.pdf"}]},{"thema":"frucht","text":"Die Frucht ist mittelgroß bis groß und flachrund, oft etwas unregelmäßig; um den Kelch zeigt sie leichte Rippen. Wikipedia beschreibt die Form als breitkugelig-flach.","belege":[{"quelle":"web_pomologen_verein","url":"https://www.pomologen-verein.de/media/user_upload/Landesgruppen/2009_Stina_Lohmann_Beschreibung.pdf"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Stina_Lohmann&oldid=259606008"}]},{"thema":"schale","text":"Die Schale ist glatt. Das Sortenblatt der Norddeutschen Apfeltage nennt eine gelbe Grundfarbe mit teilweise rosafarbener Deckfarbe und geflammten roten Strichen; Wikipedia beschreibt die Grundfarbe als grüngelb mit roter, streifiger Deckfarbe. Die Stielgrube ist sternförmig berostet.","belege":[{"quelle":"web_pomologen_verein","url":"https://www.pomologen-verein.de/media/user_upload/Landesgruppen/2009_Stina_Lohmann_Beschreibung.pdf"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Stina_Lohmann&oldid=259606008"}]},{"thema":"fleisch_geschmack","text":"Die Angaben zum Fruchtfleisch gehen auseinander: Wikipedia beschreibt es als weiß, fest und saftig, das Sortenblatt der Norddeutschen Apfeltage als hellgelb und etwas trocken. Übereinstimmend wird der Geschmack als süßsäuerlich und aromatisch angegeben, nach Wikipedia mit leichtem Aroma.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Stina_Lohmann&oldid=259606008"},{"quelle":"web_pomologen_verein","url":"https://www.pomologen-verein.de/media/user_upload/Landesgruppen/2009_Stina_Lohmann_Beschreibung.pdf"}]},{"thema":"reife_lagerung","text":"Gepflückt wird ab Oktober, nach dem Sortenblatt Mitte bis Ende Oktober. Genussreif wird die Frucht zu Beginn des neuen Jahres, nach dem Sortenblatt im Februar; sie hält bis Mai und lässt sich nach Wikipedia bis in den Juli lagern. Das Sortenblatt zählt sie zu den besten Lageräpfeln der Region.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Stina_Lohmann&oldid=259606008"},{"quelle":"web_pomologen_verein","url":"https://www.pomologen-verein.de/media/user_upload/Landesgruppen/2009_Stina_Lohmann_Beschreibung.pdf"}]},{"thema":"baum","text":"Der Baum gilt als robust und stark wachsend; das Sortenblatt der Norddeutschen Apfeltage nennt mittelstarken bis starken Wuchs. Er stellt geringe Ansprüche an den Boden und wächst auch auf leichten Sandböden. Der Ertrag setzt mittelspät ein, ist dann aber gut und reichlich.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Stina_Lohmann&oldid=259606008"},{"quelle":"web_pomologen_verein","url":"https://www.pomologen-verein.de/media/user_upload/Landesgruppen/2009_Stina_Lohmann_Beschreibung.pdf"}]},{"thema":"verwendung","text":"Stina Lohmann wird als Tafelapfel gegessen und als Wirtschaftsapfel zum Kochen und für Apfelsaft verwendet. Heute wird sie vor allem als Liebhabersorte zur Selbstversorgung angebaut.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Stina_Lohmann&oldid=259606008"},{"quelle":"web_pomologen_verein","url":"https://www.pomologen-verein.de/media/user_upload/Landesgruppen/2009_Stina_Lohmann_Beschreibung.pdf"}]},{"thema":"unterscheidung","text":"Nach Wikipedia wird die Sorte von Baumschulen häufig unter dem Namen Korbiniansapfel verkauft; der echte Korbiniansapfel gilt als möglicherweise verschollen.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Stina_Lohmann&oldid=259606008"}]},{"thema":"frucht","text":"Nach den Erhebungen der National Fruit Collection: große, flachrunde Frucht mit weißlich gelber Grundfarbe und flächiger und gestreifter orangefarbener Deckfarbe auf einem kleinen bis mittleren Teil der Schale. Die Schale ist wenig berostet, das Fruchtfleisch cremefarben. Das Fleisch ist mittelfest und mäßig saftig; im Geschmack mäßig bis deutlich süß und mäßig sauer, mit schwachem bis mittlerem Aroma. In der Sammlung als Tafelapfel geführt; pflückreif Anfang Oktober, lagerfähig bis März.","belege":[{"quelle":"nfc2025","seite":"Akzession 1951202"}]}],"bilder":[{"url":"https://upload.wikimedia.org/wikipedia/commons/8/8a/Malus_-_Stina_Lohmann.JPG","seite":"https://commons.wikimedia.org/wiki/File:Malus_-_Stina_Lohmann.JPG","art":"frucht","urheber":"Genet","lizenz":"CC BY-SA 3.0","quelle":"commons","titel":"Malus - Stina Lohmann.JPG"},{"url":"https://upload.wikimedia.org/wikipedia/commons/a/a0/Cross_section_of_Stina_Lohmann%2C_National_Fruit_Collection_%28acc._1951-202%29.jpg","seite":"https://commons.wikimedia.org/wiki/File:Cross_section_of_Stina_Lohmann,_National_Fruit_Collection_(acc._1951-202).jpg","art":"schnitt","urheber":"National Fruit Collection, Brogdale","lizenz":"OGL 2.0","quelle":"nfc-commons","titel":"Cross section of Stina Lohmann, National Fruit Collection (acc. 1951-202)"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/3/38/Korbinian_Aigner_Denkmal_Karlsfeld_vor_der_Korneliuskirche_Nahansicht.jpg/960px-Korbinian_Aigner_Denkmal_Karlsfeld_vor_der_Korneliuskirche_Nahansicht.jpg","seite":"https://commons.wikimedia.org/wiki/File:Korbinian_Aigner_Denkmal_Karlsfeld_vor_der_Korneliuskirche_Nahansicht.jpg","art":"frucht","urheber":"Wikitarisch","lizenz":"CC BY-SA 4.0","quelle":"commons-fotos","titel":"Korbinian Aigner Denkmal Karlsfeld vor der Korneliuskirche Nahansicht"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/5/59/Malus_Korbiniansapfel_4415.jpg/960px-Malus_Korbiniansapfel_4415.jpg","seite":"https://commons.wikimedia.org/wiki/File:Malus_Korbiniansapfel_4415.jpg","art":"frucht","urheber":"Sven Teschke","lizenz":"CC BY-SA 3.0 DE","quelle":"commons-fotos","titel":"Malus Korbiniansapfel 4415"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/85/DO-Korbiniansapfelbaum.jpg/960px-DO-Korbiniansapfelbaum.jpg","seite":"https://commons.wikimedia.org/wiki/File:DO-Korbiniansapfelbaum.jpg","art":"baum","urheber":"Dat doris","lizenz":"CC BY-SA 4.0","quelle":"commons-fotos","titel":"DO-Korbiniansapfelbaum"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/6/6d/DO-Korbiniansapfelbaum_Schild.jpg/960px-DO-Korbiniansapfelbaum_Schild.jpg","seite":"https://commons.wikimedia.org/wiki/File:DO-Korbiniansapfelbaum_Schild.jpg","art":"baum","urheber":"Dat doris","lizenz":"CC BY-SA 4.0","quelle":"commons-fotos","titel":"DO-Korbiniansapfelbaum Schild"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/2/21/Korbinians_Apfel_jm55225.jpg/960px-Korbinians_Apfel_jm55225.jpg","seite":"https://commons.wikimedia.org/wiki/File:Korbinians_Apfel_jm55225.jpg","art":"baum","urheber":"joergens.mi","lizenz":"CC BY-SA 3.0","quelle":"commons-fotos","titel":"Korbinians Apfel jm55225"}],"munq":2886,"akzessionen":[{"sammlung":"UK National Fruit Collection (Brogdale)","nummer":"1951202","name":"Stina Lohmann"}],"farbmessung":[{"bild":"https://upload.wikimedia.org/wikipedia/commons/a/a0/Cross_section_of_Stina_Lohmann%2C_National_Fruit_Collection_%28acc._1951-202%29.jpg","methode":"NFC-Foto","verfahren":"Foto (NFC-Fototafel: 4 ganze Früchte, 2 Schnitte, Fototisch); Weißabgleich über den Hintergrund; Frucht per Hintergrundmodell freigestellt; Schalenpixel ohne Glanzlichter einzeln klassifiziert: Grundfarbe aus gelbgrünen Pixeln, Deckfarbe = Pixel mit deutlich höherem a* als die Grundfarbe (auch dunkle Rot- und Braunrottöne), Anteile über Pixel; Höhe/Breite aus dem Längsschnitt","grundfarbe":"#d9be4a","deckfarbe":"#b2513d","deckfarbeAnteil":0.48,"rostfarbe":"#937245","fleischfarbe":"#e9dbc0","hoeheZuBreite":0.808}]}