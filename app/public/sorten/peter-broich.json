l":"schale_lentizellen_art","wert":"braun","original":"Punkte … braun, oft gelblich umflossen","quelle":"engelbrecht1889","seite":"580 (Nr. 523)"},{"merkmal":"schale_lentizellen_art","wert":"sternfoermig","original":"sternförmige, hellbraune Rostpunkte sind auf der ganzen Frucht zerstreut","quelle":"lauche_erg1883","seite":"104 (Nr. 741)"},{"merkmal":"schale_berostung_wangen","wert":"3","original":"Anflüge von Rost kommen zuweilen vor","quelle":"engelbrecht1889","seite":"580 (Nr. 523)"},{"merkmal":"kernhaus_form","wert":"zwiebel","original":"Kernhaus 40:37, länglich zwiebelf.","quelle":"engelbrecht1889","seite":"580 (Nr. 523)"},{"merkmal":"kernfaecher_oeffnung","wert":"teilweise","original":"Kammern 11:23 … mässig geräumig, etwas, oft ziemlich weit offen","quelle":"engelbrecht1889","seite":"580 (Nr. 523)"},{"merkmal":"kernfaecher_oeffnung","wert":"offen","original":"Kammern 11:23 … mässig geräumig, etwas, oft ziemlich weit offen","quelle":"engelbrecht1889","seite":"580 (Nr. 523)"},{"merkmal":"kernhaus_achse","wert":"offen","original":"Achsenh. schmal bis mittelbreit","quelle":"engelbrecht1889","seite":"580 (Nr. 523)"},{"merkmal":"kernhaus_achse","wert":"offen","original":"Kernhaus: hohlachsig","quelle":"lauche_erg1883","seite":"104 (Nr. 741)"},{"merkmal":"kerne_form","wert":"eifoermig","original":"Kerne zu 1 bis 2, mittelgross, länglich eiförmig, lang gespitzt","quelle":"engelbrecht1889","seite":"580 (Nr. 523)"},{"merkmal":"kelchhoehle_form","wert":"trichter_lang","original":"Kelchhöhle kegeltrichterf., ½ zur Achsenh., auch kürzer","quelle":"engelbrecht1889","seite":"580 (Nr. 523)"},{"merkmal":"kelchhoehle_form","wert":"trichter_kurz","original":"Kelchhöhle kegeltrichterf., ½ zur Achsenh., auch kürzer","quelle":"engelbrecht1889","seite":"580 (Nr. 523)"},{"merkmal":"kelchhoehle_form","wert":"dreieck_breit","original":"Kelchröhre kurz-kegelförmig","quelle":"lauche_erg1883","seite":"104 (Nr. 741)"},{"merkmal":"fleisch_farbe","wert":"cremeweiss","original":"Fleisch gelb