{"id":"rosa-claussen","name":"Rosa Claussen","synonyme":[{"name":"Dithmarscher Borsdorfer","beleg":{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Rosa_Claussen&oldid=152863259"}},{"name":"Hanna Claussen","beleg":{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Rosa_Claussen&oldid=152863259"}},{"name":"Jungferntitt","beleg":{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Rosa_Claussen&oldid=152863259"}}],"herkunft":{"text":"Dithmarschen (Schleswig-Holstein); vermutlich um 1910 als Zufallssämling in einem Knick entstanden. Die Namensgeberin lebte in Wrohm.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Rosa_Claussen&oldid=152863259"}],"land":"DE","landSicher":true,"ort":"Dithmarschen (Wrohm)","jahr":1910},"merkmale":[{"merkmal":"frucht_groesse","wert":"5","original":"Die Früchte werden mittelgroß","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Rosa_Claussen&oldid=152863259"},{"merkmal":"stiel_laenge","wert":"3","original":"Der Fruchtstiel ist kurz","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Rosa_Claussen&oldid=152863259"},{"merkmal":"stielgrube_tiefe","wert":"7","original":"einer tiefen Stielgrube","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Rosa_Claussen&oldid=152863259"},{"merkmal":"schale_deckfarbe_anteil","wert":"9","original":"später zu einer roten Schale","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Rosa_Claussen&oldid=152863259"},{"merkmal":"schale_deckfarbe_farbton","wert":"rot","original":"roten Streifen …, später … roten Schale","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Rosa_Claussen&oldid=152863259"},{"merkmal":"schale_deckfarbe_art","wert":"gestreift","original":"mit roten Streifen auf der Sonnenseite","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Rosa_Claussen&oldid=152863259"},{"merkmal":"schale_lentizellen_art","wert":"hell","original":"mit hellen Punkten auf der Schale","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Rosa_Claussen&oldid=152863259"},{"merkmal":"fleisch_farbe","wert":"gelblich","original":"Das „Fruchtfleisch“ ist gelblich","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Rosa_Claussen&oldid=152863259"},{"merkmal":"geschmack_saeure","wert":"5","original":"wohlschmeckend, mild-säuerlich mit ausgeprägtem Aroma","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Rosa_Claussen&oldid=152863259"},{"merkmal":"geschmack_aroma","wert":"ausgeprägtes Aroma","original":"mild-säuerlich mit ausgeprägtem Aroma","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Rosa_Claussen&oldid=152863259"},{"merkmal":"verwendung","wert":"tafel","original":"eine Tafelapfel-Sorte aus Dithmarschen","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Rosa_Claussen&oldid=152863259"},{"merkmal":"genussreife_beginn","wert":"9","original":"von Ende September bis in den Februar genussreif","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Rosa_Claussen&oldid=152863259"},{"merkmal":"genussreife_ende","wert":"2","original":"von Ende September bis in den Februar genussreif","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Rosa_Claussen&oldid=152863259"},{"merkmal":"lagerfaehigkeit","wert":"5","original":"Genussreif ist der Apfel von Ende September bis in den Februar.","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Rosa_Claussen&oldid=152863259"},{"merkmal":"anfaelligkeit_krebs","wert":"3","original":"Die Sorte gilt als krebsfrei","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Rosa_Claussen&oldid=152863259"}],"texte":[{"thema":"ueberblick","text":"Tafelapfel aus Dithmarschen, entstanden vermutlich um 1910. Die mittelgroße Frucht färbt sich von gelbgrün mit roten Streifen zu einer fast ganz roten Schale um; das gelbliche Fleisch schmeckt mild säuerlich und aromatisch. In den pomologischen Werken des 19. Jahrhunderts kommt die Sorte nicht vor.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Rosa_Claussen&oldid=152863259"}]},{"thema":"herkunft","text":"Die Sorte entstand nach Wikipedia vermutlich um 1910 als Zufallssämling in einem Knick in Dithmarschen. Ihre Namensgeberin lebte in Wrohm, einer Gemeinde mit altem Obstbaumbestand. Weitere Namen sind Dithmarscher Borsdorfer, Hanna Claussen und Jungferntitt. 2015 wurde sie als Apfelsorte des Jahres herausgestellt.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Rosa_Claussen&oldid=152863259"}]},{"thema":"frucht","text":"Die Früchte sind mittelgroß. Der kurze Stiel ragt kaum über die Frucht hinaus und sitzt in einer tiefen Stielgrube.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Rosa_Claussen&oldid=152863259"}]},{"thema":"schale","text":"Die Schale ist eben, zu Beginn gelbgrün mit roten Streifen auf der Sonnenseite, später rot mit hellen Schalenpunkten.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Rosa_Claussen&oldid=152863259"}]},{"thema":"fleisch_geschmack","text":"Das Fleisch ist gelblich und schmeckt mild säuerlich mit ausgeprägtem Aroma.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Rosa_Claussen&oldid=152863259"}]},{"thema":"reife_lagerung","text":"Genussreif ist der Apfel von Ende September bis in den Februar.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Rosa_Claussen&oldid=152863259"}]},{"thema":"baum","text":"Die Sorte gilt als krebsfrei und bildet große, gut verzweigte Bäume.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Rosa_Claussen&oldid=152863259"}]}],"bilder":[],"regionen":[{"region":"DE-SH","art":"herkunft","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Rosa_Claussen&oldid=152863259"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Rosa_Claussen&oldid=152863259"}]},{"region":"DE-SH","art":"empfehlung","belege":[{"quelle":"rg_shhh-pv-sortenempfehlung"}],"original":"Rosa Claußen Apfel"},{"region":"DE-HH","art":"empfehlung","belege":[{"quelle":"rg_shhh-pv-sortenempfehlung"}],"original":"Rosa Claußen Apfel"}],"gefaehrdung":[{"stufe":"Rote Liste der gefährdeten einheimischen Nutzpflanzen in Deutschland","belege":[{"quelle":"rg_ble-rote-liste"}],"original":"Dithmarscher Borsdorfer"}]}