{"id":"purpurroter-cousinot","name":"Purpurroter Cousinot","synonyme":[{"name":"Červené tvrdé","beleg":{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Purpurroter_Cousinot&oldid=258880903"}},{"name":"Purpurröd Cousinot","beleg":{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Purpurroter_Cousinot&oldid=258880903"}}],"herkunft":{"text":"Genauer Ursprung unbekannt. Die heute unter diesem Namen verbreitete Sorte geht nach Wikipedia auf den Reisermuttergarten Magdeburg zurück und ist dort seit den 1920er Jahren verbreitet; sie gilt als nicht identisch mit Diels historischem Purpurroten Wintercousinot.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Purpurroter_Cousinot&oldid=258880903"}],"land":"DE","landSicher":false,"ort":"Reisermuttergarten Magdeburg","jahr":1920},"merkmale":[{"merkmal":"frucht_groesse","wert":"5","original":"Der Apfel wird mittelgroß, meist kleiner als 8 cm im Durchmesser","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Purpurroter_Cousinot&oldid=258880903"},{"merkmal":"frucht_form","wert":"rund","original":"eine runde, meist regelmäßige, hochgebaute Form","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Purpurroter_Cousinot&oldid=258880903"},{"merkmal":"frucht_symmetrie","wert":"symmetrisch","original":"eine runde, meist regelmäßige, hochgebaute Form","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Purpurroter_Cousinot&oldid=258880903"},{"merkmal":"schale_beschaffenheit","wert":"glatt","original":"Die glatte Schale","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Purpurroter_Cousinot&oldid=258880903"},{"merkmal":"schale_grundfarbe","wert":"gelbgruen","original":"gelblichgrüne bis gelbe Grundfarbe","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Purpurroter_Cousinot&oldid=258880903"},{"merkmal":"schale_grundfarbe","wert":"gelb","original":"gelblichgrüne bis gelbe Grundfarbe","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Purpurroter_Cousinot&oldid=258880903"},{"merkmal":"schale_deckfarbe_farbton","wert":"rot","original":"mit einer meist intensiv roten Deckfarbe","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Purpurroter_Cousinot&oldid=258880903"},{"merkmal":"schale_lentizellen_anzahl","wert":"3","original":"weist eine leichte Punktierung (Lentizellen) auf","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Purpurroter_Cousinot&oldid=258880903"},{"merkmal":"fleisch_farbe","wert":"weiss","original":"ein weißes bis hellgelbliches z. T. von einer rot gefärbten Äderung durchzogenes Fruchtfleisch","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Purpurroter_Cousinot&oldid=258880903"},{"merkmal":"fleisch_farbe","wert":"cremeweiss","original":"ein weißes bis hellgelbliches z. T. von einer rot gefärbten Äderung durchzogenes Fruchtfleisch","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Purpurroter_Cousinot&oldid=258880903"},{"merkmal":"geschmack_aroma","wert":"erfrischend, aromatisch","original":"einen erfrischenden, aromatischen Geschmack","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Purpurroter_Cousinot&oldid=258880903"},{"merkmal":"pflueckreife","wert":"10","original":"Der Apfel ist im Oktober pflückreif","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Purpurroter_Cousinot&oldid=258880903"},{"merkmal":"genussreife_beginn","wert":"12","original":"die Genussreife erreicht er spätestens im Dezember","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Purpurroter_Cousinot&oldid=258880903"},{"merkmal":"verwendung","wert":"tafel","original":"früher als Tafel- und Wirtschaftsapfel genutzt","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Purpurroter_Cousinot&oldid=258880903"},{"merkmal":"verwendung","wert":"kueche","original":"früher als Tafel- und Wirtschaftsapfel genutzt","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Purpurroter_Cousinot&oldid=258880903"},{"merkmal":"frucht_breite","wert":66.8,"quelle":"nfc2025","seite":"Akzession 1958064 (NFC-Früchte)"},{"merkmal":"frucht_hoehe","wert":62.1,"quelle":"nfc2025","seite":"Akzession 1958064 (NFC-Früchte)"},{"merkmal":"frucht_groesse","wert":"5","quelle":"nfc2025","seite":"Akzession 1958064 (NFC-Früchte)","original":"Medium"},{"merkmal":"frucht_form","wert":"walzenfoermig","quelle":"nfc2025","seite":"Akzession 1958064 (NFC-Früchte)","original":"Oblong"},{"merkmal":"frucht_hoehe_breite","wert":0.93,"quelle":"nfc2025","seite":"Akzession 1958064 (NFC-Früchte)"},{"merkmal":"frucht_rippung","wert":"1","quelle":"nfc2025","seite":"Akzession 1958064 (NFC-Früchte)","original":"Very light"},{"merkmal":"frucht_kronung","wert":"1","quelle":"nfc2025","seite":"Akzession 1958064 (NFC-Früchte)","original":"Absent or very weak"},{"merkmal":"schale_grundfarbe","wert":"gruengelb","quelle":"nfc2025","seite":"Akzession 1958064 (NFC-Früchte)","original":"Green yellow"},{"merkmal":"schale_deckfarbe_anteil","wert":"5","quelle":"nfc2025","seite":"Akzession 1958064 (NFC-Früchte)","original":"Medium to high"},{"merkmal":"schale_deckfarbe_anteil","wert":"7","quelle":"nfc2025","seite":"Akzession 1958064 (NFC-Früchte)","original":"Medium to high"},{"merkmal":"schale_deckfarbe_farbton","wert":"rot","quelle":"nfc2025","seite":"Akzession 1958064 (NFC-Früchte)","original":"Red"},{"merkmal":"schale_deckfarbe_art","wert":"gestreift","quelle":"nfc2025","seite":"Akzession 1958064 (NFC-Früchte)","original":"Only stripes"},{"merkmal":"schale_berostung_gesamt","wert":"3","quelle":"nfc2025","seite":"Akzession 1958064 (NFC-Früchte)","original":"Low to medium"},{"merkmal":"schale_berostung_gesamt","wert":"5","quelle":"nfc2025","seite":"Akzession 1958064 (NFC-Früchte)","original":"Low to medium"},{"merkmal":"fleisch_farbe","wert":"cremeweiss","quelle":"nfc2025","seite":"Akzession 1958064 (NFC-Früchte)","original":"Cream"},{"merkmal":"verwendung","wert":"tafel","quelle":"nfc2025","seite":"Akzession 1958064","original":"Dessert"},{"merkmal":"pflueckreife","wert":"10","quelle":"nfc2025","seite":"Akzession 1958064","original":"Mid October"},{"merkmal":"genussreife_ende","wert":"3","quelle":"nfc2025","seite":"Akzession 1958064","original":"March"},{"merkmal":"bluete_zeit","wert":"5","quelle":"nfc2025","seite":"Akzession 1958064","original":"Klasse 5 (10 % der Blüten offen, Tag 126)"},{"merkmal":"lagerfaehigkeit","wert":"7","original":"hält er sich bis zum Ende des Frühjahrs oder bis in den Frühsommer","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Purpurroter_Cousinot&oldid=258880903"},{"merkmal":"hochstamm","wert":"gut","original":"Als Hoch- oder Halbstamm bildet die Sorte","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Purpurroter_Cousinot&oldid=258880903"},{"merkmal":"standort_boden","wert":"3","original":"Sie ist anspruchslos","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Purpurroter_Cousinot&oldid=258880903"},{"merkmal":"standort_klima","wert":"3","original":"gedeiht auch in kalten Gegenden","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Purpurroter_Cousinot&oldid=258880903"},{"merkmal":"bluete_frost","wert":"3","original":"lang andauernden, wenig empfindlichen Blüte","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Purpurroter_Cousinot&oldid=258880903"}],"texte":[{"thema":"ueberblick","text":"Alter Winterapfel mit mittelgroßen, runden, hochgebauten Früchten und meist intensiv roter Deckfarbe. Wegen dieser Farbe, die sich durch Polieren noch hervorheben lässt, gehört die Sorte zu den Weihnachtsäpfeln und wurde und wird als Christbaumschmuck verwendet. Heute wird sie als Liebhabersorte und im Streuobst angebaut.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Purpurroter_Cousinot&oldid=258880903"}]},{"thema":"herkunft","text":"Der genaue Ursprung ist nicht bekannt. Nach Wikipedia stammt die heute unter dem Namen Purpurroter Cousinot verbreitete Sorte vom Reisermuttergarten Magdeburg und ist seit den 1920er Jahren in Umlauf. Sie soll nicht identisch sein mit einer verschollenen Sorte, die Diel 1813 als Englische Büschelrenette und 1828 als Purpurroten Wintercousinot beschrieb.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Purpurroter_Cousinot&oldid=258880903"}]},{"thema":"frucht","text":"Die Frucht ist mittelgroß, meist unter 8 cm im Durchmesser, rund, meist regelmäßig und hoch gebaut. Angaben zu Kelch, Stiel und Längsschnitt der heutigen Sorte liegen im ausgewerteten Material nicht vor.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Purpurroter_Cousinot&oldid=258880903"}]},{"thema":"schale","text":"Die Schale ist glatt, auf gelblich grünem bis gelbem Grund meist intensiv rot gefärbt und nur leicht punktiert. Die Röte lässt sich durch Polieren zum Glänzen bringen.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Purpurroter_Cousinot&oldid=258880903"}]},{"thema":"fleisch_geschmack","text":"Das Fleisch ist weiß bis hell gelblich und teilweise von roten Adern durchzogen. Der Geschmack wird als erfrischend und aromatisch beschrieben.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Purpurroter_Cousinot&oldid=258880903"}]},{"thema":"reife_lagerung","text":"Gepflückt wird im Oktober, genussreif ist der Apfel spätestens im Dezember. Bei guter Lagerung hält er sich bis zum Ende des Frühjahrs oder bis in den Frühsommer.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Purpurroter_Cousinot&oldid=258880903"}]},{"thema":"baum","text":"Als Hoch- oder Halbstamm bildet die Sorte eine breite, kugelige, dicht verzweigte Krone. Sie ist anspruchslos, gedeiht auch in kalten Gegenden und setzt dank einer lang andauernden, wenig empfindlichen Blüte meist gut Früchte an.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Purpurroter_Cousinot&oldid=258880903"}]},{"thema":"verwendung","text":"Früher wurde die Sorte als Tafel- und Wirtschaftsapfel genutzt; wegen ihrer Farbe dient sie auch als Weihnachtsbaumschmuck.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Purpurroter_Cousinot&oldid=258880903"}]},{"thema":"unterscheidung","text":"Engelbrecht (1889, Nr. 506) und das Illustrirte Handbuch (Bd. IV, Nr. 383) beschreiben unter dem Namen Purpurroter Cousinot den Purpurroten Winter-Cousinot Diels; das Handbuch setzt ihn mit Diels Englischer Büschelreinette gleich. Nach Wikipedia handelt es sich dabei um eine andere, heute verschollene Sorte. Ob die historischen Beschreibungen auf die heute verbreitete Sorte passen, ist ungeklärt; ihre Angaben sind deshalb hier nicht übernommen.","belege":[{"quelle":"engelbrecht1889","seite":"559 (Nr. 506)"},{"quelle":"illustr_hb_4","band":"IV","seite":"243 (Nr. 383)"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Purpurroter_Cousinot&oldid=258880903"}]},{"thema":"frucht","text":"Nach den Erhebungen der National Fruit Collection: die Sorte bildet mittelgroße, walzenförmige Früchte mit grünlich gelber Grundfarbe und gestreifter roter Deckfarbe auf einem mittleren bis großen Teil der Schale. Das Fruchtfleisch ist cremefarben, die Schale wenig bis mäßig berostet. Tafelapfel, pflückreif Mitte Oktober und lagerfähig bis März.","belege":[{"quelle":"nfc2025","seite":"Akzession 1958064"}]}],"bilder":[{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/e/e5/Malus_Purpurroter_Cousinot_4308.jpg/960px-Malus_Purpurroter_Cousinot_4308.jpg","seite":"https://commons.wikimedia.org/wiki/File:Malus_Purpurroter_Cousinot_4308.jpg","art":"frucht","urheber":"Sven Teschke","lizenz":"CC BY-SA 3.0 de","quelle":"commons","titel":"Malus Purpurroter Cousinot 4308.jpg"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/5/51/Deutsche_Pomologie_-_Aepfel_-_009.jpg/960px-Deutsche_Pomologie_-_Aepfel_-_009.jpg","seite":"https://commons.wikimedia.org/wiki/File:Deutsche_Pomologie_-_Aepfel_-_009.jpg","art":"tafel","urheber":"Wilhelm Lauche (Deutsche Pomologie, 1882)","lizenz":"gemeinfrei","quelle":"lauche_dp1882","titel":"Deutsche Pomologie - Aepfel - 009.jpg (Purpurrother Cousinot)"},{"url":"https://upload.wikimedia.org/wikipedia/commons/6/60/Cross_section_of_Purpurroter_Cousinot%2C_National_Fruit_Collection_%28acc._1958-064%29.jpg","seite":"https://commons.wikimedia.org/wiki/File:Cross_section_of_Purpurroter_Cousinot,_National_Fruit_Collection_(acc._1958-064).jpg","art":"schnitt","urheber":"National Fruit Collection, Brogdale","lizenz":"OGL 2.0","quelle":"nfc-commons","titel":"Cross section of Purpurroter Cousinot, National Fruit Collection (acc. 1958-064)"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/e/ea/Apfel_Purpurroter_Cousinot_%281%29.jpg/960px-Apfel_Purpurroter_Cousinot_%281%29.jpg","seite":"https://commons.wikimedia.org/wiki/File:Apfel_Purpurroter_Cousinot_(1).jpg","art":"frucht","urheber":"Hinnerk11","lizenz":"CC BY-SA 4.0","quelle":"commons-fotos","titel":"Apfel Purpurroter Cousinot (1)"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/2/2f/Apfel_Purpurroter_Cousinot_%282%29.jpg/960px-Apfel_Purpurroter_Cousinot_%282%29.jpg","seite":"https://commons.wikimedia.org/wiki/File:Apfel_Purpurroter_Cousinot_(2).jpg","art":"frucht","urheber":"Hinnerk11","lizenz":"CC BY-SA 4.0","quelle":"commons-fotos","titel":"Apfel Purpurroter Cousinot (2)"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/75/Malus_-_Purpurroter_Cousinot.JPG/960px-Malus_-_Purpurroter_Cousinot.JPG","seite":"https://commons.wikimedia.org/wiki/File:Malus_-_Purpurroter_Cousinot.JPG","art":"frucht","urheber":"Gen