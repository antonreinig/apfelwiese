{"id":"maunzen","name":"Maunzen","synonyme":[{"name":"Maunzenapfel","beleg":{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Maunzen&oldid=213591448"}}],"herkunft":{"text":"Zufallssämling, um 1900 vom Baumwart Maunzen in Holzhausen bei Göppingen (Württemberg) gefunden; nach dem strengen Winter 1928/29 wegen seiner Frosthärte in Süddeutschland weit verbreitet.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Maunzen&oldid=213591448"},{"quelle":"web_trenthorst","url":"https://www.trenthorst.de/.cm4all/uproc.php/0/TrentObst/Apfelsorten/maunzenapfel.pdf"}]},"merkmale":[{"merkmal":"frucht_groesse","wert":"3","original":"eher klein bis mittelgroß","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Maunzen&oldid=213591448"},{"merkmal":"frucht_groesse","wert":"5","original":"eher klein bis mittelgroß","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Maunzen&oldid=213591448"},{"merkmal":"frucht_rippung","wert":"7","original":"mit ausgeprägten Rippen, die Frucht wirkt dadurch oft kantig","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Maunzen&oldid=213591448"},{"merkmal":"schale_grundfarbe","wert":"weisslichgelb","original":"Die gelblich weiße Grundfarbe","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Maunzen&oldid=213591448"},{"merkmal":"schale_deckfarbe_farbton","wert":"rot","original":"mit roten bzw. rosafarbenen Streifen","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Maunzen&oldid=213591448"},{"merkmal":"schale_deckfarbe_farbton","wert":"rosa","original":"mit roten bzw. rosafarbenen Streifen","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Maunzen&oldid=213591448"},{"merkmal":"schale_deckfarbe_art","wert":"gestreift","original":"mit roten bzw. rosafarbenen Streifen","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Maunzen&oldid=213591448"},{"merkmal":"fleisch_festigkeit","wert":"7","original":"sehr fest und saftig mit rein weißem Fruchtfleisch","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Maunzen&oldid=213591448"},{"merkmal":"fleisch_saftigkeit","wert":"7","original":"sehr fest und saftig","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Maunzen&oldid=213591448"},{"merkmal":"fleisch_farbe","wert":"weiss","original":"rein weißem Fruchtfleisch","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Maunzen&oldid=213591448"},{"merkmal":"geschmack_saeure","wert":"9","original":"welches stark säuerlich … schmeckt","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Maunzen&oldid=213591448"},{"merkmal":"pflueckreife","wert":"9","original":"erreichen ihre Baumreife ab Mitte bis Ende September","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Maunzen&oldid=213591448"},{"merkmal":"genussreife_ende","wert":"2","original":"Prinzipiell bis Februar haltbar","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Maunzen&oldid=213591448"},{"merkmal":"verwendung","wert":"most","original":"als Mostapfel und Back- und Kochapfel … nicht jedoch als Tafelapfel","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Maunzen&oldid=213591448"},{"merkmal":"verwendung","wert":"kueche","original":"als Mostapfel und Back- und Kochapfel","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Maunzen&oldid=213591448"},{"merkmal":"baum_wuchs","wert":"5","original":"mit mittlerem bis starkem Wuchs","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Maunzen&oldid=213591448"},{"merkmal":"baum_wuchs","wert":"7","original":"mit mittlerem bis starkem Wuchs","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Maunzen&oldid=213591448"},{"merkmal":"frucht_groesse","wert":"3","original":"Klein bis mittelgroß","quelle