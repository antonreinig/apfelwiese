{"id":"schoener-von-wiltshire","name":"Schöner von Wiltshire","synonyme":[{"name":"Schöner von Wilshire","beleg":{"quelle":"engelbrecht1889","seite":"304 (Nr. 272)"}},{"name":"Wilshire Beauty","beleg":{"quelle":"lauche_erg1883","seite":"271 (Nr. 825)"}},{"name":"Beauty of Wiltshire","beleg":{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Schöner_von_Wiltshire&oldid=251757885"}},{"name":"Schöne von Wiltshire","beleg":{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Schöner_von_Wiltshire&oldid=251757885"}},{"name":"Wiltshire","beleg":{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Schöner_von_Wiltshire&oldid=251757885"}},{"name":"Weiße Wachsrenette","beleg":{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Schöner_von_Wiltshire&oldid=251757885"}}],"herkunft":{"text":"Englische Sorte. Nach Lauche (1883) von Standish in England gezüchtet; die Königliche Gärtner-Lehranstalt erhielt sie als „Wilshire Beauty“ von Palandt in Hildesheim. Wikipedia nennt die Grafschaft Wiltshire als Herkunftsgebiet und gibt an, über die Entstehung sei wenig bekannt; nachgewiesen sei die Sorte seit 1840.","belege":[{"quelle":"lauche_erg1883","seite":"271 (Nr. 825)"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Schöner_von_Wiltshire&oldid=251757885"}]},"merkmale":[{"merkmal":"frucht_breite","wert":88,"original":"Gestalt 88:65—70","quelle":"engelbrecht1889","seite":"304 (Nr. 272)"},{"merkmal":"frucht_hoehe","wert":67.5,"original":"Gestalt 88:65—70","quelle":"engelbrecht1889","seite":"304 (Nr. 272)"},{"merkmal":"frucht_hoehe_breite","wert":0.77,"original":"Gestalt 88:65—70","quelle":"engelbrecht1889","seite":"304 (Nr. 272)"},{"merkmal":"frucht_groesse","wert":"7","original":"großer, flach-kugelförmiger … Apfel","quelle":"lauche_erg1883","seite":"271 (Nr. 825)"},{"merkmal":"frucht_form","wert":"flachkonisch","original":"abgestumpft flachrund kegelförm.","quelle":"engelbrecht1889","seite":"304 (Nr. 272)"},{"merkmal":"frucht_form","wert":"flachrund","original":"großer, flach-kugelförmiger … Apfel","quelle":"lauche_erg1883","seite":"271 (Nr. 825)"},{"merkmal":"frucht_breiteste_stelle","wert":"stiel","original":"etwas stielbauch.","quelle":"engelbrecht1889","seite":"304 (Nr. 272)"},{"merkmal":"frucht_breiteste_stelle","wert":"stiel","original":"der Bauch ist dem Stiele genähert","quelle":"lauche_erg1883","seite":"271 (Nr. 825)"},{"merkmal":"frucht_symmetrie","wert":"schief","original":"Hälften ungleich","quelle":"engelbrecht1889","seite":"304 (Nr. 272)"},{"merkmal":"frucht_rippung","wert":"5","original":"Querschnitt etwas flachkantig","quelle":"engelbrecht1889","seite":"304 (Nr. 272)"},{"merkmal":"frucht_kronung","wert":"5","original":"Einsenk. … zwischen breiten, flach und ungleich über die Frucht laufenden Rippen","quelle":"engelbrecht1889","seite":"304 (Nr. 272)"},{"merkmal":"frucht_kronung","wert":"1","original":"Kelcheinsenkung flach und breit, … von feinen Falten umgeben","quelle":"lauche_erg1883","seite":"271 (Nr. 825)"},{"merkmal":"kelch_offenheit","wert":"halboffen","original":"Kelch halb offen bis offen","quelle":"engelbrecht1889","seite":"304 (Nr. 272)"},{"merkmal":"kelch_offenheit","wert":"offen","original":"Kelch halb offen bis offen","quelle":"engelbrecht1889","seite":"304 (Nr. 272)"},{"merkmal":"kelch_offenheit","wert":"geschlossen","original":"Kelch: geschlossen","quelle":"lauche_erg1883","seite":"271 (Nr. 825)"},{"merkmal":"kelchgrube_tiefe","wert":"7","original":"Einsenk. ziemlich tief, mässig weit","quelle":"engelbrecht1889","seite":"304 (Nr. 272)"},{"merkmal":"kelchgrube_weite","wert":"5","original":"Einsenk. ziemlich tief, mässig weit","quelle":"engelbrecht1889","seite":"304 (Nr. 272)"},{"merkmal":"kelchgrube_tiefe","wert":"3","original":"Kelcheinsenkung flach und breit, schön schüsselförmig","quelle":"lauche_erg1883","seite":"271 (Nr. 825)"},{"merkmal":"kelchgrube_weite","wert":"7","original":"Kelcheinsenkung flach und breit, schön schüsselförmig","quelle":"lauche_erg1883","seite":"271 (Nr. 825)"},{"merkmal":"stiel_dicke","wert":"5","original":"Stiel holzig, mitteldick, bis an 19 mm l. oder kürzer","quelle":"engelbrecht1889","seite":"304 (Nr. 272)"},{"merkmal":"stiel_laenge","wert":"3","original":"Stiel: kurz, holzig, … kaum herausragend","quelle":"lauche_erg1883","seite":"271 (Nr. 825)"},{"merkmal":"stiel_laenge","wert":"5","original":"Der Stiel mittellang (etwa 16 bis 25 Millimeter), dick","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Schöner_von_Wiltshire&oldid=251757885"},{"merkmal":"stiel_dicke","wert":"7","original":"Der Stiel mittellang (etwa 16 bis 25 Millimeter), dick","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Schöner_von_Wiltshire&oldid=251757885"},{"merkmal":"stielgrube_tiefe","wert":"7","original":"Höhle tief, weit, faltig","quelle":"engelbrecht1889","seite":"304 (Nr. 272)"},{"merkmal":"stielgrube_weite","wert":"7","original":"Höhle tief, weit, faltig","quelle":"engelbrecht1889","seite":"304 (Nr. 272)"},{"merkmal":"stielgrube_tiefe","wert":"7","original":"Stieleinsenkung tief und eng, glatt","quelle":"lauche_erg1883","seite":"271 (Nr. 825)"},{"merkmal":"stielgrube_weite","wert":"3","original":"Stieleinsenkung tief und eng, glatt","quelle":"lauche_erg1883","seite":"271 (Nr. 825)"},{"merkmal":"schale_berostung_stielgrube","wert":"3","original":"Höhle … zart bräunlichgrün berostet","quelle":"engelbrecht1889","seite":"304 (Nr. 272)"},{"merkmal":"schale_berostung_wangen","wert":"0","original":"Rost fehlt","quelle":"lauche_erg1883","seite":"271 (Nr. 825)"},{"merkmal":"schale_beschaffenheit","wert":"glatt","original":"Schale glatt, etwas geschmeidig und glänzend","quelle":"engelbrecht1889","seite":"304 (Nr. 272)"},{"merkmal":"schale_beschaffenheit","wert":"glaenzend","original":"Schale glatt, etwas geschmeidig und glänzend","quelle":"engelbrecht1889","seite":"304 (Nr. 272)"},{"merkmal":"schale_beschaffenh