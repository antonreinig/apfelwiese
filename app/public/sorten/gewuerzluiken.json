{"id":"gewuerzluiken","name":"Gewürzluiken","synonyme":[{"name":"Gewürzluike","beleg":{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Gewürzluiken&oldid=229743293"}},{"name":"Gewürzluikenapfel","beleg":{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Gewürzluiken&oldid=229743293"}}],"herkunft":{"text":"Zufallssämling, vermutlich aus Nordwürttemberg; seit 1885 in ganz Württemberg verbreitet.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Gewürzluiken&oldid=229743293"}],"land":"DE","landSicher":false,"ort":"Nordwürttemberg (vermutet)"},"merkmale":[{"merkmal":"frucht_groesse","wert":"5","original":"Die mittelgroßen bis großen Früchte","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Gewürzluiken&oldid=229743293"},{"merkmal":"frucht_groesse","wert":"7","original":"Die mittelgroßen bis großen Früchte","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Gewürzluiken&oldid=229743293"},{"merkmal":"schale_grundfarbe","wert":"gelb","original":"haben eine gelbe Grundfarbe","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Gewürzluiken&oldid=229743293"},{"merkmal":"schale_deckfarbe_farbton","wert":"rot","original":"kräftig karminrote bis dunkelrote Deckfarbe","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Gewürzluiken&oldid=229743293"},{"merkmal":"schale_deckfarbe_farbton","wert":"dunkelrot","original":"kräftig karminrote bis dunkelrote Deckfarbe","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Gewürzluiken&oldid=229743293"},{"merkmal":"schale_deckfarbe_art","wert":"gestreift","original":"mit teilweise braunroten Streifen","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Gewürzluiken&oldid=229743293"},{"merkmal":"fleisch_farbe","wert":"weiss","original":"Das Fruchtfleisch ist weiß, sehr saftig","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Gewürzluiken&oldid=229743293"},{"merkmal":"fleisch_saftigkeit","wert":"7","original":"Das Fruchtfleisch ist weiß, sehr saftig","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Gewürzluiken&oldid=229743293"},{"merkmal":"geschmack_saeure","wert":"7","original":"hat einen säuerlichen, leicht würzigen Geschmack","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Gewürzluiken&oldid=229743293"},{"merkmal":"geschmack_aroma","wert":"leicht würzig","original":"hat einen säuerlichen, leicht würzigen Geschmack","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Gewürzluiken&oldid=229743293"},{"merkmal":"pflueckreife","wert":"10","original":"Pflückreif sind die Früchte etwa Mitte bis Ende Oktober","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Gewürzluiken&oldid=229743293"},{"merkmal":"genussreife_beginn","wert":"11","original":"von November bis März genussreif","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Gewürzluiken&oldid=229743293"},{"merkmal":"genussreife_ende","wert":"3","original":"von November bis März genussreif","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Gewürzluiken&oldid=229743293"},{"merkmal":"verwendung","wert":"tafel","original":"Verwendet wird die Frucht als Tafelapfel und zur Mostherstellung","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Gewürzluiken&oldid=229743293"},{"merkmal":"verwendung","wert":"most","original":"Verwendet wird die Frucht als Tafelapfel und zur Mostherstellung","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Gewürzluiken&oldid=229743293"},{"merkmal":"frucht_breite","wert":67,"quelle":"nfc2025","seite":"Akzession 1951175 (Smith 1971)","original":"62-72"},{"merkmal":"frucht_hoehe","wert":60,"quelle":"nfc2025","seite":"Akzession 1951175 (Smith 1971)","original":"53-67"},{"merkmal":"frucht_groesse","wert":"5","quelle":"nfc2025","seite":"Akzession 1951175 (Smith 1971)","original":"Medium to large"},{"merkmal":"frucht_groesse","wert":"7","quelle":"nfc2025","seite":"Akzession 1951175 (Smith 1971)","original":"Medium to large"},{"merkmal":"frucht_form","wert":"breitrundkonisch","quelle":"nfc2025","seite":"Akzession 1951175 (Smith 1971)","original":"Broad globose conical"},{"merkmal":"frucht_hoehe_breite","wert":0.896,"quelle":"nfc2025","seite":"Akzession 1951175 (Smith 1971)"},{"merkmal":"frucht_rippung","wert":"1","quelle":"nfc2025","seite":"Akzession 1951175 (Smith 1971)","original":"Very light"},{"merkmal":"schale_grundfarbe","wert":"gruengelb","quelle":"nfc2025","seite":"Akzession 1951175 (Smith 1971)","original":"Green yellow"},{"merkmal":"schale_deckfarbe_anteil","wert":"7","quelle":"nfc2025","seite":"Akzession 1951175 (Smith 1971)","original":"High to very high"},{"merkmal":"schale_deckfarbe_anteil","wert":"9","quelle":"nfc2025","seite":"Akzession 1951175 (Smith 1971)","original":"High to very high"},{"merkmal":"schale_deckfarbe_farbton","wert":"orange","quelle":"nfc2025","seite":"Akzession 1951175 (Smith 1971)","original":"Orange"},{"merkmal":"schale_deckfarbe_art","wert":"gestreift","quelle":"nfc2025","seite":"Akzession 1951175 (Smith 1971)","original":"Only stripes"},{"merkmal":"fleisch_farbe","wert":"gruenlich","quelle":"nfc2025","seite":"Akzession 1951175 (Smith 1971)","original":"Greenish"},{"merkmal":"verwendung","wert":"tafel","quelle":"nfc2025","seite":"Akzession 1951175","original":"Dessert"},{"merkmal":"pflueckreife","wert":"10","quelle":"nfc2025","seite":"Akzession 1951175","original":"Mid October"},{"merkmal":"genussreife_ende","wert":"3","quelle":"nfc2025","seite":"Akzession 1951175","original":"March"},{"merkmal":"bluete_zeit","wert":"5","quelle":"nfc2025","seite":"Akzession 1951175","original":"Klasse 6 (10 % der Blüten offen, Tag 131)"},{"merkmal":"bluete_zeit","wert":"7","quelle":"nfc2025","seite":"Akzession 1951175","original":"Klasse 6 (10 % der Blüten offen, Tag 131)"},{"merkmal":"standort_klima","wert":"7","original":"sollte nur in wärmeren Lagen gepflanzt werden","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Gewürzluiken&oldid=229743293"},{"merkmal":"lagerfaehigkeit","wert":"7","original":"genussreif von November bis März","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Gewürzluiken&oldid=229743293"}],"texte":[{"thema":"ueberblick","text":"Die Gewürzluike ist eine württembergische Apfelsorte, die als Tafel- und Mostapfel genutzt wird. Die mittelgroßen bis großen Früchte sind gelb mit kräftig karmin- bis dunkelroter Deckfarbe; das weiße, sehr saftige Fleisch schmeckt säuerlich und leicht würzig. Sie wird Mitte bis Ende Oktober gepflückt und ist von November bis März genussreif.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Gewürzluiken&oldid=229743293"}]},{"thema":"herkunft","text":"Die Sorte geht auf einen Zufallssämling zurück, vermutlich aus Nordwürttemberg. Seit 1885 wurde sie in ganz Württemberg verbreitet und gehörte dort neben dem Luikenapfel zu den am häufigsten gepflanzten Sorten. In den Werken von Lucas, Oberdieck und Engelbrecht (1859–1889) ist sie nicht beschrieben.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Gewürzluiken&oldid=229743293"}]},{"thema":"frucht","text":"Die Früchte sind mittelgroß bis groß. Die Grundfarbe ist gelb, die Deckfarbe kräftig karminrot bis dunkelrot, teilweise mit braunroten Streifen. In kalten Lagen reifen die Früchte oft nicht aus, färben schlecht und schmecken grasig. Angaben zu Form, Kelch, Stiel und Schnitt liegen in der verwendeten Quelle nicht vor.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Gewürzluiken&oldid=229743293"}]},{"thema":"fleisch_geschmack","text":"Das Fleisch ist weiß und sehr saftig, der Geschmack säuerlich und leicht würzig.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Gewürzluiken&oldid=229743293"}]},{"thema":"reife_lagerung","text":"Pflückreif ist die Frucht etwa Mitte bis Ende Oktober, genussreif von November bis März.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Gewürzluiken&oldid=229743293"}]},{"thema":"baum","text":"Die Sorte ist anfällig für Holzfrost und sollte nur in wärmeren Lagen gepflanzt werden.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Gewürzluiken&oldid=229743293"}]},{"thema":"verwendung","text":"Die Frucht dient als Tafelapfel und zur Mostbereitung.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Gewürzluiken&oldid=229743293"}]},{"thema":"unterscheidung","text":"Die Gewürzluike wird nach Wikipedia oft mit dem Luikenapfel verwechselt, mit dem sie in Württemberg zusammen verbreitet ist.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Gewürzluiken&oldid=229743293"}]},{"thema":"frucht","text":"Nach den Erhebungen der National Fruit Collection: mittelgroßer bis großer, breit rundlich-kegelförmiger Apfel mit grünlich gelber Grundfarbe und gestreifter orangefarbener Deckfarbe auf einem großen bis sehr großen Teil der Schale. Das Fruchtfleisch ist grünlich. In der Sammlung als Tafelapfel geführt; pflückreif Mitte Oktober, lagerfähig bis März.","belege":[{"quelle":"nfc2025","seite":"Akzession 1951175"}]}],"bilder":[{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/b/b8/Malus_Gew%C3%BCrzluiken_4476.jpg/960px-Malus_Gew%C3%BCrzluiken_4476.jpg","seite":"https://commons.wikimedia.org/wiki/File:Malus_Gew%C3%BCrzluiken_4476.jpg","art":"frucht","urheber":"Sven Teschke","lizenz":"CC BY-SA 3.0 de","quelle":"commons","titel":"Malus Gewürzluiken 4476.jpg"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/4/4d/Gew%C3%BCrzluike_jm55190.jpg/960px-Gew%C3%BCrzluike_jm55190.jpg","seite":"https://commons.wikimedia.org/wiki/File:Gew%C3%BCrzluike_jm55190.jpg","art":"frucht","urheber":"joergens.mi","lizenz":"CC BY-SA 3.0","quelle":"commons","titel":"Gewürzluike jm55190.jpg"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/83/Gew%C3%BCrzluikenbaum.jpg/960px-Gew%C3%BCrzluikenbaum.jpg","seite":"https://commons.wikimedia.org/wiki/File:Gew%C3%BCrzluikenbaum.jpg","art":"baum","urheber":"Bonjour35","lizenz":"CC BY-SA 4.0","quelle":"commons","titel":"Gewürzluikenbaum.jpg"},{"url":"https://upload.wikimedia.org/wikipedia/commons/6/61/Cross_section_of_Gewurzluiken%2C_National_Fruit_Collection_%28acc._1951-175%29.jpg","seite":"https://commons.wikimedia.org/wiki/File:Cross_section_of_Gewurzluiken,_National_Fruit_Collection_(acc._1951-175).jpg","art":"schnitt","urheber":"National Fruit Collection, Brogdale","lizenz":"OGL 2.0","quelle":"nfc-commons","titel":"Cross section of Gewurzluiken, National Fruit Collection (acc. 1951-175)"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/4/47/Apfel_044_Gewuerzluiken_%28fcm%29.jpg/960px-Apfel_044_Gewuerzluiken_%28fcm%29.jpg","seite":"https://commons.wikimedia.org/wiki/File:Apfel_044_Gewuerzluiken_(fcm).jpg","art":"frucht","urheber":"Photograph: Frank C. Müller , Frankfurt am Main","lizenz":"CC BY-SA 4.0","quelle":"commons-fotos","titel":"Apfel 044 Gewuerzluiken (fcm)"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/0/0e/Apfel_045_Gewuerzluiken_%28fcm%29.jpg/960px-Apfel_045_Gewuerzluiken_%28fcm%29.jpg","seite":"https://commons.wikimedia.org/wiki/File:Apfel_045_Gewuerzluiken_(fcm).jpg","art":"frucht","urheber":"Photograph: Frank C. Müller , Frankfurt am Main","lizenz":"CC BY-SA 4.0","quelle":"commons-fotos","titel":"Apfel 045 Gewuerzluiken (fcm)"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/6/6e/Apfel_046_Gewuerzluiken_%28fcm%29.jpg/960px-Apfel_046_Gewuerzluiken_%28fcm%29.jpg","seite":"https://commons.wikimedia.org/wiki/File:Apfel_046_Gewuerzluiken_(fcm).jpg","art":"frucht","urheber":"Photograph: Frank C. Müller , 