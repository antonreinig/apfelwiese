erg1883","seite":"294 (Nr. 836)"},{"merkmal":"fleisch_farbe","wert":"cremeweiss","original":"Fleisch hellgelblichweiss, fein, locker, mürbe","quelle":"engelbrecht1889","seite":"161 (Nr. 141)"},{"merkmal":"fleisch_farbe","wert":"gelblich","original":"Das gelblich bis hell lachsgelbe Fruchtfleisch","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Transparent_von_Croncels&oldid=253888738"},{"merkmal":"fleisch_festigkeit","wert":"3","original":"Fleisch … fein, locker, mürbe, saftig","quelle":"engelbrecht1889","seite":"161 (Nr. 141)"},{"merkmal":"fleisch_saftigkeit","wert":"7","original":"Fleisch … locker, mürbe, saftig","quelle":"engelbrecht1889","seite":"161 (Nr. 141)"},{"merkmal":"geschmack_suesse","wert":"5","original":"etwas vorherrschend, recht angenehm weinig, fast ebenso süss","quelle":"engelbrecht1889","seite":"161 (Nr. 141)"},{"merkmal":"geschmack_saeure","wert":"5","original":"etwas vorherrschend, recht angenehm weinig, fast ebenso süss","quelle":"engelbrecht1889","seite":"161 (Nr. 141)"},{"merkmal":"geschmack_aroma","wert":"rosenapfelartig gewürzt","original":"rosenapfelartig, sehr merklich gewürzt","quelle":"engelbrecht1889","seite":"161 (Nr. 141)"},{"merkmal":"verwendung","wert":"tafel","original":"Transparente de Croncels (Illustr. Handb., E.-B.) oo†","quelle":"engelbrecht1889","seite":"161 (Nr. 141)"},{"merkmal":"verwendung","wert":"kueche","original":"Transparente de Croncels (Illustr. Handb., E.-B.) oo†","quelle":"engelbrecht1889","seite":"161 (Nr. 141)"},{"merkmal":"pflueckreife","wert":"8","original":"Die Pflückreife beginnt Ende August und geht bis Mitte September","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Transparent_von_Croncels&oldid=253888738"},{"merkmal":"pflueckreife","wert":"9","original":"Die Pflückreife beginnt Ende August und geht bis Mitte September","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Transparent_von_Croncels&oldid=253888738"},{"merkmal":"genuss