m"},{"merkmal":"schale_grundfarbe","wert":"weisslichgelb","quelle":"nfc2025","seite":"Akzession 1948683 (Smith 1971)","original":"Whitish yellow"},{"merkmal":"schale_deckfarbe_farbton","wert":"orange","quelle":"nfc2025","seite":"Akzession 1948683 (Smith 1971)","original":"Orange"},{"merkmal":"schale_berostung_gesamt","wert":"1","quelle":"nfc2025","seite":"Akzession 1948683 (Smith 1971)","original":"Very low"},{"merkmal":"fleisch_farbe","wert":"cremeweiss","quelle":"nfc2025","seite":"Akzession 1948683 (Smith 1971)","original":"Cream"},{"merkmal":"fleisch_festigkeit","wert":"3","quelle":"nfc2025","seite":"Akzession 1948683 (Verkostung P. Hale, 16/08/2023)","original":"Soft to intermediate"},{"merkmal":"fleisch_festigkeit","wert":"5","quelle":"nfc2025","seite":"Akzession 1948683 (Verkostung P. Hale, 16/08/2023)","original":"Soft to intermediate"},{"merkmal":"fleisch_saftigkeit","wert":"3","quelle":"nfc2025","seite":"Akzession 1948683 (Verkostung P. Hale, 16/08/2023)","original":"Low to intermediate"},{"merkmal":"fleisch_saftigkeit","wert":"5","quelle":"nfc2025","seite":"Akzession 1948683 (Verkostung P. Hale, 16/08/2023)","original":"Low to intermediate"},{"merkmal":"geschmack_suesse","wert":"3","quelle":"nfc2025","seite":"Akzession 1948683 (Verkostung P. Hale, 16/08/2023)","original":"Low"},{"merkmal":"geschmack_saeure","wert":"5","quelle":"nfc2025","seite":"Akzession 1948683 (Verkostung P. Hale, 16/08/2023)","original":"Intermediate to high"},{"merkmal":"geschmack_saeure","wert":"7","quelle":"nfc2025","seite":"Akzession 1948683 (Verkostung P. Hale, 16/08/2023)","original":"Intermediate to high"},{"merkmal":"verwendung","wert":"kueche","quelle":"nfc2025","seite":"Akzession 1948683","original":"Culinary"},{"merkmal":"pflueckreife","wert":"9","quelle":"nfc2025","seite":"Akzession 1948683","original":"Early September"},{"merkmal":"genussreife_ende","wert":"10","quelle":"nfc2025","seite":"Akzession 1948683","original":"October"},{"merkmal":"bluete_zeit","wert":"3","quelle":"nfc2025","seite":"Akzession 1948683","original":"Klasse 4 (10 % der Blüten offen, Tag 122)"},{"merkmal":"bluete_zeit","wert":"5","quelle":"nfc2025","seite":"Akzession 1948683","original":"Klasse 4 (10 % der Blüten offen, Tag 122)"},{"merkmal":"lagerfaehigkeit","wert":"3","original":"höchstens einen Monat lagerfähig","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Transparent_von_Croncels&oldid=253888738"},{"merkmal":"verwendung","wert":"kueche","original":"Nach Wikipedia ist sie bei Bäckereien als Kuchenapfel gesucht","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Transparent_von_Croncels&oldid=253888738"},{"merkmal":"gesundheit","wert":"7","original":"Der Baum wächst nach Lauche gut, ist sehr fruchtbar und nicht empfindlich","quelle":"lauche_erg1883","seite":"294 (Nr. 836)"},{"merkmal":"anfaelligkeit_schorf","wert":"7","original":"Die Sorte ist anfällig für Schorf, Mehltau und Viruskrankheiten","quelle":"lauche_erg1883","seite":"294 (Nr. 836)","belege":[{"quelle":"lauche_erg1883","seite":"294 (Nr. 836)"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Transparent_von_Croncels&oldid=253888738"}]},{"merkmal":"anfaelligkeit_mehltau","wert":"7","original":"Die Sorte ist anfällig für Schorf, Mehltau und Viruskrankheiten","quelle":"lauche_erg1883","seite":"294 (Nr. 836)","belege":[{"quelle":"lauche_erg1883","seite":"294 (Nr. 836)"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Transparent_von_Croncels&oldid=253888738"}]},{"merkmal":"anfaelligkeit_krebs","wert":"7","original":"verträgt keinen schweren Boden (Krebs)","quelle":"lauche_erg1883","seite":"294 (Nr. 836)","belege":[{"quelle":"lauche_erg1883","seite":"294 (Nr. 836)"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Transparent_von_Croncels&oldid=253888738"}]},{"merkmal":"standort_klima","wert":"5","original":"reift in rauem Klima nicht aus","quelle":"lauche_erg1883","seite":"294 (Nr. 836)","belege":[{"quelle":"lauche_erg1883","seite":"294 (Nr. 836)"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Transparent_von_Croncels&oldid=253888738"}]},{"merkmal":"bluete_frost","wert":"3","original":"die Blüten sind wenig frostempfindlich","quelle":"lauche_erg1883","seite":"294 (Nr. 836)","belege":[{"quelle":"lauche_erg1883","seite":"294 (Nr. 836)"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Transparent_von_Croncels&oldid=253888738"}]}],"texte":[{"thema":"ueberblick","text":"Transparent von Croncels ist ein großer, flacher, hellgelber Herbstapfel französischer Herkunft mit lockerem, mürbem, saftigem Fleisch und rosenapfelartiger Würze. Engelbrecht ordnet ihn bei den Rosenäpfeln ein und bewertet ihn als Tafel- und Haushaltsfrucht. Die Frucht ist sehr druckempfindlich und nur kurz haltbar; bei Bäckereien ist sie nach Wikipedia als Kuchenapfel gesucht.","belege":[{"quelle":"engelbrecht1889","seite":"161 (Nr. 141)"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Transparent_von_Croncels&oldid=253888738"}]},{"thema":"herkunft","text":"Die Gebrüder Baltet, Baumschulbesitzer in Croncels bei Troyes, zogen die Sorte aus Samen und brachten sie 1869 in den Handel; die Königliche Gärtner-Lehranstalt erhielt sie 1870 vom Züchter. Lauche bezeichnete sie 1883 als in Deutschland wenig bekannt. Engelbrecht erhielt Früchte aus Düren und aus der Landesbaumschule Braunschweig mit einem Reis von Simon Louis in Metz. Nach einer bei Wikipedia zitierten genomischen Abstammungsanalyse (2020) sind Weißer Winterkalvill und Charlamowsky die Elternsorten.","belege":[{"quelle":"lauche_erg1883","seite":"293 (Nr. 836)"},{"quelle":"engelbrecht1889","seite":"161 (Nr. 141)"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Transparent_von_Croncels&oldid=253888738"}]},{"thema":"frucht","text":"Engelbrecht maß 86 mm Breite und 71–72 mm Höhe, Lauche etwa 90:70 mm, Wikipedia nennt 80 mm Breite, 67 mm Höhe und 195 g. Die Frucht ist stark abgestumpft flachrund kegelförmig, etwas stielbauchig, mit gleichen Hälften und ziemlich rundem Querschnitt. Der halb offene, nach Lauche auch geschlossene Kelch mit langen Blättchen sitzt in einer tiefen, mäßig weiten Einsenkung zwischen flachen, nicht weit laufenden Rippen. Der mitteldicke Stiel ist etwa 14 mm lang, nach Lauche lang und oft von einem Fleischwulst zur Seite gedrückt; er steht in einer tiefen Stielgrube.","belege":[{"quelle":"engelbrecht1889","seite":"161 (Nr. 141)"},{"quelle":"lauche_erg1883","seite":"293 (Nr. 836)"},{"quelle":"lauche_erg1883","seite":"294 (Nr. 836)"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Transparent_von_Croncels&oldid=253888738"}]},{"thema":"schale","text":"Die Schale ist glatt, etwas geschmeidig, beduftet und glänzend, hellgrünlichgelb und später gelblichweiß, nach Lauche grünlich strohgelb. Sonnenseits ist sie goldiger und oft leicht rötlich angeflogen. Die Schalenpunkte sind zahlreich, meist nur helle Tupfen, seltener bräunlich; Lauche beschreibt sie als fein, weiß und um Kelch und Stiel sehr dicht. Die Stielgrube ist berostet, nach Lauche strahlig. Wikipedia nennt die Schale trocken bis schwach fettig und von außen sehr leicht eindrückbar.","belege":[{"quelle":"engelbrecht1889","seite":"161 (Nr. 141)"},{"quelle":"lauche_erg1883","seite":"294 (Nr. 836)"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Transparent_von_Croncels&oldid=253888738"}]},{"thema":"schnitt","text":"Das Kernhaus ist mit 46:31 mm breit und flach zwiebelförmig, nach Lauche abgerundet zwiebelförmig und kelchwärts kurz zugespitzt. Die Kammern (12:19 mm) sind stielwärts stumpf gespitzt, kelchwärts flach abgerundet, wenig zerrissen, geräumig und etwas offen; Lauche nennt das Kernhaus fast geschlossen. Die Achsenhöhle ist mäßig breit. Je Kammer liegen ein bis zwei große, vollkommene, breit eiförmige, kurz gespitzte, kaffeebraune Kerne. Die Kelchhöhle ist nach Engelbrecht ein Kegel, der die Hälfte bis zwei Drittel des Weges zur Achsenhöhle reicht; Lauche beschreibt die Kelchröhre ohne Tiefenangabe als breit kegelförmig. Das Fleisch ist am Schnitt hellgelblichweiß.","belege":[{"quelle":"engelbrecht1889","seite":"161 (Nr. 141)"},{"quelle":"lauche_erg1883","seite":"294 (Nr. 836)"}]},{"thema":"fleisch_geschmack","text":"Das Fleisch ist hellgelblichweiß, fein, locker, mürbe und saftig, nach Wikipedia gelblich bis hell lachsgelb und beinahe schaumig. Der Geschmack ist rosenapfelartig, deutlich gewürzt, angenehm weinig und fast ebenso süß; Wikipedia nennt ihn zart süßsäuerlich und je nach Standort wenig bis fein aromatisch.","belege":[{"quelle":"engelbrecht1889","seite":"161 (Nr. 141)"},{"quelle":"lauche_erg1883","seite":"294 (Nr. 836)"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Transparent_von_Croncels&oldid=253888738"}]},{"thema":"reife_lagerung","text":"Engelbrecht gibt als Genussreife Anfang September bis Oktober an. Nach Lauche reift die Frucht Ende August und hält sich vier Wochen. Wikipedia nennt Pflückreife von Ende August bis Mitte September und Genussreife von September bis Oktober; der Apfel ist sehr druck- und transportempfindlich und höchstens einen Monat lagerfähig.","belege":[{"quelle":"engelbrecht1889","seite":"161 (Nr. 141)"},{"quelle":"lauche_erg1883","seite":"294 (Nr. 836)"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Transparent_von_Croncels&oldid=253888738"}]},{"thema":"baum","text":"Der Baum wächst nach Lauche gut, ist sehr fruchtbar und nicht empfindlich. Wikipedia beschreibt ihn als anfangs stark-, später mittelstark wachsend, mit schräg aufrechten Leitästen und dichter seitlicher Verzweigung; wegen Starkwuchs und Frosthärte wurde er früher als Stammbildner verwendet. Die Sorte ist anfällig für Schorf, Mehltau und Viruskrankheiten, verträgt keinen schweren Boden (Krebs) und reift in rauem Klima nicht aus. Die Blütezeit ist lang, die Blüten sind wenig frostempfindlich.","belege":[{"quelle":"lauche_erg1883","seite":"294 (Nr. 836)"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Transparent_von_Croncels&oldid=253888738"}]},{"thema":"verwendung","text":"Engelbrecht und Lauche stufen die Sorte als Frucht für Tafel und Wirtschaft ein. Nach Wikipedia ist sie bei Bäckereien als Kuchenapfel gesucht.","belege":[{"quelle":"engelbrecht1889","seite":"161 (Nr. 141)"},{"quelle":"lauche_erg1883","seite":"294 (Nr. 836)"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Transparent_von_Croncels&oldid=253888738"}]},{"thema":"frucht","text":"Nach den Erhebungen der National Fruit Collection: die Sorte bildet große, breit rundlich-kegelförmige Früchte mit weißlich gelber Grundfarbe und orangefarbener Deckfarbe. Das Fruchtfleisch ist cremefarben, die Schale kaum berostet. Das Fleisch ist weich bis mittelfest und wenig bis mäßig saftig; im Geschmack wenig süß und mäßig bis deutlich sauer, mit schwachem Aroma. In der Sammlung als Küchenapfel geführt; pflückreif Anfang September, lagerfähig bis Oktober.","belege":[{"quelle":"nfc2025","seite":"Akzession 1948683"}]}],"bilder":[{"url":"https://archive.org/download/bub_gb_tR4EMgEACAAJ/page/n178_w800.jpg","seite":"https://archive.org/details/bub_gb_tR4EMgEACAAJ/page/n178","art":"schnitt","urheber":"Theodor Engelbrecht (Zeichnung), Albert Probst (Holzschnitt)","lizenz":"gemeinfrei","quelle":"engelbrecht1889","titel":"Längsschnitt-Umriss bei Engelbrecht 1889, S. 161 (ganze Buchseite)"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/9d/Malus-Croncels.jpg/960px-Malus-Croncels.jpg","seite":"https://commons.wikimedia.org/wiki/File:Malus-Croncels.jpg","art":"frucht","urheber":"Sven Teschke","lizenz":"CC BY-SA 2.0 de","quelle":"commons","titel":"Malus-Croncels.jpg"},{"url":"https://upload.wikimedia.org/wikipedia/commons/b/b5/Cross_section_of_Transparente_de_Croncels%2C_National_Fruit_Collection_%28acc._1948-683%29.jpg","seite":"https://commons.wikimedia.org/wiki/File:Cross_section_of_Transparente_de_Croncels,_National_Fruit_Collection_(acc._1948-683).jpg","art":"schnitt","urheber":"National Fruit Collection, Brogdale","lizenz":"OGL 2.0","quelle":"nfc-commons","titel":"Cross section of Transparente de Croncels, National Fruit Collection (acc. 1948-683)"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/80/Ailly-le-Haut-Clocher_%28Fr-80%29_Apple_festival%2C_2025-11-01%2C_Transparente_de_Croncels.jpg/960px-Ailly-le-Haut-Clocher_%28Fr-80%29_Apple_festival%2C_2025-11-01%2C_Transparente_de_Croncels.jpg","seite":"https://commons.wikimedia.org/wiki/File:Ailly-le-Haut-Clocher_(Fr-80)_Apple_festival,_2025-11-01,_Transparente_de_Croncels.jpg","art":"frucht","urheber":"APictche","lizenz":"CC BY-SA 4.0","quelle":"commons-fotos","titel":"Ailly-le-Haut-Clocher (Fr-80) Apple festival, 2025-11-01, Transparente de Croncels"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/d/d3/BW-1-6_Transparent_von_Croncels_%281%29.jpg/960px-BW-1-6_Transparent_von_Croncels_%281%29.jpg","seite":"https://commons.wikimedia.org/wiki/File:BW-1-6_Transparent_von_Croncels_(1).jpg","art":"frucht","urheber":"Tragopogon","lizenz":"CC BY 4.0","quelle":"commons-fotos","titel":"BW-1-6 Transparent von Croncels (1)"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/2/20/Crocels_-_Apfel_aus_Croncels.jpg/960px-Crocels_-_Apfel_aus_Croncels.jpg","seite":"https://commons.wikimedia.org/wiki/File:Crocels_-_Apfel_aus_Croncels.jpg","art":"frucht","urheber":"Bahnmoeller","lizenz":"CC BY-SA 3.0","quelle":"commons-fotos","titel":"Crocels - Apfel aus Croncels"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/6/64/Jab%C5%82ka_w_Daszewicach_w_Wielkopolsce_-_wrzesie%C5%84_2018.jpg/960px-Jab%C5%82ka_w_Daszewicach_w_Wielkopolsce_-_wrzesie%C5%84_2018.jpg","seite":"https://commons.wikimedia.org/wiki/File:Jab%C5%82ka_w_Daszewicach_w_Wielkopolsce_-_wrzesie%C5%84_2018.jpg","art":"frucht","urheber":"Koefbac","lizenz":"CC BY-SA 4.0","quelle":"commons-fotos","titel":"Jabłka w Daszewicach w Wielkopolsce - wrzesień 2018"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/a/ad/Jab%C5%82ko_w_Daszewicach_-_wrzesie%C5%84_2018.jpg/960px-Jab%C5%82ko_w_Daszewicach_-_wrzesie%C5%84_2018.jpg","seite":"https://commons.wikimedia.org/wiki/File:Jab%C5%82ko_w_Daszewicach_-_wrzesie%C5%84_2018.jpg","art":"frucht","urheber":"Koefbac","lizenz":"CC BY-SA 4.0","quelle":"commons-fotos","titel":"Jabłko w Daszewicach - wrzesień 2018"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/6/67/Jab%C5%82o%C5%84_w_Daszewicach_w_Wielkopolsce_-_wrzesie%C5%84_2018.jpg/960px-Jab%C5%82o%C5%84_w_Daszewicach_w_Wielkopolsce_-_wrzesie%C5%84_2018.jpg","seite":"https://commons.wikimedia.org/wiki/File:Jab%C5%82o%C5%84_w_Daszewicach_w_Wielkopolsce_-_wrzesie%C5%84_2018.jpg","art":"frucht","urheber":"Koefbac","lizenz":"CC BY-SA 4.0","quelle":"commons-fotos","titel":"Jabłoń w Daszewicach w Wielkopolsce - wrzesień 2018"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/b/b6/Malus_Croncels_4576.jpg/960px-Malus_Croncels_4576.jpg","seite":"https://commons.wikimedia.org/wiki/File:Malus_Croncels_4576.jpg","art":"frucht","urheber":"Sven Teschke","lizenz":"CC BY-SA 3.0 DE","quelle":"commons-fotos","titel":"Malus Croncels 4576"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/2/20/PommesTransparentesDeCroncelsBreel.jpg/960px-PommesTransparentesDeCroncelsBreel.jpg","seite":"https://commons.wikimedia.org/wiki/File:PommesTransparentesDeCroncelsBreel.jpg","art":"frucht","urheber":"Ikmo-ned","lizenz":"CC BY-SA 4.0","quelle":"commons-fotos","titel":"PommesTransparentesDeCroncelsBreel"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/3/39/Transparente_de_Croncels.jpg/960px-Transparente_de_Croncels.jpg","seite":"https://commons.wikimedia.org/wiki/File:Transparente_de_Croncels.jpg","art":"frucht","urheber":"TJSweden","lizenz":"CC BY-SA 3.0","quelle":"commons-fotos","titel":"Transparente de Croncels"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/c2/Baltet_-_L%27art_de_greffer_-_fig160.jpg/960px-Baltet_-_L%27art_de_greffer_-_fig160.jpg","seite":"https://commons.wikimedia.org/wiki/File:Baltet_-_L%27art_de_greffer_-_fig160.jpg","art":"tafel","urheber":"Charles Baltet","lizenz":"gemeinfrei","quelle":"commons-illustrationen","titel":"Baltet - L'art de greffer - fig160"},{"url":"https://upload.wikimedia.org/wikipedia/commons/c/c7/Transparemnte_de_Croncels_Deutsche_Pomologie_Lauche_1883.jpg","seite":"https://commons.wikimedia.org/wiki/File:Transparemnte_de_Croncels_Deutsche_Pomologie_Lauche_1883.jpg","art":"tafel","urheber":"Wilhelm Lauche","lizenz":"gemeinfrei","quelle":"commons-illustrationen","titel":"Transparemnte de Croncels Deutsche Pomologie Lauche 1883"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/c3/Tansparent_von_Crocels_%28Ak%29_%28apple%29_jm179423.jpgtbd.jpg/960px-Tansparent_von_Crocels_%28Ak%29_%28apple%29_jm179423.jpgtbd.jpg","seite":"https://commons.wikimedia.org/wiki/File:Tansparent_von_Crocels_(Ak)_(apple)_jm179423.jpgtbd.jpg","art":"baum","urheber":"joergens.mi","lizenz":"CC BY-SA 3.0","quelle":"commons-fotos","titel":"Tansparent von Crocels (Ak) (apple) jm179423.jpgtbd"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/13/Tansparent_von_Crocels_%28MH%29_%28apple%29_jm179425.jpg/960px-Tansparent_von_Crocels_%28MH%29_%28apple%29_jm179425.jpg","seite":"https://commons.wikimedia.org/wiki/File:Tansparent_von_Crocels_(MH)_(apple)_jm179425.jpg","art":"baum","urheber":"joergens.mi","lizenz":"CC BY-SA 3.0","quelle":"commons-fotos","titel":"Tansparent von Crocels (MH) (apple) jm179425"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/3/34/Transparent_von_Croncels_%28M8%29_%28apple%29_jm179415.jpg/960px-Transparent_von_Croncels_%28M8%29_%28apple%29_jm179415.jpg","seite":"https://commons.wikimedia.org/wiki/File:Transparent_von_Croncels_(M8)_(apple)_jm179415.jpg","art":"baum","urheber":"joergens.mi","lizenz":"CC BY-SA 3.0","quelle":"commons-fotos","titel":"Transparent von Croncels (M8) (apple) jm179415"}],"munq":62,"akzessionen":[{"sammlung":"UK National Fruit Collection (Brogdale)","nummer":"1948683","name":"Transparente de Croncels"}],"farbmessung":[{"bild":"https://upload.wikimedia.org/wikipedia/commons/b/b5/Cross_section_of_Transparente_de_Croncels%2C_National_Fruit_Collection_%28acc._1948-683%29.jpg","methode":"NFC-Foto","verfahren":"Foto (NFC-Fototafel: 4 ganze Früchte, 2 Schnitte, Fototisch); Weißabgleich über den Hintergrund; Frucht per Hintergrundmodell freigestellt; Schalenpixel ohne Glanzlichter einzeln klassifiziert: Grundfarbe aus gelbgrünen Pixeln, Deckfarbe = Pixel mit deutlich höherem a* als die Grundfarbe (auch dunkle Rot- und Braunrottöne), Anteile über Pixel; Höhe/Breite aus dem Längsschnitt","grundfarbe":"#d7c45b","deckfarbe":"#c96c59","deckfarbeAnteil":0.21,"rostfarbe":"#8a6739","fleischfarbe":"#fbecca","hoeheZuBreite":0.834}],"regionen":[{"region":"DE-BW","art":"regionalsorte","belege":[{"quelle":"rg_bw-kob-landkreissorten"}],"original":"Transparent aus Croncels"},{"region":"DE-BY","art":"empfehlung","belege":[{"quelle":"rg_by-lwg-3151"}],"original":"Transparent aus Croncels"},{"region":"DE-BB","art":"empfehlung","belege":[{"quelle":"rg_bb-pv-sortenempfehlung"}],"original":"Apfel aus Croncel"},{"region":"DE-BE","art":"empfehlung","belege":[{"quelle":"rg_bb-pv-sortenempfehlung"}],"original":"Apfel aus Croncel"},{"region":"DE-RP","art":"empfehlung","belege":[{"quelle":"rg_rp-streuobst-sortenempfehlung-2018"}],"original":"Apfel aus Croncels"},{"region":"DE-ST","art":"regionalsorte","belege":[{"quelle":"rg_st-lpv-boerde-2012"}],"original":"Croncels"},{"region":"DE-TH","art":"empfehlung","belege":[{"quelle":"rg_th-grueneliga-2002"}],"original":"Apfel aus Croncels"}],"gefaehrdung":[{"stufe":"Rote Liste der gefährdeten einheimischen Nutzpflanzen in Deutschland","belege":[{"quelle":"rg_ble-rote-liste"}],"original":"Transparent aus Croncels"}]}