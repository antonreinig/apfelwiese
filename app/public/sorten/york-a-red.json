al":"Dessert"},{"merkmal":"pflueckreife","wert":"10","quelle":"nfc2025","seite":"Akzession 1951040; Akzession 1974264","original":"Late October"},{"merkmal":"genussreife_ende","wert":"4","quelle":"nfc2025","seite":"Akzession 1951040; Akzession 1974264","original":"April"},{"merkmal":"bluete_zeit","wert":"5","quelle":"nfc2025","seite":"Akzession 1951040","original":"Klasse 5 (10 % der Blüten offen, Tag 129)"},{"merkmal":"bluete_zeit","wert":"5","quelle":"nfc2025","seite":"Akzession 1974264","original":"Klasse 6 (10 % der Blüten offen, Tag 131)"},{"merkmal":"bluete_zeit","wert":"7","quelle":"nfc2025","seite":"Akzession 1974264","original":"Klasse 6 (10 % der Blüten offen, Tag 131)"}],"texte":[{"thema":"ueberblick","text":"Die Sorte bildet große, stark abgeflachte Früchte mit weißlich gelber Grundfarbe und flächiger und gestreifter orangefarbener Deckfarbe auf einem kleinen Teil der Schale. Die Schale ist kaum berostet, das Fruchtfleisch gelblich. Bei der Verkostung war das Fleisch mittelfest bis fest und mäßig saftig, der Geschmack mäßig bis deutlich süß und säurearm bis mäßig sauer, mit schwachem bis mittlerem Aroma. Tafelapfel, pflückreif Ende Oktober und lagerfähig bis April.","belege":[{"quelle":"nfc2025","seite":"Akzession 1974264, 1951040"}]}],"bilder":[{"url":"https://upload.wikimedia.org/wikipedia/commons/d/d0/Cross_section_of_York-a-Red%2C_National_Fruit_Collection_%28acc._1951-040%29.jpg","seite":"https://commons.wikimedia.org/wiki/File:Cross_section_of_York-a-Red,_National_Fruit_Collection_(acc._1951-040).jpg","art":"schnitt","urheber":"National Fruit Collection, Brogdale","lizenz":"OGL 2.0","quelle":"nfc-commons","titel":"Cross section of York-a-Red, National Fruit Collection (acc. 1951-040)"}],"farbmessung":[{"bild":"https://upload.wikimedia.org/wikipedia/commons/d/d0/Cross_section_of_York-a-Red%2C_National_Fruit_Collection_%28acc._1951-040%29.jpg","methode":"NFC-Foto","verfahren":"Foto (NFC-Fototafel: 4 ganze Früchte, 2 Schnitte, Fototisch); Weißabgleich