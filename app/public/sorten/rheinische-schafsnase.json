:"commons-fotos","titel":"Schafsnase Europom Luxemburg 334"}],"regionen":[{"region":"DE-NW","art":"verbreitung","belege":[{"quelle":"engelbrecht1889","seite":"90 (Nr. 81)"},{"quelle":"engelbrecht1889","seite":"90 (Nr. 81)"},{"quelle":"engelbrecht1889","seite":"91 (Nr. 82)"}],"original":"die Sorte war in der Gegend um Düren als Schafsnase verbreitet"},{"region":"DE-RP","art":"empfehlung","belege":[{"quelle":"rg_rp-streuobst-sortenempfehlung-2018"}],"original":"Rheinische Schafsnase"},{"region":"DE-TH","art":"empfehlung","belege":[{"quelle":"rg_th-grueneliga-2002"}],"original":"Rheinische Schafsnase"}],"gefaehrdung":[{"stufe":"Rote Liste der gefährdeten einheimischen Nutzpflanzen in Deutschland","belege":[{"quelle":"rg_ble-rote-liste"}],"original":"Rheinische Schafsnase"}]}