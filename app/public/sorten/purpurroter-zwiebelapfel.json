{"id":"purpurroter-zwiebelapfel","name":"Purpurroter Zwiebelapfel","synonyme":[{"name":"Kohlenbacher","beleg":{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Purpurroter_Zwiebelapfel&oldid=250402612"}},{"name":"Christkindler","beleg":{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Purpurroter_Zwiebelapfel&oldid=250402612"}},{"name":"Franzosenapfel","beleg":{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Purpurroter_Zwiebelapfel&oldid=250402612"}},{"name":"Aujäger","beleg":{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Purpurroter_Zwiebelapfel&oldid=250402612"}},{"name":"Talapfel","beleg":{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Purpurroter_Zwiebelapfel&oldid=250402612"}}],"herkunft":{"text":"Lokalsorte aus Mittelbaden zwischen Kenzingen und Kehl; Abstammung unbekannt, nach Wikipedia bereits im 16. Jahrhundert in Straßburg dokumentiert.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Purpurroter_Zwiebelapfel&oldid=250402612"}]},"merkmale":[{"merkmal":"frucht_groesse","wert":"3","original":"Die Frucht ist klein und rot bis purpurrot","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Purpurroter_Zwiebelapfel&oldid=250402612"},{"merkmal":"schale_deckfarbe_farbton","wert":"rot","original":"Die Frucht ist klein und rot bis purpurrot","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Purpurroter_Zwiebelapfel&oldid=250402612"},{"merkmal":"schale_deckfarbe_farbton","wert":"purpurrot","original":"Die Frucht ist klein und rot bis purpurrot","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Purpurroter_Zwiebelapfel&oldid=250402612"},{"merkmal":"stiel_laenge","wert":"3","original":"hat einen kurzen, dicken Stiel","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Purpurroter_Zwiebelapfel&oldid=250402612"},{"merkmal":"stiel_dicke","wert":"7","original":"hat einen kurzen, dicken Stiel","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Purpurroter_Zwiebelapfel&oldid=250402612"},{"merkmal":"verwendung","wert":"most","original":"Der robuste Mostapfel","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Purpurroter_Zwiebelapfel&oldid=250402612"},{"merkmal":"genussreife_beginn","wert":"11","original":"von November bis März genussreif","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Purpurroter_Zwiebelapfel&oldid=250402612"},{"merkmal":"genussreife_ende","wert":"3","original":"von November bis März genussreif","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Purpurroter_Zwiebelapfel&oldid=250402612"},{"merkmal":"baum_wuchs","wert":"7","original":"Der Baum ist starkwüchsig","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Purpurroter_Zwiebelapfel&oldid=250402612"}],"texte":[{"thema":"ueberblick","text":"Regionale Mostapfelsorte aus Mittelbaden mit kleinen, rot bis purpurrot gefärbten Früchten an kurzem, dickem Stiel. Wegen der kräftigen Farbe dienten die Früchte früher als Weihnachtsäpfel, daher auch der Name Christkindler. Die Sorte ist heute selten; der Landesverband für Obstbau, Garten und Landschaft Baden-Württemberg wählte sie zur Streuobstsorte des Jahres 2021.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Purpurroter_Zwiebelapfel&oldid=250402612"}]},{"thema":"herkunft","text":"Die Sorte stammt aus dem mittelbadischen Raum zwischen Kenzingen und Kehl. Ihre Abstammung ist unbekannt; Wikipedia gibt an, dass sie bereits im 16. Jahrhundert in Straßburg dokumentiert sei. Regional ist sie unter mehreren Namen bekannt, darunter Kohlenbacher, Christkindler, Franzosenapfel, Aujäger und Talapfel. In den ausgewerteten Pomologien des 19. Jahrhunderts (Illustrirtes Handbuch, Lauche, Engelbrecht) ist sie nicht beschrieben; der dort als Synonym des Roten Stettiners genannte „Rothe Zwiebelapfel in Baden“ lässt sich ihr nicht sicher zuordnen.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Purpurroter_Zwiebelapfel&oldid=250402612"},{"quelle":"illustr_hb_1","band":"I","seite":"555 (Nr. 261)"}]},{"thema":"frucht","text":"Die Frucht ist klein und rot bis purpurrot gefärbt; der Stiel ist kurz und dick. Weitere Angaben zu Form, Kelch, Schale und Schnitt liegen im ausgewerteten Material nicht vor.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Purpurroter_Zwiebelapfel&oldid=250402612"}]},{"thema":"reife_lagerung","text":"Die Früchte sind von November bis März genussreif.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Purpurroter_Zwiebelapfel&oldid=250402612"}]},{"thema":"baum","text":"Der Baum wächst stark, ist sehr robust gegen Krankheiten und eine typische Streuobstsorte.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Purpurroter_Zwiebelapfel&oldid=250402612"}]},{"thema":"verwendung","text":"Die Sorte wird vor allem als Mostapfel genutzt; wegen ihrer Farbe dienten die Früchte früher als Weihnachtsäpfel.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Purpurroter_Zwiebelapfel&oldid=250402612"}]}],"bilder":[{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/e/ed/Purpurroter_Zwiebelapfel%2C_Christkindler.jpg/960px-Purpurroter_Zwiebelapfel%2C_Christkindler.jpg","seite":"https://commons.wikimedia.org/wiki/File:Purpurroter_Zwiebelapfel,_Christkindler.jpg","art":"frucht","urheber":"Marcel Adler","lizenz":"CC0","quelle":"commons","titel":"Purpurroter Zwiebelapfel, Christkindler.jpg"},{"url":"https://upload.wikimedia.org/wikipedia/commons/4/40/Christkindler-2.JPG","seite":"https://commons.wikimedia.org/wiki/File:Christkindler-2.JPG","art":"frucht","urheber":"HerbertRi","lizenz":"CC BY-SA 3.0","quelle":"commons-fotos","titel":"Christkindler-2"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/4/4e/Molters_15.jpg/960px-Molters_15.jpg","seite":"https://commons.wikimedia.org/wiki/File:Molters_15.jpg","art":"tafel","urheber":"Gottfried Wilhelm Leibniz Bibliothek","lizenz":"gemeinfrei","quelle":"commons-illustrationen","titel":"Molters 15"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/0/0b/Malus_Purpurroter_Zwiebelapfel_4223.jpg/960px-Malus_Purpurroter_Zwiebelapfel_4223.jpg","seite":"https://commons.wikimedia.org/wiki/File:Malus_Purpurroter_Zwiebelapfel_4223.jpg","art":"baum","urheber":"Sven Teschke","lizenz":"CC BY-SA 3.0 DE","quelle":"commons-fotos","titel":"Malus Purpurroter Zwiebelapfel 4223"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/0/03/Kohlenbacher_%28apple%29_jm179355.jpg/960px-Kohlenbacher_%28apple%29_jm179355.jpg","seite":"https://commons.wikimedia.org/wiki/File:Kohlenbacher_(apple)_jm179355.jpg","art":"baum","urheber":"joergens.mi","lizenz":"CC BY-SA 3.0","quelle":"commons-fotos","titel":"Kohlenbacher (apple) jm179355"}]}