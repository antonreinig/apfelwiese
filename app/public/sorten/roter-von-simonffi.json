{"id":"roter-von-simonffi","name":"Roter von Simonffi","synonyme":[{"name":"Zigeunerapfel","beleg":{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Roter_von_Simonffi&oldid=261001331"}},{"name":"Simonffy piros","beleg":{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Roter_von_Simonffi&oldid=261001331"}},{"name":"Zwiebelapfel","beleg":{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Roter_von_Simonffi&oldid=261001331"}}],"herkunft":{"text":"Lokalsorte aus Österreich-Ungarn, in Ungarn als Simonffy piros bekannt. In Niederösterreich, vor allem im Weinviertel, verbreitet; ihre Identität wurde erst durch den Fund einer ungarischen Beschreibung geklärt, die auch ihre Verbreitung zur Zeit der Monarchie belegt.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Roter_von_Simonffi&oldid=261001331"},{"quelle":"web_arche_noah","url":"https://www.arche-noah.at/media/roter_von_simonffi_beschreibung_und_foto.pdf"}]},"merkmale":[{"merkmal":"frucht_groesse","wert":"3","original":"klein bis maximal mittelgroß","quelle":"web_arche_noah","url":"https://www.arche-noah.at/media/roter_von_simonffi_beschreibung_und_foto.pdf"},{"merkmal":"frucht_groesse","wert":"5","original":"klein bis maximal mittelgroß","quelle":"web_arche_noah","url":"https://www.arche-noah.at/media/roter_von_simonffi_beschreibung_und_foto.pdf"},{"merkmal":"frucht_breite","wert":59,"original":"im Schnitt 53 mm hoch und 59 mm breit","quelle":"web_arche_noah","url":"https://www.arche-noah.at/media/roter_von_simonffi_beschreibung_und_foto.pdf"},{"merkmal":"frucht_hoehe","wert":53,"original":"im Schnitt 53 mm hoch und 59 mm breit","quelle":"web_arche_noah","url":"https://www.arche-noah.at/media/roter_von_simonffi_beschreibung_und_foto.pdf"},{"merkmal":"frucht_hoehe_breite","wert":0.9,"original":"im Schnitt 53 mm hoch und 59 mm breit","quelle":"web_arche_noah","url":"https://www.arche-noah.at/media/roter_von_simonffi_beschreibung_und_foto.pdf"},{"merkmal":"frucht_form","wert":"rund","original":"halbkugelförmig bis rund","quelle":"web_arche_noah","url":"https://www.arche-noah.at/media/roter_von_simonffi_beschreibung_und_foto.pdf"},{"merkmal":"frucht_rippung","wert":"3","original":"im Querschnitt fast rund","quelle":"web_arche_noah","url":"https://www.arche-noah.at/media/roter_von_simonffi_beschreibung_und_foto.pdf"},{"merkmal":"frucht_symmetrie","wert":"schief","original":"einseitig etwas höher gebaut, sonst sehr ebenmäßig","quelle":"web_arche_noah","url":"https://www.arche-noah.at/media/roter_von_simonffi_beschreibung_und_foto.pdf"},{"merkmal":"schale_beschaffenheit","wert":"glatt","original":"glatt, fest, glänzend, vom Baum manchmal etwas bläulich bereift","quelle":"web_arche_noah","url":"https://www.arche-noah.at/media/roter_von_simonffi_beschreibung_und_foto.pdf"},{"merkmal":"schale_beschaffenheit","wert":"glaenzend","original":"glatt, fest, glänzend","quelle":"web_arche_noah","url":"https://www.arche-noah.at/media/roter_von_simonffi_beschreibung_und_foto.pdf"},{"merkmal":"schale_beschaffenheit","wert":"bereift","original":"vom Baum manchmal etwas bläulich bereift","quelle":"web_arche_noah","url":"https://www.arche-noah.at/media/roter_von_simonffi_beschreibung_und_foto.pdf"},{"merkmal":"schale_grundfarbe","wert":"weisslichgelb","original":"Grundfarbe grünlichgelb, später weißlichgelb","quelle":"web_arche_noah","url":"https://www.arche-noah.at/media/roter_von_simonffi_beschreibung_und_foto.pdf"},{"merkmal":"schale_deckfarbe_anteil","wert":"9","original":"von roter, flächiger Deckfarbe ganz überdeckt","quelle":"web_arche_noah","url":"https://www.arche-noah.at/media/roter_von_simonffi_beschreibung_und_foto.pdf"},{"merkmal":"schale_deckfarbe_farbton","wert":"dunkelrot","original":"die ganze Frucht dunkelweinrot, fast schwärzlich","quelle":"web_arche_noah","url":"https://www.arche-noah.at/media/roter_von_simonffi_beschreibung_und_foto.pdf"},{"merkmal":"schale_deckfarbe_art","wert":"verwaschen","original":"von roter, flächiger Deckfarbe ganz überdeckt","quelle":"web_arche_noah","url":"https://www.arche-noah.at/media/roter_von_simonffi_beschreibung_und_foto.pdf"},{"merkmal":"schale_deckfarbe_art","wert":"gestreift","original":"schattenseitig noch dunkelweinrot gestreift","quelle":"web_arche_noah","url":"https://www.arche-noah.at/media/roter_von_simonffi_beschreibung_und_foto.pdf"},{"merkmal":"schale_lentizellen_groesse","wert":"3","original":"Lentizellen klein, gelblich, wenig auffallend","quelle":"web_arche_noah","url":"https://www.arche-noah.at/media/roter_von_simonffi_beschreibung_und_foto.pdf"},{"merkmal":"schale_lentizellen_art","wert":"hell","original":"Lentizellen klein, gelblich","quelle":"web_arche_noah","url":"https://www.arche-noah.at/media/roter_von_simonffi_beschreibung_und_foto.pdf"},{"merkmal":"schale_berostung_wangen","wert":"3","original":"vereinzelt zarte Rostfiguren","quelle":"web_arche_noah","url":"https://www.arche-noah.at/media/roter_von_simonffi_beschreibung_und_foto.pdf"},{"merkmal":"kelch_offenheit","wert":"halboffen","original":"klein, halboffen bis offen","quelle":"web_arche_noah","url":"https://www.arche-noah.at/media/roter_von_simonffi_beschreibung_und_foto.pdf"},{"merkmal":"kelch_offenheit","wert":"offen","original":"klein, halboffen bis offen","quelle":"web_arche_noah","url":"https://www.arche-noah.at/media/roter_von_simonffi_beschreibung_und_foto.pdf"},{"merkmal":"kelchgrube_tiefe","wert":"3","original":"Einsenkung flach, mittelweit","quelle":"web_arche_noah","url":"https://www.arche-noah.at/media/roter_von_simonffi_beschreibung_und_foto.pdf"},{"merkmal":"kelchgrube_weite","wert":"5","original":"Einsenkung flach, mittelweit","quelle":"web_arche_noah","url":"https://www.arche-noah.at/media/roter_von_simonffi_beschreibung_und_foto.pdf"},{"merkmal":"kelchhoehle_form","wert":"dreieck_breit","original":"Kelchhöhle klein, dreieckig","quelle":"web_arche_noah","url":"https://www.arche-noah.at/media/roter_von_simonffi_beschreibung_und_foto.pdf"},{"merkmal":"stiel_laenge","wert":"3","original":"meist kurz, auch mittellang, 10–20 mm, dünn","quelle":"web_arche_noah","url":"https://www.arche-noah.at/media/roter_von_simonffi_beschreibung_und_foto.pdf"},{"merkmal":"stiel_laenge","wert":"5","original":"meist kurz, auch mittellang, 10–20 mm, dünn","quelle":"web_arche_noah","url":"https://www.arche-noah.at/media/roter_von_simonffi_beschreibung_und_foto.pdf"},{"merkmal":"stiel_dicke","wert":"3","original":"10–20 mm, dünn","quelle":"web_arche_noah","url":"https://www.arche-noah.at/media/roter_von_simonffi_beschreibung_und_foto.pdf"},{"merkmal":"stielgrube_tiefe","wert":"7","original":"Einsenkung tief, eng","quelle":"web_arche_noah","url":"https://www.arche-noah.at/media/roter_von_simonffi_beschreibung_und_foto.pdf"},{"merkmal":"stielgrube_weite","wert":"3","original":"Einsenkung tief, eng","quelle":"web_arche_noah","url":"https://www.arche-noah.at/media/roter_von_simonffi_beschreibung_und_foto.pdf"},{"merkmal":"schale_berostung_stielgrube","wert":"7","original":"meist mit strahlenförmigem, ockerfarbenen Rost","quelle":"web_arche_noah","url":"https://www.arche-noah.at/media/roter_von_simonffi_beschreibung_und_foto.pdf"},{"merkmal":"kernhaus_form","wert":"zwiebel","original":"Gefäßbündel zwiebelförmig","quelle":"web_arche_noah","url":"https://www.arche-noah.at/media/roter_von_simonffi_beschreibung_und_foto.pdf"},{"merkmal":"kernhaus_lage","wert":"mitte","original":"Kernhaus: klein, mittelständig","quelle":"web_arche_noah","url":"https://www.arche-noah.at/media/roter_von_simonffi_beschreibung_und_foto.pdf"},{"merkmal":"kernfaecher_oeffnung","wert":"geschlossen","original":"Kammern sehr eng, geschlossen","quelle":"web_arche_noah","url":"https://www.arche-noah.at/media/roter_von_simonffi_beschreibung_und_foto.pdf"},{"merkmal":"fleisch_farbe","wert":"gruenlich","original":"grünlichweiß, anfangs fest, abknackend","quelle":"web_arche_noah","url":"https://www.arche-noah.at/media/roter_von_simonffi_beschreibung_und_foto.pdf"},{"merkmal":"fleisch_farbe","wert":"gruenlich","original":"grünlichweiße … Fruchtfleisch","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Roter_von_Simonffi&oldid=261001331"},{"merkmal":"fleisch_festigkeit","wert":"7","original":"anfangs fest, abknackend, später weicher","quelle":"web_arche_noah","url":"https://www.arche-noah.at/media/roter_von_simonffi_beschreibung_und_foto.pdf"},{"merkmal":"fleisch_festigkeit","wert":"5","original":"anfangs fest, abknackend, später weicher","quelle":"web_arche_noah","url":"https://www.arche-noah.at/media/roter_von_simonffi_beschreibung_und_foto.pdf"},{"merkmal":"fleisch_saftigkeit","wert":"7","original":"später weicher saftig","quelle":"web_arche_noah","url":"https://www.arche-noah.at/media/roter_von_simonffi_beschreibung_und_foto.pdf"},{"merkmal":"geschmack_suesse","wert":"5","original":"leicht säuerlichsüß, mit starkem Rosenaroma","quelle":"web_arche_noah","url":"https://www.arche-noah.at/media/roter_von_simonffi_beschreibung_und_foto.pdf"},{"merkmal":"geschmack_saeure","wert":"5","original":"leicht säuerlichsüß, mit starkem Rosenaroma","quelle":"web_arche_noah","url":"https://www.arche-noah.at/media/roter_von_simonffi_beschreibung_und_foto.pdf"},{"merkmal":"geschmack_suesse","wert":"5","original":"schmeckt süßsäuerlich","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Roter_von_Simonffi&oldid=261001331"},{"merkmal":"geschmack_saeure","wert":"5","original":"schmeckt süßsäuerlich","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Roter_von_Simonffi&oldid=261001331"},{"merkmal":"geschmack_aroma","wert":"starkes Rosenaroma","original":"mit starkem Rosenaroma; Geschmackstyp McIntosh","quelle":"web_arche_noah","url":"https://www.arche-noah.at/media/roter_von_simonffi_beschreibung_und_foto.pdf"},{"merkmal":"pflueckreife","wert":"10","original":"Anfang bis Mitte Oktober","quelle":"web_arche_noah","url":"https://www.arche-noah.at/media/roter_von_simonffi_beschreibung_und_foto.pdf"},{"merkmal":"genussreife_beginn","wert":"10","original":"vom Baum weg bis Februar, März","quelle":"web_arche_noah","url":"https://www.arche-noah.at/media/roter_von_simonffi_beschreibung_und_foto.pdf"},{"merkmal":"genussreife_ende","wert":"2","original":"vom Baum weg bis Februar, März","quelle":"web_arche_noah","url":"https://www.arche-noah.at/media/roter_von_simonffi_beschreibung_und_foto.pdf"},{"merkmal":"genussreife_ende","wert":"3","original":"vom Baum weg bis Februar, März","quelle":"web_arche_noah","url":"https://www.arche-noah.at/media/roter_von_simonffi_beschreibung_und_foto.pdf"},{"merkmal":"genussreife_beginn","wert":"10","original":"im Oktober ernte- und genussreif und bis März haltbar","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Roter_von_Simonffi&oldid=261001331"},{"merkmal":"genussreife_ende","wert":"3","original":"im Oktober ernte- und genussreif und bis März haltbar","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Roter_von_Simonffi&oldid=261001331"},{"merkmal":"verwendung","wert":"tafel","original":"ausgezeichneter milder, sehr schöner Tafelapfel","quelle":"web_arche_noah","url":"https://www.arche-noah.at/media/roter_von_simonffi_beschreibung_und_foto.pdf"},{"merkmal":"baum_wuchs","wert":"5","original":"Wuchs mittelstark","quelle":"web_arche_noah","url":"https://www.arche-noah.at/media/roter_von_simonffi_beschreibung_und_foto.pdf"},{"merkmal":"frucht_groesse","wert":"3","quelle":"nfc2025","seite":"Akzession 1948400 (NFC-Früchte)","original":"Small"},{"merkmal":"frucht_form","wert":"walzenfoermig","quelle":"nfc2025","seite":"Akzession 1948400 (NFC-Früchte)","original":"Oblong"},{"merkmal":"frucht_rippung","wert":"1","quelle":"nfc2025","seite":"Akzession 1948400 (NFC-Früchte)","original":"Very light"},{"merkmal":"frucht_kronung","wert":"1","quelle":"nfc2025","seite":"Akzession 1948400 (NFC-Früchte)","original":"Weak"},{"merkmal":"schale_grundfarbe","wert":"gruengelb","quelle":"nfc2025","seite":"Akzession 1948400 (NFC-Früchte)","original":"Green yellow"},{"merkmal":"schale_deckfarbe_anteil","wert":"9","quelle":"nfc2025","seite":"Akzession 1948400 (NFC-Früchte)","original":"Very high"},{"merkmal":"schale_deckfarbe_farbton","wert":"rot","quelle":"nfc2025","seite":"Akzession 1948400 (NFC-Früchte)","original":"Red"},{"merkmal":"schale_deckfarbe_art","wert":"gestreift","quelle":"nfc2025","seite":"Akzession 1948400 (NFC-Früchte)","original":"Flush with stripes"},{"merkmal":"schale_deckfarbe_art","wert":"verwaschen","quelle":"nfc2025","seite":"Akzession 1948400 (NFC-Früchte)","original":"Flush with stripes"},{"merkmal":"schale_berostung_gesamt","wert":"3","quelle":"nfc2025","seite":"Akzession 1948400 (NFC-Früchte)","original":"Low"},{"merkmal":"fleisch_farbe","wert":"weiss","quelle":"nfc2025","seite":"Akzession 1948400 (NFC-Früchte)","original":"White"},{"merkmal":"fleisch_festigkeit","wert":"5","quelle":"nfc2025","seite":"Akzession 1948400 (Verkostung P. Hale, 31/10/2022)","original":"Intermediate"},{"merkmal":"fleisch_saftigkeit","wert":"5","quelle":"nfc2025","seite":"Akzession 1948400 (Verkostung P. Hale, 31/10/2022)","original":"Intermediate to high"},{"merkmal":"fleisch_saftigkeit","wert":"7","quelle":"nfc2025","seite":"Akzession 1948400 (Verkostung P. Hale, 31/10/2022)","original":"Intermediate to high"},{"merkmal":"geschmack_suesse","wert":"5","quelle":"nfc2025","seite":"Akzession 1948400 (Verkostung P. Hale, 31/10/2022)","original":"Intermediate to high"},{"merkmal":"geschmack_suesse","wert":"7","quelle":"nfc2025","seite":"Akzession 1948400 (Verkostung P. Hale, 31/10/2022)","original":"Intermediate to high"},{"merkmal":"geschmack_saeure","wert":"7","quelle":"nfc2025","seite":"Akzession 1948400 (Verkostung P. Hale, 31/10/2022)","original":"High"},{"merkmal":"verwendung","wert":"tafel","quelle":"nfc2025","seite":"Akzession 1948400","original":"Dessert"},{"merkmal":"pflueckreife","wert":"10","quelle":"nfc2025","seite":"Akzession 1948400","original":"Mid October"},{"merkmal":"genussreife_ende","wert":"3","quelle":"nfc2025","seite":"Akzession 1948400","original":"March"},{"merkmal":"bluete_zeit","wert":"3","quelle":"nfc2025","seite":"Akzession 1948400","original":"Klasse 4 (10 % der Blüten offen, Tag 122)"},{"merkmal":"bluete_zeit","wert":"5","quelle":"nfc2025","seite":"Akzession 1948400","original":"Klasse 4 (10 % der Blüten offen, Tag 122)"}],"texte":[{"thema":"ueberblick","text":"Kleiner bis mittelgroßer, fast schwarzroter Winterapfel aus dem ehemaligen Österreich-Ungarn, in Niederösterreich unter dem Namen Zigeunerapfel verbreitet und beliebt. Das Fleisch ist grünlichweiß, saftig, mild säuerlichsüß und deutlich nach Rosen duftend. Die dekorativen Früchte wurden traditionell auch als Christbaumschmuck verwendet.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Roter_von_Simonffi&oldid=261001331"},{"quelle":"web_arche_noah","url":"https://www.arche-noah.at/media/roter_von_simonffi_beschreibung_und_foto.pdf"}]},{"thema":"herkunft","text":"Die Sorte stammt aus Österreich-Ungarn; in Ungarn heißt sie Simonffy piros. In Österreich trägt sie mehrere Lokalnamen, etwa Zwiebelapfel (im Burgenland), am häufigsten Zigeunerapfel. Nach dem Arche-Noah-Sortenblatt tragen diesen Namen allerdings viele rote Sorten; die Identität ließ sich erst über eine ungarische Beschreibung klären, die auch die Ausbreitung zur Zeit der Monarchie dokumentiert. Verbreitet ist sie in ganz Niederösterreich, besonders im Weinviertel, und auf Streuobstwiesen.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Roter_von_Simonffi&oldid=261001331"},{"quelle":"web_arche_noah","url":"https://www.arche-noah.at/media/roter_von_simonffi_beschreibung_und_foto.pdf"}]},{"thema":"frucht","text":"Die Früchte sind klein bis höchstens mittelgroß, im Mittel etwa 59 mm breit und 53 mm hoch, halbkugelig bis rund mit fast rundem Querschnitt; eine Seite ist etwas höher gebaut, sonst wirken sie sehr ebenmäßig. Der kleine, halb offene bis offene Kelch mit stark weißfilzigen Blättchen sitzt in einer flachen, mittelweiten, gefältelten Einsenkung mit fein geripptem Rand. Der meist kurze, teils mittellange Stiel (10–20 mm) ist dünn und steht in einer tiefen, engen Stielgrube mit meist strahlig auslaufendem, ockerfarbenem Rost.","belege":[{"quelle":"web_arche_noah","url":"https://www.arche-noah.at/media/roter_von_simonffi_beschreibung_und_foto.pdf"}]},{"thema":"schale","text":"Die Schale ist glatt, fest und glänzend, vom Baum manchmal leicht bläulich bereift. Die grünlichgelbe, später weißlichgelbe Grundfarbe ist meist nicht zu sehen, weil eine flächige Röte die Frucht ganz bedeckt; schattenseits ist sie zusätzlich dunkel weinrot gestreift, meist aber die ganze Frucht fast schwärzlich weinrot und wie lackiert. Die Lentizellen sind klein, gelblich und unauffällig, vereinzelt gibt es zarte Rostfiguren und häufig Warzen.","belege":[{"quelle":"web_arche_noah","url":"https://www.arche-noah.at/media/roter_von_simonffi_beschreibung_und_foto.pdf"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Roter_von_Simonffi&oldid=261001331"}]},{"thema":"schnitt","text":"Nach dem Arche-Noah-Sortenblatt ist das Kernhaus klein und sitzt in der Mitte der Frucht; die Gefäßbündellinie ist zwiebelförmig. Die Achse ist nur minimal hohl. Die Kammern sind sehr eng und geschlossen, ihre Wände zerrissen und ohrenförmig. Die Kerne sind rehbraun, oval und etwa 7 mm lang und 4,5 mm breit. Die Kelchhöhle ist klein und dreieckig, die Kelchröhre reicht manchmal dünn bis ins Kernhaus; die Staubfäden sitzen ober- bis mittelständig. Am Schnitt ist das Fleisch grünlichweiß.","belege":[{"quelle":"web_arche_noah","url":"https://www.arche-noah.at/media/roter_von_simonffi_beschreibung_und_foto.pdf"}]},{"thema":"fleisch_geschmack","text":"Das grünlichweiße Fleisch ist anfangs fest und knackig, später weicher und saftig. Es schmeckt mild süßsäuerlich mit kräftigem Rosenaroma; das Sortenblatt ordnet den Geschmack dem Typ McIntosh zu.","belege":[{"quelle":"web_arche_noah","url":"https://www.arche-noah.at/media/roter_von_simonffi_beschreibung_und_foto.pdf"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Roter_von_Simonffi&oldid=261001331"}]},{"thema":"reife_lagerung","text":"Gepflückt wird Anfang bis Mitte Oktober; um Mitte Oktober fallen die Früchte vom Baum, nehmen dabei aber kaum Schaden. Sie sind direkt vom Baum genießbar und lassen sich problemlos bis Februar oder März lagern.","belege":[{"quelle":"web_arche_noah","url":"https://www.arche-noah.at/media/roter_von_simonffi_beschreibung_und_foto.pdf"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Roter_von_Simonffi&oldid=261001331"}]},{"thema":"verwendung","text":"Das Sortenblatt beschreibt den Apfel als milden, sehr schönen Tafelapfel. Traditionell dienten die dekorativen Früchte auch als Christbaumäpfel.","belege":[{"quelle":"web_arche_noah","url":"https://www.arche-noah.at/media/roter_von_simonffi_beschreibung_und_foto.pdf"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Roter_von_Simonffi&oldid=261001331"}]},{"thema":"baum","text":"Der Wuchs ist mittelstark; der Baum bildet schöne, runde, dicht verzweigte, mittelgroße Kronen und eignet sich für alle Baumformen und Unterlagen. Er trägt sehr früh, mittelhoch bis hoch und sehr regelmäßig. Die Sorte gedeiht auf warmen, trockeneren Standorten wie im Weinviertel und auch im südlichen Waldviertel; in raueren Lagen nehmen Schorf und Krebs zu. Die Früchte sind auffällig wenig wurmig; in geringem Maß tritt Kernhausschimmel auf.","belege":[{"quelle":"web_arche_noah","url":"https://www.arche-noah.at/media/roter_von_simonffi_beschreibung_und_foto.pdf"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Roter_von_Simonffi&oldid=261001331"}]},{"thema":"unterscheidung","text":"Der Name Zigeunerapfel wird für viele rote Sorten gebraucht und taugt allein nicht zur Bestimmung. Ähnliche Früchte haben nach dem Arche-Noah-Sortenblatt McIntosh, der Schwarzschillernde Kohlapfel und Büttners Schwarzschillernde Goldrenette.","belege":[{"quelle":"web_arche_noah","url":"https://www.arche-noah.at/media/roter_von_simonffi_beschreibung_und_foto.pdf"}]},{"thema":"frucht","text":"Nach den Erhebungen der National Fruit Collection: kleine, walzenförmige Frucht mit grünlich gelber Grundfarbe und flächiger und gestreifter roter Deckfarbe auf fast der ganzen Schale. Die Schale ist wenig berostet, das Fruchtfleisch weiß. Das Fleisch ist mittelfest und mäßig saftig bis saftig; im Geschmack mäßig bis deutlich süß und deutlich sauer, mit mittlerem bis kräftigem Aroma. In der Sammlung als Tafelapfel geführt; pflückreif Mitte Oktober, lagerfähig bis März.","belege":[{"quelle":"nfc2025","seite":"Akzession 1948400"}]}],"bilder":[{"url":"https://upload.wikimedia.org/wikipedia/commons/0/0f/Roter_von_Simonffi.jpg","seite":"https://commons.wikimedia.org/wiki/File:Roter_von_Simonffi.jpg","art":"frucht","urheber":"Loimo","lizenz":"CC BY-SA 4.0","quelle":"commons","titel":"Roter von Simonffi.jpg"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/2/2a/Roter_von_Simonffi_Burgenland.jpg/960px-Roter_von_Simonffi_Burgenland.jpg","seite":"https://commons.wikimedia.org/wiki/File:Roter_von_Simonffi_Burgenland.jpg","art":"frucht","urheber":"Johann Werfring","lizenz":"CC BY-SA 4.0","quelle":"commons","titel":"Roter von Simonffi Burgenland.jpg"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/0/0d/Roter_von_Simonffi_Okt_2021_a.jpg/960px-Roter_von_Simonffi_Okt_2021_a.jpg","seite":"https://commons.wikimedia.org/wiki/File:Roter_von_Simonffi_Okt_2021_a.jpg","art":"baum","urheber":"Loimo","lizenz":"CC BY-SA 4.0","quelle":"commons-fotos","titel":"Roter von Simonffi Okt 2021 a"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/2/2a/Roter_von_Simonffi_Okt_2021_b.jpg/960px-Roter_von_Simonffi_Okt_2021_b.jpg","seite":"https://commons.wikimedia.org/wiki/File:Roter_von_Simonffi_Okt_2021_b.jpg","art":"baum","urheber":"Loimo","lizenz":"CC BY-SA 4.0","quelle":"commons-fotos","titel":"Roter von Simonffi Okt 2021 b"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/c3/Apple_tree_Simonffy_piros_%28Southern_Burgenland%2C_April_2026%29.jpg/960px-Apple_tree_Simonffy_piros_%28Southern_Burgenland%2C_April_2026%29.jpg","seite":"https://commons.wikimedia.org/wiki/File:Apple_tree_Simonffy_piros_(Southern_Burgenland,_April_2026).jpg","art":"bluete","urheber":"Eva Maria Mandl","lizenz":"CC BY-SA 4.0","quelle":"commons-fotos","titel":"Apple tree Simonffy piros (Southern Burgenland, April 2026)"},{"url":"https://upload.wikimedia.org/wikipedia/commons/1/18/Cross_section_of_Simonffy_Piros%2C_National_Fruit_Collection_%28acc._1948-400%29.jpg","seite":"https://commons.wikimedia.org/wiki/File:Cross_section_of_Simonffy_Piros,_National_Fruit_Collection_(acc._1948-400).jpg","art":"schnitt","urheber":"National Fruit Collection, Brogdale","lizenz":"OGL 2.0","quelle":"nfc-commons","titel":"Cross section of Simonffy Piros, National Fruit Collection (acc. 1948-400)"},{"url":"https://upload.wikimedia.org/wikipedia/commons/b/bf/Simonffy_Piros_on_tree%2C_National_Fruit_Collection_%28acc._1948-400%29.jpg","seite":"https://commons.wikimedia.org/wiki/File:Simonffy_Piros_on_tree,_National_Fruit_Collection_(acc._1948-400).jpg","art":"baum","urheber":"National Fruit Collection, Brogdale","lizenz":"OGL 2.0","quelle":"nfc-commons","titel":"Simonffy Piros on tree, National Fruit Collection (acc. 1948-400)"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/98/Zwiebelapfel_%28apple%29_jm156656.jpg/960px-Zwiebelapfel_%28apple%29_jm156656.jpg","seite":"https://commons.wikimedia.org/wiki/File:Zwiebelapfel_(apple)_jm156656.jpg","art":"schnitt","urheber":"Joergens.mi","lizenz":"CC BY-SA 3.0","quelle":"commons-fotos","titel":"Zwiebelapfel (apple) jm156656"}],"munq":1377,"akzessionen":[{"sammlung":"UK National Fruit Collection (Brogdale)","nummer":"1948400","name":"Simonffy Piros"}],"farbmessung":[{"bild":"https://upload.wikimedia.org/wikipedia/commons/1/18/Cross_section_of_Simonffy_Piros%2C_National_Fruit_Collection_%28acc._1948-400%29.jpg","methode":"NFC-Foto","verfahren":"Foto (NFC-Fototafel: 4 ganze Früchte, 2 Schnitte, Fototisch); Weißabgleich über den Hintergrund; Frucht per Hintergrundmodell freigestellt; Schalenpixel ohne Glanzlichter einzeln klassifiziert: Grundfarbe aus gelbgrünen Pixeln, Deckfarbe = Pixel mit deutlich höherem a* als die Grundfarbe (auch dunkle Rot- und Braunrottöne), Anteile über Pixel; Höhe/Breite aus dem Längsschnitt","grundfarbe":"#a99656","deckfarbe":"#7e3741","deckfarbeAnteil":0.69,"fleischfarbe":"#bfbeb4","hoeheZuBreite":0.869}]}