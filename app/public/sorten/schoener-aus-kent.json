{"id":"schoener-aus-kent","name":"Schöner aus Kent","synonyme":[{"name":"Beauty of Kent","beleg":{"quelle":"engelbrecht1889","seite":"307 (Nr. 275)"}},{"name":"Beauté de Kent","beleg":{"quelle":"engelbrecht1889","seite":"307 (Nr. 275)"}}],"herkunft":{"text":"Herkunft nach Hogg unbekannt; Forsyth machte die Sorte 1824 bekannt. Mitte des 19. Jahrhunderts in England und Amerika sehr verbreitet, in Deutschland erst in einigen Baumschulen und Gärten.","belege":[{"quelle":"illustr_hb_1","band":"I","seite":"113"}],"jahr":1824},"merkmale":[{"merkmal":"frucht_breite","wert":79,"original":"Gestalt 79:57—63","quelle":"engelbrecht1889","seite":"307 (Nr. 275)"},{"merkmal":"frucht_hoehe","wert":60,"original":"Gestalt 79:57—63","quelle":"engelbrecht1889","seite":"307 (Nr. 275)"},{"merkmal":"frucht_hoehe_breite","wert":0.76,"original":"Gestalt 79:57—63","quelle":"engelbrecht1889","seite":"307 (Nr. 275)"},{"merkmal":"frucht_form","wert":"flachkonisch","original":"abgest. flachrund kegelf.","quelle":"engelbrecht1889","seite":"307 (Nr. 275)"},{"merkmal":"frucht_breiteste_stelle","wert":"stiel","original":"etwas stielbauch.","quelle":"engelbrecht1889","seite":"307 (Nr. 275)"},{"merkmal":"frucht_symmetrie","wert":"schief","original":"Hälften ungleich","quelle":"engelbrecht1889","seite":"307 (Nr. 275)"},{"merkmal":"frucht_rippung","wert":"3","original":"Querschnitt nicht ganz rund","quelle":"engelbrecht1889","seite":"307 (Nr. 275)"},{"merkmal":"frucht_kronung","wert":"5","original":"zwischen breiten, ungleichmässig, flach doch deutlich über die Frucht laufenden Rippen","quelle":"engelbrecht1889","seite":"307 (Nr. 275)"},{"merkmal":"kelch_offenheit","wert":"geschlossen","original":"Kelch geschlossen bis fast halb offen, ziemlich klein","quelle":"engelbrecht1889","seite":"307 (Nr. 275)"},{"merkmal":"kelch_offenheit","wert":"halboffen","original":"Kelch geschlossen bis fast halb offen, ziemlich klein","quelle":"engelbrecht1889","seite":"307 (Nr. 275)"},{"merkmal":"kelchgrube_tiefe","wert":"