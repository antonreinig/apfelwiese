form","wert":"zwiebel","original":"Kernhaus 37:32, rundlich zwiebelf.","quelle":"engelbrecht1889","seite":"84 (Nr. 75)"},{"merkmal":"kernfaecher_oeffnung","wert":"offen","original":"Kammern 11:23 … mittelgeräumig, offen","quelle":"engelbrecht1889","seite":"84 (Nr. 75)"},{"merkmal":"kernfaecher_oeffnung","wert":"offen","original":"Fächer groß, offen und geräumig","quelle":"illustr_hb_1","band":"I","seite":"59"},{"merkmal":"kernhaus_achse","wert":"offen","original":"Achsenh. mittelbreit","quelle":"engelbrecht1889","seite":"84 (Nr. 75)"},{"merkmal":"kerne_form","wert":"eifoermig","original":"Kerne zu 1 bis 2, mittelgross, länglich eiförmig, gespitzt, braun","quelle":"engelbrecht1889","seite":"84 (Nr. 75)"},{"merkmal":"kelchhoehle_form","wert":"dreieck_lang","original":"Kelchhöhle kegel- bis kegeltrichterförmig, ⅗ bis ⅔ zur Achsenhöhle","quelle":"engelbrecht1889","seite":"84 (Nr. 75)"},{"merkmal":"kelchhoehle_form","wert":"trichter_lang","original":"Kelchhöhle kegel- bis kegeltrichterförmig, ⅗ bis ⅔ zur Achsenhöhle","quelle":"engelbrecht1889","seite":"84 (Nr. 75)"},{"merkmal":"kelchhoehle_form","wert":"trichter_kurz","original":"Kelchhöhle: trichterförmig mit kurzer Röhre","quelle":"illustr_hb_1","band":"I","seite":"59"},{"merkmal":"fleisch_farbe","wert":"gruenlich","original":"Fleisch hellgrünlichweiss, fast weisslich","quelle":"engelbrecht1889","seite":"84 (Nr. 75)"},{"merkmal":"fleisch_farbe","wert":"weiss","original":"Fleisch hellgrünlichweiss, fast weisslich","quelle":"engelbrecht1889","seite":"84 (Nr. 75)"},{"merkmal":"fleisch_farbe","wert":"cremeweiss","original":"mit süß-säuerlichem, gelblich weißem Fruchtfleisch","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Pommerscher_Krummstiel&oldid=268636980"},{"merkmal":"fleisch_festigkeit","wert":"5","original":"ziemlich fein, markig bis mürbe","quelle":"engelbrecht1889","seite":"84 (Nr. 75)"},{"merkmal":"fleisch_festigkeit","wert":"3","original":"ziemlich fein, markig bis mürbe","quelle":"eng