{"id":"roter-pariner","name":"Roter Pariner","synonyme":[{"name":"Rote Pariner","beleg":{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Roter_Pariner&oldid=260711644"}},{"name":"Parine","beleg":{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Roter_Pariner&oldid=260711644"}},{"name":"Pariner Apfel","beleg":{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Roter_Pariner&oldid=260711644"}},{"name":"Pariner Weihnachtsapfel","beleg":{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Roter_Pariner&oldid=260711644"}}],"herkunft":{"text":"Um 1900 in der 1888 gegründeten Baumschule Welchert in Groß Parin (Schleswig-Holstein) entstanden und nach dem Ort benannt; Lokalsorte im Raum Lübeck.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Roter_Pariner&oldid=260711644"}],"land":"DE","landSicher":true,"ort":"Groß Parin","jahr":1900},"merkmale":[{"merkmal":"frucht_groesse","wert":"5","original":"Früchte sind mittelgroß","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Roter_Pariner&oldid=260711644"},{"merkmal":"frucht_form","wert":"rund","original":"kugelförmigen bis kugelförmig abgeflachten Früchte","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Roter_Pariner&oldid=260711644"},{"merkmal":"frucht_form","wert":"flachrund","original":"kugelförmigen bis kugelförmig abgeflachten Früchte","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Roter_Pariner&oldid=260711644"},{"merkmal":"schale_beschaffenheit","wert":"glatt","original":"Die glatte, leicht wachsige Schale","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Roter_Pariner&oldid=260711644"},{"merkmal":"schale_grundfarbe","wert":"gelb","original":"eine gelbe – an nicht beschienenen Stellen gelegentlich auch noch grüne – Grundfarbe","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Roter_Pariner&oldid=260711644"},{"merkmal":"schale_deckfarbe_anteil","wert":"9","original":"eine durchgehend rote Deckfarbe","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Roter_Pariner&oldid=260711644"},{"merkmal":"schale_deckfarbe_farbton","wert":"rot","original":"eine durchgehend rote Deckfarbe","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Roter_Pariner&oldid=260711644"},{"merkmal":"schale_lentizellen_art","wert":"hell","original":"mit hellen Lentizellen","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Roter_Pariner&oldid=260711644"},{"merkmal":"kelch_offenheit","wert":"offen","original":"unterhalb der offenen Kelchblätter","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Roter_Pariner&oldid=260711644"},{"merkmal":"kelchgrube_tiefe","wert":"3","original":"Die flache Kelchgrube","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Roter_Pariner&oldid=260711644"},{"merkmal":"kelchhoehle_form","wert":"trichter_kurz","original":"trichterförmige Kelchhöhle von geringer Tiefe","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Roter_Pariner&oldid=260711644"},{"merkmal":"kernfaecher_oeffnung","wert":"geschlossen","original":"Das Kerngehäuse ist geschlossen","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Roter_Pariner&oldid=260711644"},{"merkmal":"stiel_laenge","wert":"3","original":"der Stiel ist kurz","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Roter_Pariner&oldid=260711644"},{"merkmal":"fleisch_farbe","wert":"weiss","original":"Das Fruchtfleisch ist weiß, sehr fest","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Roter_Pariner&oldid=260711644"},{"merkmal":"fleisch_festigkeit","wert":"7","original":"Das Fruchtfleisch ist weiß, sehr fest","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Roter_Pariner&oldid=260711644"},{"merkmal":"geschmack_saeure","wert":"7","original":"leicht würzig und säuerlich","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Roter_Pariner&oldid=260711644"},{"merkmal":"geschmack_aroma","wert":"leicht würzig","original":"leicht würzig und säuerlich","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Roter_Pariner&oldid=260711644"},{"merkmal":"verwendung","wert":"kueche","original":"zur Verarbeitung als Bratapfel und Kuchenapfel","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Roter_Pariner&oldid=260711644"},{"merkmal":"verwendung","wert":"most","original":"sowie zum Entsaften","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Roter_Pariner&oldid=260711644"},{"merkmal":"pflueckreife","wert":"10","original":"im Oktober erntereif","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Roter_Pariner&oldid=260711644"},{"merkmal":"genussreife_beginn","wert":"12","original":"Genußreife … nach Lagerung ab Ende Dezember oder später","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Roter_Pariner&oldid=260711644"},{"merkmal":"genussreife_ende","wert":"3","original":"bis März … genussreif","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Roter_Pariner&oldid=260711644"},{"merkmal":"bluete_zeit","wert":"6","original":"Die Blüte des Roten Pariners ist weiß und erfolgt mittelspät (gleichzeitig mit C","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Roter_Pariner&oldid=260711644"},{"merkmal":"lagerfaehigkeit","wert":"7","original":"ab Ende Dezember bis März genussreif","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Roter_Pariner&oldid=260711644"},{"merkmal":"gesundheit","wert":"7","original":"Der robuste Baum","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Roter_Pariner&oldid=260711644"},{"merkmal":"ertrag_alternanz","wert":"regelmaessig","original":"trägt reich und regelmäßig ohne Neigung zur Alternanz","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Roter_Pariner&oldid=260711644"},{"merkmal":"hochstamm","wert":"gut","original":"eignet sich für extensiven Streuobstanbau","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Roter_Pariner&oldid=260711644"}],"texte":[{"thema":"ueberblick","text":"Der Rote Pariner ist eine schleswig-holsteinische Lokalsorte aus dem Raum Lübeck, die um 1900 in Groß Parin entstand. Die mittelgroßen, runden bis flachrunden Früchte sind ringsum rot, das weiße Fleisch ist sehr fest und säuerlich. Als Winterapfel wird er im Oktober geerntet, ist ab Ende Dezember genussreif und dient vor allem als Brat-, Kuchen- und Saftapfel.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Roter_Pariner&oldid=260711644"}]},{"thema":"herkunft","text":"Die Sorte entstand um 1900 in der 1888 gegründeten Baumschule Welchert in Groß Parin und wurde nach diesem Ort benannt. Sie ist nur als Lokalsorte im Raum Lübeck verbreitet. In den ausgewerteten Werken des 19. Jahrhunderts kommt sie nicht vor.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Roter_Pariner&oldid=260711644"}]},{"thema":"frucht","text":"Die Früchte sind mittelgroß, kugelförmig bis abgeflacht kugelförmig und bleiben unter 10 cm Durchmesser. Der Stiel ist kurz. Die offenen Kelchblätter sitzen in einer flachen Kelchgrube.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Roter_Pariner&oldid=260711644"}]},{"thema":"schale","text":"Die Schale ist glatt und leicht wachsig. Die Grundfarbe ist gelb, an unbeschienenen Stellen gelegentlich noch grün; darüber liegt eine durchgehende rote Deckfarbe mit hellen Schalenpunkten.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Roter_Pariner&oldid=260711644"}]},{"thema":"schnitt","text":"Die flache Kelchgrube geht in eine trichterförmige Kelchhöhle von geringer Tiefe über. Das Kerngehäuse ist geschlossen. Das Fruchtfleisch ist am Schnitt weiß. Weitere Angaben zu Kammern, Achse und Kernen liegen nicht vor.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Roter_Pariner&oldid=260711644"}]},{"thema":"fleisch_geschmack","text":"Das weiße Fleisch ist sehr fest, leicht würzig und säuerlich. Geschält schmeckt die Frucht deutlich besser.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Roter_Pariner&oldid=260711644"}]},{"thema":"reife_lagerung","text":"Die Ernte erfolgt im Oktober. Die Früchte sind dann sehr hart und kaum druckempfindlich, welken auf dem Lager kaum und sind ab Ende Dezember bis März genussreif, bei guter Lagerung auch deutlich länger.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Roter_Pariner&oldid=260711644"}]},{"thema":"baum","text":"Der robuste Baum wächst hochkronig, trägt reich und regelmäßig ohne Neigung zur Alternanz und eignet sich für extensiven Streuobstanbau. Er blüht weiß und mittelspät, etwa gleichzeitig mit Cox Orange und Elstar.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Roter_Pariner&oldid=260711644"}]},{"thema":"verwendung","text":"Die Sorte wird vor allem als Bratapfel, Kuchenapfel und zum Entsaften verwendet. Besonders die kleineren Früchte dienen als Weihnachtsapfel zur Dekoration.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Roter_Pariner&oldid=260711644"}]}],"bilder":[{"url":"https://upload.wikimedia.org/wikipedia/commons/2/2f/Malus_-_Roter_Pariner_am_Baum.JPG","seite":"https://commons.wikimedia.org/wiki/File:Malus_-_Roter_Pariner_am_Baum.JPG","art":"baum","urheber":"Genet","lizenz":"CC BY-SA 3.0","quelle":"commons","titel":"Malus - Roter Pariner am Baum.JPG"},{"url":"https://upload.wikimedia.org/wikipedia/commons/d/d9/Malus_-_Roter_Pariner-_Blossom.JPG","seite":"https://commons.wikimedia.org/wiki/File:Malus_-_Roter_Pariner-_Blossom.JPG","art":"bluete","urheber":"Genet","lizenz":"CC BY-SA 3.0","quelle":"commons","titel":"Malus - Roter Pariner- Blossom.JPG"},{"url":"https://upload.wikimedia.org/wikipedia/commons/8/8f/Malus_-_Roter-Pariner.JPG","seite":"https://commons.wikimedia.org/wiki/File:Malus_-_Roter-Pariner.JPG","art":"frucht","urheber":"Genet","lizenz":"CC BY-SA 3.0","quelle":"commons","titel":"Malus - Roter-Pariner.JPG"},{"url":"https://upload.wikimedia.org/wikipedia/commons/3/3f/Malus_-_Roter_Pariner_-_seeds.JPG","seite":"https://commons.wikimedia.org/wiki/File:Malus_-_Roter_Pariner_-_seeds.JPG","art":"frucht","urheber":"Genet","lizenz":"CC BY-SA 3.0","quelle":"commons","titel":"Malus - Roter Pariner - seeds.JPG"}],"regionen":[{"region":"DE-SH","art":"herkunft","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Roter_Pariner&oldid=260711644"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Roter_Pariner&oldid=260711644"},{"quelle":"rg_shhh-pv-sortenempfehlung","seite":"Spalte Herkunft"}]},{"region":"DE-SH","art":"verbreitung","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Roter_Pariner&oldid=260711644"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Roter_Pariner&oldid=260711644"},{"quelle":"rg_shhh-pv-sortenempfehlung","seite":"Spalte Herkunft"}],"original":"nur als Lokalsorte im Raum Lübeck verbreitet"},{"region":"DE-SH","art":"empfehlung","belege":[{"quelle":"rg_shhh-pv-sortenempfehlung"}],"original":"Roter Pariner"},{"region":"DE-HH","art":"empfehlung","belege":[{"quelle":"rg_shhh-pv-sortenempfehlung"}],"original":"Roter Pariner"}]}