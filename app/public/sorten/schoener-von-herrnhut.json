{"id":"schoener-von-herrnhut","name":"Schöner von Herrnhut","synonyme":[{"name":"Herrnhut","beleg":{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Schöner_von_Herrnhut&oldid=222815346"}},{"name":"Herrnhuter Taubenapfel","beleg":{"quelle":"web_streuobst_bayern","url":"https://www.streuobst-in-bayern.de/detail/id=62a2f07e0b4b083d0dcbdd4a"}}],"herkunft":{"text":"Herrnhut bei Zittau (Sachsen). Zufallssämling, um 1880 von A. Heintze gefunden, ab etwa 1900 im Handel.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Schöner_von_Herrnhut&oldid=222815346"},{"quelle":"web_streuobst_bayern","url":"https://www.streuobst-in-bayern.de/detail/id=62a2f07e0b4b083d0dcbdd4a"}],"land":"DE","landSicher":true,"ort":"Herrnhut bei Zittau","jahr":1880},"merkmale":[{"merkmal":"frucht_groesse","wert":"5","original":"mittelgroß, um 100 g, bei reichem Behang kleiner","quelle":"web_streuobst_bayern","url":"https://www.streuobst-in-bayern.de/detail/id=62a2f07e0b4b083d0dcbdd4a"},{"merkmal":"frucht_gewicht","wert":100,"original":"mittelgroß, um 100 g","quelle":"web_streuobst_bayern","url":"https://www.streuobst-in-bayern.de/detail/id=62a2f07e0b4b083d0dcbdd4a"},{"merkmal":"frucht_form","wert":"unregelmaessig","original":"ungleichmäßig, hochgebaut, mit flachen Kanten","quelle":"web_streuobst_bayern","url":"https://www.streuobst-in-bayern.de/detail/id=62a2f07e0b4b083d0dcbdd4a"},{"merkmal":"frucht_rippung","wert":"5","original":"ungleichmäßig, hochgebaut, mit flachen Kanten","quelle":"web_streuobst_bayern","url":"https://www.streuobst-in-bayern.de/detail/id=62a2f07e0b4b083d0dcbdd4a"},{"merkmal":"kelchgrube_tiefe","wert":"3","original":"Flache, faltige Kelcheinsenkung","quelle":"web_streuobst_bayern","url":"https://www.streuobst-in-bayern.de/detail/id=62a2f07e0b4b083d0dcbdd4a"},{"merkmal":"frucht_kronung","wert":"5","original":"Flache, faltige Kelcheinsenkung","quelle":"web_streuobst_bayern","url":"https://www.streuobst-in-bayern.de/detail/