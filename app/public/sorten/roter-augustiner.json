{"id":"roter-augustiner","name":"Roter Augustiner","synonyme":[{"name":"Rother Augustiner","beleg":{"quelle":"engelbrecht1889","seite":"144 (Nr. 128)"}},{"name":"Rother Herbst-Tafftapfel","beleg":{"quelle":"illustr_hb_4","band":"IV","seite":"47"}},{"name":"Tafft-Apfel","beleg":{"quelle":"illustr_hb_4","band":"IV","seite":"47"}},{"name":"Sammetapfel","beleg":{"quelle":"illustr_hb_4","band":"IV","seite":"47"}},{"name":"Seidenrock","beleg":{"quelle":"illustr_hb_4","band":"IV","seite":"47"}},{"name":"Wollenschläger","beleg":{"quelle":"illustr_hb_4","band":"IV","seite":"47"}}],"herkunft":{"text":"Diel erhielt die Sorte aus dem ehemaligen kurfürstlichen Garten in Oberlahnstein und leitete den Namen vermutlich von einem Augustinerkloster ab; im 19. Jahrhundert unter mehreren Volksnamen in Süddeutschland verbreitet.","belege":[{"quelle":"illustr_hb_4","band":"IV","seite":"47"}]},"merkmale":[{"merkmal":"frucht_breite","wert":70,"original":"Gestalt 70:56—59","quelle":"engelbrecht1889","seite":"144 (Nr. 128)"},{"merkmal":"frucht_hoehe","wert":57.5,"original":"Gestalt 70:56—59","quelle":"engelbrecht1889","seite":"144 (Nr. 128)"},{"merkmal":"frucht_hoehe_breite","wert":0.82,"original":"Gestalt 70:56—59","quelle":"engelbrecht1889","seite":"144 (Nr. 128)"},{"merkmal":"frucht_form","wert":"rund","original":"abgest. rundlich, wenig stielbauch.","quelle":"engelbrecht1889","seite":"144 (Nr. 128)"},{"merkmal":"frucht_breiteste_stelle","wert":"stiel","original":"wenig stielbauch.","quelle":"engelbrecht1889","seite":"144 (Nr. 128)"},{"merkmal":"frucht_symmetrie","wert":"schief","original":"Hälften nicht ganz gleich","quelle":"engelbrecht1889","seite":"144 (Nr. 128)"},{"merkmal":"frucht_rippung","wert":"5","original":"Querschnitt flachkantig","quelle":"engelbrecht1889","seite":"144 (Nr. 128)"},{"merkmal":"kelch_offenheit","wert":"offen","original":"Kelch offen bis halb offen","quelle":"engelbrecht1889","seite":"144 (Nr. 128)"},{"merkmal":"kelch_offenheit","wert":"halboffen","original":"Ke