{"id":"berner-rosenapfel","name":"Berner Rosenapfel","synonyme":[{"name":"Neuer Berner Rosenapfel","beleg":{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Berner_Rosenapfel&oldid=249981550"}},{"name":"Berner Rosenäpple","beleg":{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Berner_Rosenapfel&oldid=249981550"}},{"name":"Berner Rosen","beleg":{"quelle":"nfc2025","seite":"Akzession 1947067"}}],"herkunft":{"text":"Zufallssämling, um 1870 von F. Baumann und Adolf Daepp auf dem Grundstück der Familie Baumann in Oppligen (Kanton Bern, Schweiz) gefunden; der Mutterbaum trug 1888 erste Früchte. Die Baumschule Daepp vermehrte die Sorte und brachte sie als „Neuer Berner Rosen Apfel“ in der Schweiz und in Deutschland in den Handel. Nach einer genomweiten SNP-Analyse sind Roter Winter-Kalvill und Sauergrauech die Eltern.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Berner_Rosenapfel&oldid=249981550"},{"quelle":"web_bogl_bw","url":"https://www.bogl-bw.de/berner-rosenapfel/"}],"land":"CH","landSicher":true,"ort":"Oppligen (Kanton Bern)","jahr":1870},"merkmale":[{"merkmal":"frucht_groesse","wert":"5","original":"Mittelgrosse Äpfel","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Berner_Rosenapfel&oldid=249981550"},{"merkmal":"frucht_groesse","wert":"5","original":"mittelgroß","quelle":"web_bogl_bw","url":"https://www.bogl-bw.de/berner-rosenapfel/"},{"merkmal":"frucht_form","wert":"unregelmaessig","original":"Unregelmässig geformt","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Berner_Rosenapfel&oldid=249981550"},{"merkmal":"frucht_form","wert":"stumpfkonisch","original":"Die Frucht nimmt gegen den Kelch zu stumpf kegelförmig ab","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Berner_Rosenapfel&oldid=249981550"},{"merkmal":"frucht_form","wert":"rund","original":"rundlich bis hochgebaut","quelle":"web_bogl_bw","url":"https://www.bogl-bw.de/berner-rosenapfel/"},{"merkmal":"frucht_breiteste_stelle","wert":"stiel","original":"Der Bauch liegt unter der Mitte","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Berner_Rosenapfel&oldid=249981550"},{"merkmal":"frucht_kronung","wert":"5","original":"zeigen sich oft hellgrüne Streifen, Falten und Perlen","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Berner_Rosenapfel&oldid=249981550"},{"merkmal":"kelch_offenheit","wert":"halboffen","original":"Der grüne grossblättrige Kelch ist halb offen oder geschlossen","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Berner_Rosenapfel&oldid=249981550"},{"merkmal":"kelch_offenheit","wert":"geschlossen","original":"Der grüne grossblättrige Kelch ist halb offen oder geschlossen","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Berner_Rosenapfel&oldid=249981550"},{"merkmal":"kelchgrube_tiefe","wert":"7","original":"Er liegt in ziemlich tiefer, eckiger … Höhle","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Berner_Rosenapfel&oldid=249981550"},{"merkmal":"stielgrube_weite","wert":"3","original":"Die Stielhöhle ist eng","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Berner_Rosenapfel&oldid=249981550"},{"merkmal":"schale_berostung_stielgrube","wert":"7","original":"häufig mit gelbbraunem, strahligem Roste ausgekleidet","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Berner_Rosenapfel&oldid=249981550"},{"merkmal":"schale_grundfarbe","wert":"gruengelb","original":"Von der grünlich-gelben Grundfarbe ist meist gar nichts zu sehen","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Berner_Rosenapfel&oldid=249981550"},{"merkmal":"schale_deckfarbe_anteil","wert":"9","original":"Die ganze Frucht ist dunkelrot verwaschen","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Berner_Rosenapfel&oldid=249981550"},{"merkmal":"schale_deckfarbe_farbton","wert":"dunkelrot","original":"Die ganze Frucht ist dunkelrot verwaschen","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Berner_Rosenapfel&oldid=249981550"},{"merkmal":"schale_deckfarbe_farbton","wert":"rot","original":"flächig karminrote Deckfarbe","quelle":"web_bogl_bw","url":"https://www.bogl-bw.de/berner-rosenapfel/"},{"merkmal":"schale_deckfarbe_art","wert":"verwaschen","original":"Die ganze Frucht ist dunkelrot verwaschen","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Berner_Rosenapfel&oldid=249981550"},{"merkmal":"schale_deckfarbe_art","wert":"gestreift","original":"An helleren Stellen sind schwache Streifen sichtbar","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Berner_Rosenapfel&oldid=249981550"},{"merkmal":"schale_lentizellen_art","wert":"hell","original":"die hellen, vertieft erscheinenden Punkte","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Berner_Rosenapfel&oldid=249981550"},{"merkmal":"schale_beschaffenheit","wert":"bereift","original":"auffallende lilafarbene Bereifung, den die Frucht baumfrisch aufweist","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Berner_Rosenapfel&oldid=249981550"},{"merkmal":"schale_beschaffenheit","wert":"bereift","original":"lila bereift","quelle":"web_bogl_bw","url":"https://www.bogl-bw.de/berner-rosenapfel/"},{"merkmal":"kernhaus_form","wert":"zwiebel","original":"Kernhaus: Gross, zwiebel- oder herzförmig","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Berner_Rosenapfel&oldid=249981550"},{"merkmal":"kernhaus_form","wert":"herz","original":"Kernhaus: Gross, zwiebel- oder herzförmig","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Berner_Rosenapfel&oldid=249981550"},{"merkmal":"kernhaus_achse","wert":"offen","original":"Der Achsenstrang bildet eine spindelige Höhlung","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Berner_Rosenapfel&oldid=249981550"},{"merkmal":"kernfaecher_oeffnung","wert":"offen","original":"in welche sich die … Samenfächer ganzspaltig öffnen","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Berner_Rosenapfel&oldid=249981550"},{"merkmal":"kernfaecher_form","wert":"bohnen","original":"die bohnen- oder muschelförmig anliegende Samenfächer","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Berner_Rosenapfel&oldid=249981550"},{"merkmal":"kerne_form","wert":"eifoermig","original":"Samen: klein, eiförmig, dunkelbraun","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Berner_Rosenapfel&oldid=249981550"},{"merkmal":"fleisch_farbe","wert":"gruenlich","original":"Das grünlich oder gelblich weisse Fleisch","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Berner_Rosenapfel&oldid=249981550"},{"merkmal":"fleisch_farbe","wert":"cremeweiss","original":"Das grünlich oder gelblich weisse Fleisch","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Berner_Rosenapfel&oldid=249981550"},{"merkmal":"fleisch_saftigkeit","wert":"7","original":"Das Fleisch ist sehr saftig","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Berner_Rosenapfel&oldid=249981550"},{"merkmal":"fleisch_saftigkeit","wert":"7","original":"sehr saftig","quelle":"web_bogl_bw","url":"https://www.bogl-bw.de/berner-rosenapfel/"},{"merkmal":"geschmack_suesse","wert":"5","original":"süss-weinsäuerlich mit kräftigem, himbeerartigem Gewürz","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Berner_Rosenapfel&oldid=249981550"},{"merkmal":"geschmack_saeure","wert":"5","original":"süss-weinsäuerlich mit kräftigem, himbeerartigem Gewürz","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Berner_Rosenapfel&oldid=249981550"},{"merkmal":"geschmack_aroma","wert":"kräftig, himbeerartig gewürzt","original":"mit kräftigem, himbeerartigem Gewürz","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Berner_Rosenapfel&oldid=249981550"},{"merkmal":"verwendung","wert":"tafel","original":"Die Sorte wird als Tafelapfel und zur Saftbereitung verwendet","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Berner_Rosenapfel&oldid=249981550"},{"merkmal":"verwendung","wert":"most","original":"Die Sorte wird als Tafelapfel und zur Saftbereitung verwendet","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Berner_Rosenapfel&oldid=249981550"},{"merkmal":"verwendung","wert":"tafel","original":"Tafel- und Wirtschaftsapfel","quelle":"web_bogl_bw","url":"https://www.bogl-bw.de/berner-rosenapfel/"},{"merkmal":"verwendung","wert":"kueche","original":"Tafel- und Wirtschaftsapfel","quelle":"web_bogl_bw","url":"https://www.bogl-bw.de/berner-rosenapfel/"},{"merkmal":"verwendung","wert":"most","original":"sehr guter Saft","quelle":"web_bogl_bw","url":"https://www.bogl-bw.de/berner-rosenapfel/"},{"merkmal":"genussreife_beginn","wert":"9","original":"Ab Ende September kann der Berner Rosenapfel baumfrisch genossen werden","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Berner_Rosenapfel&oldid=249981550"},{"merkmal":"genussreife_ende","wert":"1","original":"Lagerfähig ist der Berner Rosenapfel bis Januar","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Berner_Rosenapfel&oldid=249981550"},{"merkmal":"genussreife_ende","wert":"1","original":"haltbar bis Januar","quelle":"web_bogl_bw","url":"https://www.bogl-bw.de/berner-rosenapfel/"},{"merkmal":"baum_wuchs","wert":"7","original":"In der Jugend wächst der Baum kräftig","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Berner_Rosenapfel&oldid=249981550"},{"merkmal":"baum_wuchs","wert":"5","original":"mittelstark","quelle":"web_bogl_bw","url":"https://www.bogl-bw.de/berner-rosenapfel/"},{"merkmal":"bluete_zeit","wert":"4","original":"Die Blütezeit ist mittelfrüh und hält über einen","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Berner_Rosenapfel&oldid=249981550"},{"merkmal":"frucht_breite","wert":62.5,"quelle":"nfc2025","seite":"Akzession 1947067 (Smith 1971)","original":"55-70"},{"merkmal":"frucht_hoehe","wert":57.5,"quelle":"nfc2025","seite":"Akzession 1947067 (Smith 1971)","original":"50-65"},{"merkmal":"frucht_groesse","wert":"5","quelle":"nfc2025","seite":"Akzession 1947067 (Smith 1971)","original":"Medium"},{"merkmal":"frucht_form","wert":"walzenfoermig","quelle":"nfc2025","seite":"Akzession 1947067 (Smith 1971)","original":"Oblong"},{"merkmal":"frucht_hoehe_breite","wert":0.92,"quelle":"nfc2025","seite":"Akzession 1947067 (Smith 1971)"},{"merkmal":"frucht_rippung","wert":"1","quelle":"nfc2025","seite":"Akzession 1947067 (Smith 1971)","original":"Very light"},{"merkmal":"schale_grundfarbe","wert":"gruengelb","quelle":"nfc2025","seite":"Akzession 1947067 (Smith 1971)","original":"Green yellow"},{"merkmal":"schale_deckfarbe_anteil","wert":"7","quelle":"nfc2025","seite":"Akzession 1947067 (Smith 1971)","original":"High to very high"},{"merkmal":"schale_deckfarbe_anteil","wert":"9","quelle":"nfc2025","seite":"Akzession 1947067 (Smith 1971)","original":"High to very high"},{"merkmal":"schale_deckfarbe_farbton","wert":"dunkelrot","quelle":"nfc2025","seite":"Akzession 1947067 (Smith 1971)","original":"Dark Red"},{"merkmal":"schale_deckfarbe_art","wert":"gestreift","quelle":"nfc2025","seite":"Akzession 1947067 (Smith 1971)","original":"Only stripes"},{"merkmal":"schale_berostung_gesamt","wert":"1","quelle":"nfc2025","seite":"Akzession 1947067 (Smith 1971)","original":"Very low"},{"merkmal":"fleisch_farbe","wert":"gruenlich","quelle":"nfc2025","seite":"Akzession 1947067 (Smith 1971)","original":"Greenish"},{"merkmal":"verwendung","wert":"tafel","quelle":"nfc2025","seite":"Akzession 1947067","original":"Dessert"},{"merkmal":"pflueckreife","wert":"10","quelle":"nfc2025","seite":"Akzession 1947067","original":"Early October"},{"merkmal":"genussreife_ende","wert":"1","quelle":"nfc2025","seite":"Akzession 1947067","original":"January"},{"merkmal":"bluete_zeit","wert":"5","quelle":"nfc2025","seite":"Akzession 1947067","original":"Klasse 5 (10 % der Blüten offen, Tag 127)"},{"merkmal":"ertrag_beginn","wert":"frueh","original":"Der Ertrag setzt früh ein","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Berner_Rosenapfel&oldid=249981550","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Berner_Rosenapfel&oldid=249981550"},{"quelle":"web_bogl_bw","url":"https://www.bogl-bw.de/berner-rosenapfel/"}]},{"merkmal":"ertrag_alternanz","wert":"regelmaessig","original":"ist regelmäßig hoch","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Berner_Rosenapfel&oldid=249981550","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Berner_Rosenapfel&oldid=249981550"},{"quelle":"web_bogl_bw","url":"https://www.bogl-bw.de/berner-rosenapfel/"}]},{"merkmal":"anfaelligkeit_schorf","wert":"7","original":"Die Sorte ist anfällig für Schorf","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Berner_Rosenapfel&oldid=249981550","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Berner_Rosenapfel&oldid=249981550"},{"quelle":"web_bogl_bw","url":"https://www.bogl-bw.de/berner-rosenapfel/"}]},{"merkmal":"anfaelligkeit_mehltau","wert":"7","original":"in tieferen Lagen für Mehltau","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Berner_Rosenapfel&oldid=249981550","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Berner_Rosenapfel&oldid=249981550"},{"quelle":"web_bogl_bw","url":"https://www.bogl-bw.de/berner-rosenapfel/"}]},{"merkmal":"standort_boden","wert":"7","original":"gedeiht am besten auf feuchten, nährstoffreichen Böden","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Berner_Rosenapfel&oldid=249981550","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Berner_Rosenapfel&oldid=249981550"},{"quelle":"web_bogl_bw","url":"https://www.bogl-bw.de/berner-rosenapfel/"}]},{"merkmal":"standort_feuchte","wert":"feucht","original":"gedeiht am besten auf feuchten, nährstoffreichen Böden","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Berner_Rosenapfel&oldid=249981550","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Berner_Rosenapfel&oldid=249981550"},{"quelle":"web_bogl_bw","url":"https://www.bogl-bw.de/berner-rosenapfel/"}]},{"merkmal":"standort_klima","wert":"3","original":"in etwas höheren Lagen","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Berner_Rosenapfel&oldid=249981550","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Berner_Rosenapfel&oldid=249981550"},{"quelle":"web_bogl_bw","url":"https://www.bogl-bw.de/berner-rosenapfel/"}]},{"merkmal":"bluete_frost","wert":"3","original":"BOGL nennt sie holz- und blütenfrosthart","quelle":"web_bogl_bw","url":"https://www.bogl-bw.de/berner-rosenapfel/"},{"merkmal":"lagerfaehigkeit","wert":"5","original":"Sie hält sich bis Januar","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Berner_Rosenapfel&oldid=249981550","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Berner_Rosenapfel&oldid=249981550"},{"quelle":"web_bogl_bw","url":"https://www.bogl-bw.de/berner-rosenapfel/"}]}],"texte":[{"thema":"ueberblick","text":"Der Berner Rosenapfel ist ein dunkelroter Herbst- und Winterapfel aus dem Kanton Bern und dort eine der verbreitetsten Gartensorten. Kennzeichnend sind die fast ganz dunkelrot verwaschene Schale mit hellen, vertieft wirkenden Punkten und der lilafarbene Duft der baumfrischen Frucht.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Berner_Rosenapfel&oldid=249981550"}]},{"thema":"herkunft","text":"Um 1870 fanden F. Baumann und Adolf Daepp auf dem Grundstück der Familie Baumann in Oppligen einen Zufallssämling, der 1888 erstmals trug. Daepp erkannte die neue Sorte, veredelte sie in seiner Baumschule und vertrieb sie als „Neuer Berner Rosen Apfel“ in der Schweiz und in Deutschland. 1895 erhielt sie auf der Schweizerischen landwirtschaftlichen Ausstellung in Bern einen 2. Preis, 1896 auf der Allgemeinen Deutschen Obstausstellung in Kassel eine Silbermedaille. Eine genomweite SNP-Analyse nennt Roter Winter-Kalvill und Sauergrauech als Eltern.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Berner_Rosenapfel&oldid=249981550"},{"quelle":"web_bogl_bw","url":"https://www.bogl-bw.de/berner-rosenapfel/"}]},{"thema":"frucht","text":"Die Äpfel sind mittelgroß, 6,5 bis 7 cm hoch, 7 bis 7,5 cm breit und wiegen 110 bis 130 g. Flache Rippen vom Stiel zum Kelch stören die Rundung; der Bauch liegt unter der Mitte, zum Kelch nimmt die Frucht stumpf kegelförmig ab. BOGL beschreibt die Form als rundlich bis hochgebaut. Der grüne, großblättrige Kelch ist halb offen oder geschlossen und sitzt in ziemlich tiefer, eckiger Grube mit hellgrünen Streifen, Falten und Perlen. Der Stiel ist teils dünn, braunrot und 1 bis 1,5 cm lang, teils nur eine fleischige, knopfartige Verdickung; Fleischwülste drücken ihn oft zur Seite.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Berner_Rosenapfel&oldid=249981550"},{"quelle":"web_bogl_bw","url":"https://www.bogl-bw.de/berner-rosenapfel/"}]},{"thema":"schale","text":"Die grünlich gelbe Grundfarbe ist meist ganz verdeckt und erscheint nur bei schattig gewachsenen Früchten um den Kelch. Die Frucht ist dunkelrot verwaschen (BOGL: flächig karminrot), an helleren Stellen schwach gestreift. Typisch sind die hellen, vertieft erscheinenden Punkte und der lilafarbene Duft. Die Schale ist ziemlich dick, mattglänzend und aromatisch. Die enge Stielgrube ist häufig mit gelbbraunem, strahligem Rost ausgekleidet.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Berner_Rosenapfel&oldid=249981550"},{"quelle":"web_bogl_bw","url":"https://www.bogl-bw.de/berner-rosenapfel/"}]},{"thema":"schnitt","text":"Das Kernhaus ist groß, zwiebel- oder herzförmig. Die Achse bildet eine spindelförmige Höhlung, in die sich die bohnen- bis muschelförmigen Kernfächer ganz öffnen. Die Kerne sind klein, eiförmig und dunkelbraun. Die Kelchröhre ist kegelförmig und bis 1 cm lang; die Staubgefäße sitzen 2 mm unter den Kelchblättern. Am Schnitt sind die Gefäßbündel um das Kernhaus rötlich, das Fleisch unter der Schale oft rötlich angelaufen.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Berner_Rosenapfel&oldid=249981550"}]},{"thema":"fleisch_geschmack","text":"Das Fleisch ist grünlich bis gelblich weiß und sehr saftig, süß-weinsäuerlich mit kräftigem, himbeerartigem Gewürz. BOGL nennt den Geschmack eher süßlich mit erfrischender Säure.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Berner_Rosenapfel&oldid=249981550"},{"quelle":"web_bogl_bw","url":"https://www.bogl-bw.de/berner-rosenapfel/"}]},{"thema":"reife_lagerung","text":"Ab Ende September kann die Frucht baumfrisch gegessen werden. Sie hält sich bis Januar, Früchte aus höheren Lagen auch länger.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Berner_Rosenapfel&oldid=249981550"},{"quelle":"web_bogl_bw","url":"https://www.bogl-bw.de/berner-rosenapfel/"}]},{"thema":"baum","text":"Der Baum wächst in der Jugend kräftig und lässt mit Ertragsbeginn nach; BOGL nennt den Wuchs mittelstark. Die Krone ist aufrecht, hoch gewölbt und sparrig verzweigt und vergreist ohne Schnitt bald. Die rosafarbenen Blüten erscheinen Anfang Mai, die Blütezeit ist mittelfrüh und lang. Der Ertrag setzt früh ein und ist regelmäßig hoch. Die Sorte ist anfällig für Schorf und in tieferen Lagen für Mehltau und gedeiht am besten auf feuchten, nährstoffreichen Böden in etwas höheren Lagen; BOGL nennt sie holz- und blütenfrosthart.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Berner_Rosenapfel&oldid=249981550"},{"quelle":"web_bogl_bw","url":"https://www.bogl-bw.de/berner-rosenapfel/"}]},{"thema":"verwendung","text":"Der Berner Rosenapfel ist Tafel- und Wirtschaftsapfel und liefert einen sehr guten Saft.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Berner_Rosenapfel&oldid=249981550"},{"quelle":"web_bogl_bw","url":"https://www.bogl-bw.de/berner-rosenapfel/"}]},{"thema":"frucht","text":"Nach den Erhebungen der National Fruit Collection: mittelgroße, walzenförmige Frucht mit grünlich gelber Grundfarbe und gestreifter dunkelroter Deckfarbe auf einem großen bis sehr großen Teil der Schale. Die Schale ist kaum berostet, das Fruchtfleisch grünlich. Tafelapfel, pflückreif Anfang Oktober und lagerfähig bis Januar.","belege":[{"quelle":"nfc2025","seite":"Akzession 1947067"}]}],"bilder":[{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/71/Malus-Berner-Rosenapfel.jpg/960px-Malus-Berner-Rosenapfel.jpg","seite":"https://commons.wikimedia.org/wiki/File:Malus-Berner-Rosenapfel.jpg","art":"frucht","urheber":"Sven Teschke","lizenz":"CC BY-SA 2.0 de","quelle":"commons","titel":"Malus-Berner-Rosenapfel.jpg"},{"url":"https://upload.wikimedia.org/wikipedia/commons/e/e2/Berner_Rose_Obstprospekt_2015_klein.jpg","seite":"https://commons.wikimedia.org/wiki/File:Berner_Rose_Obstprospekt_2015_klein.jpg","art":"frucht","urheber":"Gartenpflanzen Daepp","lizenz":"CC BY-SA 4.0","quelle":"commons","titel":"Berner Rose Obstprospekt 2015 klein.jpg"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/73/Berner_rosenapfel.jpg/960px-Berner_rosenapfel.jpg","seite":"https://commons.wikimedia.org/wiki/File:Berner_rosenapfel.jpg","art":"baum","urheber":"Flachlandtapir at German Wikipedia","lizenz":"CC BY-SA 2.0 de","quelle":"commons","titel":"Berner rosenapfel.jpg"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/a/a5/Berner_Rosenapfel_jm55137.jpg/960px-Berner_Rosenapfel_jm55137.jpg","seite":"https://commons.wikimedia.org/wiki/File:Berner_Rosenapfel_jm55137.jpg","art":"frucht","urheber":"joergens.mi","lizenz":"CC BY-SA 3.0","quelle":"commons","titel":"Berner Rosenapfel jm55137.jpg"},{"url":"https://upload.wikimedia.org/wikipedia/commons/6/60/Cross_section_of_Berner_Rosen%2C_National_Fruit_Collection_%28acc._1947-067%29.jpg","seite":"https://commons.wikimedia.org/wiki/File:Cross_section_of_Berner_Rosen,_National_Fruit_Collection_(acc._1947-067).jpg","art":"schnitt","urheber":"National Fruit Collection, Brogdale","lizenz":"OGL 2.0","quelle":"nfc-commons","titel":"Cross section of Berner Rosen, National Fruit Collection (acc. 1947-067)"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/a/a9/Apfel_015_Berner_Rosenapfel_%28fcm%29.jpg/960px-Apfel_015_Berner_Rosenapfel_%28fcm%29.jpg","seite":"https://commons.wikimedia.org/wiki/File:Apfel_015_Berner_Rosenapfel_(fcm).jpg","art":"frucht","urheber":"Photograph: Frank C. Müller , Frankfurt am Main","lizenz":"CC BY-SA 4.0","quelle":"commons-fotos","titel":"Apfel 015 Berner Rosenapfel (fcm)"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/78/Apfel_016_Berner_Rosenapfel_%28fcm%29.jpg/960px-Apfel_016_Berner_Rosenapfel_%28fcm%29.jpg","seite":"https://commons.wikimedia.org/wiki/File:Apfel_016_Berner_Rosenapfel_(fcm).jpg","art":"frucht","urheber":"Photograph: Frank C. Müller , Frankfurt am Main","lizenz":"CC BY-SA 4.0","quelle":"commons-fotos","titel":"Apfel 016 Berner Rosenapfel (fcm)"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/87/BW-2-3_Berner_Rosenapfel_%282%29.jpg/960px-BW-2-3_Berner_Rosenapfel_%282%29.jpg","seite":"https://commons.wikimedia.org/wiki/File:BW-2-3_Berner_Rosenapfel_(2).jpg","art":"frucht","urheber":"Tragopogon","lizenz":"CC BY 4.0","quelle":"commons-fotos","titel":"BW-2-3 Berner Rosenapfel (2)"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/e/ea/Malus-Berner-Rosenapfel_27.08.2012.jpg/960px-Malus-Berner-Rosenapfel_27.08.2012.jpg","seite":"https://commons.wikimedia.org/wiki/File:Malus-Berner-Rosenapfel_27.08.2012.jpg","art":"frucht","urheber":"Unterillertaler","lizenz":"CC BY-SA 3.0","quelle":"commons-fotos","titel":"Malus-Berner-Rosenapfel 27.08.2012"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/6/6d/Berner_Rosenapfel_%28apple%29_jm179333.jpg/960px-Berner_Rosenapfel_%28apple%29_jm179333.jpg","seite":"https://commons.wikimedia.org/wiki/File:Berner_Rosenapfel_(apple)_jm179333.jpg","art":"baum","urheber":"joergens.mi","lizenz":"CC BY-SA 3.0","quelle":"commons-fotos","titel":"Berner Rosenapfel (apple) jm179333"}],"munq":83,"akzessionen":[{"sammlung":"UK National Fruit Collection (Brogdale)","nummer":"1947067","name":"Berner Rosen"}],"farbmessung":[{"bild":"https://upload.wikimedia.org/wikipedia/commons/6/60/Cross_section_of_Berner_Rosen%2C_National_Fruit_Collection_%28acc._1947-067%29.jpg","methode":"NFC-Foto","verfahren":"Foto (NFC-Fototafel: 4 ganze Früchte, 2 Schnitte, Fototisch); Weißabgleich über den Hintergrund; Frucht per Hintergrundmodell freigestellt; Schalenpixel ohne Glanzlichter einzeln klassifiziert: Grundfarbe aus gelbgrünen Pixeln, Deckfarbe = Pixel mit deutlich höherem a* als die Grundfarbe (auch dunkle Rot- und Braunrottöne), Anteile über Pixel; Höhe/Breite aus dem Längsschnitt","grundfarbe":"#c9b767","deckfarbe":"#8d3b52","deckfarbeAnteil":0.72,"fleischfarbe":"#d1cbc7","hoeheZuBreite":0.889}],"regionen":[{"region":"DE-BW","art":"regionalsorte","belege":[{"quelle":"rg_bw-kob-landkreissorten"}],"original":"Berner Rosenapfel"},{"region":"DE-ST","art":"regionalsorte","belege":[{"quelle":"rg_st-lpv-boerde-2012"}],"original":"Neuer Berner Rosenapfel"},{"region":"DE-SH","art":"empfehlung","belege":[{"quelle":"rg_shhh-pv-sortenempfehlung"}],"original":"Berner Rosenapfel"},{"region":"DE-HH","art":"empfehlung","belege":[{"quelle":"rg_shhh-pv-sortenempfehlung"}],"original":"Berner Rosenapfel"},{"region":"DE-TH","art":"empfehlung","belege":[{"quelle":"rg_th-grueneliga-2002"}],"original":"Berner Rosenapfel"}],"gefaehrdung":[{"stufe":"Rote Liste der gefährdeten einheimischen Nutzpflanzen in Deutschland","belege":[{"quelle":"rg_ble-rote-liste"}],"original":"Berner Rosenapfel"}]}