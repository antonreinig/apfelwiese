ington),_National_Fruit_Collection_(acc._1925-030).jpg","art":"schnitt","urheber":"National Fruit Collection, Brogdale","lizenz":"OGL 2.0","quelle":"nfc-commons","titel":"Cross section of Ruby (Thorrington), National Fruit Collection (acc. 1925-030)"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/d/d8/Pomological_Watercolor_POM00000838.jpg/960px-Pomological_Watercolor_POM00000838.jpg","seite":"https://commons.wikimedia.org/wiki/File:Pomological_Watercolor_POM00000838.jpg","art":"tafel","urheber":"Amanda Newton","lizenz":"gemeinfrei","quelle":"usda-pomological","titel":"Pomological Watercolor POM00000838"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/8c/Pomological_Watercolor_POM00000839.jpg/960px-Pomological_Watercolor_POM00000839.jpg","seite":"https://commons.wikimedia.org/wiki/File:Pomological_Watercolor_POM00000839.jpg","art":"tafel","urheber":"Royal Charles Steadman","lizenz":"gemeinfrei","quelle":"usda-pomological","titel":"Pomological Watercolor POM00000839"}],"farbmessung":[{"bild":"https://upload.wikimedia.org/wikipedia/commons/7/70/Cross_section_of_Ruby_%28Thorrington%29%2C_National_Fruit_Collection_%28acc._1925-030%29.jpg","methode":"NFC-Foto","verfahren":"Foto (NFC-Fototafel: 4 ganze Früchte, 2 Schnitte, Fototisch); Weißabgleich über den Hintergrund; Frucht per Hintergrundmodell freigestellt; Schalenpixel ohne Glanzlichter einzeln klassifiziert: Grundfarbe aus gelbgrünen Pixeln, Deckfarbe = Pixel mit deutlich höherem a* als die Grundfarbe (auch dunkle Rot- und Braunrottöne), Anteile über Pixel; Höhe/Breite aus dem Längsschnitt","grundfarbe":"#b9aa66","deckfarbe":"#8f4346","deckfarbeAnteil":0.65,"fleischfarbe":"#cfd0c7","hoeheZuBreite":0.84},{"bild":"https://upload.wikimedia.org/wikipedia/commons/f/fd/Cross_section_of_Ruby_%28Seabrook%29%2C_National_Fruit_Collection_%28acc._1936-026%29.jpg","methode":"NFC-Foto","verfahren":"Foto (NFC-Fototafel: 4 ganze Früchte, 2 Schnitte, Fototisch); Weißabgleich über den Hintergrund; Frucht per Hintergrundmodell freigestellt; Schalenpixel ohne Glanzlichter einzeln klassifiziert: Grundfarbe aus gelbgrünen Pixeln, Deckfarbe = Pixel mit deutlich höherem a* als die Grundfarbe (auch dunkle Rot- und Braunrottöne), Anteile über Pixel; Höhe/Breite aus dem Längsschnitt","grundfarbe":"#cfc987","deckfarbe":"#af425a","deckfarbeAnteil":0.5,"rostfarbe":"#927a57","fleischfarbe":"#e8dfc4","hoeheZuBreite":0.933},{"bild":"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/8c/Pomological_Watercolor_POM00000839.jpg/960px-Pomological_Watercolor_POM00000839.jpg","methode":"Aquarell","verfahren":"Aquarell (USDA Pomological Watercolor, ca. 1886–1942); Papierton als Weißpunkt; Frucht vor Papier freigestellt; Schalenpixel einzeln klassifiziert (Deckfarbe = deutlich höheres a* als die Grundfarbe, Anteile über Pixel); Höhe/Breite aus dem gemalten Längsschnitt, sonst aus der Seitenansicht; gemessen an einer 480 px breiten Kopie; Farbwiedergabe des Malers, nicht fotometrisch","grundfarbe":"#d39f5e","deckfarbe":"#b63d23","deckfarbeAnteil":0.95,"fleischfarbe":"#fbf1cf","hoeheZuBreite":0.892},{"bild":"https://thumb.wikimedia.org/wikipedia/commons/thumb/d/d8/Pomological_Watercolor_POM00000838.jpg/960px-Pomological_Watercolor_POM00000838.jpg","methode":"Aquarell","verfahren":"Aquarell (USDA Pomological Watercolor, ca. 1886–1942); Papierton als Weißpunkt; Frucht vor Papier freigestellt; Schalenpixel einzeln klassifiziert (Deckfarbe = deutlich höheres a* als die Grundfarbe, Anteile über Pixel); Höhe/Breite aus dem gemalten Längsschnitt, sonst aus der Seitenansicht; gemessen an einer 480 px breiten Kopie; Farbwiedergabe des Malers, nicht fotometrisch","deckfarbe":"#930c0a","deckfarbeAnteil":0.99,"fleischfarbe":"#f5e0c1","hoeheZuBreite":0.848}]}