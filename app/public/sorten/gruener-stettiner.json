{"id":"gruener-stettiner","name":"Grüner Stettiner","synonyme":[{"name":"Grüner Rostocker","beleg":{"quelle":"illustr_hb_1","band":"I","seite":"537"}},{"name":"Grüner Bietigheimer","beleg":{"quelle":"illustr_hb_1","band":"I","seite":"537"}},{"name":"Schweizerapfel","beleg":{"quelle":"illustr_hb_1","band":"I","seite":"537"}},{"name":"Winterscheibling","beleg":{"quelle":"illustr_hb_1","band":"I","seite":"537"}},{"name":"Eisapfel","beleg":{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Grüner_Stettiner&oldid=270432953"}},{"name":"Bamberger","beleg":{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Grüner_Stettiner&oldid=270432953"}},{"name":"Galsapfel","beleg":{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Grüner_Stettiner&oldid=270432953"}},{"name":"Grüner Boedigheimer","beleg":{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Grüner_Stettiner&oldid=270432953"}},{"name":"Grüner Rowiener","beleg":{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Grüner_Stettiner&oldid=270432953"}},{"name":"Grüner Winterstettiner","beleg":{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Grüner_Stettiner&oldid=270432953"}},{"name":"Grüner Zwiebelapfel","beleg":{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Grüner_Stettiner&oldid=270432953"}}],"herkunft":{"text":"Herkunft und Entstehung sind unbekannt. Der Name lässt an Pommern denken, belegt ist das nicht. Johann Ludwig Christ erwähnte die Sorte 1797 erstmals; das Handbuch nennt sie 1859 eine alte, in vielen Gegenden Deutschlands verbreitete Frucht.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Grüner_Stettiner&oldid=270432953"},{"quelle":"illustr_hb_1","band":"I","seite":"537"}],"jahr":1797},"merkmale":[{"merkmal":"frucht_breite","wert":80,"original":"Gestalt 80:61—62","quelle":"engelbrecht1889","seite":"729 (Nr. 653)"},{"merkmal":"frucht_hoehe","wert":61.5,"original":"Gestalt 80:61—62","quelle":"engelbrecht1889","seite":"729 (Nr. 653)"},{"merkmal":"frucht_hoehe_breite","wert":0.77,"original":"Gestalt 80:61—62","quelle":"engelbrecht1889","seite":"729 (Nr. 653)"},{"merkmal":"frucht_form","wert":"rund","original":"abgestumpft rundlich bis flachrund","quelle":"engelbrecht1889","seite":"729 (Nr. 653)"},{"merkmal":"frucht_form","wert":"flachrund","original":"abgestumpft rundlich bis flachrund","quelle":"engelbrecht1889","seite":"729 (Nr. 653)"},{"merkmal":"frucht_breiteste_stelle","wert":"mitte","original":"mittel- oder wenig stielbauch.","quelle":"engelbrecht1889","seite":"729 (Nr. 653)"},{"merkmal":"frucht_breiteste_stelle","wert":"stiel","original":"mittel- oder wenig stielbauch.","quelle":"engelbrecht1889","seite":"729 (Nr. 653)"},{"merkmal":"frucht_symmetrie","wert":"symmetrisch","original":"Hälften meistens gleich","quelle":"engelbrecht1889","seite":"729 (Nr. 653)"},{"merkmal":"kelch_offenheit","wert":"halboffen","original":"Kelch halb offen bis offen","quelle":"engelbrecht1889","seite":"729 (Nr. 653)"},{"merkmal":"kelch_offenheit","wert":"offen","original":"Kelch halb offen bis offen","quelle":"engelbrecht1889","seite":"729 (Nr. 653)"},{"merkmal":"kelchgrube_tiefe","wert":"5","original":"Einsenk. mitteltief, mittelweit","quelle":"engelbrecht1889","seite":"729 (Nr. 653)"},{"merkmal":"kelchgrube_weite","wert":"5","original":"Einsenk. mitteltief, mittelweit","quelle":"engelbrecht1889","seite":"729 (Nr. 653)"},{"merkmal":"frucht_kronung","wert":"5","original":"zwischen deutlichen, nur flach und nicht weit zum Bauche laufenden Falten","quelle":"engelbrecht1889","seite":"729 (Nr. 653)"},{"merkmal":"frucht_rippung","wert":"3","original":"Querschn. ziemlich rund","quelle":"engelbrecht1889","seite":"729 (Nr. 653)"},{"merkmal":"stiel_dicke","wert":"3","original":"Stiel holzig, dünn bis mitteldick, etwa 12 mm l.","quelle":"engelbrecht1889","seite":"729 (Nr. 653)"},{"merkmal":"stiel_dicke","wert":"5","original":"Stiel holzig, dünn bis mitteldick, etwa 12 mm l.","quelle":"engelbrecht1889","seite":"729 (Nr. 653)"},{"merkmal":"stielgrube_tiefe","wert":"5","original":"Höhle mitteltief, mässig weit, eben, berostet","quelle":"engelbrecht1889","seite":"729 (Nr. 653)"},{"merkmal":"stielgrube_weite","wert":"5","original":"Höhle mitteltief, mässig weit, eben, berostet","quelle":"engelbrecht1889","seite":"729 (Nr. 653)"},{"merkmal":"schale_berostung_stielgrube","wert":"5","original":"Höhle mitteltief, mässig weit, eben, berostet","quelle":"engelbrecht1889","seite":"729 (Nr. 653)"},{"merkmal":"schale_beschaffenheit","wert":"glatt","original":"Schale glatt","quelle":"engelbrecht1889","seite":"729 (Nr. 653)"},{"merkmal":"schale_grundfarbe","wert":"gelbgruen","original":"hellgrün, später gelblichgrün bis grünlichgelb","quelle":"engelbrecht1889","seite":"729 (Nr. 653)"},{"merkmal":"schale_grundfarbe","wert":"gruengelb","original":"hellgrün, später gelblichgrün bis grünlichgelb","quelle":"engelbrecht1889","seite":"729 (Nr. 653)"},{"merkmal":"schale_deckfarbe_anteil","wert":"3","original":"sonnenw. nicht selten bald heller, bald dunkler rother Anflug","quelle":"engelbrecht1889","seite":"729 (Nr. 653)"},{"merkmal":"schale_deckfarbe_farbton","wert":"rot","original":"bald heller, bald dunkler rother Anflug","quelle":"engelbrecht1889","seite":"729 (Nr. 653)"},{"merkmal":"schale_deckfarbe_art","wert":"verwaschen","original":"rother Anflug","quelle":"engelbrecht1889","seite":"729 (Nr. 653)"},{"merkmal":"schale_lentizellen_anzahl","wert":"5","original":"Punkte ziemlich zahlreich, fein bis mitteldick, braun","quelle":"engelbrecht1889","seite":"729 (Nr. 653)"},{"merkmal":"schale_lentizellen_groesse","wert":"3","original":"Punkte ziemlich zahlreich, fein bis mitteldick, braun","quelle":"engelbrecht1889","seite":"729 (Nr. 653)"},{"merkmal":"schale_lentizellen_groesse","wert":"5","original":"Punkte ziemlich zahlreich, fein bis mitteldick, braun","quelle":"engelbrecht1889","seit