quelle":"illustr_hb_1","band":"I","seite":"537"},{"merkmal":"frucht_breiteste_stelle","wert":"mitte","original":"der stärkste Durchmesser in der Mitte","quelle":"illustr_hb_1","band":"I","seite":"537"},{"merkmal":"kelch_offenheit","wert":"offen","original":"Kelch: offen, oft verstümmelt","quelle":"illustr_hb_1","band":"I","seite":"537"},{"merkmal":"kelchgrube_tiefe","wert":"7","original":"in einer tiefen, weiten Einsenkung","quelle":"illustr_hb_1","band":"I","seite":"537"},{"merkmal":"kelchgrube_weite","wert":"7","original":"in einer tiefen, weiten Einsenkung","quelle":"illustr_hb_1","band":"I","seite":"537"},{"merkmal":"stiel_laenge","wert":"1","original":"Stiel: ganz kurz, selten über die Stielhöhle hervorragend","quelle":"illustr_hb_1","band":"I","seite":"537"},{"merkmal":"schale_deckfarbe_anteil","wert":"0","original":"hellgrün, später gelblichgrün, ohne Röthe","quelle":"illustr_hb_1","band":"I","seite":"537"},{"merkmal":"schale_grundfarbe","wert":"gelbgruen","original":"hellgrün, später gelblichgrün","quelle":"illustr_hb_1","band":"I","seite":"537"},{"merkmal":"fleisch_festigkeit","wert":"7","original":"Fleisch: fest, glasartig und vollsaftig","quelle":"illustr_hb_1","band":"I","seite":"537"},{"merkmal":"fleisch_saftigkeit","wert":"7","original":"Fleisch: fest, glasartig und vollsaftig","quelle":"illustr_hb_1","band":"I","seite":"537"},{"merkmal":"kernfaecher_oeffnung","wert":"geschlossen","original":"Kernhaus: geschlossen, eng, flach","quelle":"illustr_hb_1","band":"I","seite":"537"},{"merkmal":"genussreife_beginn","wert":"12","original":"Reife und Nutzung: December, sehr lange haltbar","quelle":"illustr_hb_1","band":"I","seite":"537"},{"merkmal":"verwendung","wert":"kueche","original":"Besonders für die Wirthschaft zu verwenden","quelle":"illustr_hb_1","band":"I","seite":"537"},{"merkmal":"baum_wuchs","wert":"7","original":"wird außergewöhnlich groß … wächst … zum Erstaunen rasch","quelle":"illustr_hb_1","band":"I","seite":"537"},{"merkmal":"pflueckreife","wert":"10","original":"Pflück- oder Erntereife Mitte bis Ende Oktober","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Grüner_Stettiner&oldid=270432953"},{"merkmal":"genussreife_beginn","wert":"12","original":"genussreif ist er dann ab Dezember","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Grüner_Stettiner&oldid=270432953"},{"merkmal":"verwendung","wert":"most","original":"eignet sich sehr gut für Apfelsaft und Apfelwein (Most)","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Grüner_Stettiner&oldid=270432953"},{"merkmal":"verwendung","wert":"doerren","original":"eignet sich … sehr gut für Apfelringe","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Grüner_Stettiner&oldid=270432953"},{"merkmal":"kernhaus_breite_mm","wert":43,"original":"Kernhaus 43:34","quelle":"engelbrecht1889","seite":"729 (Nr. 653)"},{"merkmal":"kernhaus_hoehe_mm","wert":34,"original":"Kernhaus 43:34","quelle":"engelbrecht1889","seite":"729 (Nr. 653)"},{"merkmal":"kernfach_breite_mm","wert":12,"original":"Kammern 12:20","quelle":"engelbrecht1889","seite":"729 (Nr. 653)"},{"merkmal":"kernfach_hoehe_mm","wert":20,"original":"Kammern 12:20","quelle":"engelbrecht1889","seite":"729 (Nr. 653)"},{"merkmal":"verwendung","wert":"kueche","original":"eignet er sich gut für Saft und Apfelwein, als Kochapfel und für Apfelringe","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Grüner_Stettiner&oldid=270432953"},{"merkmal":"standort_klima","wert":"3","original":"gedeiht auch in rauen Lagen","quelle":"illustr_hb_1","band":"I","seite":"537"},{"merkmal":"ertrag_beginn","wert":"spaet","original":"er trägt etwas spät","quelle":"illustr_hb_1","band":"I","seite":"537"},{"merkmal":"gesundheit","wert":"7","original":"Wikipedia beschreibt ihn als robusten Massenträger","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Grüner_Stettiner&oldid=270432953"},{"merkmal":"hochstamm","wert":"gut","original":"wo sie auch als Straßenbaum gepflanzt wurde","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Grüner_Stettiner&oldid=270432953","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Grüner_Stettiner&oldid=270432953"},{"quelle":"engelbrecht1889","seite":"729 (Nr. 653)"}]},{"merkmal":"lagerfaehigkeit","wert":"7","original":"Engelbrecht nennt Anfang Januar bis April","quelle":"engelbrecht1889","seite":"729 (Nr. 653)"},{"merkmal":"lagerfaehigkeit","wert":"7","original":"Nach Wikipedia hält sie bei guter Lagerung bis in den Juli","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Grüner_Stettiner&oldid=270432953"}],"texte":[{"thema":"ueberblick","text":"Großer, flachrunder, grüner Winterapfel aus der Gruppe der Plattäpfel, der sich außergewöhnlich lange lagern lässt. Er galt im 19. Jahrhundert als Wirtschaftsapfel, wurde aber auf dem Land auch gern roh gegessen. Heute ist er selten und gilt als gefährdet.","belege":[{"quelle":"engelbrecht1889","seite":"729 (Nr. 653)"},{"quelle":"illustr_hb_1","band":"I","seite":"537"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Grüner_Stettiner&oldid=270432953"}]},{"thema":"herkunft","text":"Wann und wo die Sorte entstand, ist nicht bekannt. Die erste sichere Erwähnung stammt von Johann Ludwig Christ (1797); ausführlicher beschrieben ihn Gotthard (1804) und Christ (1809). Ab 1834 vermehrte die Baumschule der Akademie Eldena unter Ferdinand Jühlke die Sorte für Pommern, wo sie auch als Straßenbaum gepflanzt wurde. 1877 gehörte sie im Regierungsbezirk Magdeburg zu den am häufigsten gepflanzten Sorten. Engelbrecht erhielt 1889 Früchte von Bertog sen. aus Magdeburg und vom Verein für Pomologie in Meiningen.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Grüner_Stettiner&oldid=270432953"},{"quelle":"engelbrecht1889","seite":"729 (Nr. 653)"}]},{"thema":"frucht","text":"Engelbrecht maß 80 mm Breite bei 61 bis 62 mm Höhe; für die Handbuch-Abbildung gibt er 84:67 mm an, das Handbuch selbst nennt 3 bis 3½ Zoll Breite und 2½ Zoll Höhe. Die Frucht ist abgestumpft rundlich bis flachrund, der Bauch liegt in der Mitte oder wenig zum Stiel hin, die Hälften sind meist gleich und der Querschnitt ziemlich rund. Den Kelch fand Engelbrecht halb offen bis offen in einer mitteltiefen, mittelweiten Grube zwischen deutlichen Falten; das Handbuch beschreibt den Kelch als offen, oft verstümmelt, in tiefer, weiter Grube, aus der vier bis fünf breite Erhabenheiten bis zur Fruchtmitte ziehen. Der holzige Stiel ist dünn bis mitteldick und etwa 12 mm lang; laut Handbuch ragt er selten über die Stielgrube hinaus. Die Stielgrube ist mitteltief, mäßig weit und berostet.","belege":[{"quelle":"engelbrecht1889","seite":"729 (Nr. 653)"},{"quelle":"illustr_hb_1","band":"I","seite":"537"}]},{"thema":"schale","text":"Die glatte Schale ist hellgrün und wird auf dem Lager gelblichgrün bis grünlichgelb. Engelbrecht sah sonnenseits nicht selten einen hellen bis dunkleren roten Anflug, das Handbuch beschreibt die Frucht als ohne Röte. Die Schalenpunkte sind ziemlich zahlreich, fein bis mitteldick und braun, in der Röte oft hell umflossen. Die Früchte welken nicht und haben einen merklichen Geruch.","belege":[{"quelle":"engelbrecht1889","seite":"729 (Nr. 653)"},{"quelle":"illustr_hb_1","band":"I","seite":"537"}]},{"thema":"schnitt","text":"Engelbrecht zeigt ein zwiebelförmiges Kernhaus von 43:34 mm. Die Kammern (12:20 mm) sind stielwärts spitz, kelchwärts abgerundet, oft etwas zerrissen, mäßig geräumig und bald etwas offen, bald fast geschlossen. Die Achsenhöhle ist mittelbreit bis schmal. Je Kammer liegen ein bis zwei große, lang eiförmige, lang gespitzte, hellbraune Kerne, die oft unvollkommen sind. Die Kelchhöhle ist kegelförmig und reicht ⅖ zur Achsenhöhle. Das Handbuch nennt das Kernhaus geschlossen, eng und flach, die Kelchröhre sehr kurz und die Kerne meist unvollkommen. Das Fleisch ist am Schnitt grünlich-gelblichweiß.","belege":[{"quelle":"engelbrecht1889","seite":"729 (Nr. 653)"},{"quelle":"illustr_hb_1","band":"I","seite":"537"}]},{"thema":"fleisch_geschmack","text":"Das Fleisch ist halbfein, zunächst fest und glasartig, später markig, und sehr saftig. Engelbrecht fand es ungewürzt und fast ausschließlich weinig, ohne merkliche Süße; das Handbuch nennt den Geschmack erfrischend und weinartig. Ältere Autoren wie Gotthard (1804) zählten den Apfel zu den Sorten ersten Ranges.","belege":[{"quelle":"engelbrecht1889","seite":"729 (Nr. 653)"},{"quelle":"illustr_hb_1","band":"I","seite":"537"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Grüner_Stettiner&oldid=270432953"}]},{"thema":"reife_lagerung","text":"Gepflückt wird Mitte bis Ende Oktober. Das Handbuch gibt die Reife ab Dezember an und nennt die Frucht sehr lange haltbar; Engelbrecht nennt Anfang Januar bis April. Nach Wikipedia hält sie bei guter Lagerung bis in den Juli und wurde früher anderen Stettinern vorgezogen, weil sie auf dem Lager nicht stippig wird; am Baum kann sie dagegen bei ungünstigem Boden stippig werden.","belege":[{"quelle":"engelbrecht1889","seite":"729 (Nr. 653)"},{"quelle":"illustr_hb_1","band":"I","seite":"537"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Grüner_Stettiner&oldid=270432953"}]},{"thema":"baum","text":"Nach dem Handbuch wird der Baum außergewöhnlich groß, wächst in kräftigem Boden sehr rasch, bildet eine hohe, kugelige Krone, ist sehr dauerhaft und gedeiht auch in rauen Lagen; er trägt etwas spät. Die Sommertriebe sind dunkelviolettrot und stark bewollt, die Blätter groß, rundlich und scharf gezahnt. Wikipedia beschreibt ihn als robusten Massenträger, der sehr alt werden kann und den strengen Winter 1879/80 um Traunstein gut überstand.","belege":[{"quelle":"illustr_hb_1","band":"I","seite":"537"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Grüner_Stettiner&oldid=270432953"}]},{"thema":"verwendung","text":"Engelbrecht (††) und das Handbuch führen den Grünen Stettiner als Wirtschaftsapfel. Nach Wikipedia eignet er sich gut für Saft und Apfelwein, als Kochapfel und für Apfelringe.","belege":[{"quelle":"engelbrecht1889","seite":"729 (Nr. 653)"},{"quelle":"illustr_hb_1","band":"I","seite":"537"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Grüner_Stettiner&oldid=270432953"}]}],"bilder":[{"url":"https://archive.org/download/bub_gb_tR4EMgEACAAJ/page/n742_w800.jpg","seite":"https://archive.org/details/bub_gb_tR4EMgEACAAJ/page/n742","art":"schnitt","urheber":"Theodor Engelbrecht (Zeichnung), Albert Probst (Holzschnitt)","lizenz":"gemeinfrei","quelle":"engelbrecht1889","titel":"Längsschnitt-Umriss bei Engelbrecht 1889, S. 729 (ganze Buchseite)"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/4/40/Gr%C3%BCner_Stettiner_jm55246.jpg/960px-Gr%C3%BCner_Stettiner_jm55246.jpg","seite":"https://commons.wikimedia.org/wiki/File:Gr%C3%BCner_Stettiner_jm55246.jpg","art":"frucht","urheber":"joergens.mi","lizenz":"CC BY-SA 3.0","quelle":"commons","titel":"Grüner Stettiner jm55246.jpg"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/94/Gr%C3%BCner_Stettiner_%28apple%29_jm179427.jpg/960px-Gr%C3%BCner_Stettiner_%28apple%29_jm179427.jpg","seite":"https://commons.wikimedia.org/wiki/File:Gr%C3%BCner_Stettiner_(apple)_jm179427.jpg","art":"frucht","urheber":"joergens.mi","lizenz":"CC BY-SA 3.0","quelle":"commons","titel":"Grüner Stettiner (apple) jm179427.jpg"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/c7/Apfel_062_Gruener_Stettiner_%28fcm%29.jpg/960px-Apfel_062_Gruener_Stettiner_%28fcm%29.jpg","seite":"https://commons.wikimedia.org/wiki/File:Apfel_062_Gruener_Stettiner_(fcm).jpg","art":"frucht","urheber":"Photograph: Frank C. Müller , Frankfurt am Main","lizenz":"CC BY-SA 4.0","quelle":"commons-fotos","titel":"Apfel 062 Gruener Stettiner (fcm)"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/a/a4/Apfel_063_Gruener_Stettiner_%28fcm%29.jpg/960px-Apfel_063_Gruener_Stettiner_%28fcm%29.jpg","seite":"https://commons.wikimedia.org/wiki/File:Apfel_063_Gruener_Stettiner_(fcm).jpg","art":"frucht","urheber":"Photograph: Frank C. Müller , Frankfurt am Main","lizenz":"CC BY-SA 4.0","quelle":"commons-fotos","titel":"Apfel 063 Gruener Stettiner (fcm)"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/3/37/Gr%C3%BCner_Winterstettiner.jpg/960px-Gr%C3%BCner_Winterstettiner.jpg","seite":"https://commons.wikimedia.org/wiki/File:Gr%C3%BCner_Winterstettiner.jpg","art":"frucht","urheber":"Bahnmoeller","lizenz":"CC BY-SA 3.0","quelle":"commons-fotos","titel":"Grüner Winterstettiner"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/4/4a/Malus-Gr%C3%BCner-Stettiner.jpg/960px-Malus-Gr%C3%BCner-Stettiner.jpg","seite":"https://commons.wikimedia.org/wiki/File:Malus-Gr%C3%BCner-Stettiner.jpg","art":"frucht","urheber":"unbekannt","lizenz":"CC BY-SA 2.0 DE","quelle":"commons-fotos","titel":"Malus-Grüner-Stettiner"}],"regionen":[{"region":"DE-MV","art":"verbreitung","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Grüner_Stettiner&oldid=270432953"},{"quelle":"illustr_hb_1","band":"I","seite":"537"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Grüner_Stettiner&oldid=270432953"},{"quelle":"engelbrecht1889","seite":"729 (Nr. 653)"}],"original":"Ab 1834 vermehrte die Baumschule der Akademie Eldena unter Ferdinand Jühlke die Sorte für Pommern"},{"region":"DE-ST","art":"verbreitung","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Grüner_Stettiner&oldid=270432953"},{"quelle":"illustr_hb_1","band":"I","seite":"537"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Grüner_Stettiner&oldid=270432953"},{"quelle":"engelbrecht1889","seite":"729 (Nr. 653)"}],"original":"1877 gehörte sie im Regierungsbezirk Magdeburg zu den am häufigsten gepflanzten Sorten"},{"region":"DE-TH","art":"empfehlung","belege":[{"quelle":"rg_th-grueneliga-2002"}],"original":"Grüner Stettiner"}],"gefaehrdung":[{"stufe":"selten","belege":[{"quelle":"engelbrecht1889","seite":"729 (Nr. 653)"},{"quelle":"illustr_hb_1","band":"I","seite":"537"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Grüner_Stettiner&oldid=270432953"}],"original":"Heute ist er selten und gilt als gefährdet"},{"stufe":"Rote Liste der gefährdeten einheimischen Nutzpflanzen in Deutschland","belege":[{"quelle":"rg_ble-rote-liste"}],"original":"Grüner Stettiner"}]}