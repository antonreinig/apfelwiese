{"id":"ananasrenette","name":"Ananasrenette","synonyme":[{"name":"Ananas-Reinette","beleg":{"quelle":"engelbrecht1889","seite":"475 (Nr. 427)"}},{"name":"Reinette Ananas","beleg":{"quelle":"engelbrecht1889","seite":"475 (Nr. 427)"}},{"name":"Goldapfel","beleg":{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Ananasrenette&oldid=262010814"}},{"name":"Ananasová reneta","beleg":{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Ananasrenette&oldid=262010814"}},{"name":"Ananasrenett","beleg":{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Ananasrenette&oldid=262010814"}}],"herkunft":{"text":"Vermutlich Niederlande bzw. Benelux-Länder; seit 1820 im Rheinland angebaut, 1826 von Diel beschrieben.","belege":[{"quelle":"illustr_hb_1","band":"I","seite":"131"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Ananasrenette&oldid=262010814"}],"land":"NL","landSicher":false,"jahr":1820},"merkmale":[{"merkmal":"frucht_breite","wert":62,"original":"Gestalt 62:56—58","quelle":"engelbrecht1889","seite":"475 (Nr. 427)"},{"merkmal":"frucht_hoehe","wert":57,"original":"Gestalt 62:56—58","quelle":"engelbrecht1889","seite":"475 (Nr. 427)"},{"merkmal":"frucht_hoehe_breite","wert":0.92,"original":"Gestalt 62:56—58","quelle":"engelbrecht1889","seite":"475 (Nr. 427)"},{"merkmal":"frucht_form","wert":"eifoermig","original":"abgestumpft länglich oder rundlich eiförmig","quelle":"engelbrecht1889","seite":"475 (Nr. 427)"},{"merkmal":"frucht_breiteste_stelle","wert":"stiel","original":"stielbauch.","quelle":"engelbrecht1889","seite":"475 (Nr. 427)"},{"merkmal":"frucht_symmetrie","wert":"symmetrisch","original":"Hälften gleich","quelle":"engelbrecht1889","seite":"475 (Nr. 427)"},{"merkmal":"frucht_rippung","wert":"1","original":"Querschn. rund","quelle":"engelbrecht1889","seite":"475 (Nr. 427)"},{"merkmal":"frucht_kronung","wert":"1","original":"zwischen unbedeutenden, kurzen Falten","quelle":"en