{"id":"hollaender-prinz","name":"Holländer Prinz","synonyme":[{"name":"Holländer Prinzenapfel","beleg":{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Holländer_Prinz&oldid=232870340"}}],"herkunft":{"text":"Herkunft unbekannt. Verbreitet im Alten Land und an der Elbe aufwärts bis ins Wendland; der Name lässt an niederländische Siedler denken, in den Niederlanden ist die Sorte aber nicht bekannt.","belege":[{"quelle":"web_pomologen_verein","url":"https://www.pomologen-verein.de/media/user_upload/2023_Hollaender_Prinz.pdf"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Holländer_Prinz&oldid=232870340"}]},"merkmale":[{"merkmal":"frucht_groesse","wert":"5","original":"Mittelgroße, kugelige bis hochkugelige Frucht","quelle":"web_pomologen_verein","url":"https://www.pomologen-verein.de/media/user_upload/2023_Hollaender_Prinz.pdf"},{"merkmal":"frucht_form","wert":"rund","original":"Mittelgroße, kugelige bis hochkugelige Frucht","quelle":"web_pomologen_verein","url":"https://www.pomologen-verein.de/media/user_upload/2023_Hollaender_Prinz.pdf"},{"merkmal":"schale_grundfarbe","wert":"gelb","original":"Die Schale ist in der Grundfarbe hellgelb","quelle":"web_pomologen_verein","url":"https://www.pomologen-verein.de/media/user_upload/2023_Hollaender_Prinz.pdf"},{"merkmal":"schale_deckfarbe_anteil","wert":"7","original":"kann bis zu 2/3 karminrot überzogen sein","quelle":"web_pomologen_verein","url":"https://www.pomologen-verein.de/media/user_upload/2023_Hollaender_Prinz.pdf"},{"merkmal":"schale_deckfarbe_farbton","wert":"rot","original":"bis zu 2/3 karminrot überzogen","quelle":"web_pomologen_verein","url":"https://www.pomologen-verein.de/media/user_upload/2023_Hollaender_Prinz.pdf"},{"merkmal":"schale_deckfarbe_art","wert":"verwaschen","original":"bis zu 2/3 karminrot überzogen","quelle":"web_pomologen_verein","url":"https://www.pomologen-verein.de/media/user_upload/2023_Hollaender_Prinz.pdf"},{"merkmal":"schale_lentizellen_groesse","wert":"7","original":"Charakteristisch sind die großen Lentizellen","quelle":"web_pomologen_verein","url":"https://www.pomologen-verein.de/media/user_upload/2023_Hollaender_Prinz.pdf"},{"merkmal":"schale_lentizellen_art","wert":"braun","original":"großen Lentizellen die fließend in hellbraune Rostnetze übergehen","quelle":"web_pomologen_verein","url":"https://www.pomologen-verein.de/media/user_upload/2023_Hollaender_Prinz.pdf"},{"merkmal":"schale_berostung_stielgrube","wert":"7","original":"Besonders im Stielbereich ist die Frucht grobschuppig, weit auslaufend berostet","quelle":"web_pomologen_verein","url":"https://www.pomologen-verein.de/media/user_upload/2023_Hollaender_Prinz.pdf"},{"merkmal":"fleisch_farbe","wert":"gelblich","original":"Das etwas gelbliche Fruchtfleisch ist saftig","quelle":"web_pomologen_verein","url":"https://www.pomologen-verein.de/media/user_upload/2023_Hollaender_Prinz.pdf"},{"merkmal":"fleisch_saftigkeit","wert":"7","original":"Fruchtfleisch ist saftig","quelle":"web_pomologen_verein","url":"https://www.pomologen-verein.de/media/user_upload/2023_Hollaender_Prinz.pdf"},{"merkmal":"geschmack_suesse","wert":"7","original":"leicht aromatisch und vorherrschend süßlich","quelle":"web_pomologen_verein","url":"https://www.pomologen-verein.de/media/user_upload/2023_Hollaender_Prinz.pdf"},{"merkmal":"geschmack_saeure","wert":"3","original":"leicht aromatisch und vorherrschend süßlich","quelle":"web_pomologen_verein","url":"https://www.pomologen-verein.de/media/user_upload/2023_Hollaender_Prinz.pdf"},{"merkmal":"geschmack_aroma","wert":"leicht aromatisch","original":"leicht aromatisch","quelle":"web_pomologen_verein","url":"https://www.pomologen-verein.de/media/user_upload/2023_Hollaender_Prinz.pdf"},{"merkmal":"fleisch_festigkeit","wert":"3","original":"wird bei Lagerung mürbe","quelle":"web_pomologen_verein","url":"https://www.pomologen-verein.de/media/user_upload/2023_Hollaender_Prinz.pdf"},{"merkmal":"pflueckreife","wert":"9","original":"Pflückreife Mitte September","quelle":"web_pomologen_verein","url":"https://www.pomologen-verein.de/media/user_upload/2023_Hollaender_Prinz.pdf"},{"merkmal":"genussreife_beginn","wert":"9","original":"Genussreife Mitte September bis Mitte November","quelle":"web_pomologen_verein","url":"https://www.pomologen-verein.de/media/user_upload/2023_Hollaender_Prinz.pdf"},{"merkmal":"genussreife_ende","wert":"11","original":"Genussreife Mitte September bis Mitte November","quelle":"web_pomologen_verein","url":"https://www.pomologen-verein.de/media/user_upload/2023_Hollaender_Prinz.pdf"},{"merkmal":"baum_wuchs","wert":"5","original":"wächst mittelstark bis stark","quelle":"web_pomologen_verein","url":"https://www.pomologen-verein.de/media/user_upload/2023_Hollaender_Prinz.pdf"},{"merkmal":"baum_wuchs","wert":"7","original":"wächst mittelstark bis stark","quelle":"web_pomologen_verein","url":"https://www.pomologen-verein.de/media/user_upload/2023_Hollaender_Prinz.pdf"},{"merkmal":"verwendung","wert":"tafel","original":"ist eine alte Tafelapfelsorte","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Holländer_Prinz&oldid=232870340"},{"merkmal":"gesundheit","wert":"7","original":"gilt als relativ robust","quelle":"web_pomologen_verein","url":"https://www.pomologen-verein.de/media/user_upload/2023_Hollaender_Prinz.pdf","belege":[{"quelle":"web_pomologen_verein","url":"https://www.pomologen-verein.de/media/user_upload/2023_Hollaender_Prinz.pdf"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Holländer_Prinz&oldid=232870340"}]},{"merkmal":"lagerfaehigkeit","wert":"3","original":"genussreif von Mitte September bis Mitte November","quelle":"web_pomologen_verein","url":"https://www.pomologen-verein.de/media/user_upload/2023_Hollaender_Prinz.pdf","belege":[{"quelle":"web_pomologen_verein","url":"https://www.pomologen-verein.de/media/user_upload/2023_Hollaender_Prinz.pdf"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Holländer_Prinz&oldid=232870340"}]}],"texte":[{"thema":"ueberblick","text":"Alte norddeutsche Tafelapfelsorte, verbreitet im Alten Land und an der Elbe bis ins Wendland. Die mittelgroße, kugelige Frucht ist hellgelb, bis zu zwei Dritteln karminrot überzogen und hat auffällig große Lentizellen mit hellbraunen Rostnetzen. Der Holländer Prinz war Streuobstsorte des Jahres 2023 in Norddeutschland.","belege":[{"quelle":"web_pomologen_verein","url":"https://www.pomologen-verein.de/media/user_upload/2023_Hollaender_Prinz.pdf"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Holländer_Prinz&oldid=232870340"}]},{"thema":"herkunft","text":"Die genaue Herkunft ist unbekannt. Der Name deutet auf die Niederlande, doch ist die Sorte dort nicht bekannt. Weil sie vor allem im Alten Land und weiter elbaufwärts vorkommt, wird vermutet, dass niederländische Siedler sie mitgebracht oder gezogen haben. Das Sortenblatt der Norddeutschen Apfeltage stützt sich auf Loewel und Labus, „Deutsche Äpfel“ (1941), Nr. 27.","belege":[{"quelle":"web_pomologen_verein","url":"https://www.pomologen-verein.de/media/user_upload/2023_Hollaender_Prinz.pdf"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Holländer_Prinz&oldid=232870340"}]},{"thema":"frucht","text":"Die Frucht ist mittelgroß und kugelig bis hochkugelig. Angaben zu Kelch, Stiel und Gruben enthalten die ausgewerteten Quellen nicht.","belege":[{"quelle":"web_pomologen_verein","url":"https://www.pomologen-verein.de/media/user_upload/2023_Hollaender_Prinz.pdf"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Holländer_Prinz&oldid=232870340"}]},{"thema":"schale","text":"Die Grundfarbe ist hellgelb, bis zu zwei Drittel der Schale können karminrot überzogen sein. Typisch sind große Lentizellen, die fließend in hellbraune Rostnetze übergehen. Um den Stiel ist die Frucht grobschuppig und weit auslaufend berostet.","belege":[{"quelle":"web_pomologen_verein","url":"https://www.pomologen-verein.de/media/user_upload/2023_Hollaender_Prinz.pdf"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Holländer_Prinz&oldid=232870340"}]},{"thema":"schnitt","text":"Nähere Angaben zum Kernhaus fehlen. Das Sortenblatt hält fest, dass dem Holländer Prinz die typischen Merkmale der Prinzenäpfel fehlen, etwa das offene Kernhaus und die Walzenform; die Sorte gehöre eher zu den Renetten. Das Fleisch ist am Schnitt etwas gelblich.","belege":[{"quelle":"web_pomologen_verein","url":"https://www.pomologen-verein.de/media/user_upload/2023_Hollaender_Prinz.pdf"}]},{"thema":"fleisch_geschmack","text":"Das etwas gelbliche Fruchtfleisch ist saftig, leicht aromatisch und vorwiegend süßlich. Im Lager wird es mürbe.","belege":[{"quelle":"web_pomologen_verein","url":"https://www.pomologen-verein.de/media/user_upload/2023_Hollaender_Prinz.pdf"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Holländer_Prinz&oldid=232870340"}]},{"thema":"reife_lagerung","text":"Pflückreif ab Mitte September, genussreif von Mitte September bis Mitte November.","belege":[{"quelle":"web_pomologen_verein","url":"https://www.pomologen-verein.de/media/user_upload/2023_Hollaender_Prinz.pdf"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Holländer_Prinz&oldid=232870340"}]},{"thema":"baum","text":"Der Baum wächst mittelstark bis stark und gilt als relativ robust.","belege":[{"quelle":"web_pomologen_verein","url":"https://www.pomologen-verein.de/media/user_upload/2023_Hollaender_Prinz.pdf"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Holländer_Prinz&oldid=232870340"}]},{"thema":"unterscheidung","text":"Trotz des Namens ist der Holländer Prinz kein typischer Prinzenapfel: Nach dem Sortenblatt fehlen ihm das offene Kernhaus und die Walzenform dieser Gruppe.","belege":[{"quelle":"web_pomologen_verein","url":"https://www.pomologen-verein.de/media/user_upload/2023_Hollaender_Prinz.pdf"}]}],"bilder":[],"regionen":[{"region":"DE-NI","art":"verbreitung","belege":[{"quelle":"web_pomologen_verein","url":"https://www.pomologen-verein.de/media/user_upload/2023_Hollaender_Prinz.pdf"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Holländer_Prinz&oldid=232870340"},{"quelle":"web_pomologen_verein","url":"https://www.pomologen-verein.de/media/user_upload/2023_Hollaender_Prinz.pdf"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Holländer_Prinz&oldid=232870340"}],"original":"Verbreitet im Alten Land und an der Elbe aufwärts bis ins Wendland"},{"region":"DE-SH","art":"empfehlung","belege":[{"quelle":"rg_shhh-pv-sortenempfehlung"}],"original":"Holländer Prinz"},{"region":"DE-HH","art":"empfehlung","belege":[{"quelle":"rg_shhh-pv-sortenempfehlung"}],"original":"Holländer Prinz"}]}