seite":"226 (Nr. 204)"},{"merkmal":"frucht_rippung","wert":"5","original":"Querschn. etwas flachkantig","quelle":"engelbrecht1889","seite":"226 (Nr. 204)"},{"merkmal":"stiel_dicke","wert":"3","original":"Stiel holzig, dünn, etwa 16 mm l.","quelle":"engelbrecht1889","seite":"226 (Nr. 204)"},{"merkmal":"stielgrube_tiefe","wert":"5","original":"Höhle mitteltief, mittelweit, fast eben","quelle":"engelbrecht1889","seite":"226 (Nr. 204)"},{"merkmal":"stielgrube_weite","wert":"5","original":"Höhle mitteltief, mittelweit, fast eben","quelle":"engelbrecht1889","seite":"226 (Nr. 204)"},{"merkmal":"schale_berostung_stielgrube","wert":"3","original":"nicht weithin zart hellbraun berostet","quelle":"engelbrecht1889","seite":"226 (Nr. 204)"},{"merkmal":"schale_beschaffenheit","wert":"glatt","original":"Schale glatt, geschmeidig, fast fettig, glänzend","quelle":"engelbrecht1889","seite":"226 (Nr. 204)"},{"merkmal":"schale_beschaffenheit","wert":"glaenzend","original":"Schale glatt, geschmeidig, fast fettig, glänzend","quelle":"engelbrecht1889","seite":"226 (Nr. 204)"},{"merkmal":"schale_grundfarbe","wert":"gelb","original":"hellgrünlichgelb, später gelb, fast wachsartig gelb","quelle":"engelbrecht1889","seite":"226 (Nr. 204)"},{"merkmal":"schale_grundfarbe","wert":"weisslichgelb","original":"hellgrünlichgelb, später gelb, fast wachsartig gelb","quelle":"engelbrecht1889","seite":"226 (Nr. 204)"},{"merkmal":"schale_deckfarbe_anteil","wert":"5","original":"sonnenw. leuchtend carmoisinroth überzogen","quelle":"engelbrecht1889","seite":"226 (Nr. 204)"},{"merkmal":"schale_deckfarbe_farbton","wert":"rot","original":"sonnenw. leuchtend carmoisinroth überzogen","quelle":"engelbrecht1889","seite":"226 (Nr. 204)"},{"merkmal":"schale_deckfarbe_art","wert":"verwaschen","original":"carmoisinroth überzogen, nicht oder undeutlich streifig","quelle":"engelbrecht1889","seite":"226 (Nr. 204)"},{"merkmal":"schale_lentizellen_anzahl","wert":"3","original":"Punkte sparsam, recht fein, bräunlich","quelle":"engelbrecht1889","seite":"226 (Nr. 204)"},{"merkmal":"schale_lentizellen_groesse","wert":"3","original":"Punkte sparsam, recht fein, bräunlich","quelle":"engelbrecht1889","seite":"226 (Nr. 204)"},{"merkmal":"schale_lentizellen_art","wert":"braun","original":"Punkte … bräunlich, im Roth als gelbe Dupfen erscheinend","quelle":"engelbrecht1889","seite":"226 (Nr. 204)"},{"merkmal":"kernhaus_form","wert":"zwiebel","original":"Kernhaus 33:26, zwiebelf.","quelle":"engelbrecht1889","seite":"226 (Nr. 204)"},{"merkmal":"kernfaecher_oeffnung","wert":"geschlossen","original":"Kammern 9:16 … mittelgeräumig, nicht oder wenig offen","quelle":"engelbrecht1889","seite":"226 (Nr. 204)"},{"merkmal":"kernfaecher_oeffnung","wert":"teilweise","original":"Kammern 9:16 … mittelgeräumig, nicht oder wenig offen","quelle":"engelbrecht1889","seite":"226 (Nr. 204)"},{"merkmal":"kernhaus_achse","wert":"offen","original":"Achsenh. schmal","quelle":"engelbrecht1889","seite":"226 (Nr. 204)"},{"merkmal":"kerne_form","wert":"eifoermig","original":"Kerne zu 1 bis 2, mittelgross, meistens vollkommen, eiförmig, gespitzt","quelle":"engelbrecht1889","seite":"226 (Nr. 204)"},{"merkmal":"kelchhoehle_form","wert":"dreieck_lang","original":"Kelchhöhle abgestumpfter Kegel, ½ zur Achsenh.","quelle":"engelbrecht1889","seite":"226 (Nr. 204)"},{"merkmal":"fleisch_farbe","wert":"cremeweiss","original":"Fleisch hellgelblichweiss, fast weiss","quelle":"engelbrecht1889","seite":"226 (Nr. 204)"},{"merkmal":"fleisch_festigkeit","wert":"3","original":"fein, mürbe, zart","quelle":"engelbrecht1889","seite":"226 (Nr. 204)"},{"merkmal":"fleisch_saftigkeit","wert":"7","original":"saftig","quelle":"engelbrecht1889","seite":"226 (Nr. 204)"},{"merkmal":"geschmack_saeure","wert":"5","original":"wenig vorherrschend, mild weinig, nicht viel weniger süss","quelle":"engelbrecht1889","seite":"226 (Nr. 204)"},{"merkmal":"geschmack_suesse","wert":"5","original":"wenig vorherrschend, mild weinig, nicht viel weniger süss","quelle":"engelbrecht1889","seite":"226 (Nr. 204)"},{"merkmal":"geschmack_aroma","wert":"edel rosenapfelartig gewürzt","original":"edel rosenapfelartig gewürzt","quelle":"engelbrecht1889","seite":"226 (Nr. 204)"},{"merkmal":"verwendung","wert":"tafel","original":"fast oo†† (Kopfzeile)","quelle":"engelbrecht1889","seite":"226 (Nr. 204)"},{"merkmal":"verwendung","wert":"kueche","original":"fast oo†† (Kopfzeile)","quelle":"engelbrecht1889","seite":"226 (Nr. 204)"},{"merkmal":"genussreife_beginn","wert":"11","original":"Ende November bis Februar, März","quelle":"engelbrecht1889","seite":"226 (Nr. 204)"},{"merkmal":"genussreife_ende","wert":"2","original":"Ende November bis Februar, März","quelle":"engelbrecht1889","seite":"226 (Nr. 204)"},{"merkmal":"genussreife_ende","wert":"3","original":"Ende November bis Februar, März","quelle":"engelbrecht1889","seite":"226 (Nr. 204)"},{"merkmal":"kernhaus_breite_mm","wert":33,"original":"Kernhaus 33:26","quelle":"engelbrecht1889","seite":"226 (Nr. 204)"},{"merkmal":"kernhaus_hoehe_mm","wert":26,"original":"Kernhaus 33:26","quelle":"engelbrecht1889","seite":"226 (Nr. 204)"},{"merkmal":"kernfach_breite_mm","wert":9,"original":"Kammern 9:16","quelle":"engelbrecht1889","seite":"226 (Nr. 204)"},{"merkmal":"kernfach_hoehe_mm","wert":16,"original":"Kammern 9:16","quelle":"engelbrecht1889","seite":"226 (Nr. 204)"},{"merkmal":"lagerfaehigkeit","wert":"7","original":"Nach Engelbrecht ist die Frucht von Ende November bis Februar oder März genussreif","quelle":"engelbrecht1889","seite":"226 (Nr. 204)"}],"texte":[{"thema":"ueberblick","text":"Südtiroler Winterapfel aus der Gruppe der Rosenäpfel, der als sehr guter Tafelapfel gilt. Zeitweise war er die Hauptsorte des Südtiroler Erwerbsanbaus. Engelbrecht beschrieb ihn 1889 unter dem Namen Mantuaner und nannte Kalterer Böhmer als zweiten Namen.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Kalterer_Böhmer&oldid=260070328"},{"quelle":"engelbrecht1889","seite":"226 (Nr. 204)"}]},{"thema":"herkunft","text":"Die Sorte stammt aus Südtirol, entstand als Zufallssämling und ist seit etwa 1810 bekannt. Engelbrecht bezog sich auf Maders Schrift über die wertvollsten Obstsorten für Südtirol und erhielt seine Früchte von Mader aus San Michele. 1929 stellte sie 28 Prozent der gesamten Südtiroler Apfelanlieferung; ihr Anbau wuchs bis in die 1950er-Jahre und ging danach zugunsten anderer Sorten zurück. Im Erwerbsanbau spielt sie heute keine Rolle mehr.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Kalterer_Böhmer&oldid=260070328"},{"quelle":"engelbrecht1889","seite":"226 (Nr. 204)"}]},{"thema":"frucht","text":"Engelbrecht maß 78 mm Breite bei nur 54 bis 55 mm Höhe; die Frucht ist also deutlich flachrund, mittelbauchig und hat nach ihm gleiche Hälften. Der geschlossene Kelch sitzt in einer tiefen, etwas engen Grube zwischen flachen, breit zum Bauch laufenden Rippen; der Querschnitt ist etwas flachkantig. Der dünne, holzige Stiel ist etwa 16 mm lang, die Stielgrube mitteltief, mittelweit und zart hellbraun berostet.","belege":[{"quelle":"engelbrecht1889","seite":"226 (Nr. 204)"}]},{"thema":"schale","text":"Die glatte, geschmeidige und glänzende Schale fühlt sich fast fettig an. Sie ist zunächst hell grünlichgelb, später gelb bis fast wachsgelb. Die Sonnenseite ist leuchtend karminrot überzogen, kaum oder gar nicht gestreift. Die spärlichen, sehr feinen bräunlichen Punkte erscheinen im Rot als gelbe Tupfen.","belege":[{"quelle":"engelbrecht1889","seite":"226 (Nr. 204)"}]},{"thema":"schnitt","text":"Das Kernhaus ist zwiebelförmig und klein (33:26 mm). Die glattwandigen, mittelgeräumigen Kammern sind an beiden Enden spitz oder kelchwärts kaum abgestumpft und nicht oder nur wenig offen; die Achsenhöhle ist schmal. Je Kammer liegen ein bis zwei mittelgroße, meist vollkommene, eiförmige, gespitzte braune Kerne. Die Kelchhöhle ist ein abgestumpfter Kegel, der bis zur Hälfte des Weges zur Achsenhöhle reicht. Das Fleisch ist am Schnitt hell gelblichweiß bis fast weiß.","belege":[{"quelle":"engelbrecht1889","seite":"226 (Nr. 204)"}]},{"thema":"fleisch_geschmack","text":"Das Fleisch ist fein, mürbe, zart und saftig. Engelbrecht beschreibt den Geschmack als edel rosenapfelartig gewürzt, mit milder, kaum vorherrschender Säure und fast gleich starker Süße.","belege":[{"quelle":"engelbrecht1889","seite":"226 (Nr. 204)"}]},{"thema":"reife_lagerung","text":"Nach Engelbrecht ist die Frucht von Ende November bis Februar oder März genussreif und welkt nicht.","belege":[{"quelle":"engelbrecht1889","seite":"226 (Nr. 204)"}]},{"thema":"verwendung","text":"Engelbrecht stufte die Sorte fast als sehr gute Tafel- und Haushaltsfrucht ein (fast oo††). Heute gilt sie vor allem als Apfel für den Frischverzehr.","belege":[{"quelle":"engelbrecht1889","seite":"226 (Nr. 204)"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Kalterer_Böhmer&oldid=260070328"}]}],"bilder":[{"url":"https://archive.org/download/bub_gb_tR4EMgEACAAJ/page/n243_w800.jpg","seite":"https://archive.org/details/bub_gb_tR4EMgEACAAJ/page/n243","art":"schnitt","urheber":"Theodor Engelbrecht (Zeichnung), Albert Probst (Holzschnitt)","lizenz":"gemeinfrei","quelle":"engelbrecht1889","titel":"Längsschnitt-Umriss bei Engelbrecht 1889, S. 226 (ganze Buchseite)"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/1d/Kalterer_B%C3%B6hmer_jm55271.jpg/960px-Kalterer_B%C3%B6hmer_jm55271.jpg","seite":"https://commons.wikimedia.org/wiki/File:Kalterer_B%C3%B6hmer_jm55271.jpg","art":"frucht","urheber":"joergens.mi","lizenz":"CC BY-SA 3.0","quelle":"commons","titel":"Kalterer Böhmer jm55271.jpg"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/0/03/Le_Jardin_%28Pl._2%29_%287467872810%29.jpg/960px-Le_Jardin_%28Pl._2%29_%287467872810%29.jpg","seite":"https://commons.wikimedia.org/wiki/File:Le_Jardin_(Pl._2)_(7467872810).jpg","art":"tafel","urheber":"Unknown author Unknown author","lizenz":"gemeinfrei","quelle":"commons-illustrationen","titel":"Le Jardin (Pl. 2) (7467872810)"}],"gefaehrdung":[{"stufe":"Rote Liste der gefährdeten einheimischen Nutzpflanzen in Deutschland","belege":[{"quelle":"rg_ble-rote-liste"}],"original":"Kalterer Böhmer"}]}