"},{"merkmal":"verwendung","wert":"tafel","quelle":"nfc2025","seite":"Akzession 1907004","original":"Dessert"},{"merkmal":"pflueckreife","wert":"8","quelle":"nfc2025","seite":"Akzession 1907004","original":"Late August"},{"merkmal":"genussreife_ende","wert":"9","quelle":"nfc2025","seite":"Akzession 1907004","original":"September"},{"merkmal":"bluete_zeit","wert":"3","quelle":"nfc2025","seite":"Akzession 1907004","original":"Klasse 4 (10 % der Blüten offen, Tag 122)"},{"merkmal":"bluete_zeit","wert":"5","quelle":"nfc2025","seite":"Akzession 1907004","original":"Klasse 4 (10 % der Blüten offen, Tag 122)"}],"texte":[{"thema":"ueberblick","text":"Mittelgroßer, walzenförmiger Apfel mit orangefarbener Grundfarbe und roter Deckfarbe. Die Schale ist kaum berostet, das Fruchtfleisch gelblich. Bei der Verkostung war das Fleisch fest und mäßig saftig, der Geschmack wenig bis mäßig süß und mäßig sauer, mit sehr schwachem Aroma. Tafelapfel, pflückreif Ende August und lagerfähig bis September.","belege":[{"quelle":"nfc2025","seite":"Akzession 1907004"}]}],"bilder":[{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/3/36/The_Pomological_magazine_%28Pl._107%29_%288744821098%29.jpg/960px-The_Pomological_magazine_%28Pl._107%29_%288744821098%29.jpg","seite":"https://commons.wikimedia.org/wiki/File:The_Pomological_magazine_(Pl._107)_(8744821098).jpg","art":"tafel","urheber":"Lindley, John","lizenz":"gemeinfrei","quelle":"commons-illustrationen","titel":"The Pomological magazine (Pl. 107) (8744821098)"}]}