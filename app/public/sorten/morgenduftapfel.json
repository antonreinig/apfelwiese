{"id":"morgenduftapfel","name":"Morgenduftapfel","synonyme":[{"name":"Morgenduft-Apfel","beleg":{"quelle":"illustr_hb_1","band":"I","seite":"97"}},{"name":"Hoary Morning","beleg":{"quelle":"engelbrecht1889","seite":"185 (Nr. 164)"}},{"name":"Dainty Apple","beleg":{"quelle":"illustr_hb_1","band":"I","seite":"97"}},{"name":"Downy","beleg":{"quelle":"illustr_hb_1","band":"I","seite":"97"}},{"name":"Sam Rawlings","beleg":{"quelle":"illustr_hb_1","band":"I","seite":"97"}},{"name":"Bedufteter Morgen-Apfel","beleg":{"quelle":"illustr_hb_1","band":"I","seite":"97"}}],"herkunft":{"text":"Nach dem Illustrirten Handbuch (1859) ein englischer Apfel, der auch in nordamerikanischen und deutschen Gärten verbreitet war.","belege":[{"quelle":"illustr_hb_1","band":"I","seite":"97"}]},"merkmale":[{"merkmal":"frucht_breite","wert":82,"original":"Gestalt 82:53—56","quelle":"engelbrecht1889","seite":"185 (Nr. 164)"},{"merkmal":"frucht_hoehe","wert":54.5,"original":"Gestalt 82:53—56","quelle":"engelbrecht1889","seite":"185 (Nr. 164)"},{"merkmal":"frucht_hoehe_breite","wert":0.66,"original":"Gestalt 82:53—56","quelle":"engelbrecht1889","seite":"185 (Nr. 164)"},{"merkmal":"frucht_form","wert":"flachrund","original":"bald flachrund, doch etwas stielbauch., bald kelchw. merklich abnehmend","quelle":"engelbrecht1889","seite":"185 (Nr. 164)"},{"merkmal":"frucht_breiteste_stelle","wert":"stiel","original":"flachrund, doch etwas stielbauch.","quelle":"engelbrecht1889","seite":"185 (Nr. 164)"},{"merkmal":"frucht_symmetrie","wert":"symmetrisch","original":"Hälften wenig verschieden","quelle":"engelbrecht1889","seite":"185 (Nr. 164)"},{"merkmal":"frucht_rippung","wert":"1","original":"Querschnitt rund","quelle":"engelbrecht1889","seite":"185 (Nr. 164)"},{"merkmal":"kelch_offenheit","wert":"geschlossen","original":"Kelch geschlossen, ziemlich klein, meist braun","quelle":"engelbrecht1889","seite":"185 (Nr. 164)"},{"merkmal":"kelchgrube_tiefe","wert":"3","original":"Einsenk. wenig tief, meist ziemlich