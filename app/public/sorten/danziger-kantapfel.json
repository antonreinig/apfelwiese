utsche_Pomologie_-_Aepfel_-_017.jpg","methode":"Farbtafel","verfahren":"Chromolithografie (Lauche, Deutsche Pomologie 1882–83); Papierton als Weißpunkt; Frucht vor Papier freigestellt; Schalenpixel einzeln klassifiziert (Deckfarbe = deutlich höheres a* als die Grundfarbe, Anteile über Pixel); Höhe/Breite aus dem Längsschnitt, sonst aus der Seitenansicht; gemessen an einer 480 px breiten Kopie; Druckfarben gealtert, nicht fotometrisch","grundfarbe":"#d9ab20","deckfarbe":"#ad1106","deckfarbeAnteil":0.88,"fleischfarbe":"#ece8d3","hoeheZuBreite":0.837}],"bildabgleich":{"bild":"https://upload.wikimedia.org/wikipedia/commons/d/db/Cross_section_of_Danziger_Kantapfel%2C_National_Fruit_Collection_%28acc._1948-656%29.jpg","seite":"https://commons.wikimedia.org/wiki/File:Cross_section_of_Danziger_Kantapfel,_National_Fruit_Collection_(acc._1948-656).jpg","verfahren":"Umriss der NFC-Seitenansichten gegen den Modellumriss (Rastersuche über Höhe/Breite, Kegel- und Walzenform), Lage am Stielrest erkannt, Rippung aus der Stielansicht; Version 3","werte":{"hoeheZuBreite":0.94,"konisch":0.14,"walze":-0.2,"rippung":0.2,"unregelmaessig":0},"guete":0.0267},"regionen":[{"region":"DE-BW","art":"empfehlung","belege":[{"quelle":"rg_bw-logl-streuobstsorte-des-jahres","seite":"Streuobstsorte des Jahres 2006"}],"original":"Danziger Kantapfel"},{"region":"DE-BY","art":"empfehlung","belege":[{"quelle":"rg_by-lwg-3151"}],"original":"Danziger Kant"},{"region":"DE-BB","art":"empfehlung","belege":[{"quelle":"rg_bb-pv-sortenempfehlung"}],"original":"Danziger Kantapfel"},{"region":"DE-BE","art":"empfehlung","belege":[{"quelle":"rg_bb-pv-sortenempfehlung"}],"original":"Danziger Kantapfel"},{"region":"DE-MV","art":"empfehlung","belege":[{"quelle":"rg_mv-lfa-hoehne-2012","seite":"S. 187, Tab. 1"}],"original":"Danziger Kantapfel"},{"region":"DE-NW","art":"empfehlung","belege":[{"quelle":"rg_nw-koordinierungsausschuss-2023"}],"original":"Danziger Kantapfel"},{"region":"DE-RP","art":"empfehlung","belege":[{"quelle":"rg_rp-streuobst-sortenempfehlung-2018"}],"original":"Danziger Kantapfel"},{"region":"DE-ST","art":"regionalsorte","belege":[{"quelle":"rg_st-lpv-boerde-2012"}],"original":"Danziger Kantapfel"},{"region":"DE-SH","art":"empfehlung","belege":[{"quelle":"rg_shhh-pv-sortenempfehlung"}],"original":"Danziger Kantapfel"},{"region":"DE-HH","art":"empfehlung","belege":[{"quelle":"rg_shhh-pv-sortenempfehlung"}],"original":"Danziger Kantapfel"},{"region":"DE-TH","art":"empfehlung","belege":[{"quelle":"rg_th-grueneliga-2002"}],"original":"Danziger Kantapfel"}],"gefaehrdung":[{"stufe":"Rote Liste der gefährdeten einheimischen Nutzpflanzen in Deutschland","belege":[{"quelle":"rg_ble-rote-liste"}],"original":"Danziger Kantapfel"}]}