{"id":"florianer-rosenapfel","name":"Florianer Rosenapfel","synonyme":[{"name":"Rose de St. Florian","beleg":{"quelle":"engelbrecht1889","seite":"214 (Nr. 193)"}},{"name":"Florianer Rosenapfel","beleg":{"quelle":"illustr_hb_1","band":"I","seite":"431"}},{"name":"Gestreifter Rosenapfel","beleg":{"quelle":"illustr_hb_1","band":"I","seite":"431"}}],"herkunft":{"text":"Herkunft unsicher, vielleicht aus der Abtei St. Florian (Oberösterreich). Oberdieck erhielt die Reiser von Magister Schröder in Homburg als Gestreiften Rosenapfel, benannte die Sorte um und verbreitete sie.","belege":[{"quelle":"illustr_hb_1","band":"I","seite":"431"}],"land":"AT","landSicher":false},"merkmale":[{"merkmal":"frucht_breite","wert":69,"original":"Gestalt 69:67—69","quelle":"engelbrecht1889","seite":"214 (Nr. 193)"},{"merkmal":"frucht_hoehe","wert":68,"original":"Gestalt 69:67—69","quelle":"engelbrecht1889","seite":"214 (Nr. 193)"},{"merkmal":"frucht_hoehe_breite","wert":0.99,"original":"Gestalt 69:67—69","quelle":"engelbrecht1889","seite":"214 (Nr. 193)"},{"merkmal":"frucht_breiteste_stelle","wert":"stiel","original":"stielbauchig","quelle":"engelbrecht1889","seite":"214 (Nr. 193)"},{"merkmal":"frucht_symmetrie","wert":"schief","original":"Hälften meistens etwas verschieden","quelle":"engelbrecht1889","seite":"214 (Nr. 193)"},{"merkmal":"kelch_offenheit","wert":"geschlossen","original":"Kelch geschlossen, grün und braun, wollig","quelle":"engelbrecht1889","seite":"214 (Nr. 193)"},{"merkmal":"kelchgrube_tiefe","wert":"7","original":"Einsenkung tief, weit","quelle":"engelbrecht1889","seite":"214 (Nr. 193)"},{"merkmal":"kelchgrube_weite","wert":"7","original":"Einsenkung tief, weit","quelle":"engelbrecht1889","seite":"214 (Nr. 193)"},{"merkmal":"frucht_kronung","wert":"9","original":"zwischen starken, doch flach und ungleich über den Bauch laufenden Rippen","quelle":"engelbrecht1889","seite":"214 (Nr. 193)"},{"merkmal":"frucht_rippung","wert":"3","original":"Querschnitt nicht ganz rund","quelle":"engelbrecht1889","seite":"214 (Nr. 193)"},{"merkmal":"stiel_dicke","wert":"3","original":"Stiel holzig, dünn bis mitteldick, etwa 15 mm lang","quelle":"engelbrecht1889","seite":"214 (Nr. 193)"},{"merkmal":"stiel_dicke","wert":"5","original":"Stiel holzig, dünn bis mitteldick, etwa 15 mm lang","quelle":"engelbrecht1889","seite":"214 (Nr. 193)"},{"merkmal":"stielgrube_tiefe","wert":"5","original":"Höhle mitteltief bis tief, mittelweit","quelle":"engelbrecht1889","seite":"214 (Nr. 193)"},{"merkmal":"stielgrube_tiefe","wert":"7","original":"Höhle mitteltief bis tief, mittelweit","quelle":"engelbrecht1889","seite":"214 (Nr. 193)"},{"merkmal":"stielgrube_weite","wert":"5","original":"Höhle mitteltief bis tief, mittelweit","quelle":"engelbrecht1889","seite":"214 (Nr. 193)"},{"merkmal":"schale_berostung_stielgrube","wert":"3","original":"fast eben, zart berostet","quelle":"engelbrecht1889","seite":"214 (Nr. 193)"},{"merkmal":"schale_beschaffenheit","wert":"bereift","original":"Schale fein, etwas geschmeidig, beduftet","quelle":"engelbrecht1889","seite":"214 (Nr. 193)"},{"merkmal":"schale_grundfarbe","wert":"gelb","original":"grünlichgelb, später gelb","quelle":"engelbrecht1889","seite":"214 (Nr. 193)"},{"merkmal":"schale_deckfarbe_anteil","wert":"7","original":"sonnenwärts weithin punktirt geröthet","quelle":"engelbrecht1889","seite":"214 (Nr. 193)"},{"merkmal":"schale_deckfarbe_farbton","wert":"rot","original":"dunkler roth, zuweilen fast ringsum dunkler roth gestreift","quelle":"engelbrecht1889","seite":"214 (Nr. 193)"},{"merkmal":"schale_deckfarbe_art","wert":"getuepfelt","original":"weithin punktirt geröthet","quelle":"engelbrecht1889","seite":"214 (Nr. 193)"},{"merkmal":"schale_deckfarbe_art","wert":"gestreift","original":"zuweilen fast ringsum dunkler roth gestreift","quelle":"engelbrecht1889","seite":"214 (Nr. 193)"},{"merkmal":"schale_lentizellen_anzahl","wert":"3","original":"Punkte sparsam, fein, hellbräunlich","quelle":"engelbrecht1889","seite":"214 (Nr. 193)"