,"band":"I","seite":"431"},{"merkmal":"schale_lentizellen_anzahl","wert":"3","original":"Punkte fein, zerstreut","quelle":"illustr_hb_1","band":"I","seite":"431"},{"merkmal":"schale_lentizellen_groesse","wert":"3","original":"Punkte fein, zerstreut","quelle":"illustr_hb_1","band":"I","seite":"431"},{"merkmal":"kerne_form","wert":"eifoermig","original":"fast eiförmigen, vollkommenen, schwarzbraunen Kernen","quelle":"illustr_hb_1","band":"I","seite":"431"},{"merkmal":"kelchhoehle_form","wert":"dreieck_breit","original":"Kelchröhre geht als breiter Kegel … etwas herab","quelle":"illustr_hb_1","band":"I","seite":"431"},{"merkmal":"fleisch_saftigkeit","wert":"5","original":"hinreichend saftreich","quelle":"illustr_hb_1","band":"I","seite":"431"},{"merkmal":"geschmack_suesse","wert":"7","original":"von gezuckertem, durch etwas Säure gehobenen … Geschmacke","quelle":"illustr_hb_1","band":"I","seite":"431"},{"merkmal":"geschmack_saeure","wert":"5","original":"von gezuckertem, durch etwas Säure gehobenen … Geschmacke","quelle":"illustr_hb_1","band":"I","seite":"431"},{"merkmal":"geschmack_aroma","wert":"alantartig gewürzt","original":"merklich alantartig gewürzten, delikaten Geschmacke","quelle":"illustr_hb_1","band":"I","seite":"431"},{"merkmal":"genussreife_beginn","wert":"10","original":"zeitigt bald nach Michaelis","quelle":"illustr_hb_1","band":"I","seite":"431"},{"merkmal":"genussreife_ende","wert":"12","original":"hält sich in gutem Geschmack bis gegen Weihnachten","quelle":"illustr_hb_1","band":"I","seite":"431"},{"merkmal":"verwendung","wert":"tafel","original":"Für Tafel und Haushalt sehr schätzbar","quelle":"illustr_hb_1","band":"I","seite":"431"},{"merkmal":"verwendung","wert":"kueche","original":"Für Tafel und Haushalt sehr schätzbar","quelle":"illustr_hb_1","band":"I","seite":"431"},{"merkmal":"baum_wuchs","wert":"5","original":"wächst … gesund, doch gemäßigt","quelle":"illustr_hb_1","band":"I","seite":"431"},{"merkmal":"kernhaus_breite_mm","wert":37,"original":"Kernhaus 37:39","quelle":"engelbrecht1889","seite":"214 (Nr. 193)"},{"merkmal":"kernhaus_hoehe_mm","wert":39,"original":"Kernhaus 37:39","quelle":"engelbrecht1889","seite":"214 (Nr. 193)"},{"merkmal":"kernfach_breite_mm","wert":12,"original":"Kammern 12:18","quelle":"engelbrecht1889","seite":"214 (Nr. 193)"},{"merkmal":"kernfach_hoehe_mm","wert":18,"original":"Kammern 12:18","quelle":"engelbrecht1889","seite":"214 (Nr. 193)"},{"merkmal":"frucht_breite","wert":67,"quelle":"nfc2025","seite":"Akzession 1947320 (Smith 1971)"},{"merkmal":"frucht_hoehe","wert":64,"quelle":"nfc2025","seite":"Akzession 1947320 (Smith 1971)"},{"merkmal":"frucht_groesse","wert":"5","quelle":"nfc2025","seite":"Akzession 1947320 (Smith 1971)","original":"Medium"},{"merkmal":"frucht_form","wert":"elliptisch","quelle":"nfc2025","seite":"Akzession 1947320 (Smith 1971)","original":"Ellipsoid"},{"merkmal":"frucht_hoehe_breite","wert":0.955,"quelle":"nfc2025","seite":"Akzession 1947320 (Smith 1971)"},{"merkmal":"frucht_rippung","wert":"5","quelle":"nfc2025","seite":"Akzession 1947320 (Smith 1971)","original":"Medium"},{"merkmal":"schale_grundfarbe","wert":"gelb","quelle":"nfc2025","seite":"Akzession 1947320 (Smith 1971)","original":"Yellow"},{"merkmal":"schale_deckfarbe_farbton","wert":"rot","quelle":"nfc2025","seite":"Akzession 1947320 (Smith 1971)","original":"Red"},{"merkmal":"schale_deckfarbe_art","wert":"gestreift","quelle":"nfc2025","seite":"Akzession 1947320 (Smith 1971)","original":"Only stripes"},{"merkmal":"fleisch_farbe","wert":"gruenlich","quelle":"nfc2025","seite":"Akzession 1947320 (Smith 1971)","original":"Greenish"},{"merkmal":"verwendung","wert":"tafel","quelle":"nfc2025","seite":"Akzession 1947320","original":"Dessert"},{"merkmal":"pflueckreife","wert":"10","quelle":"nfc2025","seite":"Akzession 1947320","original":"Mid October"},{"merkmal":"genussreife_ende","wert":"1","quelle":"nfc2025","seite":"Akzession 1947320","original":"January"},{"merkmal":"bluete_zeit","wert":"5","quelle":"nfc2025","seite":"Akzession 1947320","original":"Klasse 5 (10 % der Blüten offen, Tag 126)"},{"merkmal":"gesundheit","wert":"7","original":"wächst in allerlei Boden gesund","quelle":"illustr_hb_1","band":"I","seite":"431"},{"merkmal":"standort_boden","wert":"3","original":"wächst in allerlei Boden gesund","quelle":"illustr_hb_1","band":"I","seite":"431"},{"merkmal":"ertrag_beginn","wert":"frueh","original":"trägt früh und reichlich","quelle":"illustr_hb_1","band":"I","seite":"431"},{"merkmal":"lagerfaehigkeit","wert":"5","original":"Genussreif von Oktober bis Dezember","quelle":"engelbrecht1889","seite":"214 (Nr. 193)","belege":[{"quelle":"engelbrecht1889","seite":"214 (Nr. 193)"},{"quelle":"illustr_hb_1","band":"I","seite":"431"}]}],"texte":[{"thema":"ueberblick","text":"Hochgebauter, etwa gleich breiter wie hoher Herbstapfel mit gelber, weithin geröteter und rot gestreifter Schale und würzigem, alantartigem Geschmack. Genussreif von Oktober bis Dezember.","belege":[{"quelle":"engelbrecht1889","seite":"214 (Nr. 193)"},{"quelle":"illustr_hb_1","band":"I","seite":"431"}]},{"thema":"herkunft","text":"Oberdieck erhielt die Reiser von Magister Schröder in Homburg unter dem Namen Gestreifter Rosenapfel, angeblich von Schmidberger aus St. Florian. Weil dieser Name schon für andere Sorten vergeben war und sich die Herkunft aus St. Florian als zweifelhaft erwies, benannte er die Sorte in Florianer Rosenapfel um und verschickte sie vielfach. Den echten St. Florianer Gestreiften Rosenapfel hielt er für identisch mit Diels Tulpenapfel. Engelbrecht erhielt 1889 Früchte von Kolbe aus Langwarden (Oldenburg).","belege":[{"quelle":"illustr_hb_1","band":"I","seite":"431"},{"quelle":"engelbrecht1889","seite":"214 (Nr. 193)"}]},{"thema":"frucht","text":"Engelbrecht maß 69 mm Breite bei 67–69 mm Höhe; die Frucht ist abgestumpft ei-walzen- bis ei-kegelförmig, zum Stiel hin am breitesten, die Hälften meist etwas verschieden. Nach dem Handbuch ist sie hochaussehend, einzeln fast walzenförmig, meist zum Kegelförmigen geneigt. Der geschlossene Kelch sitzt in einer tiefen, weiten Einsenkung zwischen starken, flach und ungleich über den Bauch laufenden Rippen, umgeben von Falten und Fleischbeulen; der Querschnitt ist nicht ganz rund. Der dünne bis mitteldicke Stiel ist etwa 15 mm lang und steht in einer mitteltiefen bis tiefen Höhle.","belege":[{"quelle":"engelbrecht1889","seite":"214 (Nr. 193)"},{"quelle":"illustr_hb_1","band":"I","seite":"431"}]},{"thema":"schale","text":"Die feine, etwas geschmeidige Schale ist beduftet, erst grünlichgelb, später gelb. Sonnenseits ist sie weithin punktiert gerötet, darüber dunkler rot und zuweilen fast ringsum gestreift (Engelbrecht). Oberdieck beschreibt eine gelbbräunliche, nicht ganz karminrote Röte über dem größten Teil der Frucht mit kurz abgesetzten, fast karminroten Streifen. Die Punkte sind spärlich, fein und hellbräunlich. Zur Stielhöhle widersprechen sich die Quellen: Engelbrecht nennt sie zart berostet, das Handbuch rostfrei.","belege":[{"quelle":"engelbrecht1889","seite":"214 (Nr. 193)"},{"quelle":"illustr_hb_1","band":"I","seite":"431"}]},{"thema":"schnitt","text":"Das Kernhaus ist zwiebel-eiförmig und etwas höher als breit (37:39 mm). Die Kammern sind ziemlich geräumig, wenig zerrissen und meist nur wenig, selten weit offen, die Achsenhöhle ist schmal. Je Kammer liegen zwei mittelgroße, meist vollkommene, eiförmige, kurz gespitzte braune Kerne; das Handbuch nennt sie schwarzbraun. Die Kelchhöhle ist kegelförmig und reicht nach Engelbrecht zwei Fünftel der Strecke zur Achsenhöhle; nach dem Handbuch geht die Kelchröhre als breiter Kegel etwas herab. Das Fleisch ist am Schnitt hellgelblichweiß.","belege":[{"quelle":"engelbrecht1889","seite":"214 (Nr. 193)"},{"quelle":"illustr_hb_1","band":"I","seite":"431"}]},{"thema":"fleisch_geschmack","text":"Das Fleisch ist fein, mürbe und saftig. Engelbrecht fand es gewürzt, etwas vorherrschend weinig und nicht ganz so süß; Oberdieck beschreibt einen gezuckerten, durch etwas Säure gehobenen, deutlich alantartig gewürzten Geschmack und einen angenehmen Geruch.","belege":[{"quelle":"engelbrecht1889","seite":"214 (Nr. 193)"},{"quelle":"illustr_hb_1","band":"I","seite":"431"}]},{"thema":"reife_lagerung","text":"Genussreif von Oktober bis Dezember; nach dem Handbuch ab kurz nach Michaelis, gut bis gegen Weihnachten und oft noch durch den Januar haltbar, ohne leicht zu faulen.","belege":[{"quelle":"engelbrecht1889","seite":"214 (Nr. 193)"},{"quelle":"illustr_hb_1","band":"I","seite":"431"}]},{"thema":"verwendung","text":"Für Tafel und Haushalt geschätzt (Handbuch); Engelbrecht vergab die Wertzeichen für Tafel und Haushalt.","belege":[{"quelle":"illustr_hb_1","band":"I","seite":"431"},{"quelle":"engelbrecht1889","seite":"214 (Nr. 193)"}]},{"thema":"baum","text":"Der Baum ähnelt nach Oberdieck dem des Alantapfels, wächst in allerlei Boden gesund, doch gemäßigt, und trägt früh und reichlich. Die Sommertriebe sind schlank, etwas wollig, bräunlichrot und stark punktiert.","belege":[{"quelle":"illustr_hb_1","band":"I","seite":"431"}]},{"thema":"unterscheidung","text":"Nach Oberdieck gleicht die Sorte in Form, Fleisch und Geschmack dem Alantapfel (Großer edler Prinzessinapfel bei Diel), ist aber stärker gerötet und reift stets früher.","belege":[{"quelle":"illustr_hb_1","band":"I","seite":"431"}]},{"thema":"frucht","text":"Nach den Erhebungen der National Fruit Collection: mittelgroße, elliptische Frucht mit gelber Grundfarbe und gestreifter roter Deckfarbe. Das Fruchtfleisch ist grünlich. Tafelapfel, pflückreif Mitte Oktober und lagerfähig bis Januar.","belege":[{"quelle":"nfc2025","seite":"Akzession 1947320"}]}],"bilder":[{"url":"https://archive.org/download/bub_gb_tR4EMgEACAAJ/page/n231_w800.jpg","seite":"https://archive.org/details/bub_gb_tR4EMgEACAAJ/page/n231","art":"schnitt","urheber":"Theodor Engelbrecht (Zeichnung), Albert Probst (Holzschnitt)","lizenz":"gemeinfrei","quelle":"engelbrecht1889","titel":"Längsschnitt-Umriss bei Engelbrecht 1889, S. 214 (ganze Buchseite)"},{"url":"https://upload.wikimedia.org/wikipedia/commons/e/e2/Cross_section_of_Florianer_Rosenapfel%2C_National_Fruit_Collection_%28acc._1947-320%29.jpg","seite":"https://commons.wikimedia.org/wiki/File:Cross_section_of_Florianer_Rosenapfel,_National_Fruit_Collection_(acc._1947-320).jpg","art":"schnitt","urheber":"National Fruit Collection, Brogdale","lizenz":"OGL 2.0","quelle":"nfc-commons","titel":"Cross section of Florianer Rosenapfel, National Fruit Collection (acc. 1947-320)"}],"munq":602,"akzessionen":[{"sammlung":"UK National Fruit Collection (Brogdale)","nummer":"1947320","name":"Florianer Rosenapfel"}],"farbmessung":[{"bild":"https://upload.wikimedia.org/wikipedia/commons/e/e2/Cross_section_of_Florianer_Rosenapfel%2C_National_Fruit_Collection_%28acc._1947-320%29.jpg","methode":"NFC-Foto","verfahren":"Foto (NFC-Fototafel: 4 ganze Früchte, 2 Schnitte, Fototisch); Weißabgleich über den Hintergrund; Frucht per Hintergrundmodell freigestellt; Schalenpixel ohne Glanzlichter einzeln klassifiziert: Grundfarbe aus gelbgrünen Pixeln, Deckfarbe = Pixel mit deutlich höherem a* als die Grundfarbe (auch dunkle Rot- und Braunrottöne), Anteile über Pixel; Höhe/Breite aus dem Längsschnitt","grundfarbe":"#d3b14f","deckfarbe":"#873a36","deckfarbeAnteil":0.67,"fleischfarbe":"#d3c6bc","hoeheZuBreite":1.244}],"gefaehrdung":[{"stufe":"Rote Liste der gefährdeten einheimischen Nutzpflanzen in Deutschland","belege":[{"quelle":"rg_ble-rote-liste"}],"original":"Florianer Rosenapfel"}]}