iginal":"gelbgrün bis rötlichgelb gefärbt","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Geheimrat_Breuhahn&oldid=170441844"},{"merkmal":"schale_deckfarbe_farbton","wert":"orange","original":"trüb orangerot marmoriert","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Geheimrat_Breuhahn&oldid=170441844"},{"merkmal":"schale_deckfarbe_art","wert":"marmoriert","original":"trüb orangerot marmoriert","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Geheimrat_Breuhahn&oldid=170441844"},{"merkmal":"fleisch_farbe","wert":"cremeweiss","original":"Das gelblich weiße Fruchtfleisch","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Geheimrat_Breuhahn&oldid=170441844"},{"merkmal":"fleisch_saftigkeit","wert":"7","original":"feinzellig, saftig","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Geheimrat_Breuhahn&oldid=170441844"},{"merkmal":"pflueckreife","wert":"9","original":"ab Ende September bis Anfang Oktober","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Geheimrat_Breuhahn&oldid=170441844"},{"merkmal":"pflueckreife","wert":"10","original":"ab Ende September bis Anfang Oktober","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Geheimrat_Breuhahn&oldid=170441844"},{"merkmal":"genussreife_beginn","wert":"10","original":"Genussreife von Oktober bis April","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Geheimrat_Breuhahn&oldid=170441844"},{"merkmal":"genussreife_ende","wert":"4","original":"Genussreife von Oktober bis April","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Geheimrat_Breuhahn&oldid=170441844"},{"merkmal":"verwendung","wert":"tafel","original":"auch für den Frischverzehr geeignet","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Geheimrat_Breuhahn&oldid=170441844"},{"merkmal":"baum_wuchs","wert":"5","original":"Der mittelstarkwüchsige Baum","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Geheimrat_Breuhahn&oldid=170441844"},{"merkmal":"frucht_breite","wert":57,"quelle":"nfc2025","seite":"Akzession 1951176 (Smith 1971)"},{"merkmal":"frucht_hoehe","wert":45,"quelle":"nfc2025","seite":"Akzession 1951176 (Smith 1971)"},{"merkmal":"frucht_groesse","wert":"5","quelle":"nfc2025","seite":"Akzession 1951176 (Smith 1971)","original":"Medium"},{"merkmal":"frucht_form","wert":"stumpfkonisch","quelle":"nfc2025","seite":"Akzession 1951176 (Smith 1971)","original":"Truncate conical"},{"merkmal":"frucht_hoehe_breite","wert":0.789,"quelle":"nfc2025","seite":"Akzession 1951176 (Smith 1971)"},{"merkmal":"frucht_rippung","wert":"1","quelle":"nfc2025","seite":"Akzession 1951176 (Smith 1971)","original":"Absence"},{"merkmal":"schale_grundfarbe","wert":"gruengelb","quelle":"nfc2025","seite":"Akzession 1951176 (Smith 1971)","original":"Green yellow"},{"merkmal":"schale_deckfarbe_farbton","wert":"orange","quelle":"nfc2025","seite":"Akzession 1951176 (Smith 1971)","original":"Orange"},{"merkmal":"schale_deckfarbe_art","wert":"gestreift","quelle":"nfc2025","seite":"Akzession 1951176 (Smith 1971)","original":"Only stripes"},{"merkmal":"fleisch_farbe","wert":"gelblich","quelle":"nfc2025","seite":"Akzession 1951176 (Smith 1971)","original":"Yellowish"},{"merkmal":"verwendung","wert":"tafel","quelle":"nfc2025","seite":"Akzession 1951176","original":"Dessert"},{"merkmal":"pflueckreife","wert":"10","quelle":"nfc2025","seite":"Akzession 1951176","original":"Early October"},{"merkmal":"genussreife_ende","wert":"3","quelle":"nfc2025","seite":"Akzession 1951176","original":"March"},{"merkmal":"bluete_zeit","wert":"5","quelle":"nfc2025","seite":"Akzession 1951176","original":"Klasse 5 (10 % der Blüten offen, Tag 125)"},{"merkmal":"anfaelligkeit_schorf","wert":"3","original":"weniger für Schorf","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Geheimrat_Breuhahn&oldid=170441844"},{"merkmal":"lagerfaehigkeit","wert":"7","original":"genussreif von Oktober bis April","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Geheimrat_Breuhahn&oldid=170441844"}],"texte":[{"thema":"ueberblick","text":"Lagerapfel aus Geisenheim mit mittelgroßen, gelbgrünen bis rötlichgelben Früchten, trüb orangerot marmoriert, genussreif von Oktober bis April.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Geheimrat_Breuhahn&oldid=170441844"}]},{"thema":"herkunft","text":"Ein Zufallssämling aus dem Halberstädter Jungfernapfel kam 1895 an die Höhere Lehranstalt für Obstbau in Geisenheim; seit 1934 ist die Sorte im Handel. Die alten Werke von Engelbrecht (1889) und das Illustrirte Handbuch beschreiben sie nicht.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Geheimrat_Breuhahn&oldid=170441844"}]},{"thema":"frucht","text":"Die Frucht ist nach Wikipedia etwa 60 mm breit, 53 mm hoch und rund 90 g schwer. Die glatte Schale ist mäßig fettig und wird später klebrig; sie ist gelbgrün bis rötlichgelb und trüb orangerot marmoriert.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Geheimrat_Breuhahn&oldid=170441844"}]},{"thema":"fleisch_geschmack","text":"Das Fleisch ist gelblichweiß, feinzellig und saftig, mild säuerlichsüß und aromatisch.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Geheimrat_Breuhahn&oldid=170441844"}]},{"thema":"reife_lagerung","text":"Pflückreif Ende September bis Anfang Oktober, genussreif von Oktober bis April; gut lagerfähig. Im Lager kann sich Stippe und leichte Schalenbräune zeigen.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Geheimrat_Breuhahn&oldid=170441844"}]},{"thema":"baum","text":"Der Baum wächst mittelstark mit aufrechten, später sich neigenden Leitästen; die anfangs pyramidale Krone wird später breiter. Er ist anfällig für Stippe und leichte Schalenbräune, weniger für Schorf. Die Blütezeit ist kurz bis mittellang; Blüten entstehen an ein- und zweijährigen Langtrieben und endständig an Kurztrieben.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Geheimrat_Breuhahn&oldid=170441844"}]},{"thema":"frucht","text":"Nach den Erhebungen der National Fruit Collection: mittelgroßer, stumpf kegelförmiger Apfel mit grünlich gelber Grundfarbe und gestreifter orangefarbener Deckfarbe. Das Fruchtfleisch ist gelblich. Tafelapfel, pflückreif Anfang Oktober und lagerfähig bis März.","belege":[{"quelle":"nfc2025","seite":"Akzession 1951176"}]}],"bilder":[{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/3/3a/Geheimrat_Breuhahn_jm55182.jpg/960px-Geheimrat_Breuhahn_jm55182.jpg","seite":"https://commons.wikimedia.org/wiki/File:Geheimrat_Breuhahn_jm55182.jpg","art":"frucht","urheber":"joergens.mi","lizenz":"CC BY-SA 3.0","quelle":"commons","titel":"Geheimrat Breuhahn jm55182.jpg"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/6/62/30795BreuhahnovoW.jpg/960px-30795BreuhahnovoW.jpg","seite":"https://commons.wikimedia.org/wiki/File:30795BreuhahnovoW.jpg","art":"frucht","urheber":"Juniperbushman","lizenz":"CC BY-SA 4.0","quelle":"commons-fotos","titel":"30795BreuhahnovoW"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/d/d6/Malus_Breuhahn_4604.jpg/960px-Malus_Breuhahn_4604.jpg","seite":"https://commons.wikimedia.org/wiki/File:Malus_Breuhahn_4604.jpg","art":"frucht","urheber":"Sven Teschke","lizenz":"CC BY-SA 3.0 DE","quelle":"commons-fotos","titel":"Malus Breuhahn 4604"}],"munq":2892,"akzessionen":[{"sammlung":"UK National Fruit Collection (Brogdale)","nummer":"1951176","name":"Geheimrat Breuhahn"}],"farbmessung":[],"regionen":[{"region":"DE-HE","art":"herkunft","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Geheimrat_Breuhahn&oldid=170441844"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Geheimrat_Breuhahn&oldid=170441844"},{"quelle":"rg_bb-pv-sortenempfehlung","seite":"Spalte Besonderheiten/Herkunft"},{"quelle":"rg_shhh-pv-sortenempfehlung","seite":"Spalte Herkunft"}]},{"region":"DE-BB","art":"empfehlung","belege":[{"quelle":"rg_bb-pv-sortenempfehlung"}],"original":"Geheimrat Breuhahn"},{"region":"DE-BE","art":"empfehlung","belege":[{"quelle":"rg_bb-pv-sortenempfehlung"}],"original":"Geheimrat Breuhahn"},{"region":"DE-ST","art":"regionalsorte","belege":[{"quelle":"rg_st-lpv-boerde-2012"}],"original":"Geheimrat Breuhahn"},{"region":"DE-SH","art":"empfehlung","belege":[{"quelle":"rg_shhh-pv-sortenempfehlung"}],"original":"Geheimrat Breuhahn"},{"region":"DE-HH","art":"empfehlung","belege":[{"quelle":"rg_shhh-pv-sortenempfehlung"}],"original":"Geheimrat Breuhahn"},{"region":"DE-TH","art":"empfehlung","belege":[{"quelle":"rg_th-grueneliga-2002"}],"original":"Geheimrat Breuhahn"}],"gefaehrdung":[{"stufe":"Rote Liste der gefährdeten einheimischen Nutzpflanzen in Deutschland","belege":[{"quelle":"rg_ble-rote-liste"}],"original":"Geheimrat Breuhahn"}]}