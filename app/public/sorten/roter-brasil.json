{"id":"roter-brasil","name":"Roter Brasil","synonyme":[{"name":"Roter Brasilienapfel","beleg":{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Roter_Brasil&oldid=270208988"}},{"name":"Großer Brasilienapfel","beleg":{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Roter_Brasil&oldid=270208988"}},{"name":"Brunsilienappel","beleg":{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Roter_Brasil&oldid=270208988"}},{"name":"Mecklenburgischer Königsapfel","beleg":{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Roter_Brasil&oldid=270208988"}},{"name":"Mecklenburger Königsapfel","beleg":{"quelle":"engelbrecht1889","seite":"78 (Nr. 69)"}}],"herkunft":{"text":"Vermutlich aus Mecklenburg; erstmals 1773 von Pastor Henne beschrieben, 1809 von Johann Ludwig Christ. Als Mecklenburger Königsapfel war sie um 1860 in Mecklenburg verbreitet. Nach langer Verschollenheit wurde ein Altbaum bei Pommau im früheren innerdeutschen Grenzgebiet wiederentdeckt.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Roter_Brasil&oldid=270208988"},{"quelle":"illustr_hb_4","band":"IV","seite":"11"}],"land":"DE","landSicher":false,"ort":"Mecklenburg","jahr":1773},"merkmale":[{"merkmal":"frucht_breite","wert":90,"original":"Gestalt 90:77—80","quelle":"engelbrecht1889","seite":"78 (Nr. 69)"},{"merkmal":"frucht_hoehe","wert":78.5,"original":"Gestalt 90:77—80","quelle":"engelbrecht1889","seite":"78 (Nr. 69)"},{"merkmal":"frucht_hoehe_breite","wert":0.87,"original":"Gestalt 90:77—80","quelle":"engelbrecht1889","seite":"78 (Nr. 69)"},{"merkmal":"frucht_groesse","wert":"5","original":"mittlere bis große Früchte","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Roter_Brasil&oldid=270208988"},{"merkmal":"frucht_groesse","wert":"7","original":"mittlere bis große Früchte","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Roter_Bra