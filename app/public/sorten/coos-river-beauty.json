ection_(acc._1948-720).jpg","art":"schnitt","urheber":"National Fruit Collection, Brogdale","lizenz":"OGL 2.0","quelle":"nfc-commons","titel":"Cross section of Coo's River Beauty, National Fruit Collection (acc. 1948-720)"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/5/5c/Pomological_Watercolor_POM00001682.jpg/960px-Pomological_Watercolor_POM00001682.jpg","seite":"https://commons.wikimedia.org/wiki/File:Pomological_Watercolor_POM00001682.jpg","art":"tafel","urheber":"Passmore, Deborah Griscom, 1840-1911","lizenz":"gemeinfrei","quelle":"usda-pomological","titel":"Pomological Watercolor POM00001682"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/c3/Pomological_Watercolor_POM00001683.jpg/960px-Pomological_Watercolor_POM00001683.jpg","seite":"https://commons.wikimedia.org/wiki/File:Pomological_Watercolor_POM00001683.jpg","art":"tafel","urheber":"Amanda Newton","lizenz":"gemeinfrei","quelle":"usda-pomological","titel":"Pomological Watercolor POM00001683"},{"url":"https://upload.wikimedia.org/wikipedia/commons/7/7d/Coo%27s_River_Beauty_on_tree%2C_National_Fruit_Collection_%28acc._1948-720%29.jpg","seite":"https://commons.wikimedia.org/wiki/File:Coo%27s_River_Beauty_on_tree,_National_Fruit_Collection_(acc._1948-720).jpg","art":"baum","urheber":"National Fruit Collection, Brogdale","lizenz":"OGL 2.0","quelle":"nfc-commons","titel":"Coo's River Beauty on tree, National Fruit Collection (acc. 1948-720)"}],"farbmessung":[{"bild":"https://upload.wikimedia.org/wikipedia/commons/5/5b/Cross_section_of_Coo%27s_River_Beauty%2C_National_Fruit_Collection_%28acc._1948-720%29.jpg","methode":"NFC-Foto","verfahren":"Foto (NFC-Fototafel: 4 ganze Früchte, 2 Schnitte, Fototisch); Weißabgleich über den Hintergrund; Frucht per Hintergrundmodell freigestellt; Schalenpixel ohne Glanzlichter einzeln klassifiziert: Grundfarbe aus gelbgrünen Pixeln, Deckfarbe = Pixel mit deutlich höherem a* als die Grundfarbe (auch dunkle Rot- und Braunrottöne), Anteile über Pixel; Höhe/Breite aus dem Längsschnitt","grundfarbe":"#a4a853","deckfarbe":"#803842","deckfarbeAnteil":0.6,"fleischfarbe":"#d8d7d7","hoeheZuBreite":0.812},{"bild":"https://thumb.wikimedia.org/wikipedia/commons/thumb/5/5c/Pomological_Watercolor_POM00001682.jpg/960px-Pomological_Watercolor_POM00001682.jpg","methode":"Aquarell","verfahren":"Aquarell (USDA Pomological Watercolor, ca. 1886–1942); Papierton als Weißpunkt; Frucht vor Papier freigestellt; Schalenpixel einzeln klassifiziert (Deckfarbe = deutlich höheres a* als die Grundfarbe, Anteile über Pixel); Höhe/Breite aus dem gemalten Längsschnitt, sonst aus der Seitenansicht; gemessen an einer 480 px breiten Kopie; Farbwiedergabe des Malers, nicht fotometrisch","deckfarbe":"#a70806","deckfarbeAnteil":0.99,"fleischfarbe":"#f6e9d5","hoeheZuBreite":0.898},{"bild":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/c3/Pomological_Watercolor_POM00001683.jpg/960px-Pomological_Watercolor_POM00001683.jpg","methode":"Aquarell","verfahren":"Aquarell (USDA Pomological Watercolor, ca. 1886–1942); Papierton als Weißpunkt; Frucht vor Papier freigestellt; Schalenpixel einzeln klassifiziert (Deckfarbe = deutlich höheres a* als die Grundfarbe, Anteile über Pixel); Höhe/Breite aus dem gemalten Längsschnitt, sonst aus der Seitenansicht; gemessen an einer 480 px breiten Kopie; Farbwiedergabe des Malers, nicht fotometrisch","deckfarbe":"#a51914","deckfarbeAnteil":1,"fleischfarbe":"#f9eed1","hoeheZuBreite":0.812}]}