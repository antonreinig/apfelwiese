{"id":"neuer-stein-pepping","name":"Neuer Stein-Pepping","synonyme":[{"name":"Neuer Steinpepping","beleg":{"quelle":"illustr_hb_4","band":"IV","seite":"149"}},{"name":"New Rock Pippin","beleg":{"quelle":"engelbrecht1889","seite":"474 (Nr. 426)"}}],"herkunft":{"text":"Nach Hogg von dem Baumschulbesitzer William Pleasance in Barnwell bei Cambridge (England) gezogen und 1821 der Londoner Gartenbaugesellschaft vorgelegt.","belege":[{"quelle":"illustr_hb_4","band":"IV","seite":"149"}],"land":"GB","landSicher":true,"ort":"Barnwell bei Cambridge","jahr":1821},"merkmale":[{"merkmal":"frucht_breite","wert":57,"original":"Gestalt 57:41—43","quelle":"engelbrecht1889","seite":"474 (Nr. 426)"},{"merkmal":"frucht_hoehe","wert":42,"original":"Gestalt 57:41—43","quelle":"engelbrecht1889","seite":"474 (Nr. 426)"},{"merkmal":"frucht_hoehe_breite","wert":0.74,"original":"Gestalt 57:41—43","quelle":"engelbrecht1889","seite":"474 (Nr. 426)"},{"merkmal":"frucht_form","wert":"flachrund","original":"etwas flachrund, wenig stielbauch.","quelle":"engelbrecht1889","seite":"474 (Nr. 426)"},{"merkmal":"frucht_breiteste_stelle","wert":"stiel","original":"wenig stielbauch.","quelle":"engelbrecht1889","seite":"474 (Nr. 426)"},{"merkmal":"frucht_symmetrie","wert":"schief","original":"Hälften meistens nicht ganz gleich","quelle":"engelbrecht1889","seite":"474 (Nr. 426)"},{"merkmal":"kelch_offenheit","wert":"geschlossen","original":"Kelch geschlossen oder wenig offen","quelle":"engelbrecht1889","seite":"474 (Nr. 426)"},{"merkmal":"kelchgrube_tiefe","wert":"5","original":"Einsenk. mässig tief; mittelweit","quelle":"engelbrecht1889","seite":"474 (Nr. 426)"},{"merkmal":"kelchgrube_weite","wert":"5","original":"Einsenk. mässig tief; mittelweit","quelle":"engelbrecht1889","seite":"474 (Nr. 426)"},{"merkmal":"frucht_kronung","wert":"1","original":"zwischen flachen, kurzen Falten","quelle":"engelbrecht1889","seite":"474 (Nr. 426)"},{"merkmal":"frucht_rippung","wert":"1","original":"Querschnitt rund","quelle