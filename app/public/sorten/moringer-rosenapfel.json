,"wert":"7","original":"Kelcheinsenkung tief und weit","quelle":"lauche_erg1883","seite":"241 (Nr. 810)"},{"merkmal":"frucht_kronung","wert":"9","original":"von breiten Rippen umgeben, die über die Frucht calvillartig … verlaufen","quelle":"lauche_erg1883","seite":"241 (Nr. 810)"},{"merkmal":"frucht_rippung","wert":"7","original":"Rippen, die über die Frucht calvillartig bis zur Stieleinsenkung verlaufen","quelle":"lauche_erg1883","seite":"241 (Nr. 810)"},{"merkmal":"stiel_laenge","wert":"3","original":"Stiel: kurz, holzig, kaum heraustretend","quelle":"lauche_erg1883","seite":"242 (Nr. 810)"},{"merkmal":"stielgrube_tiefe","wert":"7","original":"Stieleinsenkung tief und weit, strahlig berostet","quelle":"lauche_erg1883","seite":"242 (Nr. 810)"},{"merkmal":"stielgrube_weite","wert":"7","original":"Stieleinsenkung tief und weit, strahlig berostet","quelle":"lauche_erg1883","seite":"242 (Nr. 810)"},{"merkmal":"schale_berostung_stielgrube","wert":"7","original":"Stieleinsenkung … strahlig berostet","quelle":"lauche_erg1883","seite":"242 (Nr. 810)"},{"merkmal":"schale_beschaffenheit","wert":"glatt","original":"Schale: fein, glänzend, glatt, geschmeidig","quelle":"lauche_erg1883","seite":"242 (Nr. 810)"},{"merkmal":"schale_beschaffenheit","wert":"glaenzend","original":"Schale: fein, glänzend, glatt, geschmeidig","quelle":"lauche_erg1883","seite":"242 (Nr. 810)"},{"merkmal":"schale_grundfarbe","wert":"gelb","original":"grünlich-gelb, später hellgelb","quelle":"lauche_erg1883","seite":"242 (Nr. 810)"},{"merkmal":"schale_deckfarbe_farbton","wert":"dunkelrot","original":"stark besonnte Früchte dunkel-carmoisinroth gestreift und verwaschen","quelle":"lauche_erg1883","seite":"242 (Nr. 810)"},{"merkmal":"schale_deckfarbe_art","wert":"gestreift","original":"dunkel-carmoisinroth gestreift und verwaschen","quelle":"lauche_erg1883","seite":"242 (Nr. 810)"},{"merkmal":"schale_deckfarbe_art","wert":"verwaschen","original":"dunkel-carmoisinroth gestreift und verwaschen","quelle":"lauche_erg1883","seite":"242 (Nr. 810)"},{"merkmal":"schale_lentizellen_anzahl","wert":"3","original":"Punkte sehr fein, zerstreut, kaum bemerklich","quelle":"lauche_erg1883","seite":"242 (Nr. 810)"},{"merkmal":"schale_lentizellen_groesse","wert":"3","original":"Punkte sehr fein, zerstreut, kaum bemerklich","quelle":"lauche_erg1883","seite":"242 (Nr. 810)"},{"merkmal":"fleisch_farbe","wert":"weiss","original":"Fleisch: weiß, am Rande oft röthlich","quelle":"lauche_erg1883","seite":"242 (Nr. 810)"},{"merkmal":"fleisch_festigkeit","wert":"3","original":"fein, zart und mürbe","quelle":"lauche_erg1883","seite":"242 (Nr. 810)"},{"merkmal":"geschmack_suesse","wert":"7","original":"von rosenartig-gewürztem, süß-weinigem Geschmacke","quelle":"lauche_erg1883","seite":"242 (Nr. 810)"},{"merkmal":"geschmack_saeure","wert":"5","original":"von rosenartig-gewürztem, süß-weinigem Geschmacke","quelle":"lauche_erg1883","seite":"242 (Nr. 810)"},{"merkmal":"geschmack_aroma","wert":"rosenartig gewürzt","original":"rosenartig-gewürztem … Geschmacke","quelle":"lauche_erg1883","seite":"242 (Nr. 810)"},{"merkmal":"kernhaus_achse","wert":"offen","original":"Kernhaus: hohlachsig","quelle":"lauche_erg1883","seite":"242 (Nr. 810)"},{"merkmal":"kernfaecher_oeffnung","wert":"teilweise","original":"Fächer oft etwas offen, geräumig","quelle":"lauche_erg1883","seite":"242 (Nr. 810)"},{"merkmal":"kerne_form","wert":"eifoermig","original":"zahlreiche, gut entwickelte, rund-eiförmige Samen","quelle":"lauche_erg1883","seite":"242 (Nr. 810)"},{"merkmal":"kernhaus_form","wert":"zwiebel","original":"Der durch die Gefäßbündel umgrenzte Theil des Fleisches herz-zwiebelförmig","quelle":"lauche_erg1883","seite":"242 (Nr. 810)"},{"merkmal":"kelchhoehle_form","wert":"dreieck_lang","original":"Kelchröhre lang-kegelförmig","quelle":"lauche_erg1883","seite":"242 (Nr. 810)"},{"merkmal":"genussreife_beginn","wert":"9","original":"Reifezeit und Nutzung: September-October","quelle":"lauche_erg1883","seite":"242 (Nr. 810)"},{"merkmal":"genussreife_ende","wert":"10","original":"Reifezeit und Nutzung: September-October","quelle":"lauche_erg1883","seite":"242 (Nr. 810)"},{"merkmal":"verwendung","wert":"tafel","original":"Für Tafel und Wirthschaft gleich gut","quelle":"lauche_erg1883","seite":"242 (Nr. 810)"},{"merkmal":"verwendung","wert":"kueche","original":"Für Tafel und Wirthschaft gleich gut","quelle":"lauche_erg1883","seite":"242 (Nr. 810)"},{"merkmal":"frucht_groesse","wert":"5","original":"mittelgroß bis groß","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Moringer_Rosenapfel&oldid=245232268"},{"merkmal":"frucht_groesse","wert":"7","original":"mittelgroß bis groß","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Moringer_Rosenapfel&oldid=245232268"},{"merkmal":"baum_wuchs","wert":"7","original":"Der Baum wächst kräftig","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Moringer_Rosenapfel&oldid=245232268"},{"merkmal":"genussreife_beginn","wert":"10","original":"Die Reifezeit ist im Oktober. Die Früchte halten sich bis Dezember","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Moringer_Rosenapfel&oldid=245232268"},{"merkmal":"genussreife_ende","wert":"12","original":"Die Früchte halten sich bis Dezember auf dem Lager","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Moringer_Rosenapfel&oldid=245232268"},{"merkmal":"kernhaus_breite_mm","wert":48,"original":"Kernhaus 48:26","quelle":"engelbrecht1889","seite":"196 (Nr. 175)"},{"merkmal":"kernhaus_hoehe_mm","wert":26,"original":"Kernhaus 48:26","quelle":"engelbrecht1889","seite":"196 (Nr. 175)"},{"merkmal":"kernfach_breite_mm","wert":11,"original":"Kammern 11:15","quelle":"engelbrecht1889","seite":"196 (Nr. 175)"},{"merkmal":"kernfach_hoehe_mm","wert":15,"original":"Kammern 11:15","quelle":"engelbrecht1889","seite":"196 (Nr. 175)"},{"merkmal":"lagerfaehigkeit","wert":"3","original":"Engelbrecht Anfang Oktober bis Ende November","quelle":"engelbrecht1889","seite":"196 (Nr. 175)"},{"merkmal":"lagerfaehigkeit","wert":"5","original":"Nach Wikipedia reift die Frucht im Oktober und hält sich bis Dezember","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Moringer_Rosenapfel&oldid=245232268"},{"merkmal":"gesundheit","wert":"7","original":"ist nicht empfindlich","quelle":"lauche_erg1883","seite":"242 (Nr. 810)"},{"merkmal":"hochstamm","wert":"gut","original":"für Hoch- und Buschbaum geeignet","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Moringer_Rosenapfel&oldid=245232268"}],"texte":[{"thema":"ueberblick","text":"Herbstapfel aus Moringen bei Einbeck, um 1830 entdeckt und 1869 von Oberdieck beschrieben. Die mittelgroße bis große, flach kegelförmige Frucht trägt auf hellgelbem Grund eine weithin glänzend karminrote, dunkler gestreifte und geflammte Sonnenseite. Das weiße, zarte und saftige Fleisch ist rosenapfelartig gewürzt und ausgewogen süß-weinig. Engelbrecht ordnete die Sorte den Rosenäpfeln zu.","belege":[{"quelle":"engelbrecht1889","seite":"196 (Nr. 175)"},{"quelle":"lauche_erg1883","seite":"241 (Nr. 810)"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Moringer_Rosenapfel&oldid=245232268"}]},{"thema":"herkunft","text":"Der Oberamtsrichter von Hinüber entdeckte den Mutterbaum in Moringen bei Einbeck; Wikipedia datiert den Fund auf etwa 1830. Über die Entstehung ist nichts bekannt. 1857 erhielt Oberdieck Reiser; er und von Hinüber beschrieben die Sorte 1869 in den Illustrirten Monatsheften. Lauche (1883) erhielt sie für die Gärtner-Lehranstalt von Oberdieck. Engelbrecht bekam 1889 Früchte von Lucas in Reutlingen, Palandt in Hildesheim und Kolbe in Langwarden (Oldenburg).","belege":[{"quelle":"lauche_erg1883","seite":"241 (Nr. 810)"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Moringer_Rosenapfel&oldid=245232268"},{"quelle":"engelbrecht1889","seite":"196 (Nr. 175)"}]},{"thema":"frucht","text":"Engelbrecht maß 73 mm Breite bei 58 mm Höhe, Oberdieck größere Früchte (88:70–72 mm), Lauche etwa 90 mm Breite und 70 mm Höhe. Die Form ist abgestumpft flachrund-kegelförmig bis fast rundlich, der Bauch sitzt etwas zum Stiel hin, die Hälften sind fast gleich. Der geschlossene Kelch sitzt in einer ziemlich tiefen, mittelweiten bis weiten Grube. Engelbrecht beschreibt flache Rippen über die Frucht und einen nicht ganz runden Querschnitt; nach Lauche laufen breite Rippen kalvillartig bis zur Stielgrube. Der holzige Stiel ist nach Lauche kurz und tritt kaum hervor, nach Engelbrecht mitteldick und etwa 21 mm lang.","belege":[{"quelle":"engelbrecht1889","seite":"196 (Nr. 175)"},{"quelle":"lauche_erg1883","seite":"241 (Nr. 810)"},{"quelle":"lauche_erg1883","seite":"242 (Nr. 810)"}]},{"thema":"schale","text":"Die Schale ist fein, glatt, geschmeidig und sehr glänzend, anfangs hellgrünlichgelb, später zart hellgelb. Die Sonnenseite ist oft weithin glänzend karminrot überzogen oder punktiert gerötet, mit dunkleren Streifen und Flammen; stark besonnte Früchte sind nach Lauche dunkel karmoisinrot. Die Schalenpunkte sind fein, nach Lauche kaum bemerkbar und in der Röte oft hell umrandet, nach Engelbrecht mittelzahlreich und hellbräunlich. Die Stielgrube ist zart (Engelbrecht) bzw. strahlig (Lauche) berostet.","belege":[{"quelle":"engelbrecht1889","seite":"196 (Nr. 175)"},{"quelle":"lauche_erg1883","seite":"242 (Nr. 810)"}]},{"thema":"schnitt","text":"Engelbrecht fand ein sehr flach zwiebelförmiges Kernhaus von 48:26 mm. Die Kammern (11:15 mm) sind fast glattwandig, geräumig und meist weit offen, die Achsenhöhle ist breit. Je Kammer liegen 2 bis 3 große, vollkommene, eiförmige, etwas flache, kurz gespitzte, hell kaffeebraune Kerne. Die Kelchhöhle ist kegelförmig und reicht etwa bis zur Hälfte der Achsenhöhle; Lauche nennt die Kelchröhre lang kegelförmig. Nach Lauche ist das Kernhaus hohlachsig mit geräumigen, oft etwas offenen Fächern und zahlreichen rundlich eiförmigen Samen; der von den Gefäßbündeln umgrenzte Bereich ist herz-zwiebelförmig. Das Fleisch ist am Schnitt weiß, unter der Schale oft rötlich.","belege":[{"quelle":"engelbrecht1889","seite":"196 (Nr. 175)"},{"quelle":"lauche_erg1883","seite":"242 (Nr. 810)"}]},{"thema":"fleisch_geschmack","text":"Das Fleisch ist weiß, am Rand oft rötlich, fein, zart, mürbe und saftig. Engelbrecht beschreibt den Geschmack als sanft rosenapfelartig gewürzt, etwas vorherrschend angenehm weinig und fast ebenso süß; Lauche nennt ihn rosenartig gewürzt und süß-weinig. Wikipedia beschreibt das Fleisch als locker mit fein säuerlichem Geschmack.","belege":[{"quelle":"engelbrecht1889","seite":"196 (Nr. 175)"},{"quelle":"lauche_erg1883","seite":"242 (Nr. 810)"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Moringer_Rosenapfel&oldid=245232268"}]},{"thema":"reife_lagerung","text":"Die Angaben zur Genussreife weichen ab: Lauche nennt September bis Oktober, Engelbrecht Anfang Oktober bis Ende November. Nach Wikipedia reift die Frucht im Oktober und hält sich bis Dezember.","belege":[{"quelle":"lauche_erg1883","seite":"242 (Nr. 810)"},{"quelle":"engelbrecht1889","seite":"196 (Nr. 175)"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Moringer_Rosenapfel&oldid=245232268"}]},{"thema":"verwendung","text":"Engelbrecht bewertete die Sorte als sehr guten Tafelapfel und gute Wirtschaftsfrucht (00††); Lauche hielt sie für Tafel und Wirtschaft gleich gut.","belege":[{"quelle":"engelbrecht1889","seite":"196 (Nr. 175)"},{"quelle":"lauche_erg1883","seite":"242 (Nr. 810)"}]},{"thema":"baum","text":"Nach Lauche wächst der Baum gut, bildet eine schöne rundliche Krone, trägt reichlich und ist nicht empfindlich. Die Sommertriebe sind stark, lang und violettbraun, die Blätter ziemlich groß, oval und tief gesägt. Wikipedia beschreibt den Wuchs als kräftig mit pyramidaler Krone und nennt die Sorte für Hoch- und Buschbaum geeignet.","belege":[{"quelle":"lauche_erg1883","seite":"242 (Nr. 810)"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Moringer_Rosenapfel&oldid=245232268"}]},{"thema":"unterscheidung","text":"Lauches Ergänzungsband beschreibt unmittelbar davor einen Mähringer Rosenapfel aus Tirol (Bozen, Meran), eine andere Sorte mit flachkugeliger Frucht, offenem, hohlachsigem Kernhaus und lang trichterförmiger Kelchröhre. Der Name „Möhringer Rosen“, den Wikipedia als Synonym nennt, ist deshalb mit Vorsicht zu verwenden.","belege":[{"quelle":"lauche_erg1883","seite":"239 (Nr. 809)"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Moringer_Rosenapfel&oldid=245232268"}]}],"bilder":[{"url":"https://archive.org/download/bub_gb_tR4EMgEACAAJ/page/n213_w800.jpg","seite":"https://archive.org/details/bub_gb_tR4EMgEACAAJ/page/n213","art":"schnitt","urheber":"Theodor Engelbrecht (Zeichnung), Albert Probst (Holzschnitt)","lizenz":"gemeinfrei","quelle":"engelbrecht1889","titel":"Längsschnitt-Umriss bei Engelbrecht 1889, S. 196 (ganze Buchseite)"}],"regionen":[{"region":"DE-NI","art":"herkunft","belege":[{"quelle":"lauche_erg1883","seite":"241 (Nr. 810)"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Moringer_Rosenapfel&oldid=245232268"},{"quelle":"engelbrecht1889","seite":"196 (Nr. 175)"},{"quelle":"lauche_erg1883","seite":"241 (Nr. 810)"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Moringer_Rosenapfel&oldid=245232268"},{"quelle":"engelbrecht1889","seite":"196 (Nr. 175)"}]},{"region":"DE-TH","art":"empfehlung","belege":[{"quelle":"rg_th-grueneliga-2002"}],"original":"Moringer Rosenapfel"}],"gefaehrdung":[{"stufe":"Rote Liste der gefährdeten einheimischen Nutzpflanzen in Deutschland","belege":[{"quelle":"rg_ble-rote-liste"}],"original":"Moringer Rosenapfel"}]}