{"id":"pfirsichroter-sommerapfel","name":"Pfirsichroter Sommerapfel","synonyme":[{"name":"Pfirsichrother Sommerapfel","beleg":{"quelle":"engelbrecht1889","seite":"230 (Nr. 208)"}},{"name":"Pfirschenrother Sommer-Rosenapfel","beleg":{"quelle":"engelbrecht1889","seite":"230 (Nr. 208)"}},{"name":"Pfirsichrother Sommer-Rosenapfel","beleg":{"quelle":"illustr_hb_1","band":"I","seite":"93"}},{"name":"Pfirsichroter Sommer Rosenapfel","beleg":{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Pfirsichroter_Sommerapfel&oldid=251470412"}},{"name":"Jenaer Rosenapfel","beleg":{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Pfirsichroter_Sommerapfel&oldid=251470412"}},{"name":"Sommer Rosenapfel","beleg":{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Pfirsichroter_Sommerapfel&oldid=251470412"}}],"herkunft":{"text":"Vermutlich aus Frankreich. Dittrich beschrieb die Sorte 1837 als Erster in Deutschland und gab ihr den Namen; nach ihm stammte sie wahrscheinlich von Sickler und war in Thüringen sehr verbreitet.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Pfirsichroter_Sommerapfel&oldid=251470412"},{"quelle":"illustr_hb_1","band":"I","seite":"93"}],"land":"FR","landSicher":false,"jahr":1837},"merkmale":[{"merkmal":"frucht_breite","wert":62,"original":"Gestalt 62:50—52","quelle":"engelbrecht1889","seite":"230 (Nr. 208)"},{"merkmal":"frucht_hoehe","wert":51,"original":"Gestalt 62:50—52","quelle":"engelbrecht1889","seite":"230 (Nr. 208)"},{"merkmal":"frucht_hoehe_breite","wert":0.82,"original":"Gestalt 62:50—52","quelle":"engelbrecht1889","seite":"230 (Nr. 208)"},{"merkmal":"frucht_form","wert":"rund","original":"etwas abgest. rundl., wenig stielbauch.","quelle":"engelbrecht1889","seite":"230 (Nr. 208)"},{"merkmal":"frucht_groesse","wert":"5","original":"Die Früchte sind von mittlerer bis geringer Größe","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Pfirsichroter_Sommerapfel&oldid=251470412"},{"merkmal":"frucht_groesse","wert":"3","original":"Die Früchte sind von mittlerer bis geringer Größe","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Pfirsichroter_Sommerapfel&oldid=251470412"},{"merkmal":"frucht_breiteste_stelle","wert":"stiel","original":"etwas abgest. rundl., wenig stielbauch.","quelle":"engelbrecht1889","seite":"230 (Nr. 208)"},{"merkmal":"frucht_symmetrie","wert":"symmetrisch","original":"Hälften wenig verschieden","quelle":"engelbrecht1889","seite":"230 (Nr. 208)"},{"merkmal":"frucht_rippung","wert":"5","original":"Querschnitt wenig flachkantig","quelle":"engelbrecht1889","seite":"230 (Nr. 208)"},{"merkmal":"frucht_rippung","wert":"7","original":"so daß der Querschnitt deutlich abgerundet fünfeckig erscheint","quelle":"illustr_hb_1","band":"I","seite":"93"},{"merkmal":"frucht_kronung","wert":"5","original":"zwischen flach über den Bauch laufenden Rippen","quelle":"engelbrecht1889","seite":"230 (Nr. 208)"},{"merkmal":"kelch_offenheit","wert":"geschlossen","original":"Kelch geschlossen, grünlich, wollig","quelle":"engelbrecht1889","seite":"230 (Nr. 208)"},{"merkmal":"kelchgrube_tiefe","wert":"5","original":"Einsenk. mässig tief, eng oder mittelweit","quelle":"engelbrecht1889","seite":"230 (Nr. 208)"},{"merkmal":"kelchgrube_weite","wert":"3","original":"Einsenk. mässig tief, eng oder mittelweit","quelle":"engelbrecht1889","seite":"230 (Nr. 208)"},{"merkmal":"kelchgrube_weite","wert":"5","original":"Einsenk. mässig tief, eng oder mittelweit","quelle":"engelbrecht1889","seite":"230 (Nr. 208)"},{"merkmal":"stiel_dicke","wert":"5","original":"Stiel holzig, mitteldick, etwa 24 mm l.","quelle":"engelbrecht1889","seite":"230 (Nr. 208)"},{"merkmal":"stielgrube_tiefe","wert":"5","original":"Höhle kaum mitteltief, mittelweit, eben, schwach berostet","quelle":"engelbrecht1889","seite":"230 (Nr. 208)"},{"merkmal":"stielgrube_weite","wert":"5","original":"Höhle kaum mitteltief, mitt