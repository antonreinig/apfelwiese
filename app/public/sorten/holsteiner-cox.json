mgo","url":"https://www.bund-lemgo.de/download/Holsteiner_Cox.pdf"},{"merkmal":"frucht_breite","wert":76,"quelle":"nfc2025","seite":"Akzession 1973086 (Smith 1971); Akzession 1973087 (Smith 1971); Akzession 1979163 (Smith 1971); Akzession 2000010 (Smith 1971)"},{"merkmal":"frucht_hoehe","wert":72,"quelle":"nfc2025","seite":"Akzession 1973086 (Smith 1971); Akzession 1973087 (Smith 1971); Akzession 1979163 (Smith 1971); Akzession 2000010 (Smith 1971)"},{"merkmal":"frucht_groesse","wert":"7","quelle":"nfc2025","seite":"Akzession 1973086 (Smith 1971); Akzession 1973087 (Smith 1971); Akzession 1979163 (Smith 1971); Akzession 2000010 (Smith 1971)","original":"Large"},{"merkmal":"frucht_form","wert":"stumpfkonisch","quelle":"nfc2025","seite":"Akzession 1973086 (Smith 1971); Akzession 1973087 (Smith 1971); Akzession 1979163 (Smith 1971); Akzession 2000010 (Smith 1971)","original":"Truncate conical"},{"merkmal":"frucht_hoehe_breite","wert":0.947,"quelle":"nfc2025","seite":"Akzession 1973086 (Smith 1971); Akzession 1973087 (Smith 1971); Akzession 1979163 (Smith 1971); Akzession 2000010 (Smith 1971)"},{"merkmal":"frucht_rippung","wert":"1","quelle":"nfc2025","seite":"Akzession 1973086 (Smith 1971); Akzession 1973087 (Smith 1971); Akzession 1979163 (Smith 1971); Akzession 2000010 (Smith 1971)","original":"Very light"},{"merkmal":"schale_grundfarbe","wert":"gruengelb","quelle":"nfc2025","seite":"Akzession 1973086 (Smith 1971); Akzession 1973087 (Smith 1971); Akzession 1979163 (Smith 1971); Akzession 2000010 (Smith 1971)","original":"Green yellow"},{"merkmal":"schale_deckfarbe_farbton","wert":"orange","quelle":"nfc2025","seite":"Akzession 1973086 (Smith 1971); Akzession 1973087 (Smith 1971); Akzession 1979163 (Smith 1971); Akzession 2000010 (Smith 1971)","original":"Orange"},{"merkmal":"schale_deckfarbe_art","wert":"gestreift","quelle":"nfc2025","seite":"Akzession 1973086 (Smith 1971); Akzession 1973087 (Smith 1971); Akzession 1979163 (Smith 1971); Akzession 2000010 (Smith 1971)","original":"Only stripes"},{"merkmal":"schale_berostung_gesamt","wert":"1","quelle":"nfc2025","seite":"Akzession 1973086 (Smith 1971); Akzession 1973087 (Smith 1971); Akzession 1979163 (Smith 1971); Akzession 2000010 (Smith 1971)","original":"Very low"},{"merkmal":"fleisch_farbe","wert":"gelblich","quelle":"nfc2025","seite":"Akzession 1973086 (Smith 1971); Akzession 1973087 (Smith 1971); Akzession 1979163 (Smith 1971); Akzession 2000010 (Smith 1971)","original":"Yellowish"},{"merkmal":"verwendung","wert":"tafel","quelle":"nfc2025","seite":"Akzession 1973086; Akzession 1973087; Akzession 1979163; Akzession 2000010","original":"Dessert"},{"merkmal":"pflueckreife","wert":"9","quelle":"nfc2025","seite":"Akzession 1979163","original":"Late September"},{"merkmal":"genussreife_ende","wert":"1","quelle":"nfc2025","seite":"Akzession 1979163","original":"January"},{"merkmal":"bluete_zeit","wert":"5","quelle":"nfc2025","seite":"Akzession 1979163","original":"Klasse 5 (10 % der Blüten offen, Tag 124)"},{"merkmal":"ploidie","wert":"triploid","quelle":"nfc2025","seite":"Akzession 1979163","original":"Akzessionsname \"Holstein (LA 69A)(3n)\""}],"texte":[{"thema":"ueberblick","text":"Norddeutsche Renette aus Eutin, ein Sämling von Cox Orange. Die mittelgroße bis große Frucht ist grünlichgelb bis rot, das Fleisch weiß, fest und saftig, säuerlich-würzig mit coxähnlichem Aroma. Der Holsteiner Cox reift früher als Cox Orange, ist ab Oktober genussreif und zählt zu den Hauptsorten Schleswig-Holsteins.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Holsteiner_Cox&oldid=248784419"},{"quelle":"web_bund_lemgo","url":"https://www.bund-lemgo.de/download/Holsteiner_Cox.pdf"}]},{"thema":"herkunft","text":"Johannes Vahldiek zog die Sorte in Eutin als Sämling von Cox Orange, nach Wikipedia um 1900, nach dem Sortenblatt des BUND Lemgo etwa 1920. Nach seinem Tod wurden die Sämlinge in seinem Garten geprüft und nummeriert; diese Sorte erhielt den Namen „Vahldieks Sämling Nr. 3“. Der Eutiner Gartenbauverein verbreitete sie als Lokalsorte. Nach dem Zweiten Weltkrieg wählte die Landwirtschaftskammer Schleswig-Holstein sie zur Vermehrung und Erprobung aus; als „Gelber Holsteiner Cox“ wurde sie in den 1950er- bis 1970er-Jahren im ganzen Land angebaut und 1959 auf der Bundesgartenschau in Dortmund als „hervorragend“ bewertet. Später verbreitete sie sich nach BUND Lemgo vor allem an der Niederelbe.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Holsteiner_Cox&oldid=248784419"},{"quelle":"web_bund_lemgo","url":"https://www.bund-lemgo.de/download/Holsteiner_Cox.pdf"}]},{"thema":"frucht","text":"Die Frucht wird mittelgroß bis groß und ist grünlichgelb bis rot gefärbt. Angaben zu Form, Kelch, Stiel und Gruben enthalten die ausgewerteten Quellen nicht.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Holsteiner_Cox&oldid=248784419"}]},{"thema":"schnitt","text":"Zum Kernhaus, zu den Kammern und zur Kelchhöhle liegen in den ausgewerteten Quellen keine Angaben vor. Das Fleisch ist am Schnitt weiß.","belege":[{"quelle":"web_bund_lemgo","url":"https://www.bund-lemgo.de/download/Holsteiner_Cox.pdf"}]},{"thema":"fleisch_geschmack","text":"Das Fruchtfleisch ist weiß, fest und saftig. Wikipedia nennt den Geschmack säuerlich und aromatisch-würzig mit einem Aroma nahe dem des Cox Orange, BUND Lemgo erfrischend fein säuerlich und würzig. Der Vitamin-C-Gehalt ist nach BUND Lemgo sehr hoch; die Sorte gilt dort als für Allergiker meist verträglich.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Holsteiner_Cox&oldid=248784419"},{"quelle":"web_bund_lemgo","url":"https://www.bund-lemgo.de/download/Holsteiner_Cox.pdf"}]},{"thema":"reife_lagerung","text":"Pflückreif meist ab Ende September, genussreif ab Oktober bzw. ab Mitte Oktober. Die Früchte halten nach Wikipedia bis Dezember, bei guter Lagerung deutlich länger; BUND Lemgo nennt eine Haltbarkeit bis Februar.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Holsteiner_Cox&oldid=248784419"},{"quelle":"web_bund_lemgo","url":"https://www.bund-lemgo.de/download/Holsteiner_Cox.pdf"}]},{"thema":"verwendung","text":"Tafel- und Wirtschaftsapfel; BUND Lemgo empfiehlt die Sorte auch für den Anbau auf Streuobstwiesen.","belege":[{"quelle":"web_bund_lemgo","url":"https://www.bund-lemgo.de/download/Holsteiner_Cox.pdf"}]},{"thema":"baum","text":"Der Baum ist an das feuchtkühle norddeutsche Klima angepasst, robust und kommt mit mittleren Böden aus.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Holsteiner_Cox&oldid=248784419"}]},{"thema":"frucht","text":"Nach den Erhebungen der National Fruit Collection: großer, stumpf kegelförmiger Apfel mit grünlich gelber Grundfarbe und gestreifter orangefarbener Deckfarbe. Das Fruchtfleisch ist gelblich, die Schale kaum berostet. In der Sammlung als Tafelapfel geführt; pflückreif Ende September, lagerfähig bis Januar.","belege":[{"quelle":"nfc2025","seite":"Akzession 1979163, 1973086, 1973087, 2000010"}]}],"bilder":[{"url":"https://upload.wikimedia.org/wikipedia/commons/d/db/Malus_-_Holsteiner_Cox.JPG","seite":"https://commons.wikimedia.org/wiki/File:Malus_-_Holsteiner_Cox.JPG","art":"frucht","urheber":"Genet","lizenz":"CC BY-SA 3.0","quelle":"commons","titel":"Malus - Holsteiner Cox.JPG"},{"url":"https://upload.wikimedia.org/wikipedia/commons/f/f9/Cross_section_of_Holstein_%28LA_69A%29%2C_National_Fruit_Collection_%28acc._1979-163%29.jpg","seite":"https://commons.wikimedia.org/wiki/File:Cross_section_of_Holstein_(LA_69A),_National_Fruit_Collection_(acc._1979-163).jpg","art":"schnitt","urheber":"National Fruit Collection, Brogdale","lizenz":"OGL 2.0","quelle":"nfc-commons","titel":"Cross section of Holstein (LA 69A), National Fruit Collection (acc. 1979-163)"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/c0/Apfel_Holsteiner_Cox_%281%29.jpg/960px-Apfel_Holsteiner_Cox_%281%29.jpg","seite":"https://commons.wikimedia.org/wiki/File:Apfel_Holsteiner_Cox_(1).jpg","art":"frucht","urheber":"Hinnerk11","lizenz":"CC BY-SA 4.0","quelle":"commons-fotos","titel":"Apfel Holsteiner Cox (1)"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/0/0e/Apfel_Holsteiner_Cox_%282%29.jpg/960px-Apfel_Holsteiner_Cox_%282%29.jpg","seite":"https://commons.wikimedia.org/wiki/File:Apfel_Holsteiner_Cox_(2).jpg","art":"frucht","urheber":"Hinnerk11","lizenz":"CC BY-SA 4.0","quelle":"commons-fotos","titel":"Apfel Holsteiner Cox (2)"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/d/dd/Holsteiner_Cox.jpg/960px-Holsteiner_Cox.jpg","seite":"https://commons.wikimedia.org/wiki/File:Holsteiner_Cox.jpg","art":"frucht","urheber":"Bahnmoeller","lizenz":"CC BY-SA 3.0","quelle":"commons-fotos","titel":"Holsteiner Cox"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/e/e3/Holsteiner_Cox_-_Vahndiks_S%C3%A4mling_nr_3.jpg/960px-Holsteiner_Cox_-_Vahndiks_S%C3%A4mling_nr_3.jpg","seite":"https://commons.wikimedia.org/wiki/File:Holsteiner_Cox_-_Vahndiks_S%C3%A4mling_nr_3.jpg","art":"frucht","urheber":"Bahnmoeller","lizenz":"CC BY-SA 3.0","quelle":"commons-fotos","titel":"Holsteiner Cox - Vahndiks Sämling nr 3"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/d/d9/Malus_Holsteiner_Cox_4543.jpg/960px-Malus_Holsteiner_Cox_4543.jpg","seite":"https://commons.wikimedia.org/wiki/File:Malus_Holsteiner_Cox_4543.jpg","art":"frucht","urheber":"Sven Teschke","lizenz":"CC BY-SA 3.0 DE","quelle":"commons-fotos","titel":"Malus Holsteiner Cox 4543"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/2/23/Malus-Holsteiner-Cox.jpg/960px-Malus-Holsteiner-Cox.jpg","seite":"https://commons.wikimedia.org/wiki/File:Malus-Holsteiner-Cox.jpg","art":"frucht","urheber":"unbekannt","lizenz":"CC BY-SA 2.0 DE","quelle":"commons-fotos","titel":"Malus-Holsteiner-Cox"},{"url":"https://upload.wikimedia.org/wikipedia/commons/9