l":"https://de.wikipedia.org/w/index.php?title=Fießers_Erstling&oldid=266229671"},{"merkmal":"schale_deckfarbe_anteil","wert":"5","original":"Auf der Sonnenseite mit einem rötlichen Anflug","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Fießers_Erstling&oldid=266229671"},{"merkmal":"schale_deckfarbe_farbton","wert":"rot","original":"karminrote Streifen","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Fießers_Erstling&oldid=266229671"},{"merkmal":"schale_deckfarbe_art","wert":"verwaschen","original":"rötlichen Anflug, in dem karminrote Streifen auftreten","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Fießers_Erstling&oldid=266229671"},{"merkmal":"schale_deckfarbe_art","wert":"gestreift","original":"rötlichen Anflug, in dem karminrote Streifen auftreten","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Fießers_Erstling&oldid=266229671"},{"merkmal":"fleisch_farbe","wert":"weiss","original":"Fruchtfleisch ist weiß gefärbt, locker und sehr saftig","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Fießers_Erstling&oldid=266229671"},{"merkmal":"fleisch_festigkeit","wert":"3","original":"locker","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Fießers_Erstling&oldid=266229671"},{"merkmal":"fleisch_saftigkeit","wert":"7","original":"sehr saftig","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Fießers_Erstling&oldid=266229671"},{"merkmal":"geschmack_saeure","wert":"9","original":"eigentümlich gewürzt und stark säuerlich","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Fießers_Erstling&oldid=266229671"},{"merkmal":"geschmack_aroma","wert":"eigentümlich gewürzt","original":"eigentümlich gewürzt","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Fießers_Erstling&oldid=266229671"},{"merkmal":"kernhaus_achse","wert":"offen","original":"Kernhaus ist hohlachsig","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Fießers_Erstling&oldid=266229671"},{"merkmal":"kerne_form","wert":"lang","original":"vielen lang zugespitzten, schwarzbraunen Samen","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Fießers_Erstling&oldid=266229671"},{"merkmal":"verwendung","wert":"kueche","original":"im Herbst … als Wirtschafts- oder Mostapfel","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Fießers_Erstling&oldid=266229671"},{"merkmal":"verwendung","wert":"most","original":"im Herbst … als Wirtschafts- oder Mostapfel","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Fießers_Erstling&oldid=266229671"},{"merkmal":"verwendung","wert":"tafel","original":"im Frühjahr, nach einem Rückgang der Säure als Tafelapfel","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Fießers_Erstling&oldid=266229671"},{"merkmal":"pflueckreife","wert":"10","original":"Pflückreife … ist im Oktober erreicht","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Fießers_Erstling&oldid=266229671"},{"merkmal":"genussreife_ende","wert":"3","original":"bis März und länger genießbar","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Fießers_Erstling&oldid=266229671"},{"merkmal":"bluete_zeit","wert":"3","original":"früh- und langblühend","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Fießers_Erstling&oldid=266229671"},{"merkmal":"baum_wuchs","wert":"7","original":"in der Jugend starkwüchsig","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Fießers_Erstling&oldid=266229671"},{"merkmal":"frucht_breite","wert":68,"quelle":"nfc2025","seite":"Akzession 1947469 (Smith 1971)","original":"66-70"},{"merkmal":"frucht_hoehe","wert":63,"quelle":"nfc2025","seite":"Akzession 1947469 (Smith 1971)","original":"62-64"},{"merkmal":"frucht_groesse","wert":"5","quelle":"nfc2025","seite":"Akzession 1947469 (Smith 1971)","original":"Medium"},{"merkmal":"frucht_form","wert":"konisch","quelle":"nfc2025","seite":"Akzession 1947469 (Smith 1971)","original":"Narrow conical"},{"merkmal":"frucht_hoehe_breite","wert":0.926,"quelle":"nfc2025","seite":"Akzession 1947469 (Smith 1971)"},{"merkmal":"frucht_rippung","wert":"5","quelle":"nfc2025","seite":"Akzession 1947469 (Smith 1971)","original":"Medium"},{"merkmal":"schale_grundfarbe","wert":"gruengelb","quelle":"nfc2025","seite":"Akzession 1947469 (Smith 1971)","original":"Green yellow"},{"merkmal":"schale_deckfarbe_farbton","wert":"orange","quelle":"nfc2025","seite":"Akzession 1947469 (Smith 1971)","original":"Orange"},{"merkmal":"schale_deckfarbe_art","wert":"gestreift","quelle":"nfc2025","seite":"Akzession 1947469 (Smith 1971)","original":"Only stripes"},{"merkmal":"schale_berostung_gesamt","wert":"1","quelle":"nfc2025","seite":"Akzession 1947469 (Smith 1971)","original":"Very low"},{"merkmal":"fleisch_farbe","wert":"weiss","quelle":"nfc2025","seite":"Akzession 1947469 (Smith 1971)","original":"White"},{"merkmal":"verwendung","wert":"kueche","quelle":"nfc2025","seite":"Akzession 1947469","original":"Culinary"},{"merkmal":"pflueckreife","wert":"9","quelle":"nfc2025","seite":"Akzession 1947469","original":"Mid September"},{"merkmal":"genussreife_ende","wert":"11","quelle":"nfc2025","seite":"Akzession 1947469","original":"November"},{"merkmal":"bluete_zeit","wert":"3","quelle":"nfc2025","seite":"Akzession 1947469","original":"Klasse 3 (10 % der Blüten offen, Tag 119)"},{"merkmal":"ertrag_beginn","wert":"frueh","original":"trägt sehr früh und reich","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Fießers_Erstling&oldid=266229671"},{"merkmal":"standort_klima","wert":"3","original":"Er gedeiht noch in rauen Lagen","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Fießers_Erstling&oldid=266229671"},{"merkmal":"hochstamm","wert":"gut","original":"eignet sich für den landwirtschaftlichen Obstbau als Hoch- und Halbstamm","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Fießers_Erstling&oldid=266229671"},{"merkmal":"standort_boden","wert":"3","original":"An den Boden stellt er geringe Ansprüche","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Fießers_Erstling&oldid=266229671"},{"merkmal":"standort_feuchte","wert":"feucht","original":"er sollte aber nicht zu arm und zu trocken sein","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Fießers_Erstling&oldid=266229671"},{"merkmal":"lagerfaehigkeit","wert":"7","original":"genießbar bleibt sie bis März und länger","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Fießers_Erstling&oldid=266229671"}],"texte":[{"thema":"ueberblick","text":"Fießers Erstling ist eine badische Züchtung aus der Zeit um 1880. Die Sorte gilt als sehr früh und reich tragend und als geeignet für raue Lagen. Die großen Früchte sind im Herbst stark sauer und werden dann vor allem verarbeitet; roh gegessen werden sie erst im Frühjahr. Die Sorte steht auf der Roten Liste der gefährdeten einheimischen Nutzpflanzen in Deutschland.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Fießers_Erstling&oldid=266229671"}]},{"thema":"herkunft","text":"Gezogen hat die Sorte G. H. Fießer, großherzoglicher Hofgärtner in Baden-Baden. Er bemerkte, dass der Mutterbaum schon als vierjähriger Sämling im Saatbeet Blütenknospen trug, daher der Name. Um 1880 kam die Sorte in den Handel und wurde wegen Fruchtbarkeit und Winterhärte bekannt.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Fießers_Erstling&oldid=266229671"}]},{"thema":"frucht","text":"Die Früchte sind groß bis sehr groß, etwa 82 mm breit und 66–70 mm hoch, hochgebaut kugelig und mittelbauchig. Der große Kelch ist halb offen oder offen, mit aufrechten, grünwolligen Kelchblättern; die Kelchgrube ist flach und beulig-faltig. Der sehr kurze Stiel ist holzig bis fleischig und sitzt in einer flachen, engen, faltigen Stielgrube, die grün und schwach berostet ist.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Fießers_Erstling&oldid=266229671"}]},{"thema":"schale","text":"Die Schale ist glatt, glänzend und geschmeidig. Die Grundfarbe wechselt von Grün zu Gelb. Auf der Sonnenseite liegt ein rötlicher Anflug mit karminroten Streifen. Die Schalenpunkte treten kaum hervor.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Fießers_Erstling&oldid=266229671"}]},{"thema":"schnitt","text":"Zum Schnitt nennt die Quelle nur wenig: Das Kernhaus ist hohlachsig, die Kernfächer sind geräumig und enthalten viele lang zugespitzte, schwarzbraune Kerne. Das Fruchtfleisch ist weiß. Angaben zu Kernhausform, Kelchhöhle und Öffnung der Fächer fehlen.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Fießers_Erstling&oldid=266229671"}]},{"thema":"fleisch_geschmack","text":"Das weiße Fruchtfleisch ist locker und sehr saftig, eigentümlich gewürzt und stark säuerlich. Wegen der kräftigen Säure eignet sich der Apfel im Herbst kaum zum Frischverzehr.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Fießers_Erstling&oldid=266229671"}]},{"thema":"reife_lagerung","text":"Pflückreif ist die Sorte im Oktober; genießbar bleibt sie bis März und länger. Große Früchte werden im Herbst leicht vom Sturm abgeworfen.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Fießers_Erstling&oldid=266229671"}]},{"thema":"baum","text":"Der Baum wächst in der Jugend stark, trägt sehr früh und reich und bildet später eine hochkugelige Krone mit großem, gesundem Laub. Er gedeiht noch in rauen Lagen und eignet sich für den landwirtschaftlichen Obstbau als Hoch- und Halbstamm oder Busch. An den Boden stellt er geringe Ansprüche, er sollte aber nicht zu arm und zu trocken sein. Die Sorte blüht früh und lange und ist ein guter Pollenspender.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Fießers_Erstling&oldid=266229671"}]},{"thema":"verwendung","text":"Im Herbst dient die Sorte als Wirtschafts- und Mostapfel, im Frühjahr, wenn die Säure nachgelassen hat, auch als Tafelapfel.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Fießers_Erstling&oldid=266229671"}]},{"thema":"frucht","text":"Nach den Erhebungen der National Fruit Collection: die Sorte bildet mittelgroße, schmal kegelförmige Früchte mit grünlich gelber Grundfarbe und gestreifter orangefarbener Deckfarbe. Die Schale ist kaum berostet, das Fruchtfleisch weiß. Küchenapfel, pflückreif Mitte September und lagerfähig bis November.","belege":[{"quelle":"nfc2025","seite":"Akzession 1947469"}]}],"bilder":[{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/82/Fie%C3%9Fers_erstling_DSC00312.jpg/960px-Fie%C3%9Fers_erstling_DSC00312.jpg","seite":"https://commons.wikimedia.org/wiki/File:Fie%C3%9Fers_erstling_DSC00312.jpg","art":"tafel","urheber":"Trollfreie Zone","lizenz":"CC BY-SA 3.0","quelle":"commons","titel":"Fießers erstling DSC00312.jpg"},{"url":"https://upload.wikimedia.org/wikipedia/commons/3/3d/Cross_section_of_Fiessers_Erstling%2C_National_Fruit_Collection_%28acc._1947-469%29.jpg","seite":"https://commons.wikimedia.org/wiki/File:Cross_section_of_Fiessers_Erstling,_National_Fruit_Collection_(acc._1947-469).jpg","art":"schnitt","urheber":"National Fruit Collection, Brogdale","lizenz":"OGL 2.0","quelle":"nfc-commons","titel":"Cross section of Fiessers Erstling, National Fruit Collection (acc. 1947-469)"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/90/Fie%C3%9Fers_Erstling.jpg/960px-Fie%C3%9Fers_Erstling.jpg","seite":"https://commons.wikimedia.org/wiki/File:Fie%C3%9Fers_Erstling.jpg","art":"frucht","urheber":"Bahnmoeller","lizenz":"CC BY-SA 3.0","quel