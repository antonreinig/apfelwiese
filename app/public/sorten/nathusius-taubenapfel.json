{"id":"nathusius-taubenapfel","name":"Nathusius’ Taubenapfel","synonyme":[{"name":"Nathusius' Taubenapfel","beleg":{"quelle":"engelbrecht1889","seite":"263 (Nr. 237)"}},{"name":"Großer roter Althaldensleber Pigeon","beleg":{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Nathusius’_Taubenapfel&oldid=266266093"}}],"herkunft":{"text":"1824 von dem Gärtner (später Obergärtner) August Dieskau in der Handelsgärtnerei Althaldensleben (heute Sachsen-Anhalt) aus Samen gezogen und nach seinem Arbeitgeber Johann Gottlob Nathusius benannt.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Nathusius’_Taubenapfel&oldid=266266093"},{"quelle":"engelbrecht1889","seite":"263 (Nr. 237)"}]},"merkmale":[{"merkmal":"frucht_breite","wert":67,"original":"Gestalt 67:61—63","quelle":"engelbrecht1889","seite":"263 (Nr. 237)"},{"merkmal":"frucht_hoehe","wert":62,"original":"Gestalt 67:61—63","quelle":"engelbrecht1889","seite":"263 (Nr. 237)"},{"merkmal":"frucht_hoehe_breite","wert":0.93,"original":"Gestalt 67:61—63","quelle":"engelbrecht1889","seite":"263 (Nr. 237)"},{"merkmal":"frucht_form","wert":"eifoermig","original":"etwas abgestumpft eiförmig, oft auch eiwalzenf.","quelle":"engelbrecht1889","seite":"263 (Nr. 237)"},{"merkmal":"frucht_breiteste_stelle","wert":"stiel","original":"stielbauch.","quelle":"engelbrecht1889","seite":"263 (Nr. 237)"},{"merkmal":"frucht_symmetrie","wert":"schief","original":"Hälften häufig etwas, oft sehr ungleich","quelle":"engelbrecht1889","seite":"263 (Nr. 237)"},{"merkmal":"kelch_offenheit","wert":"geschlossen","original":"Kelch geschlossen, meist braun","quelle":"engelbrecht1889","seite":"263 (Nr. 237)"},{"merkmal":"kelchgrube_tiefe","wert":"5","original":"Einsenk. mässig tief, oft ziemlich enge","quelle":"engelbrecht1889","seite":"263 (Nr. 237)"},{"merkmal":"kelchgrube_weite","wert":"3","original":"Einsenk. mässig tief, oft ziemlich enge","quelle":"engelbrecht1889","seite":"263 (Nr. 237)"},{"merk