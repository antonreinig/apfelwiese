{"id":"weisse-wachs-renette","name":"Weiße Wachs-Renette","synonyme":[{"name":"Weiße Wachs-Reinette","beleg":{"quelle":"illustr_hb_1","band":"I","seite":"127"}},{"name":"Weiße Sommer-Reinette","beleg":{"quelle":"illustr_hb_1","band":"I","seite":"127"}},{"name":"Reinette d’été blanche","beleg":{"quelle":"illustr_hb_1","band":"I","seite":"127"}},{"name":"Citronen-Apfel","beleg":{"quelle":"illustr_hb_1","band":"I","seite":"127"}}],"herkunft":{"text":"Wahrscheinlich aus Frankreich; nach dem Handbuch (1859) in Württemberg auf dem Land unter dem Namen Citronen-Apfel verbreitet. Diel beschrieb die Sorte als Weiße Wachs-Reinette.","belege":[{"quelle":"illustr_hb_1","band":"I","seite":"127"}]},"merkmale":[{"merkmal":"frucht_breite","wert":65,"original":"Gestalt 65:55—57","quelle":"engelbrecht1889","seite":"444 (Nr. 396)"},{"merkmal":"frucht_hoehe","wert":56,"original":"Gestalt 65:55—57","quelle":"engelbrecht1889","seite":"444 (Nr. 396)"},{"merkmal":"frucht_hoehe_breite","wert":0.86,"original":"Gestalt 65:55—57","quelle":"engelbrecht1889","seite":"444 (Nr. 396)"},{"merkmal":"frucht_form","wert":"rundkonisch","original":"abgestumpft rundlich kegelf.","quelle":"engelbrecht1889","seite":"444 (Nr. 396)"},{"merkmal":"frucht_form","wert":"rund","original":"hochaussehend kugelförmiger, doch öfters auch plattrunder Apfel","quelle":"illustr_hb_1","band":"I","seite":"127"},{"merkmal":"frucht_form","wert":"flachrund","original":"hochaussehend kugelförmiger, doch öfters auch plattrunder Apfel","quelle":"illustr_hb_1","band":"I","seite":"127"},{"merkmal":"frucht_groesse","wert":"5","original":"mittelgroßer … Apfel","quelle":"illustr_hb_1","band":"I","seite":"127"},{"merkmal":"frucht_breiteste_stelle","wert":"stiel","original":"etwas stielbauch.","quelle":"engelbrecht1889","seite":"444 (Nr. 396)"},{"merkmal":"frucht_symmetrie","wert":"symmetrisch","original":"Hälften gleich","quelle":"engelbrecht1889","seite":"444 (Nr. 396)"},{"merkmal":"frucht_rippung","wert":"1","original":"Querschn. run