{"id":"jansen-von-welten","name":"Jansen von Welten","synonyme":[{"name":"Reinette von Welten","beleg":{"quelle":"illustr_hb_1","band":"I","seite":"419"}},{"name":"Rosenapfel von Welten","beleg":{"quelle":"illustr_hb_1","band":"I","seite":"419"}},{"name":"Couronne des pommes","beleg":{"quelle":"illustr_hb_1","band":"I","seite":"419"}}],"herkunft":{"text":"Von Herrn Jansen in Welten, drei Stunden von Aachen, gezogen und von Diel beschrieben.","belege":[{"quelle":"illustr_hb_1","band":"I","seite":"419"},{"quelle":"engelbrecht1889","seite":"210 (Nr. 189)"}],"ort":"Welten bei Aachen"},"merkmale":[{"merkmal":"frucht_breite","wert":72,"original":"Gestalt 72:64—65","quelle":"engelbrecht1889","seite":"210 (Nr. 189)"},{"merkmal":"frucht_hoehe","wert":64.5,"original":"Gestalt 72:64—65","quelle":"engelbrecht1889","seite":"210 (Nr. 189)"},{"merkmal":"frucht_hoehe_breite","wert":0.9,"original":"Gestalt 72:64—65","quelle":"engelbrecht1889","seite":"210 (Nr. 189)"},{"merkmal":"frucht_form","wert":"eifoermig","original":"abgest. ei- bis eikegelförmig","quelle":"engelbrecht1889","seite":"210 (Nr. 189)"},{"merkmal":"frucht_breiteste_stelle","wert":"stiel","original":"stielbauchig","quelle":"engelbrecht1889","seite":"210 (Nr. 189)"},{"merkmal":"frucht_symmetrie","wert":"symmetrisch","original":"Hälften ziemlich gleich","quelle":"engelbrecht1889","seite":"210 (Nr. 189)"},{"merkmal":"kelch_offenheit","wert":"halboffen","original":"Kelch halb offen, grünlich, wollig","quelle":"engelbrecht1889","seite":"210 (Nr. 189)"},{"merkmal":"kelchgrube_tiefe","wert":"5","original":"Einsenk. mitteltief, mässig weit","quelle":"engelbrecht1889","seite":"210 (Nr. 189)"},{"merkmal":"kelchgrube_weite","wert":"5","original":"Einsenk. mitteltief, mässig weit","quelle":"engelbrecht1889","seite":"210 (Nr. 189)"},{"merkmal":"frucht_rippung","wert":"3","original":"Querschn. oft nicht ganz rund","quelle":"engelbrecht1889","seite":"210 (Nr. 189)"},{"merkmal":"stiel_dicke","wert":"5","original":"Stiel holzig, mitt