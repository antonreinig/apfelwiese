"quelle":"illustr_hb_1","band":"I","seite":"419"},{"merkmal":"fleisch_festigkeit","wert":"3","original":"parmänenartig zart und mürbe","quelle":"illustr_hb_1","band":"I","seite":"419"},{"merkmal":"fleisch_saftigkeit","wert":"5","original":"hinreichend saftreich","quelle":"illustr_hb_1","band":"I","seite":"419"},{"merkmal":"geschmack_suesse","wert":"7","original":"edlen schwachweinigen, nur etwas zimmtartigen Zuckergeschmack","quelle":"illustr_hb_1","band":"I","seite":"419"},{"merkmal":"geschmack_saeure","wert":"5","original":"edlen schwachweinigen, nur etwas zimmtartigen Zuckergeschmack","quelle":"illustr_hb_1","band":"I","seite":"419"},{"merkmal":"geschmack_aroma","wert":"etwas zimtartig","original":"nur etwas zimmtartigen Zuckergeschmack","quelle":"illustr_hb_1","band":"I","seite":"419"},{"merkmal":"kerne_form","wert":"lang","original":"ziemlich viele, lange, scharf zugespitzte Kerne","quelle":"illustr_hb_1","band":"I","seite":"419"},{"merkmal":"kelchhoehle_form","wert":"dreieck_lang","original":"Die Kelchröhre geht als Kegel ziemlich herab","quelle":"illustr_hb_1","band":"I","seite":"419"},{"merkmal":"genussreife_beginn","wert":"12","original":"zeitigt im December","quelle":"illustr_hb_1","band":"I","seite":"419"},{"merkmal":"verwendung","wert":"tafel","original":"für Tafel und Haushalt gleich schätzbar","quelle":"illustr_hb_1","band":"I","seite":"419"},{"merkmal":"verwendung","wert":"kueche","original":"für Tafel und Haushalt gleich schätzbar","quelle":"illustr_hb_1","band":"I","seite":"419"},{"merkmal":"kernhaus_breite_mm","wert":40,"original":"Kernhaus 40:37","quelle":"engelbrecht1889","seite":"210 (Nr. 189)"},{"merkmal":"kernhaus_hoehe_mm","wert":37,"original":"Kernhaus 40:37","quelle":"engelbrecht1889","seite":"210 (Nr. 189)"},{"merkmal":"kernfach_breite_mm","wert":10,"original":"Kammern 10:24","quelle":"engelbrecht1889","seite":"210 (Nr. 189)"},{"merkmal":"kernfach_hoehe_mm","wert":24,"original":"Kammern 10:24","quelle":"engelbrecht1889","seite":"210 (Nr. 189)"},{"merkmal":"frucht_breite","wert":57,"quelle":"nfc2025","seite":"Akzession 1947259 (Smith 1971)"},{"merkmal":"frucht_hoehe","wert":51,"quelle":"nfc2025","seite":"Akzession 1947259 (Smith 1971)"},{"merkmal":"frucht_groesse","wert":"5","quelle":"nfc2025","seite":"Akzession 1947259 (Smith 1971)","original":"Medium"},{"merkmal":"frucht_form","wert":"stumpfkonisch","quelle":"nfc2025","seite":"Akzession 1947259 (Smith 1971)","original":"Truncate conical"},{"merkmal":"frucht_hoehe_breite","wert":0.895,"quelle":"nfc2025","seite":"Akzession 1947259 (Smith 1971)"},{"merkmal":"frucht_rippung","wert":"1","quelle":"nfc2025","seite":"Akzession 1947259 (Smith 1971)","original":"Very light"},{"merkmal":"schale_grundfarbe","wert":"gelb","quelle":"nfc2025","seite":"Akzession 1947259 (Smith 1971)","original":"Yellow"},{"merkmal":"schale_deckfarbe_farbton","wert":"rot","quelle":"nfc2025","seite":"Akzession 1947259 (Smith 1971)","original":"Red"},{"merkmal":"schale_deckfarbe_art","wert":"gestreift","quelle":"nfc2025","seite":"Akzession 1947259 (Smith 1971)","original":"Only stripes"},{"merkmal":"schale_berostung_gesamt","wert":"1","quelle":"nfc2025","seite":"Akzession 1947259 (Smith 1971)","original":"Very low"},{"merkmal":"fleisch_farbe","wert":"gelblich","quelle":"nfc2025","seite":"Akzession 1947259 (Smith 1971)","original":"Yellowish"},{"merkmal":"fleisch_festigkeit","wert":"3","quelle":"nfc2025","seite":"Akzession 1947259 (Verkostung P. Hale, 26/10/2022)","original":"Soft to intermediate"},{"merkmal":"fleisch_festigkeit","wert":"5","quelle":"nfc2025","seite":"Akzession 1947259 (Verkostung P. Hale, 26/10/2022)","original":"Soft to intermediate"},{"merkmal":"fleisch_saftigkeit","wert":"5","quelle":"nfc2025","seite":"Akzession 1947259 (Verkostung P. Hale, 26/10/2022)","original":"Intermediate"},{"merkmal":"geschmack_suesse","wert":"7","quelle":"nfc2025","seite":"Akzession 1947259 (Verkostung P. Hale, 26/10/2022)","original":"High"},{"merkmal":"geschmack_saeure","wert":"5","quelle":"nfc2025","seite":"Akzession 1947259 (Verkostung P. Hale, 26/10/2022)","original":"Intermediate to high"},{"merkmal":"geschmack_saeure","wert":"7","quelle":"nfc2025","seite":"Akzession 1947259 (Verkostung P. Hale, 26/10/2022)","original":"Intermediate to high"},{"merkmal":"verwendung","wert":"tafel","quelle":"nfc2025","seite":"Akzession 1947259","original":"Dessert"},{"merkmal":"pflueckreife","wert":"10","quelle":"nfc2025","seite":"Akzession 1947259","original":"Mid October"},{"merkmal":"genussreife_ende","wert":"3","quelle":"nfc2025","seite":"Akzession 1947259","original":"March"},{"merkmal":"bluete_zeit","wert":"5","quelle":"nfc2025","seite":"Akzession 1947259","original":"Klasse 6 (10 % der Blüten offen, Tag 130)"},{"merkmal":"bluete_zeit","wert":"7","quelle":"nfc2025","seite":"Akzession 1947259","original":"Klasse 6 (10 % der Blüten offen, Tag 130)"},{"merkmal":"ertrag_beginn","wert":"frueh","original":"setzt bald Fruchtspieße an","quelle":"illustr_hb_1","band":"I","seite":"419"},{"merkmal":"gesundheit","wert":"7","original":"Oberdieck fand junge Bäume in verschiedenen Böden gesund und wüchsig","quelle":"illustr_hb_1","band":"I","seite":"419"},{"merkmal":"standort_boden","wert":"3","original":"Oberdieck fand junge Bäume in verschiedenen Böden gesund und wüchsig","quelle":"illustr_hb_1","band":"I","seite":"419"},{"merkmal":"lagerfaehigkeit","wert":"7","original":"nach Engelbrecht bis Mai","quelle":"engelbrecht1889","seite":"210 (Nr. 189)"}],"texte":[{"thema":"ueberblick","text":"Winterapfel aus der Gegend von Aachen, mittelgroß, abgestumpft eiförmig bis kegelförmig, gelb mit purpurner, punktierter und gestreifter Röte und zartem, zimtartig gewürztem Fleisch. Genussreif von Dezember bis Mai.","belege":[{"quelle":"engelbrecht1889","seite":"210 (Nr. 189)"},{"quelle":"illustr_hb_1","band":"I","seite":"419"}]},{"thema":"herkunft","text":"Herr Jansen in Welten, drei Stunden von Aachen, zog die Sorte. Diel verschickte sie zunächst als Reinette von Welten oder Rosenapfel von Welten, weil sie den Renetten ähnelt, im zarten Fleisch aber den Rosenäpfeln näher steht; Herr Pfennigs in Aachen hatte sie Couronne des pommes genannt. Nach dem Handbuch (1859) war sie bereits in Deutschland verbreitet. Engelbrecht erhielt Früchte aus Neuruppin (Regierungsbezirk Potsdam) und aus Moringen (Provinz Hannover).","belege":[{"quelle":"illustr_hb_1","band":"I","seite":"419"},{"quelle":"engelbrecht1889","seite":"210 (Nr. 189)"}]},{"thema":"frucht","text":"Engelbrecht maß 72 mm Breite bei 64–65 mm Höhe; die Frucht ist abgestumpft ei- bis ei-kegelförmig, zum Stiel hin am breitesten, die Hälften ziemlich gleich. Oberdieck nennt sie hochaussehend und breit zugespitzt, manche Früchte erinnern an Schlotteräpfel; feine Rippen laufen oft über die Frucht und machen die Hälften ungleich. Der Kelch ist nach Engelbrecht halb offen in mitteltiefer, mäßig weiter Einsenkung, nach dem Handbuch meist geschlossen in tiefer, schüsselförmiger Senkung. Der Stiel ist kurz (Engelbrecht etwa 10 mm, Handbuch sehr kurz) und steht in einer mäßig tiefen, nach dem Handbuch engen, oft durch einen Fleischwulst verengten Höhle.","belege":[{"quelle":"engelbrecht1889","seite":"210 (Nr. 189)"},{"quelle":"illustr_hb_1","band":"I","seite":"419"}]},{"thema":"schale","text":"Die glatte, wenig geschmeidige und nach dem Handbuch nicht fettig werdende Schale ist hellgrünlichgelb und wird in der Reife gelb bis hoch zitronengelb. Sonnenseits zeigt sie eine purpurne Röte; Engelbrecht fand sie meist nur punktiert gerötet und dunkler gestreift, Diel beschrieb sie als oft stark verwaschen mit vielen dunkleren Streifen, Oberdieck sah weniger Röte und mehr Streifen und Punkte. Die Schalenpunkte sind mittelhäufig, mitteldick und bräunlich, in der Röte teils grau oder als feine Rostpunkte mit gelblichem Hof. Der Geruch ist deutlich.","belege":[{"quelle":"engelbrecht1889","seite":"210 (Nr. 189)"},{"quelle":"illustr_hb_1","band":"I","seite":"419"}]},{"thema":"schnitt","text":"Das Kernhaus ist ei-zwiebelförmig (40:37 mm) mit offenen, mäßig geräumigen, etwas zerrissenen Kammern und mittelbreiter Achsenhöhle (Engelbrecht). Je Kammer liegen ein bis zwei mittelgroße bis große, vollkommene, eiförmige, gespitzte braune Kerne; Oberdieck beschreibt sie als lang und scharf zugespitzt und das Kernhaus als groß und oft offen. Die Kelchhöhle ist ein Kegel bis zur Hälfte der Strecke zur Achsenhöhle; auch nach dem Handbuch geht die Kelchröhre als Kegel ziemlich weit herab. Das Fleisch ist am Schnitt gelblichweiß.","belege":[{"quelle":"engelbrecht1889","seite":"210 (Nr. 189)"},{"quelle":"illustr_hb_1","band":"I","seite":"419"}]},{"thema":"fleisch_geschmack","text":"Das Fleisch ist fein, mürbe und saftig, nach Oberdieck zart wie bei Parmänen. Engelbrecht schmeckte eine rosenapfelartige, fast zimtartige Würze, mild weinig bei gleich viel oder etwas mehr Süße. Diel nannte den Geschmack zuckerreich, würzig und fein rosenartig mit Zimtnote, Oberdieck einen edlen, schwach weinigen, etwas zimtartigen Zuckergeschmack.","belege":[{"quelle":"engelbrecht1889","seite":"210 (Nr. 189)"},{"quelle":"illustr_hb_1","band":"I","seite":"419"}]},{"thema":"reife_lagerung","text":"Genussreif ab Dezember; nach Engelbrecht bis Mai, nach dem Handbuch bis in den Sommer haltbar. Dass die Frucht im Frühjahr welke, wie Diel angab, beobachtete Oberdieck nicht; Engelbrecht vermerkt ebenfalls, dass sie nicht welkt.","belege":[{"quelle":"engelbrecht1889","seite":"210 (Nr. 189)"},{"quelle":"illustr_hb_1","band":"I","seite":"419"}]},{"thema":"verwendung","text":"Für Tafel und Haushalt gleichermaßen geschätzt; Engelbrecht vergab oo++.","belege":[{"quelle":"illustr_hb_1","band":"I","seite":"419"},{"quelle":"engelbrecht1889","seite":"210 (Nr. 189)"}]},{"thema":"baum","text":"Nach Diel wächst der Baum nicht üppig, treibt feines Holz, setzt bald Fruchtspieße an und bildet eine kugelige Krone. Oberdieck fand junge Bäume in verschiedenen Böden gesund und wüchsig. Die Sommertriebe sind schlank, weißgrau bewollt und hell erdbraunrot, die Blätter mäßig groß, meist elliptisch und unten wollig.","belege":[{"quelle":"illustr_hb_1","band":"I","seite":"419"}]},{"thema":"frucht","text":"Nach den Erhebungen der National Fruit Collection: mittelgroße, stumpf kegelförmige Frucht mit gelber Grundfarbe und gestreifter roter Deckfarbe. Die Schale ist kaum berostet, das Fruchtfleisch gelblich. Das Fleisch ist weich bis mittelfest und mäßig saftig; im Geschmack deutlich süß und mäßig bis deutlich sauer, mit mittlerem Aroma. Tafelapfel, pflückreif Mitte Oktober und lagerfähig bis März.","belege":[{"quelle":"nfc2025","seite":"Akzession 1947259"}]}],"bilder":[{"url":"https://archive.org/download/bub_gb_tR4EMgEACAAJ/page/n227_w800.jpg","seite":"https://archive.org/details/bub_gb_tR4EMgEACAAJ/page/n227","art":"schnitt","urheber":"Theodor Engelbrecht (Zeichnung), Albert Probst (Holzschnitt)","lizenz":"gemeinfrei","quelle":"engelbrecht1889","titel":"Längsschnitt-Umriss bei Engelbrecht 1889, S. 210 (ganze Buchseite)"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/f/fc/Deutsche_Pomologie_-_Aepfel_-_063.jpg/960px-Deutsche_Pomologie_-_Aepfel_-_063.jpg","seite":"https://commons.wikimedia.org/wiki/File:Deutsche_Pomologie_-_Aepfel_-_063.jpg","art":"tafel","urheber":"Wilhelm Lauche (Deutsche Pomologie, 1882)","lizenz":"gemeinfrei","quelle":"lauche_dp1882","titel":"Deutsche Pomologie - Aepfel - 063.jpg (Jansen von Welten)"},{"url":"https://upload.wikimedia.org/wikipedia/commons/c/c8/Cross_section_of_Jansen_von_Welten%2C_National_Fruit_Collection_%28acc._1947-259%29.jpg","seite":"https://commons.wikimedia.org/wiki/File:Cross_section_of_Jansen_von_Welten,_National_Fruit_Collection_(acc._1947-259).jpg","art":"schnitt","urheber":"National Fruit Collection, Brogdale","lizenz":"OGL 2.0","quelle":"nfc-commons","titel":"Cross section of Jansen von Welten, National Fruit Collection (acc. 1947-259)"}],"munq":3048,"akzessionen":[{"sammlung":"UK National Fruit Collection (Brogdale)","nummer":"1947259","name":"Jansen von Welten"}],"farbmessung":[{"bild":"https://upload.wikimedia.org/wikipedia/commons/c/c8/Cross_section_of_Jansen_von_Welten%2C_National_Fruit_Collection_%28acc._1947-259%29.jpg","methode":"NFC-Foto","verfahren":"Foto (NFC-Fototafel: 4 ganze Früchte, 2 Schnitte, Fototisch); Weißabgleich über den Hintergrund; Frucht per Hintergrundmodell freigestellt; Schalenpixel ohne Glanzlichter einzeln klassifiziert: Grundfarbe aus gelbgrünen Pixeln, Deckfarbe = Pixel mit deutlich höherem a* als die Grundfarbe (auch dunkle Rot- und Braunrottöne), Anteile über Pixel; Höhe/Breite aus dem Längsschnitt","grundfarbe":"#d1b570","deckfarbe":"#82373a","deckfarbeAnteil":0.6,"fleischfarbe":"#d9cab2","hoeheZuBreite":0.893},{"bild":"https://thumb.wikimedia.org/wikipedia/commons/thumb/f/fc/Deutsche_Pomologie_-_Aepfel_-_063.jpg/960px-Deutsche_Pomologie_-_Aepfel_-_063.jpg","methode":"Farbtafel","verfahren":"Chromolithografie (Lauche, Deutsche Pomologie 1882–83); Papierton als Weißpunkt; Frucht vor Papier freigestellt; Schalenpixel einzeln klassifiziert (Deckfarbe = deutlich höheres a* als die Grundfarbe, Anteile über Pixel); Höhe/Breite aus dem Längsschnitt, sonst aus der Seitenansicht; gemessen an einer 480 px breiten Kopie; Druckfarben gealtert, nicht fotometrisch","grundfarbe":"#d1b224","deckfarbe":"#7d1008","deckfarbeAnteil":0.77,"hoeheZuBreite":0.995}],"bildabgleich":{"bild":"https://upload.wikimedia.org/wikipedia/commons/c/c8/Cross_section_of_Jansen_von_Welten%2C_National_Fruit_Collection_%28acc._1947-259%29.jpg","seite":"https://commons.wikimedia.org/wiki/File:Cross_section_of_Jansen_von_Welten,_National_Fruit_Collection_(acc._1947-259).jpg","verfahren":"Umriss der NFC-Seitenansichten gegen den Modellumriss (Rastersuche über Höhe/Breite, Kegel- und Walzenform), Lage am Stielrest erkannt, Rippung aus der Stielansicht; Version 3","werte":{"hoeheZuBreite":0.86,"konisch":0.16,"walze":0,"rippung":1,"unregelmaessig":0.44},"guete":0.0222}}