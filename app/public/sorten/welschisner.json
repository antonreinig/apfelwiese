{"id":"welschisner","name":"Welschisner","synonyme":[{"name":"Großer Böhmischer Brünnerling","beleg":{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Welschisner&oldid=268972351"}},{"name":"Welschecker","beleg":{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Welschisner&oldid=268972351"}},{"name":"Steiner","beleg":{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Welschisner&oldid=268972351"}},{"name":"Welsch Weinling","beleg":{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Welschisner&oldid=268972351"}},{"name":"Großer böhmischer Brünerling","beleg":{"quelle":"lauche_erg1883","seite":"45 (Nr. 712)"}}],"herkunft":{"text":"Um 1600 in Oberösterreich als Zufallssämling entstanden. Lauche (1883) nennt nach Hofgärtner Runkel die Gegend von Linz, Braunau und Kremsmünster als Hauptverbreitungsgebiet.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Welschisner&oldid=268972351"},{"quelle":"lauche_erg1883","seite":"45 (Nr. 712)"}]},"merkmale":[{"merkmal":"frucht_groesse","wert":"5","original":"mittelgroßer, flach-kugelförmiger, etwa 75 mm breiter … Apfel","quelle":"lauche_erg1883","seite":"45 (Nr. 712)"},{"merkmal":"frucht_form","wert":"flachrund","original":"mittelgroßer, flach-kugelförmiger … Apfel","quelle":"lauche_erg1883","seite":"45 (Nr. 712)"},{"merkmal":"kelch_offenheit","wert":"geschlossen","original":"Kelch: geschlossen; Blättchen lang-zugespitzt, wollig","quelle":"lauche_erg1883","seite":"45 (Nr. 712)"},{"merkmal":"kelchgrube_tiefe","wert":"3","original":"Kelcheinsenkung flach und eng","quelle":"lauche_erg1883","seite":"45 (Nr. 712)"},{"merkmal":"kelchgrube_weite","wert":"3","original":"Kelcheinsenkung flach und eng","quelle":"lauche_erg1883","seite":"45 (Nr. 712)"},{"merkmal":"stiel_laenge","wert":"3","original":"Stiel: kurz, braun, kaum heraustretend","quelle":"lauche_erg1883","seite":"45 (Nr. 712)"},{"merkmal":"stielgrube_tiefe","wert":"3","original":"Stieleinsenkung flach und eng","quelle":"lauche_erg1883","seite":"45 (Nr. 712)"},{"merkmal":"stielgrube_weite","wert":"3","original":"Stieleinsenkung flach und eng","quelle":"lauche_erg1883","seite":"45 (Nr. 712)"},{"merkmal":"schale_beschaffenheit","wert":"glatt","original":"Schale: glatt, glänzend, citronengelb","quelle":"lauche_erg1883","seite":"45 (Nr. 712)"},{"merkmal":"schale_beschaffenheit","wert":"glaenzend","original":"Schale: glatt, glänzend, citronengelb","quelle":"lauche_erg1883","seite":"45 (Nr. 712)"},{"merkmal":"schale_grundfarbe","wert":"gelb","original":"Schale: glatt, glänzend, citronengelb","quelle":"lauche_erg1883","seite":"45 (Nr. 712)"},{"merkmal":"schale_deckfarbe_anteil","wert":"5","original":"sonnenwärts lachendschön geröthet","quelle":"lauche_erg1883","seite":"45 (Nr. 712)"},{"merkmal":"schale_lentizellen_anzahl","wert":"7","original":"Punkte häufig, an der Sonnenseite carminroth","quelle":"lauche_erg1883","seite":"45 (Nr. 712)"},{"merkmal":"kernhaus_form","wert":"zwiebel","original":"Der durch die Gefäßbündel umgrenzte Theil des Fleisches zwiebelförmig","quelle":"lauche_erg1883","seite":"45 (Nr. 712)"},{"merkmal":"kernhaus_achse","wert":"offen","original":"Kernhaus: hohlachsig","quelle":"lauche_erg1883","seite":"45 (Nr. 712)"},{"merkmal":"kernfaecher_oeffnung","wert":"teilweise","original":"Fächer wenig geöffnet, geräumig","quelle":"lauche_erg1883","seite":"45 (Nr. 712)"},{"merkmal":"kerne_form","wert":"lang","original":"hellbraune, lang-zugespitzte Samen","quelle":"lauche_erg1883","seite":"45 (Nr. 712)"},{"merkmal":"kelchhoehle_form","wert":"dreieck_lang","original":"Kelchröhre lang-kegelförmig","quelle":"lauche_erg1883","seite":"45 (Nr. 712)"},{"merkmal":"fleisch_farbe","wert":"weiss","original":"Fleisch: weiß, fest, später mürbe","quelle":"lauche_erg1883","seite":"45 (Nr. 712)"},{"merkmal":"fleisch_festigkeit","wert":"3","original":"Fleisch: weiß, fest, später mürbe","quelle":"lauche_erg1883","seite":"45 (Nr. 712)"},{"merkmal":"fleisch_saftigkeit","wert":"3","original":"wenig saftreich","quelle":"lauche_erg1883","seite":"45 (Nr. 712)"},{"merkmal":"geschmack_suesse","wert":"7","original":"von süß-weinigem, etwas herbem Geschmack","quelle":"lauche_erg1883","seite":"45 (Nr. 712)"},{"merkmal":"geschmack_saeure","wert":"5","original":"von süß-weinigem, etwas herbem Geschmack","quelle":"lauche_erg1883","seite":"45 (Nr. 712)"},{"merkmal":"verwendung","wert":"kueche","original":"Für die Wirthschaft brauchbar","quelle":"lauche_erg1883","seite":"45 (Nr. 712)"},{"merkmal":"verwendung","wert":"kueche","original":"er zählt zu den so genannten Wirtschaftsäpfeln","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Welschisner&oldid=268972351"},{"merkmal":"genussreife_beginn","wert":"2","original":"Reife und Nutzung: Februar bis Mai","quelle":"lauche_erg1883","seite":"45 (Nr. 712)"},{"merkmal":"genussreife_ende","wert":"5","original":"Reife und Nutzung: Februar bis Mai","quelle":"lauche_erg1883","seite":"45 (Nr. 712)"},{"merkmal":"genussreife_ende","wert":"5","original":"halten sich bei entsprechender Lagerung bis Mai","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Welschisner&oldid=268972351"},{"merkmal":"frucht_groesse","wert":"9","quelle":"nfc2025","seite":"Akzession 1951208 (NFC-Früchte)","original":"Very large"},{"merkmal":"frucht_form","wert":"rund","quelle":"nfc2025","seite":"Akzession 1951208 (NFC-Früchte)","original":"Globose"},{"merkmal":"frucht_rippung","wert":"7","quelle":"nfc2025","seite":"Akzession 1951208 (NFC-Früchte)","original":"Strong"},{"merkmal":"frucht_kronung","wert":"5","quelle":"nfc2025","seite":"Akzession 1951208 (NFC-Früchte)","original":"Medium to strong"},{"merkmal":"frucht_kronung","wert":"9","quelle":"nfc2025","seite":"Akzession 1951208 (NFC-Früchte)","original":"Medium to strong"},{"merkmal":"schale_grundfarbe","wert":"weisslichgelb","quelle":"nfc2025","seite":"Akzession 1951208 (NFC-Früchte)","original":"Whitish yellow"},{"merkmal":"schale_deckfarbe_anteil","wert":"3","quelle":"nfc2025","seite":"Akzession 1951208 (NFC-Früchte)","original":"Low to medium"},{"merkmal":"schale_deckfarbe_anteil","wert":"5","quelle":"nfc2025","seite":"Akzession 1951208 (NFC-Früchte)","original":"Low to medium"},{"merkmal":"schale_deckfarbe_farbton","wert":"orange","quelle":"nfc2025","seite":"Akzession 1951208 (NFC-Früchte)","original":"Orange"},{"merkmal":"schale_deckfarbe_art","wert":"verwaschen","quelle":"nfc2025","seite":"Akzession 1951208 (NFC-Früchte)","original":"Washed out"},{"merkmal":"schale_berostung_gesamt","wert":"3","quelle":"nfc2025","seite":"Akzession 1951208 (NFC-Früchte)","original":"Low"},{"merkmal":"fleisch_farbe","wert":"weiss","quelle":"nfc2025","seite":"Akzession 1951208 (NFC-Früchte)","original":"White"},{"merkmal":"verwendung","wert":"kueche","quelle":"nfc2025","seite":"Akzession 1951208","original":"Culinary"},{"merkmal":"pflueckreife","wert":"10","quelle":"nfc2025","seite":"Akzession 1951208","original":"Late October"},{"merkmal":"genussreife_ende","wert":"3","quelle":"nfc2025","seite":"Akzession 1951208","original":"March"},{"merkmal":"bluete_zeit","wert":"3","quelle":"nfc2025","seite":"Akzession 1951208","original":"Klasse 4 (10 % der Blüten offen, Tag 121)"},{"merkmal":"bluete_zeit","wert":"5","quelle":"nfc2025","seite":"Akzession 1951208","original":"Klasse 4 (10 % der Blüten offen, Tag 121)"}],"texte":[{"thema":"ueberblick","text":"Alter oberösterreichischer Wirtschaftsapfel mit flachrunden, zitronengelben, sonnenseits geröteten Früchten, die sich bis in den Mai lagern lassen. Die Sorte gilt als klimarobust, trägt auch auf schwachen Böden und eignet sich für Höhenlagen und Streuobstwiesen.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Welschisner&oldid=268972351"},{"quelle":"lauche_erg1883","seite":"45 (Nr. 712)"}]},{"thema":"herkunft","text":"Nach der Wikipedia ist der Welschisner um 1600 als Zufallssämling in Oberösterreich entstanden. Lauche beschrieb ihn 1883 als Großen böhmischen Brünerling nach Angaben des Hofgärtners Runkel in Kremsmünster: In der Gegend von Linz, Braunau und Kremsmünster sei er häufig und als Wirtschaftsapfel sehr geschätzt, in Norddeutschland dagegen wenig bekannt. 2009 wurde ein Baum bei der Wassermühle Hoslovice im Böhmerwald gepflanzt.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Welschisner&oldid=268972351"},{"quelle":"lauche_erg1883","seite":"45 (Nr. 712)"}]},{"thema":"frucht","text":"Lauche beschreibt einen mittelgroßen, flach kugelförmigen Apfel von etwa 75 mm Breite; die Höhenangabe ist im Scan nicht sicher lesbar (vermutlich 65 mm). Der Kelch ist geschlossen, mit lang zugespitzten, wolligen Blättchen, in flacher, enger Einsenkung. Der kurze braune Stiel ragt kaum heraus und sitzt in einer flachen, engen Grube.","belege":[{"quelle":"lauche_erg1883","seite":"45 (Nr. 712)"}]},{"thema":"schale","text":"Die Schale ist glatt, glänzend und zitronengelb, sonnenseits kräftig gerötet. Die Punkte sind zahlreich und erscheinen auf der Sonnenseite karminrot.","belege":[{"quelle":"lauche_erg1883","seite":"45 (Nr. 712)"}]},{"thema":"schnitt","text":"Lauche nennt das Kernhaus hohlachsig; die von den Gefäßbündeln umgrenzte Zone ist zwiebelförmig und kelchwärts kurz zugespitzt. Die Fächer sind geräumig, aber wenig geöffnet, ihre Wände aufgerissen; sie enthalten hellbraune, lang zugespitzte Samen. Die Kelchröhre ist lang kegelförmig, die Staubfäden sitzen in der Mitte. Das Fleisch ist am Schnitt weiß.","belege":[{"quelle":"lauche_erg1883","seite":"45 (Nr. 712)"}]},{"thema":"fleisch_geschmack","text":"Das Fleisch ist weiß, anfangs fest, später mürbe und wenig saftig, mit süß-weinigem, etwas herbem Geschmack.","belege":[{"quelle":"lauche_erg1883","seite":"45 (Nr. 712)"}]},{"thema":"reife_lagerung","text":"Die Wikipedia nennt Reife Mitte Oktober und Haltbarkeit bis Mai; Lauche gibt Februar bis Mai als Genussreife an.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Welschisner&oldid=268972351"},{"quelle":"lauche_erg1883","seite":"45 (Nr. 712)"}]},{"thema":"baum","text":"Nach Lauche wächst der Baum gut, ist fruchtbar und unempfindlich, gedeiht in jedem Boden und auch in rauen Lagen; die Sommertriebe sind stark und bräunlich, die Blätter groß. Die Wikipedia nennt die Sorte klimarobust und auch auf schlechten Böden ertragreich.","belege":[{"quelle":"lauche_erg1883","seite":"45 (Nr. 712)"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Welschisner&oldid=268972351"}]},{"thema":"verwendung","text":"Wirtschaftsapfel für Küche und Verarbeitung (Lauche; Wikipedia).","belege":[{"quelle":"lauche_erg1883","seite":"45 (Nr. 712)"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Welschisner&oldid=268972351"}]},{"thema":"unterscheidung","text":"Von Liegels Brünerling (Dochnahl Nr. 1197) unterscheidet sich der Große böhmische Brünerling nach Lauche nur durch die Größe.","belege":[{"quelle":"lauche_erg1883","seite":"45 (Nr. 712)"}]},{"thema":"frucht","text":"Nach den Erhebungen der National Fruit Collection: die Sorte bildet sehr große, kugelige Früchte mit weißlich gelber Grundfarbe und verwaschener orangefarbener Deckfarbe auf einem kleinen bis mittleren Teil der Schale. Die Schale ist wenig berostet, das Fruchtfleisch weiß. In der Sammlung als Küchenapfel geführt; pflückreif Ende Oktober, lagerfähig bis März.","belege":[{"quelle":"nfc2025","seite":"Akzession 1951208"}]}],"bilder":[{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/e/e8/Welschisner.jpg/960px-Welschisner.jpg","seite":"https://commons.wikimedia.org/wiki/File:Welschisner.jpg","art":"frucht","urheber":"Hans-Martin Kast","lizenz":"CC BY-SA 3.0","quelle":"commons","titel":"Welschisner.jpg"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/80/Welschisner_jm55109.jpg/960px-Welschisner_jm55109.jpg","seite":"https://commons.wikimedia.org/wiki/File:Welschisner_jm55109.jpg","art":"frucht","urheber":"joergens.mi","lizenz":"CC BY-SA 3.0","quelle":"commons","titel":"Welschisner jm55109.jpg"},{"url":"https://upload.wikimedia.org/wikipedia/commons/c/c6/Cross_section_of_Welschisner%2C_National_Fruit_Collection_%28acc._1951-208%29.jpg","seite":"https://commons.wikimedia.org/wiki/File:Cross_section_of_Welschisner,_National_Fruit_Collection_(acc._1951-208).jpg","art":"schnitt","urheber":"National Fruit Collection, Brogdale","lizenz":"OGL 2.0","quelle":"nfc-commons","titel":"Cross section of Welschisner, National Fruit Collection (acc. 1951-208)"}],"munq":1051,"akzessionen":[{"sammlung":"UK National Fruit Collection (Brogdale)","nummer":"1951208","name":"Welschisner"}],"farbmessung":[{"bild":"https://upload.wikimedia.org/wikipedia/commons/c/c6/Cross_section_of_Welschisner%2C_National_Fruit_Collection_%28acc._1951-208%29.jpg","methode":"NFC-Foto","verfahren":"Foto (NFC-Fototafel: 4 ganze Früchte, 2 Schnitte, Fototisch); Weißabgleich über den Hintergrund; Frucht per Hintergrundmodell freigestellt; Schalenpixel ohne Glanzlichter einzeln klassifiziert: Grundfarbe aus gelbgrünen Pixeln, Deckfarbe = Pixel mit deutlich höherem a* als die Grundfarbe (auch dunkle Rot- und Braunrottöne), Anteile über Pixel; Höhe/Breite aus dem Längsschnitt","grundfarbe":"#abb740","deckfarbe":"#82413e","deckfarbeAnteil":0.47,"fleischfarbe":"#c4c3b0","hoeheZuBreite":0.829}]}