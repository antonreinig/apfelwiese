{"id":"juwel-aus-kirchwerder","name":"Juwel aus Kirchwerder","synonyme":[{"name":"Juwel von Kirchwerder","beleg":{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Juwel_aus_Kirchwerder&oldid=238008709"}},{"name":"Peter Martens Apfel","beleg":{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Juwel_aus_Kirchwerder&oldid=238008709"}},{"name":"Martens Apfel","beleg":{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Juwel_aus_Kirchwerder&oldid=238008709"}},{"name":"Martens Gravensteiner","beleg":{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Juwel_aus_Kirchwerder&oldid=238008709"}},{"name":"Martens Sämling","beleg":{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Juwel_aus_Kirchwerder&oldid=238008709"}}],"herkunft":{"text":"Zufallssämling unbekannten Alters aus den Elbmarschen, später nach Kirchwerder in den Vierlanden (Hamburg) benannt.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Juwel_aus_Kirchwerder&oldid=238008709"}],"land":"DE","landSicher":true,"ort":"Elbmarschen (später nach Kirchwerder, Vierlande, benannt)"},"merkmale":[{"merkmal":"frucht_groesse","wert":"5","original":"Der Apfel wird mittelgroß bis groß","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Juwel_aus_Kirchwerder&oldid=238008709"},{"merkmal":"frucht_groesse","wert":"7","original":"Der Apfel wird mittelgroß bis groß","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Juwel_aus_Kirchwerder&oldid=238008709"},{"merkmal":"frucht_form","wert":"flachrund","original":"regelmäßige, rundliche-abgeflachte Form","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Juwel_aus_Kirchwerder&oldid=238008709"},{"merkmal":"frucht_symmetrie","wert":"symmetrisch","original":"regelmäßige, rundliche-abgeflachte Form","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Juwel_aus_Kirchwerder&oldid=238008709"},{"merkmal":"schale_grundfarbe","wert":"gruengelb","original":"grün-gelbe Grundfarbe","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Juwel_aus_Kirchwerder&oldid=238008709"},{"merkmal":"schale_deckfarbe_anteil","wert":"5","original":"auf den von der Sonne beschienenen Seiten von einer intensiv roten … Deckfarbe überdeckt","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Juwel_aus_Kirchwerder&oldid=238008709"},{"merkmal":"schale_deckfarbe_farbton","wert":"rot","original":"intensiv roten, teils flächig, teils streifigen Deckfarbe","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Juwel_aus_Kirchwerder&oldid=238008709"},{"merkmal":"schale_deckfarbe_art","wert":"verwaschen","original":"teils flächig, teils streifigen Deckfarbe","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Juwel_aus_Kirchwerder&oldid=238008709"},{"merkmal":"schale_deckfarbe_art","wert":"gestreift","original":"teils flächig, teils streifigen Deckfarbe","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Juwel_aus_Kirchwerder&oldid=238008709"},{"merkmal":"fleisch_farbe","wert":"weiss","original":"ein hellweißes, saftiges Fruchtfleisch","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Juwel_aus_Kirchwerder&oldid=238008709"},{"merkmal":"fleisch_saftigkeit","wert":"7","original":"ein hellweißes, saftiges Fruchtfleisch","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Juwel_aus_Kirchwerder&oldid=238008709"},{"merkmal":"geschmack_saeure","wert":"7","original":"säuerlich-erfrischenden, aromatischen Geschmack","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Juwel_aus_Kirchwerder&oldid=238008709"},{"merkmal":"pflueckreife","wert":"9","original":"Der Apfel wird ab September pflückreif","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Juwel_aus_Kirchwerder&oldid=238008709"},{"merkmal":"genussreife_beginn","wert":"9","original":"die Genußreife beginnt mit der Pflückreife und dauert bis Dezember","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Juwel_aus_Kirchwerder&oldid=238008709"},{"merkmal":"genussreife_ende","wert":"12","original":"die Genußreife beginnt mit der Pflückreife und dauert bis Dezember","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Juwel_aus_Kirchwerder&oldid=238008709"},{"merkmal":"baum_wuchs","wert":"7","original":"Der starkwüchsige Baum","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Juwel_aus_Kirchwerder&oldid=238008709"},{"merkmal":"standort_boden","wert":"7","original":"braucht nährstoffreichen, lehmigen Boden","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Juwel_aus_Kirchwerder&oldid=238008709"},{"merkmal":"lagerfaehigkeit","wert":"5","original":"die Genussreife beginnt gleich mit der Ernte und reicht bis Dezember","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Juwel_aus_Kirchwerder&oldid=238008709"}],"texte":[{"thema":"ueberblick","text":"Herbstapfel aus den Elbmarschen, der vor allem im Hamburger Raum noch regelmäßig als Liebhabersorte gepflanzt wird. 2010 war er Streuobstsorte des Jahres in Norddeutschland. In den alten Sortenwerken (Engelbrecht, Illustrirtes Handbuch, Lauche) ist er nicht beschrieben.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Juwel_aus_Kirchwerder&oldid=238008709"}]},{"thema":"herkunft","text":"Die Sorte entstand zu einem unbekannten Zeitpunkt als Zufallssämling in den Elbmarschen und erhielt später den Namen des Vierländer Ortes Kirchwerder. Daneben sind die Namen Peter Martens Apfel, Martens Gravensteiner und Martens Sämling überliefert.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Juwel_aus_Kirchwerder&oldid=238008709"}]},{"thema":"frucht","text":"Die Frucht ist mittelgroß bis groß, regelmäßig gebaut und rundlich abgeflacht. Die Grundfarbe ist grüngelb; auf der Sonnenseite liegt ein kräftiges Rot, teils flächig, teils in Streifen.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Juwel_aus_Kirchwerder&oldid=238008709"}]},{"thema":"fleisch_geschmack","text":"Das Fleisch ist hell weiß und saftig, der Geschmack säuerlich-frisch und aromatisch.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Juwel_aus_Kirchwerder&oldid=238008709"}]},{"thema":"reife_lagerung","text":"Pflückreif ist die Sorte ab September; die Genussreife beginnt gleich mit der Ernte und reicht bis Dezember.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Juwel_aus_Kirchwerder&oldid=238008709"}]},{"thema":"baum","text":"Der Baum wächst stark und braucht nährstoffreichen, lehmigen Boden und ein gemäßigtes, vom Meer beeinflusstes Klima.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Juwel_aus_Kirchwerder&oldid=238008709"}]}],"bilder":[{"url":"https://upload.wikimedia.org/wikipedia/commons/f/f4/Malus_-_Juwel_von_Kirchwerder.jpg","seite":"https://commons.wikimedia.org/wiki/File:Malus_-_Juwel_von_Kirchwerder.jpg","art":"frucht","urheber":"Genet","lizenz":"CC BY-SA 3.0","quelle":"commons","titel":"Malus - Juwel von Kirchwerder.jpg"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/6/67/Apfel_Juwel_aus_Kirchwerder.jpg/960px-Apfel_Juwel_aus_Kirchwerder.jpg","seite":"https://commons.wikimedia.org/wiki/File:Apfel_Juwel_aus_Kirchwerder.jpg","art":"frucht","urheber":"Hinnerk11","lizenz":"CC BY-SA 4.0","quelle":"commons-fotos","titel":"Apfel Juwel aus Kirchwerder"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/3/33/Juwel_von_Kirchwerder.JPG/960px-Juwel_von_Kirchwerder.JPG","seite":"https://commons.wikimedia.org/wiki/File:Juwel_von_Kirchwerder.JPG","art":"frucht","urheber":"Genet","lizenz":"CC BY