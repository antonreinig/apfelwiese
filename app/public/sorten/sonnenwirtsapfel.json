//de.wikipedia.org/w/index.php?title=Sonnenwirtsapfel&oldid=259176723"},{"merkmal":"pflueckreife","wert":"10","original":"Die Erntezeit liegt von September bis Anfang Oktober.","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Sonnenwirtsapfel&oldid=259176723"},{"merkmal":"genussreife_ende","wert":"2","original":"Die Früchte sind bei guter Lagerung bis Februar haltbar.","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Sonnenwirtsapfel&oldid=259176723"},{"merkmal":"baum_wuchs","wert":"5","original":"Mittelstark bis stark wachsend","quelle":"web_kob","url":"https://www.obstsorten-bw.de/fileadmin/Dateien/Sortenbeschreibungen/Sonnenwirtsapfel_KOB.pdf"},{"merkmal":"baum_wuchs","wert":"7","original":"Mittelstark bis stark wachsend","quelle":"web_kob","url":"https://www.obstsorten-bw.de/fileadmin/Dateien/Sortenbeschreibungen/Sonnenwirtsapfel_KOB.pdf"},{"merkmal":"lagerfaehigkeit","wert":"5","original":"Bei guter Lagerung halten die Früchte bis Februar.","quelle":"web_kob","url":"https://www.obstsorten-bw.de/fileadmin/Dateien/Sortenbeschreibungen/Sonnenwirtsapfel_KOB.pdf","belege":[{"quelle":"web_kob","url":"https://www.obstsorten-bw.de/fileadmin/Dateien/Sortenbeschreibungen/Sonnenwirtsapfel_KOB.pdf"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Sonnenwirtsapfel&oldid=259176723"}]},{"merkmal":"hochstamm","wert":"gut","original":"Süddeutsche Streuobstsorte","quelle":"web_kob","url":"https://www.obstsorten-bw.de/fileadmin/Dateien/Sortenbeschreibungen/Sonnenwirtsapfel_KOB.pdf","belege":[{"quelle":"web_kob","url":"https://www.obstsorten-bw.de/fileadmin/Dateien/Sortenbeschreibungen/Sonnenwirtsapfel_KOB.pdf"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Sonnenwirtsapfel&oldid=259176723"}]},{"merkmal":"ertrag_alternanz","wert":"regelmaessig","original":"trägt regelmäßig mittelhoch bis hoch","quelle":"web_kob","url":"https://www.obstsorten-bw.de/fileadmin/Dateien/Sortenbeschreibungen/Sonnenwirtsapfel_KOB.pdf","belege":[{"quelle":"web_kob","url":"https://www.obstsorten-bw.de/fileadmin/Dateien/Sortenbeschreibungen/Sonnenwirtsapfel_KOB.pdf"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Sonnenwirtsapfel&oldid=259176723"}]},{"merkmal":"standort_boden","wert":"3","original":"stellt geringe Ansprüche an Klima und Boden","quelle":"web_kob","url":"https://www.obstsorten-bw.de/fileadmin/Dateien/Sortenbeschreibungen/Sonnenwirtsapfel_KOB.pdf","belege":[{"quelle":"web_kob","url":"https://www.obstsorten-bw.de/fileadmin/Dateien/Sortenbeschreibungen/Sonnenwirtsapfel_KOB.pdf"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Sonnenwirtsapfel&oldid=259176723"}]},{"merkmal":"standort_klima","wert":"3","original":"stellt geringe Ansprüche an Klima und Boden","quelle":"web_kob","url":"https://www.obstsorten-bw.de/fileadmin/Dateien/Sortenbeschreibungen/Sonnenwirtsapfel_KOB.pdf","belege":[{"quelle":"web_kob","url":"https://www.obstsorten-bw.de/fileadmin/Dateien/Sortenbeschreibungen/Sonnenwirtsapfel_KOB.pdf"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Sonnenwirtsapfel&oldid=259176723"}]},{"merkmal":"gesundheit","wert":"7","original":"sehr widerstandsfähig gegen Krankheiten und Schädlinge","quelle":"web_kob","url":"https://www.obstsorten-bw.de/fileadmin/Dateien/Sortenbeschreibungen/Sonnenwirtsapfel_KOB.pdf","belege":[{"quelle":"web_kob","url":"https://www.obstsorten-bw.de/fileadmin/Dateien/Sortenbeschreibungen/Sonnenwirtsapfel_KOB.pdf"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Sonnenwirtsapfel&oldid=259176723"}]}],"texte":[{"thema":"ueberblick","text":"Süddeutsche Streuobstsorte mit mittelgroßen bis großen, unregelmäßig geformten Früchten, grünlichgelber, sonnenseits mattrot marmorierter und dunkelrot geflammter Schale und auffallend stark berosteter Stielgrube. Die Bäume werden sehr groß und alt und sind sehr widerstandsfähig gegen Krankheiten. 2017 wurde der Sonnenwirtsapfel zur Streuobstsorte des Jahres in Baden-Württemberg gewählt.","belege":[{"quelle":"web_kob","url":"https://www.obstsorten-bw.de/fileadmin/Dateien/Sortenbeschreibungen/Sonnenwirtsapfel_KOB.pdf"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Sonnenwirtsapfel&oldid=259176723"}]},{"thema":"herkunft","text":"Die Sorte wurde in Backnang im Rems-Murr-Kreis als Zufallssämling auf dem Grundstück des Sonnenwirts, des Wirts des Gasthauses zur Sonne, gefunden. Das Kompetenzzentrum Obstbau Bodensee hält den Geflammten Kardinal für einen wahrscheinlichen Elternteil. Als Jahr der ersten Beschreibung werden 1932 und 1937 angegeben. Die Sorte ist in Süddeutschland verbreitet.","belege":[{"quelle":"web_kob","url":"https://www.obstsorten-bw.de/fileadmin/Dateien/Sortenbeschreibungen/Sonnenwirtsapfel_KOB.pdf"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Sonnenwirtsapfel&oldid=259176723"}]},{"thema":"frucht","text":"Die Früchte wiegen 160 bis 190 g. Die Form ist unregelmäßig, manchmal ungleichhälftig, abgeflacht kugelig bis breit abgestumpft kegelförmig, selten walzenförmig, mit dem Bauch zum Stiel hin. Drei bis fünf breite Kanten machen die Oberfläche uneben. Der sehr kurze, dicke, knopfige Stiel sitzt in tiefer, mittelweiter, stark berosteter Stielgrube. Der halb offene bis offene Kelch mit kurzen, mittelbreiten Blättchen sitzt in mitteltiefer, mittelweiter Kelchgrube mit deutlichen Rippen; Wikipedia beschreibt die Kelchgrube als sehr tief.","belege":[{"quelle":"web_kob","url":"https://www.obstsorten-bw.de/fileadmin/Dateien/Sortenbeschreibungen/Sonnenwirtsapfel_KOB.pdf"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Sonnenwirtsapfel&oldid=259176723"}]},{"thema":"schale","text":"Die Grundfarbe ist grünlichgelb. Sonnenseits ist die Schale flächig mattrot marmoriert und dunkelrot geflammt. Die Lentizellen sind hell umhöft. Die Stielgrube ist stark berostet.","belege":[{"quelle":"web_kob","url":"https://www.obstsorten-bw.de/fileadmin/Dateien/Sortenbeschreibungen/Sonnenwirtsapfel_KOB.pdf"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Sonnenwirtsapfel&oldid=259176723"}]},{"thema":"schnitt","text":"Nach dem Kompetenzzentrum Obstbau Bodensee ist das Kernhaus mittelgroß und liegt nahe am Kelch. Die Kelchhöhle ist breit und tief bis sehr tief. Die Kerne sind groß, lang, schmal, zugespitzt und hellbraun. Das Fleisch ist am Schnitt gelblichweiß.","belege":[{"quelle":"web_kob","url":"https://www.obstsorten-bw.de/fileadmin/Dateien/Sortenbeschreibungen/Sonnenwirtsapfel_KOB.pdf"}]},{"thema":"fleisch_geschmack","text":"Das Fruchtfleisch ist gelblichweiß und sehr saftig, der Geschmack angenehm fein säuerlich und fruchtig.","belege":[{"quelle":"web_kob","url":"https://www.obstsorten-bw.de/fileadmin/Dateien/Sortenbeschreibungen/Sonnenwirtsapfel_KOB.pdf"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Sonnenwirtsapfel&oldid=259176723"}]},{"thema":"reife_lagerung","text":"Geerntet wird im September bis Anfang Oktober. Bei guter Lagerung halten die Früchte bis Februar.","belege":[{"quelle":"web_kob","url":"https://www.obstsorten-bw.de/fileadmin/Dateien/Sortenbeschreibungen/Sonnenwirtsapfel_KOB.pdf"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Sonnenwirtsapfel&oldid=259176723"}]},{"thema":"verwendung","text":"Die Früchte eignen sich frisch als Tafelobst und als Wirtschaftsobst für Küche und häusliche Verwertung.","belege":[{"quelle":"web_kob","url":"https://www.obstsorten-bw.de/fileadmin/Dateien/Sortenbeschreibungen/Sonnenwirtsapfel_KOB.pdf"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Sonnenwirtsapfel&oldid=259176723"}]},{"thema":"baum","text":"Der Baum wächst mittelstark bis stark, mit wenig verzweigtem Fruchtholz und im äußeren Kronenbereich hängend. Die sehr großen Bäume bilden gleichmäßig kugelige Kronen und werden alt. Die Sorte blüht mittelfrüh, trägt regelmäßig mittelhoch bis hoch, stellt geringe Ansprüche an Klima und Boden und ist sehr widerstandsfähig gegen Krankheiten und Schädlinge. Wikipedia nennt sie auch als Stammbildner für Apfelhochstämme geeignet.","belege":[{"quelle":"web_kob","url":"https://www.obstsorten-bw.de/fileadmin/Dateien/Sortenbeschreibungen/Sonnenwirtsapfel_KOB.pdf"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Sonnenwirtsapfel&oldid=259176723"}]}],"bilder":[{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/d/d1/Sonnenwirtsapfel_jm55094.jpg/960px-Sonnenwirtsapfel_jm55094.jpg","seite":"https://commons.wikimedia.org/wiki/File:Sonnenwirtsapfel_jm55094.jpg","art":"frucht","urheber":"joergens.mi","lizenz":"CC BY-SA 3.0","quelle":"commons","titel":"Sonnenwirtsapfel jm55094.jpg"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/b/bf/Sonnenwirtsapfel_%28apple%29_jm179293.jpg/960px-Sonnenwirtsapfel_%28apple%29_jm179293.jpg","seite":"https://commons.wikimedia.org/wiki/File:Sonnenwirtsapfel_(apple)_jm179293.jpg","art":"baum","urheber":"joergens.mi","lizenz":"CC BY-SA 3.0","quelle":"commons-fotos","titel":"Sonnenwirtsapfel (apple) jm179293"}],"regionen":[{"region":"DE-BW","art":"herkunft","belege":[{"quelle":"web_kob","url":"https://www.obstsorten-bw.de/fileadmin/Dateien/Sortenbeschreibungen/Sonnenwirtsapfel_KOB.pdf"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Sonnenwirtsapfel&oldid=259176723"},{"quelle":"web_kob","url":"https://www.obstsorten-bw.de/fileadmin/Dateien/Sortenbeschreibungen/Sonnenwirtsapfel_KOB.pdf"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Sonnenwirtsapfel&oldid=259176723"}]},{"region":"DE-BW","art":"regionalsorte","belege":[{"quelle":"rg_bw-kob-landkreissorten"}],"original":"Sonnenwirtsapfel"},{"region":"DE-BW","art":"empfehlung","belege":[{"quelle":"rg_bw-logl-streuobstsorte-des-jahres","seite":"Streuobstsorte des Jahres 2017"}],"original":"Sonnenwirtsapfel"}],"gefaehrdung":[{"stufe":"Rote Liste der gefährdeten einheimischen Nutzpflanzen in Deutschland","belege":[{"quelle":"rg_ble-rote-liste"}],"original":"Sonnenwirtsapfel"}]}