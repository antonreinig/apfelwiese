{"id":"sonnenwirtsapfel","name":"Sonnenwirtsapfel","synonyme":[],"herkunft":{"text":"Zufallssämling aus Backnang (Rems-Murr-Kreis, Baden-Württemberg), gefunden auf dem Grundstück des Wirts des Gasthauses zur Sonne; vermutlich ein Abkömmling des Geflammten Kardinals. Erstmals 1932 beschrieben (eine andere Angabe nennt 1937).","belege":[{"quelle":"web_kob","url":"https://www.obstsorten-bw.de/fileadmin/Dateien/Sortenbeschreibungen/Sonnenwirtsapfel_KOB.pdf"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Sonnenwirtsapfel&oldid=259176723"}],"land":"DE","landSicher":true,"ort":"Backnang","jahr":1932},"merkmale":[{"merkmal":"frucht_groesse","wert":"5","original":"Mittelgroß bis groß (160 – 190 g)","quelle":"web_kob","url":"https://www.obstsorten-bw.de/fileadmin/Dateien/Sortenbeschreibungen/Sonnenwirtsapfel_KOB.pdf"},{"merkmal":"frucht_groesse","wert":"7","original":"Mittelgroß bis groß (160 – 190 g)","quelle":"web_kob","url":"https://www.obstsorten-bw.de/fileadmin/Dateien/Sortenbeschreibungen/Sonnenwirtsapfel_KOB.pdf"},{"merkmal":"frucht_groesse","wert":"5","original":"Die mittelgroßen Früchte","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Sonnenwirtsapfel&oldid=259176723"},{"merkmal":"frucht_form","wert":"unregelmaessig","original":"Form insgesamt unregelmäßig, manchmal ungleichhälftig; kugelförmig abgeflacht","quelle":"web_kob","url":"https://www.obstsorten-bw.de/fileadmin/Dateien/Sortenbeschreibungen/Sonnenwirtsapfel_KOB.pdf"},{"merkmal":"frucht_form","wert":"flachrund","original":"Form insgesamt unregelmäßig, manchmal ungleichhälftig; kugelförmig abgeflacht","quelle":"web_kob","url":"https://www.obstsorten-bw.de/fileadmin/Dateien/Sortenbeschreibungen/Sonnenwirtsapfel_KOB.pdf"},{"merkmal":"frucht_breiteste_stelle","wert":"stiel","original":"selten auch walzenförmig, stielbauchig","quelle":"web_kob","url":"https://www.obstsorten-bw.de/fileadmin/Dateien/Sortenbeschreibungen/Sonnenwirtsapfel_KOB.pdf"},{"merkmal":"frucht_rippung","wert":"7","original":"Oberfläche uneben, mit drei bis fünf breiten Kanten","quelle":"web_kob","url":"https://www.obstsorten-bw.de/fileadmin/Dateien/Sortenbeschreibungen/Sonnenwirtsapfel_KOB.pdf"},{"merkmal":"frucht_kronung","wert":"9","original":"Kelchgrube mitteltief, mittelweit und mit deutlichen Rippen versehen","quelle":"web_kob","url":"https://www.obstsorten-bw.de/fileadmin/Dateien/Sortenbeschreibungen/Sonnenwirtsapfel_KOB.pdf"},{"merkmal":"schale_grundfarbe","wert":"gruengelb","original":"Grundfarbe grünlichgelb","quelle":"web_kob","url":"https://www.obstsorten-bw.de/fileadmin/Dateien/Sortenbeschreibungen/Sonnenwirtsapfel_KOB.pdf"},{"merkmal":"schale_deckfarbe_anteil","wert":"5","original":"sonnenseits flächig mattrot marmoriert und dunkelrot geflammt","quelle":"web_kob","url":"https://www.obstsorten-bw.de/fileadmin/Dateien/Sortenbeschreibungen/Sonnenwirtsapfel_KOB.pdf"},{"merkmal":"schale_deckfarbe_farbton","wert":"dunkelrot","original":"sonnenseits flächig mattrot marmoriert und dunkelrot geflammt","quelle":"web_kob","url":"https://www.obstsorten-bw.de/fileadmin/Dateien/Sortenbeschreibungen/Sonnenwirtsapfel_KOB.pdf"},{"merkmal":"schale_deckfarbe_art","wert":"marmoriert","original":"sonnenseits flächig mattrot marmoriert und dunkelrot geflammt","quelle":"web_kob","url":"https://www.obstsorten-bw.de/fileadmin/Dateien/Sortenbeschreibungen/Sonnenwirtsapfel_KOB.pdf"},{"merkmal":"schale_deckfarbe_art","wert":"geflammt","original":"sonnenseits flächig mattrot marmoriert und dunkelrot geflammt","quelle":"web_kob","url":"https://www.obstsorten-bw.de/fileadmin/Dateien/Sortenbeschreibungen/Sonnenwirtsapfel_KOB.pdf"},{"merkmal":"stielgrube_tiefe","wert":"7","original":"Stielgrube tief, mittelweit und stark berostet","quelle":"web_kob","url":"https://www.obstsorten-bw.de/fileadmin/Dateien/Sortenbeschreibungen/Sonnenwirtsapfel_KOB.pdf"},{"merkmal":"stielgrube_weite","wert":"5","original":"Stielgrube tief, mittelweit und stark berostet","quelle":"web_kob","url":"https://www.obstsorten-bw.de/fileadmin/Dateien/Sortenbeschreibungen/Sonnenwirtsapfel_KOB.pdf"},{"merkmal":"schale_berostung_stielgrube","wert":"7","original":"Stielgrube tief, mittelweit und stark berostet","quelle":"web_kob","url":"https://www.obstsorten-bw.de/fileadmin/Dateien/Sortenbeschreibungen/Sonnenwirtsapfel_KOB.pdf"},{"merkmal":"schale_berostung_stielgrube","wert":"7","original":"Die Stielgrube ist stark berostet","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Sonnenwirtsapfel&oldid=259176723"},{"merkmal":"stiel_laenge","wert":"1","original":"Stiel sehr kurz, dick und knopfig","quelle":"web_kob","url":"https://www.obstsorten-bw.de/fileadmin/Dateien/Sortenbeschreibungen/Sonnenwirtsapfel_KOB.pdf"},{"merkmal":"stiel_dicke","wert":"7","original":"Stiel sehr kurz, dick und knopfig","quelle":"web_kob","url":"https://www.obstsorten-bw.de/fileadmin/Dateien/Sortenbeschreibungen/Sonnenwirtsapfel_KOB.pdf"},{"merkmal":"kelchgrube_tiefe","wert":"5","original":"Kelchgrube mitteltief, mittelweit","quelle":"web_kob","url":"https://www.obstsorten-bw.de/fileadmin/Dateien/Sortenbeschreibungen/Sonnenwirtsapfel_KOB.pdf"},{"merkmal":"kelchgrube_weite","wert":"5","original":"Kelchgrube mitteltief, mittelweit","quelle":"web_kob","url":"https://www.obstsorten-bw.de/fileadmin/Dateien/Sortenbeschreibungen/Sonnenwirtsapfel_KOB.pdf"},{"merkmal":"kelchgrube_tiefe","wert":"7","original":"die Kelchgrube sehr tief","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Sonnenwirtsapfel&oldid=259176723"},{"merkmal":"kelch_offenheit","wert":"halboffen","original":"Kelch halboffen bis offen","quelle":"web_kob","url":"https://www.obstsorten-bw.de/fileadmin/Dateien/Sortenbeschreibungen/Sonnenwirtsapfel_KOB.pdf"},{"merkmal":"kelch_offenheit","wert":"offen","original":"Kelch halboffen bis offen","quelle":"web_kob","url":"https://www.obstsorten-bw.de/fileadmin/Dateien/Sortenbeschreibungen/Sonnenwirtsapfel_KOB.pdf"},{"merkmal":"kernhaus_lage","wert":