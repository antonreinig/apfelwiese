hp?title=Gelber_Bellefleur&oldid=255232572"},{"merkmal":"kernhaus_breite_mm","wert":41,"original":"Kernhaus 41:44","quelle":"engelbrecht1889","seite":"131 (Nr. 117)"},{"merkmal":"kernhaus_hoehe_mm","wert":44,"original":"Kernhaus 41:44","quelle":"engelbrecht1889","seite":"131 (Nr. 117)"},{"merkmal":"kernfach_breite_mm","wert":11,"original":"Kammern 11:25","quelle":"engelbrecht1889","seite":"131 (Nr. 117)"},{"merkmal":"kernfach_hoehe_mm","wert":25,"original":"Kammern 11:25","quelle":"engelbrecht1889","seite":"131 (Nr. 117)"},{"merkmal":"frucht_breite","wert":61,"quelle":"nfc2025","seite":"Akzession 1948182 (Smith 1971)","original":"55-67"},{"merkmal":"frucht_hoehe","wert":52,"quelle":"nfc2025","seite":"Akzession 1948182 (Smith 1971)","original":"47-57"},{"merkmal":"frucht_groesse","wert":"5","quelle":"nfc2025","seite":"Akzession 1948182 (Smith 1971)","original":"Medium"},{"merkmal":"frucht_form","wert":"konisch","quelle":"nfc2025","seite":"Akzession 1948182 (Smith 1971)","original":"Conical"},{"merkmal":"frucht_hoehe_breite","wert":0.852,"quelle":"nfc2025","seite":"Akzession 1948182 (Smith 1971)"},{"merkmal":"frucht_rippung","wert":"1","quelle":"nfc2025","seite":"Akzession 1948182 (Smith 1971)","original":"Very light"},{"merkmal":"schale_grundfarbe","wert":"gruengelb","quelle":"nfc2025","seite":"Akzession 1948182 (Smith 1971)","original":"Green yellow"},{"merkmal":"schale_deckfarbe_farbton","wert":"orange","quelle":"nfc2025","seite":"Akzession 1948182 (Smith 1971)","original":"Orange"},{"merkmal":"schale_deckfarbe_art","wert":"gestreift","quelle":"nfc2025","seite":"Akzession 1948182 (Smith 1971)","original":"Only stripes"},{"merkmal":"schale_berostung_gesamt","wert":"3","quelle":"nfc2025","seite":"Akzession 1948182 (Smith 1971)","original":"Low"},{"merkmal":"fleisch_farbe","wert":"gelblich","quelle":"nfc2025","seite":"Akzession 1948182 (Smith 1971)","original":"Yellowish"},{"merkmal":"fleisch_festigkeit","wert":"7","quelle":"nfc2025","seite":"Akzession 1948182 (Verkostung P. Hale, 28/10/2020)","original":"Very firm"},{"merkmal":"fleisch_saftigkeit","wert":"5","quelle":"nfc2025","seite":"Akzession 1948182 (Verkostung P. Hale, 28/10/2020)","original":"Intermediate"},{"merkmal":"geschmack_suesse","wert":"5","quelle":"nfc2025","seite":"Akzession 1948182 (Verkostung P. Hale, 28/10/2020)","original":"Intermediate to high"},{"merkmal":"geschmack_suesse","wert":"7","quelle":"nfc2025","seite":"Akzession 1948182 (Verkostung P. Hale, 28/10/2020)","original":"Intermediate to high"},{"merkmal":"geschmack_saeure","wert":"5","quelle":"nfc2025","seite":"Akzession 1948182 (Verkostung P. Hale, 28/10/2020)","original":"Intermediate"},{"merkmal":"verwendung","wert":"tafel","quelle":"nfc2025","seite":"Akzession 1948182","original":"Dessert"},{"merkmal":"pflueckreife","wert":"10","quelle":"nfc2025","seite":"Akzession 1948182","original":"Early October"},{"merkmal":"genussreife_ende","wert":"12","quelle":"nfc2025","seite":"Akzession 1948182","original":"December"},{"merkmal":"bluete_zeit","wert":"5","quelle":"nfc2025","seite":"Akzession 1948182","original":"Klasse 5 (10 % der Blüten offen, Tag 127)"},{"merkmal":"standort_boden","wert":"3","original":"Die Sorte gedeiht auch auf leichten Böden","quelle":"illustr_hb_1","band":"I","seite":"69","belege":[{"quelle":"illustr_hb_1","band":"I","seite":"69"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Gelber_Bellefleur&oldid=255232572"}]},{"merkmal":"anfaelligkeit_krebs","wert":"7","original":"in nassen Jahren und auf feuchtem Boden treten Obstbaumkrebs und Schorf häufig auf","quelle":"illustr_hb_1","band":"I","seite":"69","belege":[{"quelle":"illustr_hb_1","band":"I","seite":"69"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Gelber_Bellefleur&oldid=255232572"}]},{"merkmal":"anfaelligkeit_schorf","wert":"7","original":"in nassen Jahren und auf feuchtem Boden treten Obstbaumkrebs und Schorf häufig auf","quelle":"illustr_hb_1","band":"I","seite":"69","belege":[{"quelle":"illustr_hb_1","band":"I","seite":"69"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Gelber_Bellefleur&oldid=255232572"}]},{"merkmal":"lagerfaehigkeit","wert":"7","original":"Nach Engelbrecht genussreif von Dezember bis März","quelle":"engelbrecht1889","seite":"131 (Nr. 117)"}],"texte":[{"thema":"ueberblick","text":"Amerikanischer Winterapfel aus New Jersey, mittelgroß bis groß, hochgebaut und zum Kelch hin stumpf zugespitzt, mit zitronengelber, kaum geröteter Schale. Tafel- und Wirtschaftsapfel, genussreif von November bzw. Dezember bis März; Wikipedia rechnet ihn zu den Kalvillen.","belege":[{"quelle":"engelbrecht1889","seite":"131 (Nr. 117)"},{"quelle":"illustr_hb_1","band":"I","seite":"69"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Gelber_Bellefleur&oldid=255232572"}]},{"thema":"herkunft","text":"Nach Downing stammt die Sorte aus Burlington in New Jersey und ist nach ihrer schönen Blüte benannt; in den USA war sie besonders auf den Märkten in Philadelphia häufig. Der ursprüngliche deutsche Name lautete Gelber englischer Schönblühender; v. Flotow, der sie 1854 beschrieb, wählte den kürzeren Namen Gelber Bellefleur (Handbuch 1859). 1874 empfahl der Deutsche Pomologen-Verein in Trier die Sorte zum Anbau. Engelbrecht erhielt Früchte aus Langwarden, Düren, Reutlingen und Potsdam.","belege":[{"quelle":"illustr_hb_1","band":"I","seite":"69"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Gelber_Bellefleur&oldid=255232572"},{"quelle":"engelbrecht1889","seite":"131 (Nr. 117)"}]},{"thema":"frucht","text":"Engelbrecht maß 70 mm Breite bei 64–73 mm Höhe, nach dem Handbuch auch größer (81:76–80 mm); die Frucht ist abgestumpft ei-kegelförmig, zum Stiel hin am breitesten, die Hälften verschieden. Kennzeichnend ist nach v. Flotow die etwas vorgezogene, stumpfe Spitze zum Kelch hin. Der fast geschlossene bis halb offene Kelch sitzt ziemlich tief zwischen kelchwärts starken, flach über den Bauch laufenden Rippen; der Querschnitt ist nach Engelbrecht etwas kantig, nach dem Handbuch fast rund. Der mitteldicke Stiel ist etwa 14 mm lang und steht in einer ziemlich tiefen, mittelweiten bis engen, wenig berosteten Höhle.","belege":[{"quelle":"engelbrecht1889","seite":"131 (Nr. 117)"},{"quelle":"illustr_hb_1","band":"I","seite":"69"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Gelber_Bellefleur&oldid=255232572"}]},{"thema":"schale","text":"Die glatte, etwas glänzende Schale ist erst grünlichgelb und wird in voller Reife gelb bis zitronengelb; sonnenseits zeigt sich nur zuweilen ein leichter rötlicher, nach Wikipedia bräunlichroter Anflug. Auffällig sind die ziemlich zahlreichen, mitteldicken bis starken, teils eckigen hellbraunen Schalenpunkte, die nach dem Handbuch meist weißlich umflossen sind. Gelegentlich gehen Rostfiguren vom Stiel aus. Die Frucht welkt nicht und hat keinen Geruch.","belege":[{"quelle":"engelbrecht1889","seite":"131 (Nr. 117)"},{"quelle":"illustr_hb_1","band":"I","seite":"69"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Gelber_Bellefleur&oldid=255232572"}]},{"thema":"schnitt","text":"Das Kernhaus ist groß, unregelmäßig ei-zwiebelförmig (41:44 mm) und oft von abschweifenden Gefäßbündeln begleitet. Die Kammern sind stielwärts sehr spitz, kelchwärts breiter, zerrissen, geräumig und offen, nach dem Handbuch weit offen; die Achse ist hohl, die Achsenhöhle mittelbreit bis breit. Je Kammer liegen ein bis zwei ziemlich große, meist vollkommene, eiförmige, dunkelbraune Kerne. Die Kelchhöhle ist trichterförmig und reicht zwei Drittel bis vier Fünftel der Strecke zur Achsenhöhle (Engelbrecht); das Handbuch beschreibt sie als kegelförmig mit kurzer Röhre. Am Schnitt ist das Fleisch gelblichweiß, nach dem Handbuch gelblich mit gelbgrünen Adern.","belege":[{"quelle":"engelbrecht1889","seite":"131 (Nr. 117)"},{"quelle":"illustr_hb_1","band":"I","seite":"69"}]},{"thema":"fleisch_geschmack","text":"Das Fleisch ist fein, markig bis mürbe und saftig. Engelbrecht schmeckte es angenehm, kaum gewürzt, etwas vorherrschend weinig und etwas weniger süß; v. Flotow nennt den Geschmack gewürzig weinig und renettenartig, den Geruch des Fleisches angenehm süßlich. Wikipedia beschreibt es als mild gewürzt, etwas weinig oder quittenartig und leicht süß.","belege":[{"quelle":"engelbrecht1889","seite":"131 (Nr. 117)"},{"quelle":"illustr_hb_1","band":"I","seite":"69"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Gelber_Bellefleur&oldid=255232572"}]},{"thema":"reife_lagerung","text":"Nach Engelbrecht genussreif von Dezember bis März, nach dem Handbuch ab November den Winter hindurch, 1858 bis in den März. Die Früchte sollen nicht zu früh geerntet werden.","belege":[{"quelle":"engelbrecht1889","seite":"131 (Nr. 117)"},{"quelle":"illustr_hb_1","band":"I","seite":"69"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Gelber_Bellefleur&oldid=255232572"}]},{"thema":"verwendung","text":"Engelbrecht vergab oo++; v. Flotow zählte die Sorte zu den Tafeläpfeln ersten Ranges, auch für die Wirtschaft gut brauchbar, während der Londoner Katalog sie im englischen Klima nur als Küchenapfel einstufte.","belege":[{"quelle":"engelbrecht1889","seite":"131 (Nr. 117)"},{"quelle":"illustr_hb_1","band":"I","seite":"69"}]},{"thema":"baum","text":"Der Baum wächst mittelstark, ist dünntriebig und trägt reichlich an langen Fruchtruten, die nicht geschnitten, nur ausgelichtet werden sollen; die Äste senken sich unter der Last. Die Blüte ist spät. Die Sorte gedeiht auch auf leichten Böden; in nassen Jahren und auf feuchtem Boden treten Obstbaumkrebs und Schorf häufig auf. Für Spaliere eignet sie sich nicht.","belege":[{"quelle":"illustr_hb_1","band":"I","seite":"69"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Gelber_Bellefleur&oldid=255232572"}]},{"thema":"frucht","text":"Nach den Erhebungen der National Fruit Collection: die Sorte bildet mittelgroße, kegelförmige Früchte mit grünlich gelber Grundfarbe und gestreifter orangefarbener Deckfarbe. Die Schale ist wenig berostet, das Fruchtfleisch gelblich. Bei der Verkostung war das Fleisch sehr fest und mäßig saftig, der Geschmack mäßig bis deutlich süß und mäßig sauer, mit schwachem Aroma. Tafelapfel, pflückreif Anfang Oktober und lagerfähig bis Dezember.","belege":[{"quelle":"nfc2025","seite":"Akzession 1948182"}]}],"bilder":[{"url":"https://archive.org/download/bub_gb_tR4EMgEACAAJ/page/n148_w800.jpg","seite":"https://archive.org/details/bub_gb_tR4EMgEACAAJ/page/n148","art":"schnitt","urheber":"Theodor Engelbrecht (Zeichnung), Albert Probst (Holzschnitt)","lizenz":"gemeinfrei","quelle":"engelbrecht1889","titel":"Längsschnitt-Umriss bei Engelbrecht 1889, S. 131 (ganze Buchseite)"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/d/d9/Malus_Gelber_Bellefleur_4549.jpg/960px-Malus_Gelber_Bellefleur_4549.jpg","seite":"https://commons.wikimedia.org/wiki/File:Malus_Gelber_Bellefleur_4549.jpg","art":"frucht","urheber":"Sven Teschke","lizenz":"CC BY-SA 3.0 de","quelle":"commons","titel":"Malus Gelber Bellefleur 4549.jpg"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/90/Gelber_Bellefleur_jm55185.jpg/960px-Gelber_Bellefleur_jm55185.jpg","seite":"https://commons.wikimedia.org/wiki/File:Gelber_Bellefleur_jm55185.jpg","art":"frucht","urheber":"joergens.mi","lizenz":"CC BY-SA 3.0","quelle":"commons","titel":"Gelber Bellefleur jm55185.jpg"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/ce/Deutsche_Pomologie_-_Aepfel_-_003.jpg/960px-Deutsche_Pomologie_-_Aepfel_-_003.jpg","seite":"https://commons.wikimedia.org/wiki/File:Deutsche_Pomologie_-_Aepfel_-_003.jpg","art":"tafel","urheber":"Wilhelm Lauche","lizenz":"Public domain","quelle":"lauche_dp1882","titel":"Deutsche Pomologie - Aepfel - 003.jpg"},{"url":"https://upload.wikimedia.org/wikipedia/commons/6/61/Cross_section_of_Yellow_Bellflower%2C_National_Fruit_Collection_%28acc._1953-140%29.jpg","seite":"https://commons.wikimedia.org/wiki/File:Cross_section_of_Yellow_Bellflower,_National_Fruit_Collection_(acc._1953-140).jpg","art":"schnitt","urheber":"National Fruit Collection, Brogdale","lizenz":"OGL 2.0","quelle":"nfc-commons","titel":"Cross section of Yellow Bellflower, National Fruit Collection (acc. 1953-140)"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/b/b6/Pomological_Watercolor_POM00000132.jpg/960px-Pomological_Watercolor_POM00000132.jpg","seite":"https://commons.wikimedia.org/wiki/File:Pomological_Watercolor_POM00000132.jpg","art":"tafel","urheber":"Heiges, Bertha","lizenz":"gemeinfrei","quelle":"usda-pomological","titel":"Pomological Watercolor POM00000132"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/7f/Pomological_Watercolor_POM00000525.jpg/960px-Pomological_Watercolor_POM00000525.jpg","seite":"https://commons.wikimedia.org/wiki/File:Pomological_Watercolor_POM00000525.jpg","art":"tafel","urheber":"Schutt, Ellen Isham, 1873-1955","lizenz":"gemeinfrei","quelle":"usda-pomological","titel":"Pomological Watercolor POM00000525"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/a/ad/Pomological_Watercolor_POM00000869.jpg/960px-Pomological_Watercolor_POM00000869.jpg","seite":"https://commons.wikimedia.org/wiki/File:Pomological_Watercolor_POM00000869.jpg","art":"tafel","urheber":"Schutt, Ellen Isham, 1873-1955","lizenz":"gemeinfrei","quelle":"usda-pomological","titel":"Pomological Watercolor POM00000869"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/c6/Pomological_Watercolor_POM00000870.jpg/960px-Pomological_Watercolor_POM00000870.jpg","seite":"https://commons.wikimedia.org/wiki/File:Pomological_Watercolor_POM00000870.jpg","art":"tafel","urheber":"Krieger, L.C.C. (Louis Charles Christopher), 1873-1940","lizenz":"gemeinfrei","quelle":"usda-pomological","titel":"Pomological Watercolor POM00000870"},{"url":"https://thumb.wikimedia.org/w