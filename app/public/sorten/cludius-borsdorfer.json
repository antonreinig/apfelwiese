{"id":"cludius-borsdorfer","name":"Cludius’ Borsdorfer","synonyme":[{"name":"Cludius’ grüner Borsdorfer","beleg":{"quelle":"engelbrecht1889","seite":"374 (Nr. 332)"}},{"name":"Borsdorf de Cludius","beleg":{"quelle":"engelbrecht1889","seite":"374 (Nr. 332)"}}],"herkunft":{"text":"Vom Superintendenten Hermann Heimart Cludius in Hildesheim erzogen; zuerst von Oberdieck in seiner Anleitung als Cludius' grüner Borsdorfer beschrieben.","belege":[{"quelle":"illustr_hb_4","band":"IV","seite":"137"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Cludius’_Borsdorfer&oldid=232515895"},{"quelle":"engelbrecht1889","seite":"374 (Nr. 332)"}],"land":"DE","landSicher":true,"ort":"Hildesheim"},"merkmale":[{"merkmal":"frucht_breite","wert":60,"original":"Gestalt 60:48—54","quelle":"engelbrecht1889","seite":"374 (Nr. 332)"},{"merkmal":"frucht_hoehe","wert":51,"original":"Gestalt 60:48—54","quelle":"engelbrecht1889","seite":"374 (Nr. 332)"},{"merkmal":"frucht_hoehe_breite","wert":0.85,"original":"Gestalt 60:48—54","quelle":"engelbrecht1889","seite":"374 (Nr. 332)"},{"merkmal":"frucht_form","wert":"flachkonisch","original":"abgest. flach kegelf. bis fast abgest. rundlich","quelle":"engelbrecht1889","seite":"374 (Nr. 332)"},{"merkmal":"frucht_form","wert":"rund","original":"abgest. flach kegelf. bis fast abgest. rundlich","quelle":"engelbrecht1889","seite":"374 (Nr. 332)"},{"merkmal":"frucht_breiteste_stelle","wert":"stiel","original":"etwas stielbauch.","quelle":"engelbrecht1889","seite":"374 (Nr. 332)"},{"merkmal":"frucht_symmetrie","wert":"schief","original":"Hälften oft nicht ganz gleich","quelle":"engelbrecht1889","seite":"374 (Nr. 332)"},{"merkmal":"frucht_rippung","wert":"3","original":"Querschnitt fast rund","quelle":"engelbrecht1889","seite":"374 (Nr. 332)"},{"merkmal":"frucht_kronung","wert":"1","original":"zwischen flachen, sich kaum merklich zum Bauche fortsetzenden Falten","quelle":"engelbrecht1889","seite":"374 (Nr. 332)"},{"merkmal":"kelch_offenheit","wert":"offen","original":"Kelch offen, grünlich und bräunlich, stark bewollt","quelle":"engelbrecht1889","seite":"374 (Nr. 332)"},{"merkmal":"kelchgrube_tiefe","wert":"5","original":"Einsenkung mitteltief, mittelweit","quelle":"engelbrecht1889","seite":"374 (Nr. 332)"},{"merkmal":"kelchgrube_weite","wert":"5","original":"Einsenkung mitteltief, mittelweit","quelle":"engelbrecht1889","seite":"374 (Nr. 332)"},{"merkmal":"stiel_dicke","wert":"3","original":"Stiel holzig, ziemlich dünn, etwa 11 mm lang","quelle":"engelbrecht1889","seite":"374 (Nr. 332)"},{"merkmal":"stielgrube_tiefe","wert":"7","original":"Höhle ziemlich tief, weit, eben, grün, zart braun berostet","quelle":"engelbrecht1889","seite":"374 (Nr. 332)"},{"merkmal":"stielgrube_weite","wert":"7","original":"Höhle ziemlich tief, weit, eben, grün, zart braun berostet","quelle":"engelbrecht1889","seite":"374 (Nr. 332)"},{"merkmal":"schale_berostung_stielgrube","wert":"3","original":"Höhle … zart braun berostet","quelle":"engelbrecht1889","seite":"374 (Nr. 332)"},{"merkmal":"schale_beschaffenheit","wert":"glatt","original":"Schale glatt, glänzend","quelle":"engelbrecht1889","seite":"374 (Nr. 332)"},{"merkmal":"schale_beschaffenheit","wert":"glaenzend","original":"Schale glatt, glänzend","quelle":"engelbrecht1889","seite":"374 (Nr. 332)"},{"merkmal":"schale_grundfarbe","wert":"gruengelb","original":"hellgrün, später hellgrünlichgelb bis hellgelb","quelle":"engelbrecht1889","seite":"374 (Nr. 332)"},{"merkmal":"schale_grundfarbe","wert":"gelb","original":"hellgrün, später hellgrünlichgelb bis hellgelb","quelle":"engelbrecht1889","seite":"374 (Nr. 332)"},{"merkmal":"schale_deckfarbe_anteil","wert":"3","original":"sonnenw. oft röthlicher, undeutlich streifiger Anflug","quelle":"engelbrecht1889","seite":"374 (Nr. 332)"},{"merkmal":"schale_deckfarbe_art","wert":"verwaschen","original":"röthlicher, undeutlich streifiger Anflug","quelle":"engelbrecht1889","seite":"374 (Nr. 332)"},{"merkmal":"schale_lentizellen_anzahl","wert":"5","original":"Punkte mittelzahlreich, fein, braun","quelle":"engelbrecht1889","seite":"374 (Nr. 332)"},{"merkmal":"schale_lentizellen_groesse","wert":"3","original":"Punkte mittelzahlreich, fein, braun","quelle":"engelbrecht1889","seite":"374 (Nr. 332)"},{"merkmal":"schale_lentizellen_art","wert":"braun","original":"Punkte mittelzahlreich, fein, braun","quelle":"engelbrecht1889","seite":"374 (Nr. 332)"},{"merkmal":"schale_berostung_wangen","wert":"3","original":"Kleine Anflüge von Rost kommen vor, seltener Warzen","quelle":"engelbrecht1889","seite":"374 (Nr. 332)"},{"merkmal":"kernhaus_form","wert":"eifoermig","original":"Kernhaus 31:31, zwiebeleiförmig","quelle":"engelbrecht1889","seite":"374 (Nr. 332)"},{"merkmal":"kernfaecher_oeffnung","wert":"geschlossen","original":"Kammern … meistens glattwandig, geräumig, geschlossen","quelle":"engelbrecht1889","seite":"374 (Nr. 332)"},{"merkmal":"kernhaus_achse","wert":"offen","original":"Achsenh. sehr schmal","quelle":"engelbrecht1889","seite":"374 (Nr. 332)"},{"merkmal":"kerne_form","wert":"eifoermig","original":"Kerne zu 2, mittelgross, vollkommen, eiförmig, gespitzt","quelle":"engelbrecht1889","seite":"374 (Nr. 332)"},{"merkmal":"kelchhoehle_form","wert":"dreieck_breit","original":"Kelchhöhle kurz kegel- bis kegeltrichterf., ⅖ zur Achsenh.","quelle":"engelbrecht1889","seite":"374 (Nr. 332)"},{"merkmal":"kelchhoehle_form","wert":"trichter_kurz","original":"Kelchhöhle kurz kegel- bis kegeltrichterf., ⅖ zur Achsenh.","quelle":"engelbrecht1889","seite":"374 (Nr. 332)"},{"merkmal":"fleisch_farbe","wert":"cremeweiss","original":"Fleisch hellgelblichweiss","quelle":"engelbrecht1889","seite":"374 (Nr. 332)"},{"merkmal":"fleisch_festigkeit","wert":"3","original":"fein, fest, später ziemlich mürbe","quelle":"engelbrecht1889","seite":"374 (Nr. 332)"},{"merkmal":"fleisch_saftigkeit","wert":"5","original":"genügend saftig","quelle":"engelbrecht1889","seite":"374 (Nr. 332)"},{"merkmal":"geschmack_suesse","wert":"5","original":"gewürzt, wenig vorherrschend weinig, fast ebenso süss","quelle":"engelbrecht1889","seite":"374 (Nr. 332)"},{"merkmal":"geschmack_saeure","wert":"5","original":"gewürzt, wenig vorherrschend weinig, fast ebenso süss","quelle":"engelbrecht1889","seite":"374 (Nr. 332)"},{"merkmal":"verwendung","wert":"tafel","original":"oo†† (Kopfzeile)","quelle":"engelbrecht1889","seite":"374 (Nr. 332)"},{"merkmal":"verwendung","wert":"kueche","original":"oo†† (Kopfzeile)","quelle":"engelbrecht1889","seite":"374 (Nr. 332)"},{"merkmal":"genussreife_beginn","wert":"1","original":"Januar bis Juni","quelle":"engelbrecht1889","seite":"374 (Nr. 332)"},{"merkmal":"frucht_form","wert":"flachrund","original":"Gestalt: plattrund","quelle":"illustr_hb_4","band":"IV","seite":"137"},{"merkmal":"frucht_breiteste_stelle","wert":"mitte","original":"Bauch ziemlich in der Mitte","quelle":"illustr_hb_4","band":"IV","seite":"137"},{"merkmal":"kelch_offenheit","wert":"halboffen","original":"Kelch: halb oder ganz offen","quelle":"illustr_hb_4","band":"IV","seite":"137"},{"merkmal":"kelch_offenheit","wert":"offen","original":"Kelch: halb oder ganz offen","quelle":"illustr_hb_4","band":"IV","seite":"137"},{"merkmal":"kelchgrube_tiefe","wert":"3","original":"in seichter, gewöhnlich mit 5 kleinen Rippen versehener Einsenkung","quelle":"illustr_hb_4","band":"IV","seite":"137"},{"merkmal":"frucht_kronung","wert":"1","original":"mit 5 kleinen Rippen versehener Einsenkung, welche fast unmerklich über die Frucht hinlaufen","quelle":"illustr_hb_4","band":"IV","seite":"137"},{"merkmal":"stiel_dicke","wert":"3","original":"Stiel: dünn, holzig","quelle":"illustr_hb_4","band":"IV","seite":"137"},{"merkmal":"stielgrube_tiefe","wert":"7","original":"in ziemlich tiefer, wenig berosteter Höhle stehend","quelle":"illustr_hb_4","band":"IV","seite":"137"},{"merkmal":"schale_berostung_stielgrube","wert":"3","original":"in ziemlich tiefer, wenig berosteter Höhle stehend","quelle":"illustr_hb_4","band":"IV","seite":"137"},{"merkmal":"schale_berostung_stielgrube","wert":"7","original":"Nach Oberdieck ist die Stielhöhle gewöhnlich mit strahligem Roste bekleidet","quelle":"illustr_hb_4","band":"IV","seite":"137"},{"merkmal":"schale_beschaffenheit","wert":"glatt","original":"Schale: glatt, glänzend, fein","quelle":"illustr_hb_4","band":"IV","seite":"137"},{"merkmal":"schale_beschaffenheit","wert":"glaenzend","original":"Schale: glatt, glänzend, fein","quelle":"illustr_hb_4","band":"IV","seite":"137"},{"merkmal":"schale_grundfarbe","wert":"gelb","original":"vom Baum hellgrün, später schön gelb","quelle":"illustr_hb_4","band":"IV","seite":"137"},{"merkmal":"schale_deckfarbe_anteil","wert":"5","original":"die Sonnenseite ist mit ziemlich lebhaftem Roth verwaschen und gestreift","quelle":"illustr_hb_4","band":"IV","seite":"137"},{"merkmal":"schale_deckfarbe_farbton","wert":"hellrot","original":"mit ziemlich lebhaftem Roth verwaschen und gestreift","quelle":"illustr_hb_4","band":"IV","seite":"137"},{"merkmal":"schale_deckfarbe_art","wert":"verwaschen","original":"mit ziemlich lebhaftem Roth verwaschen und gestreift","quelle":"illustr_hb_4","band":"IV","seite":"137"},{"merkmal":"schale_deckfarbe_art","wert":"gestreift","original":"mit ziemlich lebhaftem Roth verwaschen und gestreift","quelle":"illustr_hb_4","band":"IV","seite":"137"},{"merkmal":"schale_lentizellen_anzahl","wert":"5","original":"Punkte ziemlich häufig","quelle":"illustr_hb_4","band":"IV","seite":"137"},{"merkmal":"fleisch_farbe","wert":"gelblich","original":"Fleisch: fein, gelblich, bis Januar fest, später mürbe","quelle":"illustr_hb_4","band":"IV","seite":"137"},{"merkmal":"fleisch_festigkeit","wert":"3","original":"Fleisch: fein, gelblich, bis Januar fest, später mürbe","quelle":"illustr_hb_4","band":"IV","seite":"137"},{"merkmal":"geschmack_suesse","wert":"5","original":"säuerlich-süß, angenehm gewürzt","quelle":"illustr_hb_4","band":"IV","seite":"137"},{"merkmal":"geschmack_saeure","wert":"5","original":"säuerlich-süß, angenehm gewürzt","quelle":"illustr_hb_4","band":"IV","seite":"137"},{"merkmal":"kernfaecher_oeffnung","wert":"geschlossen","original":"Kernhaus: geschlossen, hohlachsig, vollsamig","quelle":"illustr_hb_4","band":"IV","seite":"137"},{"merkmal":"kernhaus_achse","wert":"offen","original":"Kernhaus: geschlossen, hohlachsig, vollsamig","quelle":"illustr_hb_4","band":"IV","seite":"137"},{"merkmal":"kelchhoehle_form","wert":"dreieck_breit","original":"Kelchröhre: sehr kurz, weit","quelle":"illustr_hb_4","band":"IV","seite":"137"},{"merkmal":"genussreife_beginn","wert":"1","original":"Reife und Nutzung: von Januar bis Juni","quelle":"illustr_hb_4","band":"IV","seite":"137"},{"merkmal":"frucht_groesse","wert":"5","original":"Die Frucht ist mittelgroß und abgestumpft kegelförmig","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Cludius’_Borsdorfer&oldid=232515895"},{"merkmal":"frucht_form","wert":"stumpfkonisch","original":"Die Frucht ist mittelgroß und abgestumpft kegelförmig","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Cludius’_Borsdorfer&oldid=232515895"},{"merkmal":"baum_wuchs","wert":"5","original":"Der Baum wächst nur mäßig","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Cludius’_Borsdorfer&oldid=232515895"},{"merkmal":"kernhaus_breite_mm","wert":31,"original":"Kernhaus 31:31","quelle":"engelbrecht1889","seite":"374 (Nr. 332)"},{"merkmal":"kernhaus_hoehe_mm","wert":31,"original":"Kernhaus 31:31","quelle":"engelbrecht1889","seite":"374 (Nr. 332)"},{"merkmal":"kernfach_breite_mm","wert":9,"original":"Kammern 9:17","quelle":"engelbrecht1889","seite":"374 (Nr. 332)"},{"merkmal":"kernfach_hoehe_mm","wert":17,"original":"Kammern 9:17","quelle":"engelbrecht1889","seite":"374 (Nr. 332)"},{"merkmal":"genussreife_ende","wert":"6","original":"Zeitigung: Januar bis Juni","quelle":"engelbrecht1889","seite":"374 (Nr. 332)"},{"merkmal":"gesundheit","wert":"7","original":"er gilt als gesund und fruchtbar","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Cludius’_Borsdorfer&oldid=232515895"},{"merkmal":"standort_boden","wert":"3","original":"nach Oberdieck in schwerem und leichtem Boden gut","quelle":"illustr_hb_4","band":"IV","seite":"137"},{"merkmal":"ertrag_alternanz","wert":"regelmaessig","original":"trug fast jährlich sehr reich","quelle":"illustr_hb_4","band":"IV","seite":"137"},{"merkmal":"lagerfaehigkeit","wert":"7","original":"Engelbrecht und das Handbuch geben Januar bis Juni als Genusszeit an","quelle":"engelbrecht1889","seite":"374 (Nr. 332)","belege":[{"quelle":"engelbrecht1889","seite":"374 (Nr. 332)"},{"quelle":"illustr_hb_4","band":"IV","seite":"137"}]}],"texte":[{"thema":"ueberblick","text":"Hildesheimer Renette aus der Gruppe der Borsdorfer, erzogen von Superintendent Cludius. Die mittelgroße, flach kegelförmige bis plattrunde Frucht ist hellgrün bis hellgelb, sonnenseits leicht gerötet und gestreift. Das feine, anfangs feste, später mürbe Fleisch ist gewürzt und ausgewogen süßsäuerlich. Die Frucht hält sich von Januar bis in den Frühsommer.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Cludius’_Borsdorfer&oldid=232515895"},{"quelle":"engelbrecht1889","seite":"374 (Nr. 332)"},{"quelle":"illustr_hb_4","band":"IV","seite":"137"}]},{"thema":"herkunft","text":"Nach dem Illustrierten Handbuch (Bd. IV) erzog Superintendent Cludius in Hildesheim die Sorte; sie war dort noch wenig bekannt und nur in Oberdiecks Anleitung (S. 102) als Cludius' grüner Borsdorfer beschrieben, ein Name, den der Bearbeiter abzukürzen vorschlug. Wikipedia nennt den Züchter Hermann Heimart Cludius. Weitere Beschreibungen gibt es bei Dochnahl (1855) und in den Illustrirten Monatsheften (1867). Engelbrecht erhielt 1889 Früchte von Palandt aus Hildesheim.","belege":[{"quelle":"illustr_hb_4","band":"IV","seite":"137"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Cludius’_Borsdorfer&oldid=232515895"},{"quelle":"engelbrecht1889","seite":"374 (Nr. 332)"}]},{"thema":"frucht","text":"Engelbrecht maß 60 mm Breite bei 48–54 mm Höhe; nach der Abbildung im Handbuch notierte er 57:42–44 mm. Die Frucht ist abgestumpft flach kegelförmig bis fast abgestumpft rundlich, etwas stielbauchig, mit oft nicht ganz gleichen Hälften und fast rundem Querschnitt; das Handbuch nennt sie plattrund mit dem Bauch etwa in der Mitte. Der offene, lang- und feinblättrige Kelch sitzt in einer mitteltiefen (Handbuch: seichten) Einsenkung mit meist 5 kleinen, kaum über die Frucht laufenden Rippen. Der dünne Stiel ist etwa 11 mm lang und steht in einer ziemlich tiefen, weiten Höhle, die zart berostet ist; nach Oberdieck ist sie gewöhnlich strahlig berostet.","belege":[{"quelle":"engelbrecht1889","seite":"374 (Nr. 332)"},{"quelle":"illustr_hb_4","band":"IV","seite":"137"}]},{"thema":"schale","text":"Die Schale ist glatt, fein und glänzend, vom Baum hellgrün, später hellgrünlichgelb bis schön gelb. Die Sonnenseite trägt nach Engelbrecht oft einen rötlichen, undeutlich streifigen Anflug, nach dem Handbuch ein ziemlich lebhaftes, verwaschenes und gestreiftes Rot, das an beschatteten Früchten kaum zu sehen ist. Die Punkte sind mittelzahlreich bis ziemlich häufig, fein und braun. Kleine Rostanflüge und vereinzelte Rostwarzen kommen vor. Die Frucht welkt nicht, der Geruch ist sehr merklich.","belege":[{"quelle":"engelbrecht1889","seite":"374 (Nr. 332)"},{"quelle":"illustr_hb_4","band":"IV","seite":"137"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Cludius’_Borsdorfer&oldid=232515895"}]},{"thema":"schnitt","text":"Engelbrecht maß ein zwiebel-eiförmiges Kernhaus von 31:31 mm. Die Kammern (9:17 mm) sind an beiden Enden ziemlich gleich spitz, meist glattwandig, geräumig und geschlossen; die Achsenhöhle ist sehr schmal. Je Kammer liegen 2 mittelgroße, vollkommene, eiförmige, gespitzte, etwas hellbraune Kerne. Die Kelchhöhle ist kurz kegel- bis kegeltrichterförmig und reicht 2/5 zur Achsenhöhle. Nach dem Handbuch ist das Kernhaus geschlossen, hohlachsig und vollsamig, die Kelchröhre sehr kurz und weit. Das Fleisch ist am Schnitt hellgelblichweiß bis gelblich.","belege":[{"quelle":"engelbrecht1889","seite":"374 (Nr. 332)"},{"quelle":"illustr_hb_4","band":"IV","seite":"137"}]},{"thema":"fleisch_geschmack","text":"Das Fleisch ist fein, hellgelblichweiß bis gelblich, bis Januar fest, später ziemlich mürbe und genügend saftig. Engelbrecht nennt es gewürzt, mit wenig überwiegender Weinsäure und fast ebenso viel Süße; das Handbuch beschreibt den Geschmack als säuerlich-süß und angenehm gewürzt, Oberdieck als fein weinigen Zuckergeschmack.","belege":[{"quelle":"engelbrecht1889","seite":"374 (Nr. 332)"},{"quelle":"illustr_hb_4","band":"IV","seite":"137"}]},{"thema":"reife_lagerung","text":"Engelbrecht und das Handbuch geben Januar bis Juni als Genusszeit an. Die Frucht fault nach dem Handbuch nicht leicht und welkt nach Engelbrecht nicht.","belege":[{"quelle":"engelbrecht1889","seite":"374 (Nr. 332)"},{"quelle":"illustr_hb_4","band":"IV","seite":"137"}]},{"thema":"baum","text":"Der Baum wächst nach Wikipedia nur mäßig, wird mittelgroß und bildet eine breitpyramidale Krone; er gilt als gesund und fruchtbar. Im Handbuch wuchs er im Sandboden rasch, nach Oberdieck in schwerem und leichtem Boden gut, mit dicht verzweigter, reich belaubter, kugelförmiger Krone, und trug fast jährlich sehr reich.","belege":[{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Cludius’_Borsdorfer&oldid=232515895"},{"quelle":"illustr_hb_4","band":"IV","seite":"137"}]},{"thema":"verwendung","text":"Engelbrecht bewertete die Sorte mit oo†† für Tafel und Haushalt. Oberdieck schätzte die Frucht, bewertete sie für seine nördlichere Gegend aber etwas niedriger als der Bearbeiter.","belege":[{"quelle":"engelbrecht1889","seite":"374 (Nr. 332)"},{"quelle":"illustr_hb_4","band":"IV","seite":"137"}]},{"thema":"unterscheidung","text":"Nach Oberdieck darf die Sorte nicht mit Diels Grünem Borsdorfer, dem Bunten grünen Borsdorfer oder Christs Grünem Borsdorfer verwechselt werden, auch wenn Diels Beschreibung Ähnlichkeiten zeigt.","belege":[{"quelle":"illustr_hb_4","band":"IV","seite":"137"}]}],"bilder":[{"url":"https://archive.org/download/bub_gb_tR4EMgEACAAJ/page/n388_w800.jpg","seite":"https://archive.org/details/bub_gb_tR4EMgEACAAJ/page/n388","art":"schnitt","urheber":"Theodor Engelbrecht (Zeichnung), Albert Probst (Holzschnitt)","lizenz":"gemeinfrei","quelle":"engelbrecht1889","titel":"Längsschnitt-Umriss bei Engelbrecht 1889, S. 374 (ganze Buchseite)"},{"url":"https://upload.wikimedia.org/wikipedia/commons/2/2a/Cludius_Borsdorfer.png","seite":"https://commons.wikimedia.org/wiki/File:Cludius_Borsdorfer.png","art":"frucht","urheber":"Eduard Lucas","lizenz":"Public domain","quelle":"commons","titel":"Cludius Borsdorfer.png"},{"url":"https://upload.wikimedia.org/wikipedia/commons/9/90/Pom.Mon.Hefte_1867_Cludius_Borsdorfer.jpg","seite":"https://commons.wikimedia.org/wiki/File:Pom.Mon.Hefte_1867_Cludius_Borsdorfer.jpg","art":"tafel","urheber":"Unknown author Unknown author","lizenz":"gemeinfrei","quelle":"pomologische-monatshefte","titel":"Pom.Mon.Hefte 1867 Cludius Borsdorfer"}],"regionen":[{"region":"DE-NI","art":"herkunft","belege":[{"quelle":"illustr_hb_4","band":"IV","seite":"137"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Cludius’_Borsdorfer&oldid=232515895"},{"quelle":"engelbrecht1889","seite":"374 (Nr. 332)"},{"quelle":"illustr_hb_4","band":"IV","seite":"137"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Cludius’_Borsdorfer&oldid=232515895"},{"quelle":"engelbrecht1889","seite":"374 (Nr. 332)"}]}]}