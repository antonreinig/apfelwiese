le":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Zwiebelborsdorfer&oldid=210773743"},{"merkmal":"schale_grundfarbe","wert":"gelb","original":"Zur Reife sind die Früchte hellgelb","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Zwiebelborsdorfer&oldid=210773743"},{"merkmal":"schale_deckfarbe_art","wert":"verwaschen","original":"flächiger oder geflammter Rotfärbung auf der Sonnenseite","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Zwiebelborsdorfer&oldid=210773743"},{"merkmal":"schale_deckfarbe_art","wert":"geflammt","original":"flächiger oder geflammter Rotfärbung auf der Sonnenseite","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Zwiebelborsdorfer&oldid=210773743"},{"merkmal":"fleisch_farbe","wert":"cremeweiss","original":"hell gelblichweiß","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Zwiebelborsdorfer&oldid=210773743"},{"merkmal":"fleisch_festigkeit","wert":"7","original":"Das feinzellige Fruchtfleisch ist fest","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Zwiebelborsdorfer&oldid=210773743"},{"merkmal":"fleisch_saftigkeit","wert":"3","original":"die Früchte haben wenig Saft und Würze","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Zwiebelborsdorfer&oldid=210773743"},{"merkmal":"geschmack_saeure","wert":"7","original":"vorwiegend weinsäuerlich mit variabler Süße","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Zwiebelborsdorfer&oldid=210773743"},{"merkmal":"verwendung","wert":"kueche","original":"hauptsächlich als Wirtschafts- und Mostapfel; 1886 … für das Dörren empfohlen","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Zwiebelborsdorfer&oldid=210773743"},{"merkmal":"verwendung","wert":"most","original":"hauptsächlich als Wirtschafts- und Mostapfel; 1886 … für das Dörren empfohlen","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Zwiebelborsdorfer&oldid=210773743"},{"merkmal":"verwendung","wert":"doerren","original":"hauptsächlich als Wirtschafts- und Mostapfel; 1886 … für das Dörren empfohlen","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Zwiebelborsdorfer&oldid=210773743"},{"merkmal":"kernhaus_breite_mm","wert":30,"original":"Kernhaus 30:25","quelle":"engelbrecht1889","seite":"389 (Nr. 345)"},{"merkmal":"kernhaus_hoehe_mm","wert":25,"original":"Kernhaus 30:25","quelle":"engelbrecht1889","seite":"389 (Nr. 345)"},{"merkmal":"lagerfaehigkeit","wert":"7","original":"nach Engelbrecht bis April","quelle":"engelbrecht1889","seite":"389 (Nr. 345)"},{"merkmal":"ertrag_beginn","wert":"frueh","original":"Nach dem Handbuch trägt er weit früher als der Winter-Borsdorfer und dann fast jährlich","quelle":"illustr_hb_1","band":"I","seite":"305"},{"merkmal":"ertrag_alternanz","wert":"regelmaessig","original":"Nach dem Handbuch trägt er weit früher als der Winter-Borsdorfer und dann fast jährlich","quelle":"illustr_hb_1","band":"I","seite":"305"},{"merkmal":"ertrag_beginn","wert":"mittel","original":"Wikipedia beschreibt den Ertragsbeginn als mittelfrüh","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Zwiebelborsdorfer&oldid=210773743"},{"merkmal":"ertrag_alternanz","wert":"alternierend","original":"den Ertrag als ausgeprägt alternierend","quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Zwiebelborsdorfer&oldid=210773743"},{"merkmal":"standort_boden","wert":"3","original":"Die Sorte ist anspruchslos an Boden und Klima","quelle":"illustr_hb_1","band":"I","seite":"305","belege":[{"quelle":"illustr_hb_1","band":"I","seite":"305"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Zwiebelborsdorfer&oldid=210773743"}]},{"merkmal":"standort_klima","wert":"3","original":"in Sachsen wurde sie für kalte Lagen und feuchte Böden empfohlen","quelle":"illustr_hb_1","band":"I","seite":"305","belege":[{"quelle":"illustr_hb_1","band":"I","seite":"305"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Zwiebelborsdorfer&oldid=210773743"}]}],"texte":[{"thema":"ueberblick","text":"Alte, flachrunde Wintersorte aus der Verwandtschaft der Borsdorfer, benannt nach ihrer Zwiebelform. Die hellgelbe Frucht ist sonnenseits karminrot überzogen, das gelblichweiße Fleisch schmeckt vorwiegend weinsäuerlich. Sie galt im 19. Jahrhundert als Wirtschaftsapfel ersten und Tafelapfel zweiten Ranges und wurde vor allem für Haushalt, Most und Dörren genutzt. Der Baum ist anspruchslos und gedeiht auch in rauen Lagen.","belege":[{"quelle":"illustr_hb_1","band":"I","seite":"305"},{"quelle":"engelbrecht1889","seite":"389 (Nr. 345)"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Zwiebelborsdorfer&oldid=210773743"}]},{"thema":"herkunft","text":"Der Ursprung ist unbekannt; das Handbuch (1859, Beitrag von Flotow) vermutet holländische oder deutsche Herkunft. Nach Wikipedia soll die Sorte schon im 17. Jahrhundert um Leipzig bekannt gewesen sein. Sicher beschrieben hat sie Hirschfeld 1778 unter den holsteinischen Äpfeln als Zwiebel- oder Zipollenapfel, danach Christ und Diel. Um 1859 war sie in ganz Deutschland verbreitet, aber nirgends in großer Menge angebaut. Engelbrecht erhielt Früchte aus Stauffenburg bei Gittelde am Harz, Bittstädt bei Arnstadt, Meißen und Kiel.","belege":[{"quelle":"illustr_hb_1","band":"I","seite":"305"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Zwiebelborsdorfer&oldid=210773743"},{"quelle":"engelbrecht1889","seite":"389 (Nr. 345)"}]},{"thema":"frucht","text":"Engelbrecht maß 68 mm Breite bei nur 45 bis 48 mm Höhe, oft kleiner. Die Frucht ist flachrund, mittel- oder kelchbauchig; die Kelchwölbung ist häufig etwas breiter als die Stielwölbung, die Hälften meist gleich. Der geschlossene oder wenig offene Kelch mit kurzen, breiten Blättchen sitzt in einer flachen, weiten, kaum gefalteten Grube; der Querschnitt ist rund. Der dünne, holzige Stiel ist 10 mm lang oder länger, nach Wikipedia sehr kurz. Die ziemlich enge, mitteltiefe Stielgrube ist oft weithin und etwas rau, nach Wikipedia strahlig berostet.","belege":[{"quelle":"engelbrecht1889","seite":"389 (Nr. 345)"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Zwiebelborsdorfer&oldid=210773743"},{"quelle":"illustr_hb_1","band":"I","seite":"305"}]},{"thema":"schale","text":"Die Schale ist glatt, etwas geschmeidig und matt glänzend, vom Baum hellgrünlich gelb, in der Reife hellgelb; das Handbuch nennt sie blass strohgelb. Die Sonnenseite ist bald stark, bald schwach karminrot überzogen, sehr selten etwas streifig; nach Wikipedia ist die Rotfärbung flächig oder geflammt. Bei beschatteten Früchten fehlt sie. Die Lentizellen sind zahlreich, fein bis mitteldick und braun, zum Stiel hin stärker und eckig und auf gelbem Grund deutlich fühlbar. Leichte Rostanflüge und Warzen kommen vor. Die Frucht welkt nicht oder kaum, ist aber druckempfindlich.","belege":[{"quelle":"engelbrecht1889","seite":"389 (Nr. 345)"},{"quelle":"illustr_hb_1","band":"I","seite":"305"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Zwiebelborsdorfer&oldid=210773743"}]},{"thema":"schnitt","text":"Nach Engelbrecht ist das Kernhaus mit 30 × 25 mm klein und rundlich zwiebelförmig. Die Kammern (9 × 16 mm) sind stielwärts spitz, kelchwärts abgerundet, glattwandig, mittelgeräumig und wenig offen; die Achsenhöhle ist meist ziemlich schmal. Je Kammer liegen ein bis zwei mittelgroße, meist vollkommene, länglich eiförmige, kurz gespitzte braune Kerne. Die Kelchhöhle ist kurz trichter- oder kegeltrichterförmig und reicht ⅖ zur Achsenhöhle. Das Handbuch nennt das Kernhaus nur schwach ausgeprägt, die Fächer ziemlich eng und zur bald größeren, bald kleineren Achsenhöhle geöffnet, die Kerne meist flach und Kelchhöhle samt Röhre kurz trichterförmig. Das Fleisch ist am Schnitt hell gelblichweiß.","belege":[{"quelle":"engelbrecht1889","seite":"389 (Nr. 345)"},{"quelle":"illustr_hb_1","band":"I","seite":"305"}]},{"thema":"fleisch_geschmack","text":"Das Fleisch ist hell gelblichweiß und fein, nach Engelbrecht etwas fest, später markig und mäßig saftig, nach dem Handbuch mürbe und ziemlich saftig, nach Wikipedia fest und wenig saftig. Der Geschmack ist vorherrschend weinig bis weinsäuerlich und wenig gewürzt; die Süße schwankt stark. Nach dem Handbuch verliert sich die Säure auf gutem Boden und in warmer Lage fast ganz, dann ähnelt die Frucht dem Edelborsdorfer.","belege":[{"quelle":"engelbrecht1889","seite":"389 (Nr. 345)"},{"quelle":"illustr_hb_1","band":"I","seite":"305"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Zwiebelborsdorfer&oldid=210773743"}]},{"thema":"reife_lagerung","text":"Genussreif ab Ende November, nach Engelbrecht bis April. Wikipedia nennt als Reifezeit Ende Oktober und eine Haltbarkeit von etwa fünf bis sechs Monaten im kühlen Naturlager.","belege":[{"quelle":"engelbrecht1889","seite":"389 (Nr. 345)"},{"quelle":"illustr_hb_1","band":"I","seite":"305"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Zwiebelborsdorfer&oldid=210773743"}]},{"thema":"baum","text":"Der Baum wird nicht sehr groß und bildet eine mittelgroße, flachkugelige Krone mit dünner Verzweigung; die Äste stehen im Alter fast waagerecht ab, die feinen Zweige hängen etwas. Nach dem Handbuch trägt er weit früher als der Winter-Borsdorfer und dann fast jährlich; Wikipedia beschreibt den Ertragsbeginn als mittelfrüh und den Ertrag als ausgeprägt alternierend. Nach dem Handbuch treibt und blüht er ziemlich spät. Die Sorte ist anspruchslos an Boden und Klima; in Sachsen wurde sie für kalte Lagen und feuchte Böden empfohlen. Eine Anmerkung der Redaktion im Handbuch erwähnt sehr große, alte und reich tragende Bäume in schwerem Calenberger Boden.","belege":[{"quelle":"illustr_hb_1","band":"I","seite":"305"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Zwiebelborsdorfer&oldid=210773743"}]},{"thema":"verwendung","text":"Engelbrecht und das Handbuch bewerten sie als Tafelobst zweiten, als Wirtschaftsobst ersten Ranges. Genutzt wurde sie vor allem im Haushalt und für Most; 1886 empfahl der Deutsche Pomologenverein sie zum Dörren.","belege":[{"quelle":"engelbrecht1889","seite":"389 (Nr. 345)"},{"quelle":"illustr_hb_1","band":"I","seite":"305"},{"quelle":"wikipedia_de","url":"https://de.wikipedia.org/w/index.php?title=Zwiebelborsdorfer&oldid=210773743"}]},{"thema":"unterscheidung","text":"Das Handbuch warnt vor einer Verwechslung mit dem eigentlichen, nach der Fruchtfarbe benannten Zwiebelapfel. Christs Doppelten Zwiebelapfel hielt das Handbuch für einen gut ausgebildeten Zwiebelborsdorfer; Engelbrecht führt ihn dagegen als eigene Sorte (Nr. 346).","belege":[{"quelle":"illustr_hb_1","band":"I","seite":"305"},{"quelle":"engelbrecht1889","seite":"390 (Nr. 346)"}]}],"bilder":[{"url":"https://archive.org/download/bub_gb_tR4EMgEACAAJ/page/n403_w800.jpg","seite":"https://archive.org/details/bub_gb_tR4EMgEACAAJ/page/n403","art":"schnitt","urheber":"Theodor Engelbrecht (Zeichnung), Albert Probst (Holzschnitt)","lizenz":"gemeinfrei","quelle":"engelbrecht1889","titel":"Längsschnitt-Umriss bei Engelbrecht 1889, S. 389 (ganze Buchseite)"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/f/f1/Malus_Zwiebelborsdorfer_4161.JPG/960px-Malus_Zwiebelborsdorfer_4161.JPG","seite":"https://commons.wikimedia.org/wiki/File:Malus_Zwiebelborsdorfer_4161.JPG","art":"frucht","urheber":"Sven Teschke","lizenz":"CC BY-SA 3.0 de","quelle":"commons","titel":"Malus Zwiebelborsdorfer 4161.JPG"},{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/98/Zwiebelapfel_%28apple%29_jm156656.jpg/960px-Zwiebelapfel_%28apple%29_jm156656.jpg","seite":"https://commons.wikimedia.org/wiki/File:Zwiebelapfel_(apple)_jm156656.jpg","art":"schnitt","urheber":"Joergens.mi","lizenz":"CC BY-SA 3.0","quelle":"commons-fotos","titel":"Zwiebelapfel (apple) jm156656"}],"gefaehrdung":[{"stufe":"Rote Liste der gefährdeten einheimischen Nutzpflanzen in Deutschland","belege":[{"quelle":"rg_ble-rote-liste"}],"original":"Zwiebelborsdorfer"}]}