rkmal":"frucht_hoehe_breite","wert":0.68,"original":"Gestalt 68:45—48","quelle":"engelbrecht1889","seite":"389 (Nr. 345)"},{"merkmal":"frucht_form","wert":"flachrund","original":"oft kleiner, flachrund","quelle":"engelbrecht1889","seite":"389 (Nr. 345)"},{"merkmal":"frucht_breiteste_stelle","wert":"mitte","original":"mittelbauch., häufig kelchbauch.","quelle":"engelbrecht1889","seite":"389 (Nr. 345)"},{"merkmal":"frucht_breiteste_stelle","wert":"kelch","original":"mittelbauch., häufig kelchbauch.","quelle":"engelbrecht1889","seite":"389 (Nr. 345)"},{"merkmal":"frucht_symmetrie","wert":"symmetrisch","original":"Hälften meistens gleich","quelle":"engelbrecht1889","seite":"389 (Nr. 345)"},{"merkmal":"frucht_rippung","wert":"1","original":"Querschn. rund","quelle":"engelbrecht1889","seite":"389 (Nr. 345)"},{"merkmal":"frucht_kronung","wert":"1","original":"Einsenk. flach, weit, kaum merklich faltig","quelle":"engelbrecht1889","seite":"389 (Nr. 345)"},{"merkmal":"kelch_offenheit","wert":"geschlossen","original":"Kelch geschlossen oder wenig offen","quelle":"engelbrecht1889","seite":"389 (Nr. 345)"},{"merkmal":"kelchgrube_tiefe","wert":"3","original":"Einsenk. flach, weit","quelle":"engelbrecht1889","seite":"389 (Nr. 345)"},{"merkmal":"kelchgrube_weite","wert":"7","original":"Einsenk. flach, weit","quelle":"engelbrecht1889","seite":"389 (Nr. 345)"},{"merkmal":"stiel_dicke","wert":"3","original":"Stiel holzig, dünn, 10 mm lang, meistens länger","quelle":"engelbrecht1889","seite":"389 (Nr. 345)"},{"merkmal":"stielgrube_tiefe","wert":"5","original":"Höhle mitteltief, ziemlich enge, eben","quelle":"engelbrecht1889","seite":"389 (Nr. 345)"},{"merkmal":"stielgrube_weite","wert":"3","original":"Höhle mitteltief, ziemlich enge","quelle":"engelbrecht1889","seite":"389 (Nr. 345)"},{"merkmal":"schale_berostung_stielgrube","wert":"7","original":"oft weithin und etwas rauh berostet","quelle":"engelbrecht1889","seite":"389 (Nr. 345)"},{"merkmal":"schale_beschaffenheit","wert":"glatt","