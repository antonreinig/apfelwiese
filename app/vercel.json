{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "fra1"
  ],
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), geolocation=(self), accelerometer=(self), gyroscope=(self), magnetometer=(self), microphone=(), payment=(), usb=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://tile.openstreetmap.org https://*.blob.vercel-storage.com; connect-src 'self' https://nominatim.openstreetmap.org https://*.blob.vercel-storage.com https://vercel.com; media-src 'self' blob:; worker-src 'self' blob:; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; manifest-src 'self'"
        }
      ]
    },
    {
      "source": "/api/((?!kachel).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/kacheln/luftbild/:z(\\d{1,2})/:y(\\d{1,7})/:x(\\d{1,7})",
      "destination": "/api/kachel?art=luftbild&z=:z&y=:y&x=:x"
    },
    {
      "source": "/wm/:pfad(.*)",
      "destination": "/api/kachel?art=wm&p=:pfad"
    }
  ],
  "crons": [
    {
      "path": "/api/aufraeumen",
      "schedule": "7 * * * *"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "apfelwiese.vercel.app"
        }
      ],
      "destination": "https://apfelwiese.app/",
      "permanent": true
    },
    {
      "source": "/:pfad+",
      "has": [
        {
          "type": "host",
          "value": "apfelwiese.vercel.app"
        }
      ],
      "destination": "https://apfelwiese.app/:pfad+",
      "permanent": true
    }
  ]
}